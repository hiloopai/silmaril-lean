#!/bin/sh
# Dispatch tool families without adding a runtime dependency.
set -eu

usage() {
    cat <<'EOF'
Usage: sil <family> <command> [arguments...]

Families:
  wasm      WebAssembly tools
  project   Silmaril projects: records, artifacts, the problem DAG

Commands:
  sil wasm as          Assemble text into a binary module
  sil wasm dis         Disassemble a binary module into text
  sil wasm opt         Apply selected program transformations
  sil wasm merge       Link named modules
  sil wasm shell       Invoke an export with a step budget
  sil wasm ctor-eval   Evaluate a supported constructor
  sil wasm metadce     Remove code using a reachability graph

  sil project init       Write silmaril.toml, the artifact registry and a records file
  sil project artifacts  Add a file to the artifact registry
  sil project lock       Hash the registry's files
  sil project lint       Check records files and the registry without Lean
  sil project dump       Build the project's modules and write the Lean dump
  sil project check      Check the dump: references, provenance, the DAG, statuses
  sil project sqlite     Check, then write the canonical SQL and the SQLite database
  sil project explore    Write a static HTML page over the database
  sil project schema     Print the records-file schema as JSON Schema

Run `sil wasm <command> --help` or `sil project --help` for options.
Build the Wasm tools with `make tools` (docs/projects/wasm.md) and `sil project` with
`make project-tool` (docs/projects/silmaril-projects.md).
EOF
}

case "${1:-}" in
    ''|-h|--help|help) usage; exit 0 ;;
    --version) echo 'sil 0.1.0'; exit 0 ;;
    wasm) shift ;;
    project)
        shift
        # `silmaril-project` is a Cargo binary: staged next to this script by `make
        # project-tool`, else a build in tools/silmaril-project, else on PATH.
        script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
        crate="$script_dir/../tools/silmaril-project"
        for bin in "$script_dir/silmaril-project" \
            "${CARGO_TARGET_DIR:-$crate/target}/release/silmaril-project" \
            "${CARGO_TARGET_DIR:-$crate/target}/debug/silmaril-project"; do
            if [ -x "$bin" ]; then exec "$bin" "$@"; fi
        done
        if command -v silmaril-project >/dev/null 2>&1; then exec silmaril-project "$@"; fi
        echo "sil: silmaril-project is not built; run 'make project-tool' from the repository root" >&2
        exit 127 ;;
    *) echo "sil: unknown family: $1 (see sil --help)" >&2; exit 2 ;;
esac

case "${1:-}" in
    ''|-h|--help|help) usage; exit 0 ;;
    as|dis|opt|merge|shell|ctor-eval|metadce) tool="wasm-$1"; shift ;;
    *) echo "sil wasm: unknown command: $1 (see sil --help)" >&2; exit 2 ;;
esac

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
for bin_dir in "$script_dir" "$script_dir/../.lake/build/bin"; do
    if [ -x "$bin_dir/$tool" ]; then
        exec "$bin_dir/$tool" "$@"
    fi
done
echo "sil: $tool is not built; run 'make tools' from the repository root" >&2
exit 127
