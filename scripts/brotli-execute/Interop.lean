module

import Lean
import Silmaril.Formats.Compression.Brotli.Execute.Defs
meta import Silmaril.Formats.Compression.Brotli.Execute.Defs

open Lean Silmaril.Formats.Compression
open Silmaril.Formats.Compression.Brotli

private def requireIO {ε α : Type} [Repr ε] (result : Except ε α) : IO α :=
  match result with
  | .error error => throw (IO.userError (reprStr error))
  | .ok value => pure value

private def take (reader : LSBReader) (width : Nat) : IO (Nat × LSBReader) :=
  match reader.readBits width with
  | none => throw (IO.userError "truncated fixture framing")
  | some result => pure result

private def window (reader : LSBReader) : IO (Nat × LSBReader) := do
  let (first, cursor) ← take reader 1
  if first = 0 then return (16, cursor)
  let (short, cursor) ← take cursor 3
  if short ≠ 0 then return (17 + short, cursor)
  let (long, cursor) ← take cursor 3
  if long = 1 then throw (IO.userError "invalid standard window")
  pure (if long = 0 then 17 else 8 + long, cursor)

private def align (reader : LSBReader) : IO LSBReader := do
  let (fill, after) ← take reader ((8 - reader.totalRead % 8) % 8)
  if fill ≠ 0 then throw (IO.userError "nonzero alignment fill")
  pure after

private inductive FrameBlock where
  | terminal
  | emptyMetadata (last : Bool)
  | compressed (last : Bool) (length : Nat)

-- Minimal framing for the producer fixtures, including empty metadata
-- generated by the writer's flush operation.
private def frameBlock (before : LSBReader) : IO (FrameBlock × LSBReader) := do
  let (last, cursor) ← take before 1
  let (empty, cursor) ← if last = 1 then take cursor 1 else pure (0, cursor)
  if empty = 1 then return (.terminal, cursor)
  let (selector, cursor) ← take cursor 2
  if selector = 3 then
    let (reserved, cursor) ← take cursor 1
    let (skipWidth, cursor) ← take cursor 2
    unless reserved == 0 && skipWidth == 0 do throw (IO.userError "fixture metadata")
    return (.emptyMetadata (last == 1), ← align cursor)
  let width := 4 * (4 + selector)
  let (sizeMinusOne, cursor) ← take cursor width
  if selector ≠ 0 && sizeMinusOne < 2 ^ (width - 4) then
    throw (IO.userError "noncanonical fixture length")
  let (raw, cursor) ← if last = 0 then take cursor 1 else pure (0, cursor)
  unless raw == 0 do throw (IO.userError "fixture raw meta-block")
  pure (.compressed (last == 1) (sizeMinusOne + 1), cursor)

private def showRing (ring : Distance.Ring) : List Nat :=
  [ring.latest, ring.second, ring.third, ring.fourth]

private def report (state : Execute.State) (rows : Array (List Nat)) (failure : Option (List Nat)) : IO UInt32 := do
  IO.println (Json.mkObj [
    ("output", toJson (state.output.toList.map UInt8.toNat)),
    ("commands", toJson rows),
    ("dictionary", toJson failure)]).compress
  return 0

public def main (args : List String) : IO UInt32 := do
  let [path] := args | return 2
  let raw ← IO.FS.readBinFile path
  let (windowBits, first) ← window (LSBReader.ofByteArray raw)
  let mut state := Execute.State.start
  let mut cursor := first
  let mut rows : Array (List Nat) := #[]
  let mut terminal := false
  for _ in [:32] do
    let (frame, afterFrame) ← frameBlock cursor
    cursor := afterFrame
    match frame with
    | .terminal =>
      terminal := true
      break
    | .emptyMetadata last =>
      if last then
        terminal := true
        break
    | .compressed last length =>
      let (header, payload) ← requireIO (CompressedHeader.read ⟨17408, 768, 100000⟩ cursor)
      cursor := payload
      let descriptor : Execute.Block := ⟨windowBits, state.output.size, length⟩
      for _ in [:length] do
        if state.output.size == descriptor.endOutput then break
        let stepStart := cursor.totalRead
        match Execute.read header descriptor ⟨8192, raw.size * 8 - stepStart⟩ state cursor with
        | .error (.unsupportedDictionary distance wordLength wordId) =>
          return ← report state rows (some [stepStart, distance, wordLength, wordId])
        | .error reason => throw (IO.userError s!"command at bit {stepStart}: {reprStr reason}")
        | .ok (result, after) =>
          rows := rows.push ([descriptor.start, length, stepStart, after.totalRead, result.state.output.size,
            result.command.insertLength, result.command.copyLength, result.distance.getD 0] ++
            showRing result.state.ring)
          state := result.state
          cursor := after
      unless state.output.size == descriptor.endOutput do throw (IO.userError "meta-block extent")
      if last then
        terminal := true
        break
  unless terminal do throw (IO.userError "fixture block limit")
  let after ← align cursor
  unless after.input.isEmpty do throw (IO.userError "trailing fixture bytes")
  report state rows none
