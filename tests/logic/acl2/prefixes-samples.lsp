(in-package "ACL2")
(set-guard-checking :none)

(defun prefix-projection-sample (x)
  (list x (x86isa::prefixes-fix x) (x86isa::prefixes->adr x)
        (x86isa::prefixes->num x) (x86isa::prefixes->nxt x)))

(assign prefix-projection-samples
  (list (prefix-projection-sample 0)
        (prefix-projection-sample 15)
        (prefix-projection-sample 16)
        (prefix-projection-sample (1- (expt 2 36)))
        (prefix-projection-sample (expt 2 36))
        (prefix-projection-sample (1- (expt 2 44)))
        (prefix-projection-sample (expt 2 44))
        (prefix-projection-sample (1- (expt 2 52)))
        (prefix-projection-sample (expt 2 52))
        (prefix-projection-sample (+ (expt 2 80) (ash 201 44) (ash 173 36) 7))
        (prefix-projection-sample -1)
        (prefix-projection-sample (- (expt 2 52)))
        (prefix-projection-sample (- (- (expt 2 52)) 1))
        (prefix-projection-sample -17)
        (prefix-projection-sample -3/2)
        (prefix-projection-sample #C(1 -2))
        (prefix-projection-sample "123")
        (prefix-projection-sample :bad)
        (prefix-projection-sample nil)
        (prefix-projection-sample '(1 . 2))))
