; Logical observations of pure functions, including calls outside their guards.
(in-package "ACL2")
(set-guard-checking :none)

(defmacro bit-selection-case (fn &rest args)
  `(list ',fn (list ,@args) (,fn ,@args)))

(assign bit-selection-samples
  (list (bit-selection-case loghead$inline 0 -13)
        (bit-selection-case loghead$inline 4 -13)
        (bit-selection-case loghead$inline -2 -13)
        (bit-selection-case loghead$inline 5/2 -13)
        (bit-selection-case loghead$inline 4 #c(3 1))
        (bit-selection-case loghead$inline 129 -1)
        (bit-selection-case logtail$inline 2 -13)
        (bit-selection-case logtail$inline 2 13)
        (bit-selection-case logtail$inline -2 -13)
        (bit-selection-case logtail$inline 5/2 -13)
        (bit-selection-case logtail$inline :bad -13)
        (bit-selection-case logtail$inline 2 7/2)
        (bit-selection-case logtail$inline 129 -13)
        (bit-selection-case bitops::part-select-width-low$inline -13 4 2)
        (bit-selection-case bitops::part-select-width-low$inline -13 :bad 2)
        (bit-selection-case bitops::part-select-width-low$inline 254 3 -2)
        (bit-selection-case bitops::part-select-low-high$inline 214 1 4)
        (bit-selection-case bitops::part-select-low-high$inline -13 2 5)
        (bit-selection-case bitops::part-select-low-high$inline 16 4 4)
        (bit-selection-case bitops::part-select-low-high$inline -1 4 3)
        (bit-selection-case bitops::part-select-low-high$inline -1 4 2)
        (bit-selection-case bitops::part-select-low-high$inline 254 -2 0)
        (bit-selection-case bitops::part-select-low-high$inline 254 1/2 5/2)
        (bit-selection-case bitops::part-select-low-high$inline 254 1/2 2)
        (bit-selection-case bitops::part-select-low-high$inline 254 #c(1 2) #c(3 2))
        (bit-selection-case bitops::part-select-low-high$inline 254 #c(1 2) #c(3 3))
        (bit-selection-case bitops::part-select-low-high$inline 254 :bad 3)
        (bit-selection-case bitops::part-select-low-high$inline 254 -2 "bad")
        (bit-selection-case bitops::part-select-low-high$inline 254 -2 -1)
        (bit-selection-case bitops::part-select-low-high$inline '(4 . 6) 0 9)
        (bit-selection-case bitops::part-select-low-high$inline
          (+ (expt 2 160) (expt 2 130)) 128 132)))
