(in-package "ACL2")
(set-guard-checking :none)
(defpkg "SILMARIL-P" '(common-lisp::nil))
(defpkg "SILMARIL-Q" nil)

(cw "~%SILMARIL nil-home ~x0~%" (if (equal (symbol-package-name 'nil) "COMMON-LISP") 1 0))
(cw "~%SILMARIL t-home ~x0~%" (if (equal (symbol-package-name 't) "COMMON-LISP") 1 0))
(cw "~%SILMARIL imported-nil ~x0~%" (if (equal 'silmaril-p::nil 'nil) 1 0))
(cw "~%SILMARIL other-nil ~x0~%" (if 'silmaril-q::nil 1 0))
(cw "~%SILMARIL same-spelling ~x0~%" (if (equal 'silmaril-p::a 'silmaril-q::a) 1 0))
(cw "~%SILMARIL symbol-completion ~x0~%" (length (symbol-name 3)))
(cw "~%SILMARIL atom-car ~x0~%" (if (car 3) 1 0))
(cw "~%SILMARIL dotted-cdr ~x0~%" (cdr '(a . 5)))
(cw "~%SILMARIL dotted-append ~x0~%" (cdr (binary-append '(a . 5) 6)))
(cw "~%SILMARIL true-listp ~x0~%" (if (true-listp '(a . 5)) 1 0))
(cw "~%SILMARIL byte-255 ~x0~%" (char-code (code-char 255)))
(cw "~%SILMARIL byte-negative ~x0~%" (char-code (code-char -1)))
(cw "~%SILMARIL byte-overflow ~x0~%" (char-code (code-char 256)))
(cw "~%SILMARIL char-completion ~x0~%" (char-code "a"))
(cw "~%SILMARIL coerce-dotted ~x0~%" (char-code (cadr (coerce (coerce '(#\A 7 . 5) 't) 'list))))
(cw "~%SILMARIL coerce-atom ~x0~%" (if (coerce 7 'list) 1 0))
(cw "~%SILMARIL reduced-denominator ~x0~%" (denominator -6/8))
(cw "~%SILMARIL complex-zero ~x0~%" (if (rationalp (complex 1/2 0)) 1 0))
(cw "~%SILMARIL complex-completion ~x0~%" (numerator (imagpart (complex 'a 1/2))))
(cw "~%SILMARIL complex-inverse ~x0~%" (denominator (imagpart (/ #c(1 2)))))
(cw "~%SILMARIL divide-zero ~x0~%" (/ 0))
(cw "~%SILMARIL divide-atom ~x0~%" (/ 'a))
(cw "~%SILMARIL ordering-complex ~x0~%" (if (< 'a #c(0 1)) 1 0))
(cw "~%SILMARIL add-atom ~x0~%" (+ 'a 8))
(cw "~%SILMARIL mul-atom ~x0~%" (* #c(0 1) 'a))
(cw "~%SILMARIL negate-atom ~x0~%" (- 'a))
(cw "~%SILMARIL numerator-complex ~x0~%" (numerator #c(4 1)))
(cw "~%SILMARIL denominator-complex ~x0~%" (denominator #c(4 1)))
(cw "~%SILMARIL zp-negative ~x0~%" (if (zp -3) 1 0))
(cw "~%SILMARIL zp-ratio ~x0~%" (if (zp 1/2) 1 0))
(cw "~%SILMARIL zp-positive ~x0~%" (if (zp 1) 1 0))
(cw "~%SILMARIL nfix-decrement ~x0~%" (nfix (1- 1)))
(cw "~%SILMARIL acl2-count ~x0~%" (acl2-count '("abc" #c(-1/2 2) . 3)))
:good-bye
