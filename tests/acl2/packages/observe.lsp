(include-book "package-use")
(assert-event
 (and (eq 'silmaril-c2-use::|takeFirst| 'silmaril-c2-home::|takeFirst|)
      (not (eq 'silmaril-c2-use::|takeFirst| 'silmaril-c2-other::|takeFirst|))
      (equal (symbol-name 'silmaril-c2-use::|takeFirst|) "takeFirst")
      (equal (symbol-name 'silmaril-c2-home::TAKEF\irst) "TAKEFiRST")
      (equal (symbol-package-name 'silmaril-c2-use::nil) "SILMARIL-C2-USE")
      (eq 'acl2::car 'common-lisp:car)
      (equal (getpropc 'silmaril-c2-use::package-first 'unnormalized-body nil (w state))
             '(silmaril-c2-home::|takeFirst| silmaril-c2-use::x))
      (equal (getpropc 'silmaril-c2-home::|takeFirst| 'unnormalized-body nil (w state))
             '(common-lisp:car silmaril-c2-home::x))
      (eq (silmaril-c2-use::package-first (cons t nil)) t)))
(value-triple :silmaril-package-check-passed)
(quit)
