module

public import Silmaril.Machine.Abi.Conformance.Defs
public import Silmaril.Machine.Abi.Conformance.ZlibLibz.Bytes

/-!
# ABI conformance of zlib's checksum functions: the code in Ubuntu's `libz.so.1.3`

The second binary of the zlib checksum rows. The prototypes and C specs are the ones of
`Silmaril.Machine.Abi.Conformance.Zlib` (`zProto`, `wProto`, `crc32zS`, …): one header, one set
of specs. Only the code differs.

**Code** in the pinned `examples/elf/pinned/zlib-libz.so.1.3` (zlib 1.3, Ubuntu zlib1g
1:1.3.dfsg-3.1ubuntu2.3, `ET_DYN`, stripped), at its **link-time addresses** (the rows rebase it,
`Code.rebase`). The bytes are `ZlibLibz.Bytes` (generated by `scripts/abi-bytes/zlib_libz.py`).

| function | `.dynsym` | region | entry offset, extent |
| --- | --- | --- | --- |
| `crc32_z` | `0x7440`, 2798 B | `[0x7440, 0x7f2e)` | `0`, 2798 |
| `crc32` | `0x7f30`, 11 B | `[0x7440, 0x7f3b)`: `crc32_z`, 2 gap bytes, `crc32` | `0xaf0`, 11 |
| `adler32_z` | `0x6ba0`, 1716 B | `[0x6ba0, 0x7254)` | `0`, 1716 |
| `adler32` | `0x7260`, 11 B | `[0x6ba0, 0x726b)`: `adler32_z`, 12 gap bytes, `adler32` | `0x6c0`, 11 |

The wrappers are `endbr64; mov %edx,%edx; jmp <_z>`, so their regions span the `_z` function.
`crc32_z` reads its tables (braid tables and `crc_table`, at `0x16180` and `0x18180`) by
`%rip`-relative addresses inside the read-only `PT_LOAD` at `0x14000`; the CRC code carries
that whole segment (`0x5e74` bytes) as one `Code.data` entry, so an admitted call has the tables
loaded. `adler32_z` has no `%rip`-relative operand and carries no data. The image is the file's
four `PT_LOAD` ranges.
-/

@[expose] public section

namespace Silmaril.Machine.Abi.Conformance.ZlibLibz

open Silmaril.X86 (Word Byte)
open Silmaril.Machine.Abi.Conformance

/-- The read-only `PT_LOAD` at `0x14000` (`0x5e74` bytes, the CRC tables in it) as read-only data. -/
def crcData : List (Word × List Byte) := [(0x14000, rodata)]

/-- The image of the pinned file: its `PT_LOAD` ranges `(p_vaddr, p_memsz)`. -/
def image : List (Word × Nat) :=
  [(0x0, 0x2000), (0x2000, 0x11c8d), (0x14000, 0x5e74), (0x1ac70, 0x428)]

/-- `crc32_z`: `0x7440`, 2798 bytes. -/
def crc32zCode : Code := ⟨0x7440, crc32zBytes, 0, 2798, crcData, image⟩

/-- `crc32`: `0x7f30`, 11 bytes, a `jmp` to `crc32_z`; the region starts at `crc32_z`. -/
def crc32Code : Code := ⟨0x7440, crc32zBytes ++ crcGap ++ crc32Bytes, 0xaf0, 11, crcData, image⟩

/-- `adler32_z`: `0x6ba0`, 1716 bytes. -/
def adler32zCode : Code := ⟨0x6ba0, adler32zBytes, 0, 1716, [], image⟩

/-- `adler32`: `0x7260`, 11 bytes, a `jmp` to `adler32_z`; the region starts at `adler32_z`. -/
def adler32Code : Code := ⟨0x6ba0, adler32zBytes ++ adlerGap ++ adler32Bytes, 0x6c0, 11, [], image⟩

end Silmaril.Machine.Abi.Conformance.ZlibLibz

end
