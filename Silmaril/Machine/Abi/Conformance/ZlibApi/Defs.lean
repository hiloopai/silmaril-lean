/-! # zlib's remaining API in Ubuntu's `libz.so.1.3`: the code

Each function's region (`ZlibApi.Bytes`, generated by `scripts/abi-bytes/zlib_api.py`) at its
link-time addresses, entered at the `.dynsym` value. A function that reads `%rip`-relative data
(the CRC tables, the `x2n` table, the version string) carries the read-only data segment
(`ZlibLibz.crcData`); the image is the file's (`ZlibLibz.image`).

| function | region | entry offset, extent | data |
| --- | --- | --- | --- |
| `crc32_combine` | `[0x9920, 0x99f9)` | `0xd0`, 9 | read-only segment |
| `adler32_combine` | `[0x7270, 0x7350)` | `0x0`, 224 | none |
| `crc32_combine_gen` | `[0x9a00, 0x9a99)` | `0x90`, 9 | read-only segment |
| `crc32_combine_op` | `[0x9aa0, 0x9ad6)` | `0x0`, 54 | none |
| `get_crc_table` | `[0x7430, 0x743c)` | `0x0`, 12 | read-only segment |
| `zlibVersion` | `[0x11110, 0x1111c)` | `0x0`, 12 | read-only segment |
| `zlibCompileFlags` | `[0x11120, 0x1112a)` | `0x0`, 10 | none |
-/

@[expose] public section

namespace Silmaril.Machine.Abi.Conformance.ZlibApi

open Silmaril.Machine.Abi.Conformance
open Silmaril.Machine.Abi.Conformance.ZlibLibz (crcData image)

/-- `crc32_combine`. -/
def crc32CombineCode : Code := ⟨0x9920, crc32CombineRegion, 0xd0, 9, crcData, image⟩

/-- `adler32_combine`. -/
def adler32CombineCode : Code := ⟨0x7270, adler32CombineRegion, 0x0, 224, [], image⟩

/-- `crc32_combine_gen`. -/
def crc32CombineGenCode : Code := ⟨0x9a00, crc32CombineGenRegion, 0x90, 9, crcData, image⟩

/-- `crc32_combine_op`. -/
def crc32CombineOpCode : Code := ⟨0x9aa0, crc32CombineOpRegion, 0x0, 54, [], image⟩

/-- `get_crc_table`. -/
def getCrcTableCode : Code := ⟨0x7430, getCrcTableRegion, 0x0, 12, crcData, image⟩

/-- `zlibVersion`. -/
def zlibVersionCode : Code := ⟨0x11110, zlibVersionRegion, 0x0, 12, crcData, image⟩

/-- `zlibCompileFlags`. -/
def zlibCompileFlagsCode : Code := ⟨0x11120, zlibCompileFlagsRegion, 0x0, 10, [], image⟩

end Silmaril.Machine.Abi.Conformance.ZlibApi

