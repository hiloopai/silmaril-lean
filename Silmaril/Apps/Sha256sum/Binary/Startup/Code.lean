/-! # The code regions of the startup of `sha256sum-min`

The startup path from `_start` to the read loop of `digest_file` (argv = [prog], no option,
the default operand `"-"`) runs through four regions of the executable segment:

* `Start`: `_start`, `[0x401000, 0x40100e)`;
* `Main`: `cmain` from its entry to the operand loop's `do_check` test, `[0x4033f0, 0x4039bd)`
  (`set_program_name`, the `POSIXLY_CORRECT` scan of the environment, option parsing with no
  option, the option-consistency checks, the default operand);
* `Call`: the `call digest_file` of the non-`--check` branch, `[0x40418f, 0x40419f)`;
* `Digest`: `digest_file` from its entry to the read-loop head, `[0x402de0, 0x402ef0)`
  (`c_streq(filename, "-")`, `have_read_stdin`, `sha_init`).

Each region lists only the instructions on the startup paths (the others are on error paths,
which the segments show unreachable). The `X86.Ext8` entries are those of the kernel-checked
lifted listing (`Lift.Gen`), rebased by `scripts/sha256sum/gen_startup_code.py`; each region's
`listing_valid` re-checks them against its bytes with the `Isa.sys8` decoder (`decide`), and
`seg1_code` ties the bytes to the transcribed image.

Everything here is VERIFIED (no `sorry`, no new axiom).
-/

@[expose] public section

open Silmaril.X86 (Byte)
open Silmaril.X86.Ext (Mem)
open Silmaril.X86.Lift (ix)
open Silmaril.X86
open Silmaril.Apps.Sha256sum.X86Sys (Isa.sys8)

namespace Silmaril.Apps.Sha256sum.Binary.Startup.Start

/-- `start`: the region `[0x401000, 0x40100e)`. -/
def base : Word := 0x401000#64

def code : List Byte := [
  0x31, 0xed, 0x48, 0x89, 0xe7, 0x48, 0x83, 0xe4, 0xf0, 0xe8, 0xe2, 0x23, 0x00, 0x00
  ]

set_option maxRecDepth 100000 in
def listing : List (Nat × Ext8.Instr × Nat) := [
  (0, .base (.alu (.d) (.xor) (.reg (.rbp)) (.rbp)), 2), -- 0x401000
  (2, .base (.mov (.q) (.reg (.rdi)) (.rsp)), 3), -- 0x401002
  (5, .base (.aluI8 (.q) (.and) (.reg (.rsp)) 0xf0#8), 4), -- 0x401005
  (9, .base (.call 0x000023e2#32), 5) -- 0x401009
  ]

set_option maxRecDepth 100000 in
/-- **The lift**: every listed instruction is what the `Ext8` decoder reads at its offset. -/
theorem listing_valid : SegVC.Listing.valid Isa.sys8 code listing = true := by decide

set_option maxRecDepth 100000 in
/-- The executable segment holds these bytes. -/
theorem seg1_code : (Image.seg1.contents.drop 0).take 14 = code := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- **Loading puts the region at `base`.** -/
theorem loaded {memory : Silmaril.Process.Memory} (h : Image.image.Mapped memory) :
    Ext.Loaded memory base code := by
  have := readWith_segment h seg1_mem Image.image_wf (acc := .execute) (by decide)
    0 14 (by decide) (by decide)
  rw [seg1_code] at this
  exact this

set_option maxRecDepth 100000 in
theorem code_length : code.length = 14 := by decide

theorem base_toNat : base.toNat = 0x401000 := rfl

end Silmaril.Apps.Sha256sum.Binary.Startup.Start

