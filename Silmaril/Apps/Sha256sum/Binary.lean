module

public import Silmaril.Apps.Sha256sum.Binary.Load
public import Silmaril.Crypto.X86.Sha256O2.Exec

/-! # `sha256sum-min`: what is proved about the binary

The binary target is `sha256sum-min` (research note `binary.md`, SHA-256
`Binary.elfSha256`): a static, libc-free x86-64 implementation of every option of GNU
`sha256sum` 9.4, built by gcc 13.3.0 `-O2`, whose `sha256_compress` is the exact clang
`-O2` pilot image. Files:

* `Binary.Layout`: the pinned hash and the addresses of `sha256_compress` and its K table.
* `Binary.Image`: the loadable image (four `PT_LOAD` segments), generated by
  `scripts/sha256sum/gen_image.py`; trusted to be the file's content.
* `Binary.Compress`: the transcription of `sha256_compress` lifted from the executable by
  `tools/x86-lift` and checked in the kernel against `X86.Ext.decode`, the pilot image and
  the pilot K table.
* `Binary.Load`: the loader places those bytes where the pilot contract needs them.

Proved here:

* `layout_relocFits`: the linked layout keeps the PC32 displacement in range, so the
  contract's `relocFits` clause holds;
* `compress_contract`: the pilot `Sha256O2.sha256_compress_O2` contract at this binary's
  layout, for any return address;
* `compress_entry_of_loaded`: in any memory the loader produced, the code and K-table
  clauses of the contract's precondition hold, so a caller inside the binary must only
  establish the System V call-site clauses (arguments, stack, buffers).

What the binary as a whole must satisfy, and what blocks it, is in `Sha256sum/Plan.lean`.
-/

@[expose] public section

namespace Silmaril.Apps.Sha256sum.Binary

open Silmaril.X86 (Word)
open Silmaril.Crypto.X86.Sha256O2

/-- The pilot layout of this binary, returning to `exit`. -/
def layout (exit : Word) : Layout := ⟨textBase, rodataBase, exit⟩

theorem layout_relocFits (exit : Word) : (layout exit).RelocFits := by
  unfold Layout.RelocFits Layout.relocValue layout textBase rodataBase
  simp only
  decide

/-- The pilot contract holds for the `sha256_compress` linked into `sha256sum-min`. -/
theorem compress_contract (exit : Word) : Contract (layout exit) frameSize :=
  sha256_compress_O2 (layout exit)

/-- The code and K-table preconditions of the contract hold in every loaded memory. -/
theorem compress_entry_of_loaded {memory : Silmaril.Process.Memory}
    (h : Image.image.Mapped memory) :
    memory.fetchBytes (layout 0).textBase.toNat size = some (image textBase rodataBase) ∧
      memory.readBytes (layout 0).rodataBase.toNat kSize = some kBytes :=
  ⟨loaded_code h, loaded_kTable h⟩

end Silmaril.Apps.Sha256sum.Binary
