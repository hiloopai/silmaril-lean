/-- **The run of glibc 2.36's inlined `tcache_get`** (bin in `rbp`; ends at offset 378). -/
theorem tcGetRun236 {A : Word} {m : MState} {tc idx cnt e v : Word}
    (hl : Loaded m.memory A mallocCode)
    (hrip : m.core.rip = A + BitVec.ofNat 64 333) (hrdx : m.core.read .rdx = tc)
    (hrbp : m.core.read .rbp = idx) (hrcx : m.core.read .rcx = cnt)
    (hent : loadN m.memory (tc + ((idx + 16#64) <<< 3)) 8 = some e) (he : e.setWidth 8 &&& 0xf#8 = 0)
    (hnext : loadN m.memory e 8 = some v)
    (hw1 : m.memory.Permitted .write (tc + ((idx + 16#64) <<< 3)).toNat 8)
    (hw2 : m.memory.Permitted .write (tc + (idx <<< 1)).toNat 2)
    (hw3 : m.memory.Permitted .write (e + 8#64).toNat 8)
    (hc1 : X86sim.Apart (tc + ((idx + 16#64) <<< 3)).toNat 8 A.toNat (A.toNat + mallocCode.length))
    (hc2 : X86sim.Apart (tc + (idx <<< 1)).toNat 2 A.toNat (A.toNat + mallocCode.length))
    (hc3 : X86sim.Apart (e + 8#64).toNat 8 A.toNat (A.toNat + mallocCode.length)) :
    ∃ m', Reaches Str9Fs.step m m' ∧ m'.core.rip = A + BitVec.ofNat 64 378 ∧
      m'.core.read .rax = e ∧
      (∀ r, r ≠ .rax → r ≠ .rcx → r ≠ .rdi → r ≠ .rsi → m'.core.read r = m.core.read r) ∧
      m'.core.fsBase = m.core.fsBase ∧ Loaded m'.memory A mallocCode ∧
      ∃ m1 m2, storeN m.memory (tc + ((idx + 16#64) <<< 3)) 8 ((e >>> 12) ^^^ v) = some m1 ∧
        storeN m1 (tc + (idx <<< 1)) 2 ((cnt.setWidth 32 - 1#32).setWidth 64) = some m2 ∧
        storeN m2 (e + 8#64) 8 0#64 = some m'.memory :=
  tcGetRun mallocTcGet hl hrip hrdx hrbp hrcx hent he hnext hw1 hw2 hw3 hc1 hc2 hc3

