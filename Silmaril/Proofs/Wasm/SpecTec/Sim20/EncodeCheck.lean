module

public import Silmaril.Wasm.SpecTec.Sim20.Encode.Defs
public import Silmaril.Raw.Wasm.SpecTec.SpecTec.Sem.Valid
public meta import Silmaril.Wasm.SpecTec.Sim20.Encode.Defs
public meta import Silmaril.Raw.Wasm.SpecTec.SpecTec.Sem.Valid

/-!
# The 2.0 encoding, checked against the wasm-2.0 IL types (build time)

`checkEncoding` reads the vendored wasm-2.0 stream `specs/spectec/wasm-2.0.ast` (the stream of
`Scripts.Wasm20.original`), and runs the IL type checker `Sem.hasTyp` (fuel 1000) on the images of
a corpus that covers **every constructor** of `V2.Instr`, `V2.Execution.Admin` and of the
runtime structure:

* every instruction, at every operator, type and shape that `V2.Instr.immediatesValid` accepts
  (the corpus is generated by enumeration and filtered by `immediatesValid`), plus boundary
  immediates (indices `0` and `2^32-1`, lanes `0` and the last lane) and floats of every IEEE
  shape (zeros, normals, subnormals, infinities, quiet and signalling NaNs);
  each image is checked against `instr` **and** `admininstr`;
* every administrative instruction, against `admininstr`;
* a configuration whose store has one instance of every kind and whose frame has locals and an
  export, against `config`.

It is compiled code run at elaboration time: a failure fails the build. It is not a kernel
theorem. The wasm-2.0 errata (`Errata/Wasm20.lean`) change only `$dataidx_instrs`, `Binstr`,
`Belem` and `Bmodule`, none of which a type of the runtime mentions, so the original stream's
types are the fixed script's.

The check does not cover host function instances, which have no 2.0 type (`Sim20.funcInstV`).
-/

@[expose] public section

namespace Silmaril.Wasm.SpecTec.Sim20.EncodeCheck

open Silmaril.SpecTec
open Silmaril.SpecTec.IL hiding Id Prod
open Silmaril.SpecTec.Sem
open Silmaril.Wasm
open Silmaril.Wasm.V2.Execution

/-! ## The corpus -/

/-- An index. -/
def ix {k : IndexKind} (n : Nat) : Idx k := ⟨⟨n % 2 ^ 32, Nat.mod_lt _ (by decide)⟩⟩

/-- A lane index. -/
def lane (n : Nat) : V2.LaneIdx := ⟨n % 256, Nat.mod_lt _ (by decide)⟩

/-- Integer and float types. -/
def intTypes : List IntType := [.i32, .i64]
/-- Float types. -/
def floatTypes : List FloatType := [.f32, .f64]
/-- Number types. -/
def numTypes : List NumType := intTypes.map .int ++ floatTypes.map .float
/-- Signedness. -/
def sxs : List Signedness := [.signed, .unsigned]
/-- Value types. -/
def valTypes : List V2.ValType :=
  numTypes.map .num ++ [.vec .v128, .ref .funcref, .ref .externref]
/-- Pack sizes. -/
def packs : List PackSize := [.i8, .i16, .i32, .i64]
/-- Integer shapes. -/
def ishapes : List IntShape := [.i8x16, .i16x8, .i32x4, .i64x2]
/-- Float shapes. -/
def fshapes : List FloatShape := [.f32x4, .f64x2]
/-- Shapes. -/
def shapes : List Shape := ishapes.map .int ++ fshapes.map .float
/-- Halves. -/
def halves : List Half := [.low, .high]

/-- Bit patterns of every IEEE shape. -/
def floatBits : FloatType → List Nat
  | .f32 => [0, 0x80000000, 0x3f800000, 0xbf800000, 1, 0x007fffff, 0x7f7fffff, 0x7f800000,
      0xff800000, 0x7fc00000, 0x7f800001, 0xffffffff]
  | .f64 => [0, 0x8000000000000000, 0x3ff0000000000000, 1, 0x000fffffffffffff,
      0x7fefffffffffffff, 0x7ff0000000000000, 0xfff0000000000000, 0x7ff8000000000000,
      0x7ff0000000000001, 0xffffffffffffffff]

/-- Integer unary operators. -/
def intUnOps : List IntUnOp := [.clz, .ctz, .popcnt] ++ packs.map .extend
/-- Integer binary operators. -/
def intBinOps : List IntBinOp :=
  [.add, .sub, .mul, .and, .or, .xor, .shl, .rotl, .rotr] ++
    sxs.flatMap fun s => [.div s, .rem s, .shr s]
/-- Integer comparisons. -/
def intRelOps : List IntRelOp := [.eq, .ne] ++ sxs.flatMap fun s => [.lt s, .gt s, .le s, .ge s]
/-- Float unary operators. -/
def floatUnOps : List FloatUnOp := [.abs, .neg, .sqrt, .ceil, .floor, .trunc, .nearest]
/-- Float binary operators. -/
def floatBinOps : List FloatBinOp := [.add, .sub, .mul, .div, .min, .max, .copysign]
/-- Float comparisons. -/
def floatRelOps : List FloatRelOp := [.eq, .ne, .lt, .gt, .le, .ge]
/-- Conversions. -/
def cvtOps : List V2.CvtOp :=
  [.wrap, .promote, .demote, .reinterpret] ++
    sxs.flatMap fun s => [.extend s, .convert s, .trunc s, .truncSat s]
/-- Vector integer binary operators. -/
def vecIntBinOps : List V2.VecIntBinOp :=
  [.add, .sub, .mul, .avgrU, .q15mulrSatS] ++
    sxs.flatMap fun s => [.addSat s, .subSat s, .min s, .max s]
/-- Vector float binary operators. -/
def vecFloatBinOps : List V2.VecFloatBinOp := [.add, .sub, .mul, .div, .min, .max, .pmin, .pmax]
/-- Vector conversions. -/
def vecCvtOps : List V2.VecCvtOp :=
  [.demoteZero, .promoteLow] ++ sxs.flatMap fun s =>
    halves.map (.extend · s) ++ [.truncSat s false, .truncSat s true, .convert none s] ++
      halves.map (fun h => .convert (some h) s)
/-- Vector loads. -/
def vecLoadOps : List (Option V2.VecLoadOp) :=
  [none, some .zero32, some .zero64] ++ (packs.map fun p => some (.splat p)) ++
    sxs.flatMap fun s => [some (.shape8x8 s), some (.shape16x4 s), some (.shape32x2 s)]
/-- Memory arguments. -/
def memargs : List V2.MemArg := [⟨0, 0⟩, ⟨3, 4294967295⟩]
/-- Block types. -/
def blockTypes : List V2.BlockType :=
  [.result none, .typeIdx (ix 0), .typeIdx (ix 4294967295)] ++ valTypes.map (.result ∘ some)

/-- Instructions without operator families. -/
def instrsBase : List V2.Instr :=
  [.nop, .unreachable, .drop, .return_, .select none, .select (some []), .select (some valTypes),
    .br (ix 0), .br (ix 4294967295), .brIf (ix 3), .brTable [] (ix 0),
    .brTable [ix 0, ix 1, ix 4294967295] (ix 2), .call (ix 7), .callIndirect (ix 0) (ix 9),
    .vecConst 0, .vecConst (BitVec.allOnes 128), .vecConst 0x0123456789abcdef,
    .vvUnOp .not, .vvBinOp .and, .vvBinOp .andnot, .vvBinOp .or, .vvBinOp .xor,
    .vvTernOp .bitselect, .vvTestOp .anyTrue, .vecSwizzle,
    .vecShuffle ((List.range 16).map lane), .vecShuffle ((List.range 16).map fun i => lane (31 - i)),
    .refNull .funcref, .refNull .externref, .refFunc (ix 2), .refIsNull,
    .localGet (ix 0), .localSet (ix 1), .localTee (ix 2), .globalGet (ix 3), .globalSet (ix 4),
    .tableGet (ix 0), .tableSet (ix 1), .tableSize (ix 2), .tableGrow (ix 3), .tableFill (ix 4),
    .tableCopy (ix 0) (ix 1), .tableInit (ix 2) (ix 3), .elemDrop (ix 5),
    .vecStore ⟨4, 16⟩, .memorySize, .memoryGrow, .memoryFill, .memoryCopy, .memoryInit (ix 0),
    .dataDrop (ix 1)]

/-- Blocks at every block type. -/
def instrsBlocks : List V2.Instr :=
  blockTypes.flatMap fun bt =>
    [.block bt [], .block bt [.nop, .drop], .loop bt [.br (ix 0)],
      .if_ bt [.nop] [], .if_ bt [] [.block bt [.unreachable]]]

/-- Integer instructions at one type. -/
def instrsIntAt (t : IntType) : List V2.Instr :=
  let ops : List V2.Instr :=
    [.intConst t 0, .intConst t 1, .intConst t (BitVec.allOnes _), .intTestOp t .eqz]
  let un : List V2.Instr := intUnOps.map (.intUnOp t)
  let bin : List V2.Instr := intBinOps.map (.intBinOp t)
  let rel : List V2.Instr := intRelOps.map (.intRelOp t)
  let ld : List V2.Instr := memargs.flatMap fun a =>
    .intLoad t none a :: packs.flatMap fun p => sxs.map fun s => .intLoad t (some (p, s)) a
  [ops, un, bin, rel, ld].flatten

/-- Integer stores at one type. -/
def instrsIntStoreAt (t : IntType) : List V2.Instr :=
  memargs.flatMap fun a => .intStore t none a :: packs.map fun p => .intStore t (some p) a

/-- Float instructions at one type. -/
def instrsFloatAt (t : FloatType) : List V2.Instr :=
  let cs : List V2.Instr := (floatBits t).map fun b => .floatConst t (BitVec.ofNat _ b)
  let un : List V2.Instr := floatUnOps.map (.floatUnOp t)
  let bin : List V2.Instr := floatBinOps.map (.floatBinOp t)
  let rel : List V2.Instr := floatRelOps.map (.floatRelOp t)
  let ld : List V2.Instr := memargs.map (.floatLoad t)
  [cs, un, bin, rel, ld].flatten

/-- Float stores at one type. -/
def instrsFloatStoreAt (t : FloatType) : List V2.Instr := memargs.map (.floatStore t)

/-- Conversions at every pair of types. -/
def instrsCvt : List V2.Instr :=
  numTypes.flatMap fun t₁ => numTypes.flatMap fun t₂ => cvtOps.map (.cvtOp t₁ t₂)

/-- Vector integer instructions at one shape. -/
def instrsVecIntAt (s : IntShape) : List V2.Instr :=
  let a : List V2.Instr :=
    [.vecIntUnOp s .abs, .vecIntUnOp s .neg, .vecIntUnOp s .popcnt, .vecAllTrue s,
      .vecBitmask s, .vecShiftOp s .shl]
  let sh : List V2.Instr := sxs.map fun x => .vecShiftOp s (.shr x)
  let bin : List V2.Instr := vecIntBinOps.map (.vecIntBinOp s)
  let rel : List V2.Instr := intRelOps.map (.vecIntRelOp s)
  let ext : List V2.Instr := ishapes.flatMap fun s₂ =>
    .vecExtBinOp s s₂ .dotS :: sxs.flatMap fun x =>
      .vecExtUnOp s s₂ (.extaddPairwise x) :: .vecNarrow s s₂ x ::
        halves.map fun h => .vecExtBinOp s s₂ (.extmul h x)
  [a, sh, bin, rel, ext].flatten

/-- The vector float instructions that the checker accepts at one shape: the operators that
`vunop_`, `vbinop_` and `vrelop_` also have at integer shapes (see `knownRejected`). -/
def instrsVecFloatAt (s : FloatShape) : List V2.Instr :=
  let un : List V2.Instr := [.vecFloatUnOp s .abs, .vecFloatUnOp s .neg]
  let bin : List V2.Instr := [.add, .sub, .mul].map (.vecFloatBinOp s)
  let rel : List V2.Instr := [.eq, .ne].map (.vecFloatRelOp s)
  [un, bin, rel].flatten

/-- Shape-indexed instructions. -/
def instrsShapeAt (s : Shape) : List V2.Instr :=
  let a : List V2.Instr :=
    [.vecSplat s, .vecReplaceLane s (lane 0), .vecReplaceLane s (lane (s.lanes - 1))]
  let c : List V2.Instr := shapes.flatMap fun s₂ => vecCvtOps.map (.vecCvtOp s s₂)
  a ++ c

/-- Vector memory instructions. -/
def instrsVecMem : List V2.Instr :=
  memargs.flatMap fun a =>
    vecLoadOps.map (.vecLoad · a) ++
      packs.flatMap fun p => [.vecLoadLane p a (lane 0), .vecStoreLane p a (lane 1)]

/-- The instruction corpus, before filtering. -/
def instrsRaw : List V2.Instr :=
  [instrsBase, instrsBlocks, intTypes.flatMap instrsIntAt, floatTypes.flatMap instrsFloatAt,
    instrsCvt, ishapes.flatMap instrsVecIntAt, fshapes.flatMap instrsVecFloatAt,
    shapes.flatMap instrsShapeAt, instrsVecMem].flatten

/-- **Rejected by the checker**, by cause (each is checked to be rejected, so that the list
stays accurate):

* `STORE` and `VEXTRACT_LANE`: their `syntax instr` cases quantify a variable (`Inn?`,
  `numtype`) that the payload does not determine and that no premise defines by an equation, and
  `hasTyp`'s `bindQuants` only solves defining equations;
* vector float operators that only the float instance of `vunop_`, `vbinop_` or `vrelop_` has
  (`SQRT`, `DIV`, `PMIN`, `LT`, …): `hasTyp` selects the integer instance
  `vunop_(Jnn X M)` for a float shape `F32 X 4` as well (the scalar families `unop_(Inn)` /
  `unop_(Fnn)` are selected correctly);
* a non-empty export name: the premise of `name` calls `$utf8`, which does not evaluate (the
  wasm-2.0 counterpart of the wasm-3.0 item U7, `NoExports` in Round 6). -/
def knownRejectedInstrs : List V2.Instr :=
  [intTypes.flatMap instrsIntStoreAt, floatTypes.flatMap instrsFloatStoreAt,
    [.vecExtractLane (.int .i8x16) (some .signed) (lane 1), .vecExtractLane (.int .i32x4) none (lane 0),
      .vecExtractLane (.float .f64x2) none (lane 1)],
    fshapes.flatMap fun s =>
      [.vecFloatUnOp s .sqrt, .vecFloatUnOp s .nearest, .vecFloatBinOp s .div,
        .vecFloatBinOp s .pmax, .vecFloatRelOp s .lt, .vecFloatRelOp s .ge]].flatten

/-- The instruction corpus: every instruction of `instrsRaw` whose immediates are valid. -/
def instrs : List V2.Instr := instrsRaw.filter V2.Instr.immediatesValid

/-- A module instance with something in every field. -/
def modInst : ModuleInst :=
  { types := [⟨[], []⟩, ⟨[.num (.int .i32), .ref .externref], [.vec .v128]⟩], funcs := [0, 3],
    globals := [1], tables := [0], mems := [0], elems := [2], datas := [5],
    exports := [⟨"", .func 0⟩, ⟨"", .global 1⟩, ⟨"", .table 0⟩, ⟨"", .mem 0⟩] }

/-- A frame with locals of every kind. -/
def frame : Frame :=
  { locals := [.i32 7, .f64 0x7ff8000000000000, .vec 1, .ref (.null .funcref),
      .ref (.funcAddr 3), .ref (.hostAddr 4)], module := modInst }

/-- The administrative corpus. -/
def admins : List Admin :=
  [.refFuncAddr 0, .refHostAddr 9, .callAddr 3, .trap, .label 0 [] [],
    .label 2 [.nop, .br (ix 1)] [.plain (.intConst .i32 1), .trap, .plain .drop],
    .frame 0 {} [], .frame 1 frame [.label 1 [] [.plain .return_]]] ++
    instrs.map .plain

/-- A store with one instance of every kind (no host functions). -/
def store : Store Empty :=
  { funcs := [⟨⟨[.num (.int .i32)], []⟩, modInst, .wasm ⟨ix 0, [.num (.float .f32)], [.drop]⟩⟩],
    globals := [⟨⟨.var, .num (.int .i64)⟩, .i64 3⟩, ⟨⟨.const, .ref .funcref⟩, .ref (.funcAddr 0)⟩],
    tables := [⟨⟨⟨0, some 10⟩, .externref⟩, [.null .externref, .hostAddr 2]⟩],
    mems := [⟨⟨⟨1, none⟩⟩, ByteArray.mk #[0, 255, 7]⟩],
    elems := [⟨.funcref, [.funcAddr 0]⟩], datas := [⟨ByteArray.mk #[1, 2]⟩] }

/-- The configuration corpus. -/
def configs : List (Config Empty) :=
  [⟨{}, {}, []⟩, ⟨store, frame, [.plain .nop]⟩, ⟨store, frame, admins.take 12⟩]

/-! ## The check -/

/-- Read the wasm-2.0 stream. -/
def readScript (path : String) : IO Script := do
  let contents ← IO.FS.readFile path
  let forms ← match SExp.parseStream contents with
    | .error msg => throw (IO.userError s!"{path} is not an S-expression stream: {msg}")
    | .ok forms => pure forms
  let some script := IL.decodeScript? forms
    | throw (IO.userError s!"{path} is not a printed SpecTec IL script")
  pure script

/-- Check one value against one type, failing loudly. -/
def expectTyped (env : Env) (what : String) (t : Typ) (v : Value) : IO Unit :=
  match hasTyp 1000 env VarEnv.empty t v with
  | .ok true => pure ()
  | .ok false => throw (IO.userError s!"Sim20 encoding: {what} is not of its IL type")
  | .error _ => throw (IO.userError s!"Sim20 encoding: typing {what} failed to evaluate")

/-- **The check.** Returns the number of values checked. -/
def checkEncoding (path : String) : IO Nat := do
  let env := envOfScript (← readScript path)
  let mut n := 0
  for i in instrs do
    expectTyped env s!"{repr i}" (.varT "instr" []) (instrToV i)
    expectTyped env s!"{repr i} (as admininstr)" (.varT "admininstr" []) (instrToV i)
    n := n + 2
  for a in admins do
    expectTyped env s!"{repr a}" (.varT "admininstr" []) (adminToV a)
    n := n + 1
  for c in configs do
    expectTyped env "a configuration" (.varT "config" []) (configV Empty.elim c)
    n := n + 1
  pure n

/-- Values the check must reject: a `CONST I32` whose payload is out of range and a function
instance with a host function (so that the check is not vacuous), and the known rejections
(`knownRejectedInstrs`, a non-empty export name), so that the list of causes stays accurate. -/
def checkRejects (path : String) : IO Unit := do
  let env := envOfScript (← readScript path)
  for i in knownRejectedInstrs do
    match hasTyp 1000 env VarEnv.empty (.varT "instr" []) (instrToV i) with
    | .ok true => throw (IO.userError s!"Sim20 encoding check: {repr i} is now accepted")
    | _ => pure ()
  match hasTyp 1000 env VarEnv.empty (.varT "name" []) (nameV "f") with
  | .ok true => throw (IO.userError "Sim20 encoding check: the name \"f\" is now accepted")
  | _ => pure ()
  let bad : Value := .case "CONST" (.tuple [Equiv.Execution.caseNilV "I32", Equiv.Execution.pctV (2 ^ 32)])
  match hasTyp 1000 env VarEnv.empty (.varT "instr" []) bad with
  | .ok false => pure ()
  | _ => throw (IO.userError "Sim20 encoding check: an out-of-range CONST was not rejected")
  let hostStore : Store String := { funcs := [⟨⟨[], []⟩, {}, .host "h"⟩] }
  match hasTyp 1000 env VarEnv.empty (.varT "store" []) (storeV id hostStore) with
  | .ok false => pure ()
  | _ => throw (IO.userError "Sim20 encoding check: a host function instance was not rejected")

#eval show IO Unit from do
  let n ← checkEncoding "specs/spectec/wasm-2.0.ast"
  unless 1000 ≤ n do throw (IO.userError s!"Sim20 encoding check: corpus too small ({n})")
  checkRejects "specs/spectec/wasm-2.0.ast"

end Silmaril.Wasm.SpecTec.Sim20.EncodeCheck
