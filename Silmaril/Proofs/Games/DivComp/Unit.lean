module

public import Silmaril.Games.DivComp.Defs
public import Silmaril.Games.Composition.Thms
public import Silmaril.Games.Strategy.Thms
import Silmaril.Proofs.Games.DivComp.Pos

/-!
# Copycat is a unit for divergence-observing composition: proofs

The finite-play part is `Strategy.id_comp`/`Strategy.comp_id`. For the new
components:

* **Counting** (`double_counts`): in a prefix of a copycat play the numbers of
  events on the two sides differ by at most one, and they are equal when the
  side that copycat reads from has completed all its exchanges. In a running
  position the lower events of a play come in pairs and its upper events do
  not (`run_parity`).
* **Near-equality** (`near_of_id_comp`, `near_of_comp_id`): an interaction of
  `s` with copycat yields a prefix of `s` or a prefix followed by one move.
  Obtained from the finite unit laws applied to the strategy generated by `s`.
* Hence: an interaction of a *divergent* (running) play with copycat yields
  the play itself, copycat never chatters forever with a strategy (it forwards
  every hidden move visibly), and an infinite interaction with copycat has the
  same visible limit as the strategy's side.

The alternation lemmas and `zip_double_*` are restated from
`Silmaril.Proofs.Games.Composition.Unit` (same statements and proofs), which the
layout rules do not let this topic import.
-/

public section

namespace Silmaril.Proofs.Games.DivComp

open Silmaril.Games

universe u v

/-! ## Generic chain lemma -/

private theorem near_length {α : Type v} {c d : List α}
    (h : c <+: d ∨ ∃ p₀ o, c = p₀ ++ [o] ∧ p₀ <+: d) : c.length ≤ d.length + 1 := by
  rcases h with h | ⟨p₀, o, he, hp₀⟩
  · exact h.length_le.trans (Nat.le_succ _)
  · rw [he, List.length_append, List.length_singleton]
    exact Nat.succ_le_succ hp₀.length_le

/-- A prefix of `c` shorter than `c` is a prefix of `d` when `c` is near `d`. -/
private theorem prefix_of_near {α : Type v} {x c d : List α} (hx : x <+: c)
    (hlen : x.length + 1 ≤ c.length) (h : c <+: d ∨ ∃ p₀ o, c = p₀ ++ [o] ∧ p₀ <+: d) :
    x <+: d := by
  rcases h with h | ⟨p₀, o, he, hp₀⟩
  · exact hx.trans h
  · have hx' : x <+: p₀ ++ [o] := he ▸ hx
    have hl : x.length ≤ p₀.length := by
      have : c.length = p₀.length + 1 := by rw [he, List.length_append, List.length_singleton]
      omega
    exact (List.prefix_of_prefix_length_le hx' (List.prefix_append p₀ [o]) hl).trans hp₀

/-- A prefix of `d` shorter than `c` is a prefix of `c` when `c` is near `d`. -/
private theorem prefix_of_near' {α : Type v} {x c d : List α} (hx : x <+: d)
    (hlen : x.length + 1 ≤ c.length) (h : c <+: d ∨ ∃ p₀ o, c = p₀ ++ [o] ∧ p₀ <+: d) :
    x <+: c := by
  rcases h with h | ⟨p₀, o, he, hp₀⟩
  · exact List.prefix_of_prefix_length_le hx h (by omega)
  · have hl : x.length ≤ p₀.length := by
      have : c.length = p₀.length + 1 := by rw [he, List.length_append, List.length_singleton]
      omega
    exact he ▸ (List.prefix_of_prefix_length_le hx hp₀ hl).trans (List.prefix_append p₀ [o])

theorem lim_eq_of_near {α : Type v} {c d : Chain α} (hc : c.Mono) (hd : d.Mono)
    (hu : c.Unbounded) (hn : ∀ n, c n <+: d n ∨ ∃ p₀ o, c n = p₀ ++ [o] ∧ p₀ <+: d n) :
    c.lim = d.lim ∧ d.Unbounded := by
  have h₁ : ∀ n, ∃ m, c n <+: d m := fun n => by
    obtain ⟨m, hm, hk⟩ := hc.unbounded_ge hu ((c n).length + 1) n
    exact ⟨m, prefix_of_near (hc.le hm) hk (hn m)⟩
  have h₂ : ∀ n, ∃ m, d n <+: c m := fun n => by
    obtain ⟨m, hm, hk⟩ := hc.unbounded_ge hu ((d n).length + 1) n
    exact ⟨m, prefix_of_near' (hd.le hm) hk (hn m)⟩
  have hdu : d.Unbounded := fun k => by
    obtain ⟨n, hn'⟩ := hu (k + 1)
    exact ⟨n, by have := near_length (hn n); omega⟩
  exact ⟨Chain.lim_eq_of h₁ h₂, hdu⟩

variable {E F : Sig.{u}}

/-! ## Projections (restated from `Silmaril.Proofs.Games.Composition.Unit`) -/

theorem lower_def (s : List (Move E F)) : lower s = s.filterMap Sum.getLeft? := rfl
theorem upper_def (s : List (Move E F)) : upper s = s.filterMap Sum.getRight? := rfl

@[simp] theorem upper_nil : upper ([] : List (Move E F)) = [] := rfl
@[simp] theorem upper_cons_inl (a : Ev E) (s : List (Move E F)) :
    upper (.inl a :: s) = upper s := rfl
@[simp] theorem upper_cons_inr (b : Ev F) (s : List (Move E F)) :
    upper (.inr b :: s) = b :: upper s := rfl
@[simp] theorem lower_nil : lower ([] : List (Move E F)) = [] := rfl
@[simp] theorem lower_cons_inl (a : Ev E) (s : List (Move E F)) :
    lower (.inl a :: s) = a :: lower s := rfl
@[simp] theorem lower_cons_inr (b : Ev F) (s : List (Move E F)) :
    lower (.inr b :: s) = lower s := rfl

theorem upper_alternating {a b : Pos E F} {s : List (Move E F)} (h : Path a s b) :
    (a = .idle → Ev.Alternating (upper s)) ∧
    (∀ q, (a = .run q ∨ ∃ m, a = .wait q m) →
      upper s = [] ∨ ∃ r w, upper s = .ans q r :: w ∧ Ev.Alternating w) := by
  induction h with
  | nil => exact ⟨fun _ => .nil, fun _ _ => .inl rfl⟩
  | @cons x y z o s st _ ih =>
    show (x = .idle → Ev.Alternating (upper (o :: s))) ∧
      (∀ q, (x = .run q ∨ ∃ m, x = .wait q m) →
        upper (o :: s) = [] ∨ ∃ r w, upper (o :: s) = .ans q r :: w ∧ Ev.Alternating w)
    cases st with
    | ask q =>
      refine ⟨fun _ => ?_, fun _ h => (by rcases h with h | ⟨_, h⟩ <;> cases h)⟩
      rcases ih.2 q (.inl rfl) with h | ⟨r, w, h, hw⟩
      · simp only [upper_cons_inr, h]; exact .ask q
      · simp only [upper_cons_inr, h]; exact .cons q r hw
    | call q m =>
      refine ⟨fun h => (by cases h), fun q' h => ?_⟩
      rcases h with h | ⟨_, h⟩ <;> cases h
      simpa using ih.2 q (.inr ⟨m, rfl⟩)
    | reply q m n =>
      refine ⟨fun h => (by cases h), fun q' h => ?_⟩
      rcases h with h | ⟨_, h⟩ <;> cases h
      simpa using ih.2 q (.inl rfl)
    | ret q r =>
      refine ⟨fun h => (by cases h), fun q' h => ?_⟩
      rcases h with h | ⟨_, h⟩ <;> cases h
      exact .inr ⟨r, _, rfl, ih.1 rfl⟩

theorem lower_alternating {a b : Pos E F} {s : List (Move E F)} (h : Path a s b) :
    ((a = .idle ∨ ∃ q, a = .run q) → Ev.Alternating (lower s)) ∧
    (∀ q m, a = .wait q m →
      lower s = [] ∨ ∃ n w, lower s = .ans m n :: w ∧ Ev.Alternating w) := by
  induction h with
  | nil => exact ⟨fun _ => .nil, fun _ _ _ => .inl rfl⟩
  | cons st _ ih =>
    cases st with
    | ask q =>
      refine ⟨fun _ => ?_, fun _ _ h => by cases h⟩
      simpa using ih.1 (.inr ⟨q, rfl⟩)
    | call q m =>
      refine ⟨fun _ => ?_, fun _ _ h => by cases h⟩
      rcases ih.2 q m rfl with h | ⟨n, w, h, hw⟩
      · simp only [lower_cons_inl, h]; exact .ask m
      · simp only [lower_cons_inl, h]; exact .cons m n hw
    | reply q m n =>
      refine ⟨fun h => (by rcases h with h | ⟨_, h⟩ <;> cases h), fun q' m' h => ?_⟩
      cases h
      exact .inr ⟨n, _, rfl, ih.1 (.inr ⟨q, rfl⟩)⟩
    | ret q r =>
      refine ⟨fun _ => ?_, fun _ _ h => by cases h⟩
      simpa using ih.1 (.inl rfl)

theorem zip_double_upper (s : List (Move E F)) : Zip s (Ev.double (upper s)) s := by
  induction s with
  | nil => exact .nil
  | cons x s ih =>
    rcases x with a | (q | ⟨q, r⟩)
    · exact .left a ih
    · simpa using Zip.right _ (Zip.sync _ ih)
    · simpa using Zip.sync _ (Zip.right _ ih)

theorem zip_double_lower (s : List (Move E F)) : Zip (Ev.double (lower s)) s s := by
  induction s with
  | nil => exact .nil
  | cons x s ih =>
    rcases x with (m | ⟨m, n⟩) | b
    · simpa using Zip.sync _ (Zip.left _ ih)
    · simpa using Zip.left _ (Zip.sync _ ih)
    · exact .right b ih

theorem lower_mono {s s' : List (Move E F)} (h : s <+: s') : lower s <+: lower s' :=
  h.filterMap _

theorem upper_mono {s s' : List (Move E F)} (h : s <+: s') : upper s <+: upper s' :=
  h.filterMap _

theorem double_mono {w w' : List (Ev E)} (h : w <+: w') : Ev.double w <+: Ev.double w' := by
  obtain ⟨r, rfl⟩ := h
  exact ⟨Ev.double r, by simp [Ev.double, List.flatMap_append]⟩

/-! ## Counting -/

/-- The counting facts about a prefix `c` of a copycat play forwarding `w`. -/
def Cnt (c : List (Move E E)) (w : List (Ev E)) : Prop :=
  upper c <+: w ∧ lower c <+: w ∧
    ((upper c).length % 2 = 0 → (lower c).length = (upper c).length) ∧
    ((lower c).length % 2 = 1 → (upper c).length = (lower c).length) ∧
    (lower c).length ≤ (upper c).length + 1 ∧ (upper c).length ≤ (lower c).length + 1

private theorem prefix_append_cases {α : Type v} {c l r : List α} (h : c <+: l ++ r) :
    c <+: l ∨ ∃ c', c = l ++ c' ∧ c' <+: r := by
  rcases le_total c.length l.length with hl | hl
  · exact .inl (List.prefix_of_prefix_length_le h (List.prefix_append l r) hl)
  · obtain ⟨c', hc'⟩ : l <+: c := List.prefix_of_prefix_length_le (List.prefix_append l r) h hl
    refine .inr ⟨c', hc'.symm, ?_⟩
    rw [← hc'] at h
    exact (List.prefix_append_right_inj l).1 h

private theorem nil_counts {c : List (Move E E)} (hc : c <+: Ev.double []) : Cnt c [] := by
  rw [Ev.double, List.flatMap_nil, List.prefix_nil] at hc
  rw [hc]
  simp [Cnt]

private theorem ask_counts {m : E.Op} {c : List (Move E E)}
    (hc : c <+: [.inr (.ask m), .inl (.ask m)]) : Cnt c [.ask m] := by
  rcases List.prefix_cons_iff.1 hc with rfl | ⟨c₁, rfl, hc₁⟩
  · simp [Cnt]
  rcases List.prefix_cons_iff.1 hc₁ with rfl | ⟨c₂, rfl, hc₂⟩
  · simp [Cnt]
  rw [List.prefix_nil] at hc₂
  rw [hc₂]
  simp [Cnt]

private theorem small_counts {m : E.Op} {n : E.Ar m} {w : List (Ev E)} {c : List (Move E E)}
    (hc : c <+: [.inr (.ask m), .inl (.ask m), .inl (.ans m n), .inr (.ans m n)]) :
    Cnt c (.ask m :: .ans m n :: w) := by
  rcases List.prefix_cons_iff.1 hc with rfl | ⟨c₁, rfl, hc₁⟩
  · simp [Cnt]
  rcases List.prefix_cons_iff.1 hc₁ with rfl | ⟨c₂, rfl, hc₂⟩
  · simp [Cnt]
  rcases List.prefix_cons_iff.1 hc₂ with rfl | ⟨c₃, rfl, hc₃⟩
  · simp [Cnt]
  rcases List.prefix_cons_iff.1 hc₃ with rfl | ⟨c₄, rfl, hc₄⟩
  · simp [Cnt]
  rw [List.prefix_nil] at hc₄
  rw [hc₄]
  simp [Cnt]

private theorem ext_counts {m : E.Op} {n : E.Ar m} {w : List (Ev E)} {c : List (Move E E)}
    (h : Cnt c w) : Cnt ([.inr (.ask m), .inl (.ask m), .inl (.ans m n), .inr (.ans m n)] ++ c)
      (.ask m :: .ans m n :: w) := by
  obtain ⟨h₁, h₂, h₃, h₄, h₅, h₆⟩ := h
  simp only [Cnt, List.cons_append, List.nil_append, upper_cons_inr, upper_cons_inl,
    lower_cons_inl, lower_cons_inr, List.length_cons]
  refine ⟨List.cons_prefix_cons.2 ⟨rfl, List.cons_prefix_cons.2 ⟨rfl, h₁⟩⟩,
    List.cons_prefix_cons.2 ⟨rfl, List.cons_prefix_cons.2 ⟨rfl, h₂⟩⟩,
    fun h => ?_, fun h => ?_, by omega, by omega⟩
  · have := h₃ (by omega); omega
  · have := h₄ (by omega); omega

/-- Counting the two sides of a copycat play. -/
theorem double_counts {w : List (Ev E)} (hw : Ev.Alternating w) :
    ∀ {c : List (Move E E)}, c <+: Ev.double w → Cnt c w := by
  induction hw with
  | nil => exact nil_counts
  | ask m => exact fun hc => ask_counts (by simpa using hc)
  | @cons m n w' _ ih =>
    intro c hc
    have hc' : c <+: [.inr (.ask m), .inl (.ask m), .inl (.ans m n), .inr (.ans m n)] ++
        Ev.double w' := by simpa using hc
    rcases prefix_append_cases hc' with h | ⟨c', he, h⟩
    · exact small_counts h
    · exact he ▸ ext_counts (ih h)

private def pw : Pos E F → ℕ
  | .wait _ _ => 1
  | _ => 0

private def pr : Pos E F → ℕ
  | .idle => 0
  | _ => 1

private theorem path_parity {x y : Pos E F} {s : List (Move E F)} (h : Path x s y) :
    ((lower s).length + pw x) % 2 = pw y % 2 ∧ ((upper s).length + pr x) % 2 = pr y % 2 := by
  induction h with
  | nil => exact ⟨by simp, by simp⟩
  | cons st _ ih =>
    cases st <;> simp only [lower_cons_inl, lower_cons_inr, upper_cons_inl, upper_cons_inr,
      List.length_cons, pw, pr] at ih ⊢ <;> omega

/-- In a running position, the lower events of a play are complete exchanges
and its upper events end with the pending question. -/
theorem run_parity {s : List (Move E F)} {q : F.Op} (h : Path .idle s (.run q)) :
    (lower s).length % 2 = 0 ∧ (upper s).length % 2 = 1 := by
  have := path_parity h
  simp only [pw, pr] at this
  omega

/-! ## Near-equality from the finite unit laws -/

theorem near_of_id_comp {c : List (Move E E)} (hc : c ∈ Strategy.id E) {s p : List (Move E F)}
    (hs : Legal s) (h : Zip c s p) : p <+: s ∨ ∃ p₀ o, p = p₀ ++ [o] ∧ p₀ <+: s := by
  have hp : p ∈ (Strategy.id E).comp (Strategy.generate {s}) :=
    ⟨c, hc, s, Strategy.subset_generate rfl hs, h⟩
  rw [Strategy.id_comp, Strategy.mem_generate] at hp
  obtain ⟨-, u, hu, hp⟩ := hp
  have hu' : u <+: s := by
    rcases hu with rfl | ⟨rfl, -⟩
    · exact List.nil_prefix
    · exact List.prefix_refl _
  rcases hp with hp | ⟨p₀, o, rfl, hp₀, -⟩
  · exact .inl (hp.trans hu')
  · exact .inr ⟨p₀, o, rfl, hp₀.trans hu'⟩

theorem near_of_comp_id {c : List (Move F F)} (hc : c ∈ Strategy.id F) {s p : List (Move E F)}
    (hs : Legal s) (h : Zip s c p) : p <+: s ∨ ∃ p₀ o, p = p₀ ++ [o] ∧ p₀ <+: s := by
  have hp : p ∈ (Strategy.generate {s}).comp (Strategy.id F) :=
    ⟨s, Strategy.subset_generate rfl hs, c, hc, h⟩
  rw [Strategy.comp_id, Strategy.mem_generate] at hp
  obtain ⟨-, u, hu, hp⟩ := hp
  have hu' : u <+: s := by
    rcases hu with rfl | ⟨rfl, -⟩
    · exact List.nil_prefix
    · exact List.prefix_refl _
  rcases hp with hp | ⟨p₀, o, rfl, hp₀, -⟩
  · exact .inl (hp.trans hu')
  · exact .inr ⟨p₀, o, rfl, hp₀.trans hu'⟩

/-! ## Interactions of copycat with divergent plays, and no chatter -/

/-- An interaction of copycat with a running play yields that play. -/
theorem eq_of_id_comp_run {c : List (Move E E)} (hc : c ∈ Strategy.id E) {s p : List (Move E F)}
    {q : F.Op} (hq : Path .idle s (.run q)) (hz : Zip c s p) : p = s := by
  obtain ⟨w, hw, hcw⟩ : ∃ w, Ev.Alternating w ∧ c <+: Ev.double w := hc
  have hcnt : Cnt c w := double_counts hw hcw
  have hpar : (lower s).length % 2 = 0 ∧ (upper s).length % 2 = 1 := run_parity hq
  have hsy : upper c = lower s := zip_sync hz
  have hl : lower p = lower c := zip_lefts hz
  have hr : upper p = upper s := zip_rights hz
  have hlen : (lower c).length = (upper c).length := hcnt.2.2.1 (by rw [hsy]; exact hpar.1)
  have heq : lower c = upper c :=
    (List.prefix_of_prefix_length_le hcnt.2.1 hcnt.1 hlen.le).eq_of_length hlen
  have hlow : lower p = lower s := by rw [hl, heq, hsy]
  exact eq_of_near (near_of_id_comp ⟨w, hw, hcw⟩ ⟨_, hq⟩ hz) hlow hr

/-- An interaction of a running play with copycat yields that play. -/
theorem eq_of_comp_id_run {c : List (Move F F)} (hc : c ∈ Strategy.id F) {s p : List (Move E F)}
    {q : F.Op} (hq : Path .idle s (.run q)) (hz : Zip s c p) : p = s := by
  obtain ⟨w, hw, hcw⟩ : ∃ w, Ev.Alternating w ∧ c <+: Ev.double w := hc
  have hcnt : Cnt c w := double_counts hw hcw
  have hpar : (lower s).length % 2 = 0 ∧ (upper s).length % 2 = 1 := run_parity hq
  have hsy : upper s = lower c := zip_sync hz
  have hl : lower p = lower s := zip_lefts hz
  have hr : upper p = upper c := zip_rights hz
  have hlen : (upper c).length = (lower c).length := hcnt.2.2.2.1 (by rw [← hsy]; exact hpar.2)
  have heq : upper c = lower c :=
    (List.prefix_of_prefix_length_le hcnt.1 hcnt.2.1 hlen.le).eq_of_length hlen
  have hup : upper p = upper s := by rw [hr, heq, hsy]
  exact eq_of_near (near_of_comp_id ⟨w, hw, hcw⟩ ⟨_, hq⟩ hz) hl hup

/-- Copycat never chatters forever with a strategy above it. -/
theorem no_chatter_id_comp {δ : DStrategy E F} (i : DStrategy.InfInteraction (DStrategy.id E) δ)
    {p : List (Move E F)} (hi : ∀ n, i.p n = p) : False := by
  obtain ⟨n, hn⟩ : ∃ n, 5 * p.length + 3 ≤ (i.s n).length + (i.t n).length := i.unbounded _
  obtain ⟨w, hw, hcw⟩ : ∃ w, Ev.Alternating w ∧ i.s n <+: Ev.double w := i.mem_s n
  have h₆ : (upper (i.s n)).length ≤ (lower (i.s n)).length + 1 :=
    (double_counts hw hcw).2.2.2.2.2
  have hz : Zip (i.s n) (i.t n) p := hi n ▸ i.zip n
  have hsy : (upper (i.s n)).length = (lower (i.t n)).length := congrArg List.length (zip_sync hz)
  have hl : (lower p).length = (lower (i.s n)).length := congrArg List.length (zip_lefts hz)
  have hr : (upper p).length = (upper (i.t n)).length := congrArg List.length (zip_rights hz)
  have e₁ : (i.s n).length = (lower (i.s n)).length + (upper (i.s n)).length := length_split _
  have e₂ : (i.t n).length = (lower (i.t n)).length + (upper (i.t n)).length := length_split _
  have e₃ : p.length = (lower p).length + (upper p).length := length_split _
  omega

/-- Copycat never chatters forever with a strategy below it. -/
theorem no_chatter_comp_id {δ : DStrategy E F} (i : DStrategy.InfInteraction δ (DStrategy.id F))
    {p : List (Move E F)} (hi : ∀ n, i.p n = p) : False := by
  obtain ⟨n, hn⟩ : ∃ n, 5 * p.length + 3 ≤ (i.s n).length + (i.t n).length := i.unbounded _
  obtain ⟨w, hw, hcw⟩ : ∃ w, Ev.Alternating w ∧ i.t n <+: Ev.double w := i.mem_t n
  have h₅ : (lower (i.t n)).length ≤ (upper (i.t n)).length + 1 :=
    (double_counts hw hcw).2.2.2.2.1
  have hz : Zip (i.s n) (i.t n) p := hi n ▸ i.zip n
  have hsy : (upper (i.s n)).length = (lower (i.t n)).length := congrArg List.length (zip_sync hz)
  have hl : (lower p).length = (lower (i.s n)).length := congrArg List.length (zip_lefts hz)
  have hr : (upper p).length = (upper (i.t n)).length := congrArg List.length (zip_rights hz)
  have e₁ : (i.s n).length = (lower (i.s n)).length + (upper (i.s n)).length := length_split _
  have e₂ : (i.t n).length = (lower (i.t n)).length + (upper (i.t n)).length := length_split _
  have e₃ : p.length = (lower p).length + (upper p).length := length_split _
  omega

/-! ## The unit laws for the new components -/

namespace IdComp

variable {δ : DStrategy E F}

theorem div_subset : ((DStrategy.id E).comp δ).div ⊆ δ.div := by
  rintro p (⟨c, s, hz, ⟨hc, -⟩ | ⟨hc, hs⟩⟩ | ⟨i, hi⟩)
  · exact hc.elim
  · obtain ⟨q, hq⟩ := δ.div_run hs
    exact (eq_of_id_comp_run hc hq hz) ▸ hs
  · exact (no_chatter_id_comp i hi).elim

theorem subset_div : δ.div ⊆ ((DStrategy.id E).comp δ).div := by
  intro s hs
  obtain ⟨x, hx⟩ := δ.toStrategy.legal (δ.div_mem hs)
  exact .inl ⟨_, s, zip_double_lower s,
    .inr ⟨⟨_, (lower_alternating hx).1 (.inl rfl), List.prefix_refl _⟩, hs⟩⟩

theorem inf_subset : ((DStrategy.id E).comp δ).inf ⊆ δ.inf := by
  rintro _ ⟨i, hu, rfl⟩
  have hn : ∀ n, i.p n <+: i.t n ∨ ∃ p₀ o, i.p n = p₀ ++ [o] ∧ p₀ <+: i.t n := fun n =>
    near_of_id_comp (i.mem_s n) (δ.toStrategy.legal (i.mem_t n)) (i.zip n)
  obtain ⟨heq, ht⟩ := lim_eq_of_near i.mono_p i.mono_t hu hn
  rw [heq]
  exact i.lim_t ht

theorem subset_inf : δ.inf ⊆ ((DStrategy.id E).comp δ).inf := by
  intro I hI
  have h := δ.inf_isInf hI
  have hpath : ∀ n, ∃ x, Path .idle (h.seq n) x := fun n =>
    δ.toStrategy.legal (δ.inf_sub hI (h.seq_mem n))
  have hcc : ∀ n, Ev.double (lower (h.seq n)) ∈ Strategy.id E := fun n =>
    ⟨_, (lower_alternating (hpath n).choose_spec).1 (.inl rfl), List.prefix_refl _⟩
  let i : DStrategy.InfInteraction (DStrategy.id E) δ :=
    { s := fun n => Ev.double (lower (h.seq n))
      t := h.seq
      p := h.seq
      zip := fun n => zip_double_lower _
      mem_s := hcc
      mem_t := fun n => δ.inf_sub hI (h.seq_mem n)
      mono_s := fun n => double_mono (lower_mono (h.seq_mono n))
      mono_t := h.seq_mono
      mono_p := h.seq_mono
      unbounded := fun k => ⟨k, by rw [h.seq_length]; omega⟩
      lim_s := fun hu => ⟨Chain.isInfPlay_lim (fun n => double_mono (lower_mono (h.seq_mono n))) hu,
        fun q ⟨n, hq⟩ => (Strategy.id E).of_prefix (hcc n) hq⟩
      lim_t := fun _ => by rw [h.lim_seq]; exact hI }
  exact ⟨i, h.seq_unbounded, h.lim_seq.symm⟩

end IdComp

namespace CompId

variable {δ : DStrategy E F}

theorem div_subset : (δ.comp (DStrategy.id F)).div ⊆ δ.div := by
  rintro p (⟨s, c, hz, ⟨hs, hc⟩ | ⟨-, hc⟩⟩ | ⟨i, hi⟩)
  · obtain ⟨q, hq⟩ := δ.div_run hs
    exact (eq_of_comp_id_run hc hq hz) ▸ hs
  · exact hc.elim
  · exact (no_chatter_comp_id i hi).elim

theorem subset_div : δ.div ⊆ (δ.comp (DStrategy.id F)).div := by
  intro s hs
  obtain ⟨x, hx⟩ := δ.toStrategy.legal (δ.div_mem hs)
  exact .inl ⟨s, _, zip_double_upper s,
    .inl ⟨hs, ⟨_, (upper_alternating hx).1 rfl, List.prefix_refl _⟩⟩⟩

theorem inf_subset : (δ.comp (DStrategy.id F)).inf ⊆ δ.inf := by
  rintro _ ⟨i, hu, rfl⟩
  have hn : ∀ n, i.p n <+: i.s n ∨ ∃ p₀ o, i.p n = p₀ ++ [o] ∧ p₀ <+: i.s n := fun n =>
    near_of_comp_id (i.mem_t n) (δ.toStrategy.legal (i.mem_s n)) (i.zip n)
  obtain ⟨heq, hs⟩ := lim_eq_of_near i.mono_p i.mono_s hu hn
  rw [heq]
  exact i.lim_s hs

theorem subset_inf : δ.inf ⊆ (δ.comp (DStrategy.id F)).inf := by
  intro I hI
  have h := δ.inf_isInf hI
  have hpath : ∀ n, ∃ x, Path .idle (h.seq n) x := fun n =>
    δ.toStrategy.legal (δ.inf_sub hI (h.seq_mem n))
  have hcc : ∀ n, Ev.double (upper (h.seq n)) ∈ Strategy.id F := fun n =>
    ⟨_, (upper_alternating (hpath n).choose_spec).1 rfl, List.prefix_refl _⟩
  let i : DStrategy.InfInteraction δ (DStrategy.id F) :=
    { s := h.seq
      t := fun n => Ev.double (upper (h.seq n))
      p := h.seq
      zip := fun n => zip_double_upper _
      mem_s := fun n => δ.inf_sub hI (h.seq_mem n)
      mem_t := hcc
      mono_s := h.seq_mono
      mono_t := fun n => double_mono (upper_mono (h.seq_mono n))
      mono_p := h.seq_mono
      unbounded := fun k => ⟨k, by rw [h.seq_length]; omega⟩
      lim_s := fun _ => by rw [h.lim_seq]; exact hI
      lim_t := fun hu => ⟨Chain.isInfPlay_lim (fun n => double_mono (upper_mono (h.seq_mono n))) hu,
        fun q ⟨n, hq⟩ => (Strategy.id F).of_prefix (hcc n) hq⟩ }
  exact ⟨i, h.seq_unbounded, h.lim_seq.symm⟩

end CompId

