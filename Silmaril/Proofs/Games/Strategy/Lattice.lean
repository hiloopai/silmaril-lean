module

public import Silmaril.Games.Strategy.Defs
public import Mathlib.Order.CompleteLattice.Basic

/-!
# The lattice of strategies: proofs

Proofs for `Silmaril.Games.Strategy.Thms`: meets are intersections, `⊥` contains
the empty play and the one-move plays in which Opponent asks a question, and
joins are unions together with `⊥`.
-/

public section

namespace Silmaril.Proofs.Games.Strategy

open Silmaril.Games Silmaril.Games.Strategy

universe u

variable {E F : Sig.{u}}

/-- Binary meets are intersections. -/
theorem mem_inf {σ τ : Strategy E F} {p : List (Move E F)} : p ∈ σ ⊓ τ ↔ p ∈ σ ∧ p ∈ τ := by
  rw [← sInf_pair, mem_sInf]
  constructor
  · rintro ⟨-, h⟩
    exact ⟨h σ (by simp), h τ (by simp)⟩
  · rintro ⟨h₁, h₂⟩
    refine ⟨σ.legal h₁, ?_⟩
    rintro ρ (rfl | rfl)
    · exact h₁
    · exact h₂

/-- The bottom strategy is generated by no play. -/
theorem bot_eq_generate : (⊥ : Strategy E F) = generate ∅ :=
  le_antisymm bot_le (generate_le fun _ h => h.elim)

/-- The bottom strategy never moves: it only lets Opponent ask a first question. -/
theorem mem_bot {p : List (Move E F)} :
    p ∈ (⊥ : Strategy E F) ↔ p = [] ∨ ∃ q, p = [.inr (.ask q)] := by
  rw [bot_eq_generate]
  change p ∈ generatePlays ∅ ↔ _
  constructor
  · rintro ⟨hl, s, hs, hp⟩
    rcases hs with rfl | ⟨hs, -⟩
    · rcases hp with hp | ⟨p₀, o, rfl, hp₀, -⟩
      · exact .inl (List.prefix_nil.1 hp)
      · rw [List.prefix_nil] at hp₀
        subst hp₀
        obtain ⟨_, hl⟩ := hl
        cases hl with
        | cons st _ => cases st with | ask q => exact .inr ⟨q, rfl⟩
    · exact hs.elim
  · rintro (rfl | ⟨q, rfl⟩)
    · exact (generate ∅ : Strategy E F).nil_mem
    · exact ⟨⟨_, .single (.ask q)⟩, [], .inl rfl, .inr ⟨[], _, rfl, List.prefix_refl _, trivial⟩⟩

/-- The plays of a join: those of `⊥` and of the joined strategies. -/
theorem mem_sSup {S : Set (Strategy E F)} {p : List (Move E F)} :
    p ∈ sSup S ↔ p ∈ (⊥ : Strategy E F) ∨ ∃ σ ∈ S, p ∈ σ := by
  constructor
  · intro hp
    rw [sSup_def] at hp
    change p ∈ generatePlays _ at hp
    obtain ⟨hl, s, hs, hp⟩ := hp
    rcases hs with rfl | ⟨⟨σ, hσ, hs⟩, -⟩
    · left
      rw [bot_eq_generate]
      exact ⟨hl, [], .inl rfl, hp⟩
    · right
      refine ⟨σ, hσ, ?_⟩
      rcases hp with hp | ⟨p₀, o, rfl, hp₀, ho⟩
      · exact σ.of_prefix hs hp
      · obtain ⟨_, hpath⟩ := hl
        obtain ⟨x, hx, hxo⟩ := Path.concat_iff.1 hpath
        exact σ.receptive (σ.of_prefix hs hp₀) hx hxo ho
  · rintro (h | ⟨σ, hσ, h⟩)
    · exact (bot_le : ⊥ ≤ sSup S) h
    · exact (le_sSup hσ : σ ≤ sSup S) h

/-- Nonempty joins are unions. -/
theorem mem_sSup_of_nonempty {S : Set (Strategy E F)} (hS : S.Nonempty)
    {p : List (Move E F)} : p ∈ sSup S ↔ ∃ σ ∈ S, p ∈ σ := by
  rw [mem_sSup]
  constructor
  · rintro (h | h)
    · obtain ⟨σ, hσ⟩ := hS
      exact ⟨σ, hσ, (bot_le : ⊥ ≤ σ) h⟩
    · exact h
  · exact .inr

end Silmaril.Proofs.Games.Strategy
