module

public import Silmaril.Games.Abstract.Game.Defs
public import Mathlib.Order.CompleteLattice.Basic
public import Mathlib.Order.GaloisConnection.Defs
public import Mathlib.Data.List.Induction

/-!
# Trace models of an abstract game: proofs

Proofs for `Silmaril.Games.Abstract.Game.Thms`: `generate` is the least model
containing the legal plays of a set, joins are generated by unions (and are
unions for nonempty families), the bottom model only lets Opponent move,
determinism is inherited by submodels, and pullback along a game morphism has
pushforward as its left adjoint.
-/

public section

namespace Silmaril.Proofs.Games.Abstract.Game

open Silmaril.Games.Abstract Silmaril.Games.Abstract.TraceModel

universe u v

variable {G : Game.{u}}

theorem subset_generate {S : Set (List G.Move)} {s : List G.Move} (hs : s ∈ S)
    (hl : s ∈ G.Legal) : s ∈ generate S :=
  ⟨hl, s, .inr ⟨hs, hl⟩, s, [], by simp, List.prefix_refl s, by simp⟩

theorem generate_le_iff {S : Set (List G.Move)} {T : TraceModel G} :
    generate S ≤ T ↔ ∀ s ∈ S, s ∈ G.Legal → s ∈ T := by
  constructor
  · exact fun h s hs hl => h (subset_generate hs hl)
  · rintro h p ⟨hp, u, hu, p₀, w, rfl, hp₀, hw⟩
    have hu' : u ∈ T := by
      rcases hu with rfl | ⟨hu, hl⟩
      · exact T.closed.nil_mem
      · exact h u hu hl
    -- Extend the prefix `p₀` of a play of `T` by the Opponent moves `w`, one at a time.
    have hp₀T : p₀ ∈ T := T.closed.of_prefix hu' hp₀
    induction w using List.reverseRecOn with
    | nil => simpa using hp₀T
    | append_singleton w o ih =>
      have hw' : ∀ o ∈ w, G.IsO o := fun o h' => hw o (List.mem_append_left _ h')
      have hpw : p₀ ++ w ∈ G.Legal :=
        G.legal_of_prefix hp (by simp)
      have := T.closed.receptive (ih hpw hw') (by simpa using hp) (hw o (by simp))
      simpa using this


theorem generate_coe (T : TraceModel G) : generate (T : Set (List G.Move)) = T :=
  le_antisymm (generate_le_iff.2 fun _ hs _ => hs)
    fun _ hs => subset_generate hs (T.closed.legal hs)

theorem sSup_eq_generate (S : Set (TraceModel G)) :
    sSup S = generate {p | ∃ T ∈ S, p ∈ T} := by
  refine (isLUB_sSup S).unique ⟨fun T hT p hp => subset_generate ⟨T, hT, hp⟩
    (T.closed.legal hp), fun U hU => generate_le_iff.2 ?_⟩
  rintro p ⟨T, hT, hp⟩ -
  exact hU hT hp

theorem mem_sSup_of_nonempty {S : Set (TraceModel G)} (hS : S.Nonempty) {p : List G.Move} :
    p ∈ sSup S ↔ ∃ T ∈ S, p ∈ T := by
  -- The union of a nonempty family of models is already a model.
  obtain ⟨T₀, hT₀⟩ := hS
  let U : TraceModel G := ⟨{p | ∃ T ∈ S, p ∈ T}, {
    nil_mem := ⟨T₀, hT₀, T₀.closed.nil_mem⟩
    legal := fun ⟨T, _, hp⟩ => T.closed.legal hp
    of_prefix := fun ⟨T, hT, hp⟩ hst => ⟨T, hT, T.closed.of_prefix hp hst⟩
    receptive := fun ⟨T, hT, hp⟩ hl ho => ⟨T, hT, T.closed.receptive hp hl ho⟩ }⟩
  have : sSup S = U := (isLUB_sSup S).unique
    ⟨fun T hT _ hp => ⟨T, hT, hp⟩, fun V hV _ ⟨T, hT, hp⟩ => hV hT hp⟩
  rw [this]
  exact Iff.rfl

theorem mem_top {p : List G.Move} : p ∈ (⊤ : TraceModel G) ↔ p ∈ G.Legal := by
  rw [← sInf_empty, mem_sInf]
  simp

theorem mem_bot {p : List G.Move} : p ∈ (⊥ : TraceModel G) ↔ p ∈ G.Legal ∧ ∀ o ∈ p, G.IsO o := by
  rw [← sSup_empty, sSup_eq_generate]
  constructor
  · rintro ⟨hp, u, hu, p₀, w, rfl, hp₀, hw⟩
    rcases hu with rfl | ⟨⟨_, h, _⟩, _⟩
    · obtain rfl := List.prefix_nil.1 hp₀
      exact ⟨hp, by simpa using hw⟩
    · exact absurd h (Set.notMem_empty _)
  · rintro ⟨hp, hw⟩
    exact ⟨hp, [], .inl rfl, [], p, by simp, List.prefix_refl _, hw⟩

theorem Det.mono {T U : TraceModel G} (h : T ≤ U) (hU : U.Det) : T.Det :=
  fun _ _ _ hp hq hpo hqo => hU (h hp) (h hq) hpo hqo

variable {H : Game.{v}}

theorem gc_map_comap (f : G.Hom H) : GaloisConnection (map f) (comap f) := by
  intro T U
  constructor
  · intro h s hs
    exact ⟨T.closed.legal hs, h (subset_generate ⟨s, hs, rfl⟩ (f.legal (T.closed.legal hs)))⟩
  · intro h
    refine generate_le_iff.2 ?_
    rintro _ ⟨s, hs, rfl⟩ -
    exact (h hs).2

end Silmaril.Proofs.Games.Abstract.Game
