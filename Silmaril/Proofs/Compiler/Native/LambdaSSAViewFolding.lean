module

public import Silmaril.Compiler.Native.Optimize.LambdaSSA.ViewTyping.Thms
public import Silmaril.Compiler.Native.Optimize.LambdaSSA.RegionFolding.Thms
public import Silmaril.Compiler.Native.Optimize.LambdaSSA.ShapePreservation.Thms
public import Silmaril.Machine.OfLambdaSSA.Thms
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
/-! Actual accepted-view folding and successful-flattening composition. Shape
and finite evaluation are derived from public source-admission proofs and the
existing operational/flattening semantics, with no successful run premise. -/
@[expose] public section

namespace Silmaril.Compiler.Native.Optimize.LambdaSSA.ViewFolding
open Silmaril.Isotope (Value)
open Silmaril.Isotope.LambdaSSA
open Silmaril.Machine.OfLambdaSSA
open Silmaril.Machine.RTL (Opcode CallOracle packValues)
open Silmaril.Machine.Lir (Memory)
open Silmaril.Machine.Lir (Word)
open Folding ViewTyping Admission

theorem tm_fits_append {context : List Shape} {term : Old.Tm} {shape : Shape}
    (typed : TmFits [] context term shape) (extra : List Shape) :
    TmFits [] (context ++ extra) term shape := by
  induction typed with
  | var lookup =>
    exact .var (by rw [List.getElem?_append_left (List.getElem?_eq_some_iff.mp lookup).1]; exact lookup)
  | unit => exact .unit
  | pair _ _ first rest => exact .pair first rest
  | op notTest _ argument => exact .op notTest argument
  | let₁ _ _ value body => exact .let₁ value body
  | let₂ _ _ value body => exact .let₂ value body

theorem region_fits_append {context : List Shape} {region : Old.Region}
    {annotation : Silmaril.Machine.RTL.SSA.Ann} {labels : List Nat}
    (typed : RegionFits [] context region annotation labels) (extra : List Shape) :
    RegionFits [] (context ++ extra) region annotation labels := by
  induction typed with
  | br lookup argument => exact .br lookup (tm_fits_append argument extra)
  | let₁ value _ body => exact .let₁ (tm_fits_append value extra) body
  | let₂ value _ body => exact .let₂ (tm_fits_append value extra) body
  | case argument _ _ left right => exact .case (tm_fits_append argument extra) left right
  | cfg length _ _ entry blocks => exact .cfg length entry blocks

theorem rootWrapper_regionFits {blocks : Fin 1 → Old.Region}
    {width params results : Nat} {annotation : Silmaril.Machine.RTL.SSA.Ann}
    (typed : RootFits [] (.cfg (.br 0 (.var 0)) 1 blocks)
      (.cfg [width] .br [annotation]) params results) :
    RegionFits [] [.tuple params] (.cfg (.br 0 (.var 0)) 1 blocks)
      (.cfg [width] .br [annotation]) [results, 0] := by
  have same : width = params := typed.1
  subst width
  refine .cfg rfl (.br rfl (.var rfl)) ?_
  intro index
  have unique : index = 0 := Subsingleton.elim index 0
  subst index
  exact region_fits_append typed.2 [.tuple params]

/-- The wrapper and exact body annotation are generated by the actual view. -/
theorem view_wrapper {base : Nat} {source : Silmaril.Compile.Mir.Block} {result : View}
    (accepted : view base source = some result) :
    ∃ (blocks : Fin 1 → Old.Region) (body : Silmaril.Machine.RTL.SSA.Ann),
      result.region = .cfg (.br 0 (.var 0)) 1 blocks ∧
      result.annotation = .cfg [result.inputs.length] .br [body] := by
  unfold view at accepted
  dsimp only at accepted
  split at accepted
  · cases accepted
  · cases converted : (enter base source).body.instrs.toList.mapM oldOp with
    | none => simp [converted] at accepted
    | some instructions =>
      simp only [converted, bind, pure] at accepted
      obtain rfl := Option.some.inj accepted
      exact ⟨_, _, rfl, rfl⟩

theorem view_regionFits {base : Nat} {source : Silmaril.Compile.Mir.Block} {result : View}
    (accepted : view base source = some result) :
    RegionFits [] [.tuple result.inputs.length] result.region result.annotation [result.outputs.length, 0] := by
  obtain ⟨blocks, annotation, regionEq, annotationEq⟩ := view_wrapper accepted
  have typed : RootFits [] result.region result.annotation result.inputs.length result.outputs.length :=
    view_fits accepted
  rw [regionEq, annotationEq] at typed ⊢
  exact rootWrapper_regionFits typed

theorem view_folded_fits {base : Nat} {source : Silmaril.Compile.Mir.Block} {result : View}
    (accepted : view base source = some result) (known : List Abstract) :
    RootFits [] (foldRegion known result.region).1 result.annotation result.inputs.length result.outputs.length := by
  obtain ⟨blocks, annotation, regionEq, annotationEq⟩ := view_wrapper accepted
  have typed : RootFits [] result.region result.annotation result.inputs.length result.outputs.length :=
    view_fits accepted
  rw [regionEq, annotationEq] at typed ⊢
  exact ShapePreservation.foldRegion_rootWrapper_fits typed known

theorem environment_unknown (env : Semantics.Env Word) : EnvironmentModels [.unknown] env := by
  intro index
  cases index <;> trivial

theorem environment_input {params : Nat} {env : Semantics.Env Word} {args : List Word}
    (length : args.length = params) (input : env 0 = packValues args) :
    ShapeEnvironment [.tuple params] env := by
  intro index shape lookup
  cases index with
  | zero =>
    have same : Shape.tuple params = shape := Option.some.inj lookup
    exact ⟨args, same ▸ ⟨input, length⟩⟩
  | succ index => cases lookup

/-- Actual accepted view and actual folding have exactly the same finite
operational results for every shape-correct packed input environment. -/
theorem view_folded_eval_iff (oracle : CallOracle)
    {base : Nat} {source : Silmaril.Compile.Mir.Block} {result : View}
    (accepted : view base source = some result)
    {env : Semantics.Env Word} {args : List Word}
    (length : args.length = result.inputs.length) (input : env 0 = packValues args)
    (before : Memory) (label : Nat) (value : Value Word) (after : Memory) :
    Semantics.Region.Eval (Opcode.step oracle) env (foldRegion [.unknown] result.region).1 before label value after ↔
      Semantics.Region.Eval (Opcode.step oracle) env result.region before label value after :=
  RegionFolding.foldRegion_eval_iff oracle (view_regionFits accepted) (view_pure accepted)
    (environment_unknown env) (environment_input length input) before label value after

theorem view_folded_exit (oracle : CallOracle)
    {base : Nat} {source : Silmaril.Compile.Mir.Block} {result : View}
    (accepted : view base source = some result)
    {env : Semantics.Env Word} {args : List Word}
    (length : args.length = result.inputs.length) (input : env 0 = packValues args)
    {before : Memory} {label : Nat} {value : Value Word} {after : Memory}
    (evaluation : Semantics.Region.Eval (Opcode.step oracle) env (foldRegion [.unknown] result.region).1
      before label value after) :
    RegionFolding.Exits [result.outputs.length, 0] label value ∧ after = before :=
  RegionFolding.foldRegion_exit oracle (view_regionFits accepted) (view_pure accepted)
    (environment_unknown env) (environment_input length input) evaluation

/-- Actual successful flattening and its existing semantics compose with the
accepted actual view and folding, without a successful source/target run premise. -/
theorem view_flattened_eval_iff (oracle : CallOracle)
    (signatures : Silmaril.Machine.RTL.SSA.CallOracle.MatchesSigs oracle [])
    {base : Nat} {source : Silmaril.Compile.Mir.Block} {result : View}
    (accepted : view base source = some result)
    (compiled : Silmaril.Machine.RTL.SSA.Compiles [] (foldRegion [.unknown] result.region).1
      result.annotation result.inputs.length result.outputs.length)
    {frame : Silmaril.Machine.RTL.Frame Nat} {args : List Word}
    (arguments : frame.readAll (Silmaril.Machine.RTL.SSA.freshRegs 0 result.inputs.length) = some args)
    {env : Semantics.Env Word} (input : env 0 = packValues args)
    {before : Memory} {label : Nat} {value : Value Word} {after : Memory} :
    Semantics.Region.Eval (Opcode.step oracle) env result.region before label value after ↔
      (label = 0 ∧ ∃ values, value = packValues values ∧
        Silmaril.Machine.RTL.SSA.Func.Exec oracle
          (Silmaril.Machine.RTL.SSA.ofLambdaSSA [] (foldRegion [.unknown] result.region).1
            result.annotation result.inputs.length result.outputs.length)
          0 frame before (.returned values after)) ∨
      (label = 1 ∧ value = .unit ∧
        Silmaril.Machine.RTL.SSA.Func.Exec oracle
          (Silmaril.Machine.RTL.SSA.ofLambdaSSA [] (foldRegion [.unknown] result.region).1
            result.annotation result.inputs.length result.outputs.length)
          0 frame before (.trapped after)) := by
  have length : args.length = result.inputs.length := by
    simpa only [Silmaril.Machine.RTL.SSA.freshRegs, List.length_map, List.length_range]
      using (Silmaril.Machine.RTL.SSA.readAll_length arguments).symm
  exact (view_folded_eval_iff oracle accepted length input before label value after).symm.trans
    (Silmaril.Machine.OfLambdaSSA.ofLambdaSSA_eval_iff signatures compiled
      (view_folded_fits accepted [.unknown]) arguments input)

end Silmaril.Compiler.Native.Optimize.LambdaSSA.ViewFolding
