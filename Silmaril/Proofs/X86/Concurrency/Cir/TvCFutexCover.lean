module

public import Silmaril.X86.Concurrency.Cir.Tv.CFutex.Defs

/-!
# Futex C litmus tests: the converse trace check

One `decide +kernel` per test: every CIR
trace of every thread is the actions of a bounded x86 trace (`FTest.coverOk`). With `tvOk` this
makes the bounded x86 behaviours and the CIR behaviours equal up to registers. It is written by
hand (not generated by `litmus-x86 cir-f`), so the generated modules stay as they are.
-/

@[expose] public section

namespace Silmaril.Proofs.X86.Concurrency.Cir.TvCFutexCover

open Silmaril.X86.Concurrency.Cir.Tv Silmaril.X86.Concurrency.Cir.Tv.CFutex

set_option maxRecDepth 100000

theorem «Flag@gcc_cover» : «Flag@gcc».coverOk = true := by decide +kernel

theorem «Flag@clang_cover» : «Flag@clang».coverOk = true := by decide +kernel

theorem «Flag-late@gcc_cover» : «Flag-late@gcc».coverOk = true := by decide +kernel

theorem «Flag-late@clang_cover» : «Flag-late@clang».coverOk = true := by decide +kernel

theorem «Mutex@gcc_cover» : «Mutex@gcc».coverOk = true := by decide +kernel

theorem «Mutex@clang_cover» : «Mutex@clang».coverOk = true := by decide +kernel

theorem «Mutex-racy@gcc_cover» : «Mutex-racy@gcc».coverOk = true := by decide +kernel

theorem «Mutex-racy@clang_cover» : «Mutex-racy@clang».coverOk = true := by decide +kernel

end Silmaril.Proofs.X86.Concurrency.Cir.TvCFutexCover
