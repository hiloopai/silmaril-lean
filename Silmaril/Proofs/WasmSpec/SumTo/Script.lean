theorem vc_init (n₀ : BitVec 32) :
    ((0 : BitVec 32) + (triBV n₀)) = (triBV n₀) := by
  bv_omega

theorem vc_exit (n₀ n acc : BitVec 32) (hc : (n == (0 : BitVec 32)) = true) (hi : (acc + (triBV n)) = (triBV n₀)) :
    acc = (triBV n₀) := by
  have h0 : n = (0 : BitVec 32) := by simpa using hc
  subst h0
  have := @triBV_zero
  bv_omega

theorem vc_step (n₀ n acc : BitVec 32) (hc : ¬((n == (0 : BitVec 32)) = true)) (hi : (acc + (triBV n)) = (triBV n₀)) :
    ((acc + n) + (triBV (n - (1 : BitVec 32)))) = (triBV n₀) := by
  have := triBV_step (i := n) (by simpa using hc)
  bv_omega

theorem vc_dec (n₀ n acc : BitVec 32) (hc : ¬((n == (0 : BitVec 32)) = true)) (hi : (acc + (triBV n)) = (triBV n₀)) :
    (n - (1 : BitVec 32)).toNat < n.toNat := by
  have h0 : n ≠ (0 : BitVec 32) := by simpa using hc
  bv_omega

/-- The loop invariant (from the annotations or a proposal), with the
measure as the loop rule's index. -/
def inv {H : Type} (s₀ : Store H) (m : ModuleInst) (n₀ : BitVec 32) :
    Nat → Store H → Frame → List Val → Prop := fun k s f vs =>
  s = s₀ ∧ vs = [] ∧ ∃ n acc : BitVec 32,
    f = ⟨[some (.i32 n), some (.i32 acc)], m⟩ ∧ k = n.toNat ∧ ((acc + (triBV n)) = (triBV n₀))

variable {H : Type} {P : Profile} {host : HostSemantics H}

/-- What the loop body must establish at measure `k`. -/
abbrev loopQ (s₀ : Store H) (m : ModuleInst) (n₀ : BitVec 32) (k : Nat) : Post H :=
  loopPost 0 (inv s₀ m n₀) k (seqPost P host [] (blockPost 0
    (seqPost P host (expression [.localGet ⟨1⟩]) (funcPost P host 1 fun s' r => s' = s₀ ∧ r = [.i32 (triBV n₀)]))))

/-- The exit branch: `POST` returns the specified result (`vc_exit`). -/
theorem loop_exit {s₀ : Store H} {m : ModuleInst} {n₀ n acc : BitVec 32}
    (hc : (n == (0 : BitVec 32)) = true) (hi : (acc + (triBV n)) = (triBV n₀)) :
    loopQ (P := P) (host := host) s₀ m n₀ n.toNat s₀ ⟨[some (.i32 n), some (.i32 acc)], m⟩ (.br 1 []) := by
  refine ⟨[], [], rfl, rfl, ?_⟩
  show WP P host s₀ _ (vals [] ++ expression [.localGet ⟨1⟩]) _
  wasm_step [Idx.toNat, Fin.val_zero, Fin.val_one, Fin.isValue, eqz32, eq32, ne32, ltS32, gtS32, leS32, geS32, ltU32, gtU32, leU32, geU32, shrS32, BitVec.toNat_ofNat, Nat.reduceMod, Nat.reducePow, Nat.reduceAdd, Nat.reduceLT, ↓reduceIte]
  exact (⟨rfl, rfl, congrArg (fun v => [Val.i32 v]) (vc_exit n₀ n acc hc hi)⟩ : _ ∧ _ ∧ _)

/-- The iteration: the state after `P2` satisfies the invariant at a smaller
measure (`vc_step`, `vc_dec`). -/
theorem loop_next {s₀ : Store H} {m : ModuleInst} {n₀ n acc : BitVec 32}
    (hc : ¬((n == (0 : BitVec 32)) = true)) (hi : (acc + (triBV n)) = (triBV n₀)) :
    WP P host s₀ ⟨[some (.i32 n), some (.i32 acc)], m⟩ (vals [] ++ expression [.localGet ⟨1⟩, .localGet ⟨0⟩, .intBinOp .i32 .add, .localSet ⟨1⟩, .localGet ⟨0⟩, .intConst .i32 1, .intBinOp .i32 .sub, .localSet ⟨0⟩, .br ⟨0⟩])
      (loopQ (P := P) (host := host) s₀ m n₀ n.toNat) := by
  show WP P host s₀ _ (vals [] ++ expression [.localGet ⟨1⟩, .localGet ⟨0⟩, .intBinOp .i32 .add, .localSet ⟨1⟩, .localGet ⟨0⟩, .intConst .i32 1, .intBinOp .i32 .sub, .localSet ⟨0⟩] ++ .plain (.br ⟨0⟩) :: []) _
  wasm_step [Idx.toNat, Fin.val_zero, Fin.val_one, Fin.isValue, eqz32, eq32, ne32, ltS32, gtS32, leS32, geS32, ltU32, gtU32, leU32, geU32, shrS32, BitVec.toNat_ofNat, Nat.reduceMod, Nat.reducePow, Nat.reduceAdd, Nat.reduceLT, ↓reduceIte]
  exact wp_br (rest := []) ⟨[], [], _, rfl, rfl, vc_dec n₀ n acc hc hi, rfl, rfl,
    (n - (1 : BitVec 32)), (acc + n), rfl, rfl, vc_step n₀ n acc hc hi⟩

/-- The loop body, from the invariant: one case per value of the exit test. -/
theorem loop_body {s₀ : Store H} {m : ModuleInst} {n₀ : BitVec 32} {k : Nat} {s : Store H}
    {f : Frame} {vs : List Val} (h : inv s₀ m n₀ k s f vs) :
    WP P host s f (vals vs ++ expression [.localGet ⟨0⟩, .intTestOp .i32 .eqz, .brIf ⟨1⟩, .localGet ⟨1⟩, .localGet ⟨0⟩, .intBinOp .i32 .add, .localSet ⟨1⟩, .localGet ⟨0⟩, .intConst .i32 1, .intBinOp .i32 .sub, .localSet ⟨0⟩, .br ⟨0⟩]) (loopQ (P := P) (host := host) s₀ m n₀ k) := by
  obtain ⟨rfl, rfl, n, acc, rfl, rfl, hi⟩ := h
  show WP P host s _ (vals [] ++ expression [.localGet ⟨0⟩, .intTestOp .i32 .eqz] ++ .plain (.brIf ⟨1⟩) ::
    expression [.localGet ⟨1⟩, .localGet ⟨0⟩, .intBinOp .i32 .add, .localSet ⟨1⟩, .localGet ⟨0⟩, .intConst .i32 1, .intBinOp .i32 .sub, .localSet ⟨0⟩, .br ⟨0⟩]) _
  wasm_step [Idx.toNat, Fin.val_zero, Fin.val_one, Fin.isValue, eqz32, eq32, ne32, ltS32, gtS32, leS32, geS32, ltU32, gtU32, leU32, geU32, shrS32, BitVec.toNat_ofNat, Nat.reduceMod, Nat.reducePow, Nat.reduceAdd, Nat.reduceLT, ↓reduceIte]
  refine wp_brIf_bool32 (vs := []) ?_
  by_cases hc : (n == (0 : BitVec 32)) = true
  · exact Eq.mpr (ite_eq_left_of_eq_true _ _ (eq_true hc)) (loop_exit hc hi)
  · exact Eq.mpr (ite_eq_right_of_eq_false _ _ (eq_false hc)) (loop_next hc hi)

