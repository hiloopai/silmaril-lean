  apply Elgot.Part.Runs.more (a' := ((1 : Nat), 27))
  · rw [thetaStep_run]; exact Part.mem_some _
  apply Elgot.Part.Runs.more (a' := ((2 : Nat), 277))
  · rw [thetaStep_run]; exact Part.mem_some _
  apply Elgot.Part.Runs.done
  rw [thetaStep_run]; exact Part.mem_some _

