/-- `elf.symbols.byName`. -/
theorem byName_ok : byName.sorted = true ∧ byName.Sound F :=
  by
  elf_leaf elf.symbols.byName
    (native := Native.byName_sound)
    (kernel := Kernel.byName_sound hello.wf hello.toByteArray_eq)

/-- `elf.symbols.byAddr`. -/
theorem byAddr_ok : byAddr.sorted = true ∧ byAddr.Sound F :=
  by
  elf_leaf elf.symbols.byAddr
    (native := Native.byAddr_sound)
    (kernel := Kernel.byAddr_sound hello.wf hello.toByteArray_eq)

/-- **`main` by name**: the forward index names entry 31, and it is `main`. -/
theorem main_entry : ∃ s, Symbols.SymAt F symtab 31 s ∧ s.name = nameOf "main" :=
  Symbols.ByName.find_sound byName_ok.2 (n := nameOf "main") (by decide)

/-- **Its extent**: the reverse map sends its first address back to entry 31. -/
theorem main_extent : ∃ s, Symbols.SymAt F symtab 31 s ∧ s.raw.value ≤ 4192 ∧ 4192 < s.raw.value + s.raw.size :=
  Symbols.ByAddr.find_sound byAddr_ok.2 (by decide)

/-- **Its code**: address 0x1060 is file offset 0x1060, the tiles cover its 27 bytes, and
each tile is one instruction of the local x86 model (`elf.tiles.x86`). -/
theorem main_code : L.offsetOf 4192 = some 4192 ∧ tilesCover ⟨4192, 27⟩ mainTiles = true ∧
    TilesAt F x86Ok 4192 mainTiles :=
  ⟨by decide, by decide, by
  elf_leaf elf.tiles.x86
    (native := Native.tilesX86_sound (c := (4192, mainTiles)))
    (kernel := Kernel.tilesX86_sound hello.wf hello.toByteArray_eq (c := (4192, mainTiles)))⟩

