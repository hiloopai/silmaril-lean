/-- **The stages assemble to the whole parse** (`parses_assemble`; no further kernel run). -/
theorem parses : Parses F (L.assemble bodies ld) :=
  parses_assemble layout
    (.cons body_0 (.cons body_1 (.cons body_2 (.cons body_3 (.cons body_4 (.cons body_5 (.cons body_6 (.cons body_7 (.cons body_8 (.cons body_9 (.cons body_10 (.cons body_11 (.cons body_12 (.cons body_13 (.cons body_14 (.cons body_15 (.cons body_16 (.cons body_17 (.cons body_18 (.cons body_19 (.cons body_20 (.cons body_21 (.cons body_22 (.cons body_23 (.cons body_24 (.cons body_25 (.cons body_26 (.cons body_27 (.cons body_28 (.cons body_29 (.cons body_30 .nil)))))))))))))))))))))))))))))))
    loader

/-- `elf.symbols.byName`. -/
theorem byName_ok : byName.sorted = true ∧ byName.Sound F :=
  Leaf.byName.of_kernel hc (c := byName) (by decide +kernel)

/-- `elf.symbols.byAddr`. -/
theorem byAddr_ok : byAddr.sorted = true ∧ byAddr.Sound F :=
  Leaf.byAddr.of_kernel hc (c := byAddr) (by decide +kernel)

/-- **`main` by name**: the forward index names entry 31, and it is `main`. -/
theorem main_entry : ∃ s, Symbols.SymAt F symtab 31 s ∧ s.name = nameOf "main" :=
  Symbols.ByName.find_sound byName_ok.2 (n := nameOf "main") (by decide)

/-- **Its extent**: the reverse map sends its first address back to entry 31. -/
theorem main_extent : ∃ s, Symbols.SymAt F symtab 31 s ∧ s.raw.value ≤ 4192 ∧ 4192 < s.raw.value + s.raw.size :=
  Symbols.ByAddr.find_sound byAddr_ok.2 (by decide)

/-- **Its code**: address 0x1060 is file offset 0x1060, the tiles cover its 27 bytes, and
each tile is one instruction of the local x86 model (`elf.tiles.x86`). -/
theorem main_code : L.offsetOf 4192 = some 4192 ∧ tilesCover ⟨4192, 27⟩ mainTiles = true ∧
    TilesAt F x86Ok 4192 mainTiles :=
  ⟨by decide, by decide, Leaf.tilesX86.of_kernel hc (c := (4192, mainTiles)) (by decide +kernel)⟩

