/-- The file. -/
noncomputable abbrev F : Silmaril.X86.Link.Blob := blobOf Silmaril.Elf.Link.Dyn.PinBytes.helloGcc

/-- Its 4 KiB pages. -/
noncomputable def pg := pagesFrom 4096 0 15960 (chunks_of% Silmaril.Elf.Link.Dyn.PinBytes.helloGcc)

theorem hc : ChunksOf F pg := Rows.pages_of_bytes rfl

/-- **Stage 1** (`elf.layout`). -/
