module

public import Silmaril.Elf.Asm.Defs

/-! # Display listings (`objdump -d`) of functions of `examples/elf-asm/reloc/scaled.o`

GENERATED by `scripts/elf-asm/listing.py` with `GNU objdump (GNU Binutils for Debian) 2.44`; do not edit.

Display data only: no proposition reads `Line.text` (`Silmaril.Elf.Asm`). The byte
ranges are objdump's instruction boundaries; `LinesTile` checks that they tile the bytes,
nothing checks that the text describes them. -/

@[expose] public section

namespace Silmaril.Elf.Asm.Example.Reloc

open Silmaril.Elf.Asm

/-- `scaled_plus_bias` (`0x0`, 20 bytes), as `objdump -d` prints it. -/
def scaledLines : List Line := [
  { off := 0, len := 4, text := "sub $0x8,%rsp", label := some "scaled_plus_bias" },
  { off := 4, len := 5, text := "call 9 <scaled_plus_bias+0x9>" },
  { off := 9, len := 6, text := "add 0x0(%rip),%eax # f <scaled_plus_bias+0xf>" },
  { off := 15, len := 4, text := "add $0x8,%rsp" },
  { off := 19, len := 1, text := "ret" }
]

end Silmaril.Elf.Asm.Example.Reloc
