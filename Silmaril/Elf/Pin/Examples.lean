module

public import Silmaril.Elf.Pin.Thms
public import Silmaril.Elf.Staged.Pinned.LeafArith.Bytes
public import Silmaril.Elf.Staged.Pinned.ZlibChecksums.Bytes
public import Silmaril.X86.Ladder.Pinned.LeafArith
public import Silmaril.X86.Ladder.Pinned.ZlibChecksums
public import Silmaril.Elf.Asm.Example.LeafArith.Defs

/-! # Two pins of one file are the same blob, by the kernel

The ladder executables are pinned twice: as `Blob` literals (`Silmaril.X86.Ladder.Pinned.*.exe`,
generated by `examples/elf-ladder/pin.sh`, which nothing else checks against the file) and as
`include_bytes` (`Silmaril.Elf.Staged.Pinned.*.F`, read from the file at elaboration, the file's
SHA-256 checked by `examples/elf/pin.sh --check`). These theorems prove them equal: a statement
about one is a statement about the other, and the literal is the committed file. Each is `unfold`
of `raw`, `blobOf_decode` and `decide +kernel` on the chunk literals (seconds). -/

@[expose] public section

namespace Silmaril.Elf.Pin.Examples

/-- `leaf-arith` (9632 bytes). -/
theorem leafArith_exe_eq :
    Silmaril.X86.Ladder.Pinned.LeafArith.exe = Silmaril.Elf.Staged.Pinned.LeafArith.F := by
  show _ = Silmaril.Elf.blobOf ⟨Silmaril.Elf.Staged.Pinned.LeafArith.raw⟩
  unfold Silmaril.Elf.Staged.Pinned.LeafArith.raw
  rw [blobOf_decode]
  decide +kernel

/-- `zlib-checksums` (12224 bytes). -/
theorem zlibChecksums_exe_eq :
    Silmaril.X86.Ladder.Pinned.ZlibChecksums.exe = Silmaril.Elf.Staged.Pinned.ZlibChecksums.F := by
  show _ = Silmaril.Elf.blobOf ⟨Silmaril.Elf.Staged.Pinned.ZlibChecksums.raw⟩
  unfold Silmaril.Elf.Staged.Pinned.ZlibChecksums.raw
  rw [blobOf_decode]
  decide +kernel

/-- **The assembly records' file is the conformance rows' file** (`Silmaril.Elf.Asm.Example.LeafArith.F`,
the file of the `clamp_i32`/`sat_add_u32` records, and `Silmaril.Elf.Staged.Pinned.LeafArith.F`, the
file of the rows `silmaril.elf.abi.leaf_arith.*`): `elf-asm` requires this theorem for the record
file's path and SHA-256, and a record-to-row link can require it for file identity. -/
theorem leafArith_record_file :
    Silmaril.Elf.Asm.Example.LeafArith.F = Silmaril.Elf.Staged.Pinned.LeafArith.F :=
  leafArith_exe_eq

/-- A different blob is refused: the file with its last byte changed is not the pin. -/
theorem leafArith_ne :
    (⟨Silmaril.X86.Ladder.Pinned.LeafArith.exe.n ^^^ (1 <<< (8 * 9631)), 9632⟩ : Silmaril.X86.Link.Blob) ≠
      Silmaril.Elf.Staged.Pinned.LeafArith.F := by
  show _ ≠ Silmaril.Elf.blobOf ⟨Silmaril.Elf.Staged.Pinned.LeafArith.raw⟩
  unfold Silmaril.Elf.Staged.Pinned.LeafArith.raw
  rw [blobOf_decode]
  decide +kernel

end Silmaril.Elf.Pin.Examples

end
