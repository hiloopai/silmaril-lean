module

public import Silmaril.Elf.Effects.Example.Sha256sum.Defs
public import Silmaril.X86.Flow.Thms

/-!
# GNU coreutils 9.4 `sha256sum` from `main`: call graph, imports and system calls

The certificate (`Defs`, generated by `tools/cfg-cert` from the Ubuntu 24.04 binary) covers
`main` (`0x2750`) and every internal function it reaches. Proved by `decide`:

* `check`: every CFG is closed and decodes (`Graph.sub`), every edge is in the graph;
* `closed`: `nodes` is closed under the edges, holds `main` and not `unresolved`;
* `direct`: no reachable node makes a direct system call (no `syscall`, `int 0x80`).

Then, over every admissible world, given the `CodeAt` rows of the blocks:

* `foreign`: `main` enters only the imports of `nodes` (`ForeignCalls`);
* `syscalls`: its system calls are within `S` for any import summaries `summ` that cover
  every reachable import within `S` (`syscallSet_of_imports`).
-/

@[expose] public section

namespace Silmaril.Elf.Effects.Example.Sha256sum

open Silmaril.X86.Flow (X64.dec UMach)
open Silmaril.Elf.Effects.Shapes
open Silmaril.Project (Value)
open Silmaril.Elf.Shapes (file)

theorem check : cert.check X64.dec [0x2750] = true := by decide +kernel
theorem closed : cert.graph.closedB nodes = true := by decide +kernel
theorem direct : nodes.all (directOk []) = true := by decide +kernel

/-- The certificate facts of `main`, given the `CodeAt` rows. -/
theorem main_ok {V : Type} (X : Value V)
    (hcode : ∀ f C, (f, C) ∈ cert.fns → ∀ b ∈ C.blocks,
      Silmaril.Elf.Link.ElfBind.CodeAt (file X) b.start b.bytes) :
    CertOk X64.dec X (.addr 0x2750) cert [] 0x2750 nodes :=
  ⟨Silmaril.X86.Flow.X64.stable, fun _ h => h, check, hcode, closed, by decide, by decide⟩

/-- **`main` enters only the imports of `nodes`.** -/
theorem foreign {σ V : Type} (J : UMach σ) (X : Value V)
    (hcode : ∀ f C, (f, C) ∈ cert.fns → ∀ b ∈ C.blocks,
      Silmaril.Elf.Link.ElfBind.CodeAt (file X) b.start b.bytes) :
    ForeignCalls J X64.dec X (.addr 0x2750) cert [] (importsOf nodes) :=
  foreignCalls_of_cert (main_ok X hcode)

/-- **The system calls of `main` are its imports' summaries.** -/
theorem syscalls {σ V : Type} (J : UMach σ) (X : Value V)
    (hcode : ∀ f C, (f, C) ∈ cert.fns → ∀ b ∈ C.blocks,
      Silmaril.Elf.Link.ElfBind.CodeAt (file X) b.start b.bytes)
    (summ : Silmaril.Elf.Effects.Summ) (S : List Nat)
    (himp : ∀ r ∈ importsOf nodes, ∃ ns, summ.lookup r = some ns ∧ ∀ n ∈ ns, n ∈ S) :
    SyscallSet J X64.dec X (.addr 0x2750) cert [] summ S :=
  syscallSet_of_imports (main_ok X hcode) (List.all_eq_true.2 fun n hn => by
    have := List.all_eq_true.1 direct n hn
    cases n <;> simp_all [directOk]) himp

end Silmaril.Elf.Effects.Example.Sha256sum
