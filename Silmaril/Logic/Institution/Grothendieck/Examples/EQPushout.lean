module

public import Silmaril.Logic.Institution.Examples.Equational
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Defs

@[expose] public section

/-!
# Pushouts of many-sorted equational signatures and amalgamation of algebras

* `EQ.pushout f₁ f₂` is the pushout of a span of many-sorted signatures: its sorts are the
  quotient of `S₁ ⊕ S₂` identifying `f₁ s` with `f₂ s`, and its operation symbols of each arity
  are the symbols of `Σ₁` and `Σ₂` landing in that arity, with `f₁ o` identified with `f₂ o`
  (`EQ.pushout_isPushout`).
* For an arbitrary pushout square of signatures, sorts and operation symbols of the pushout are
  jointly covered by the two injections (`EQ.sorts_cover`, `EQ.ops_cover`), dependent families
  over the sorts glue (`EQ.exists_glue`), and algebras agreeing on the common part amalgamate
  (`EQ.exists_amalgam`). The algebra amalgamation uses the pushout's universal property against
  a signature whose operation symbols are the operations on given carriers (`EQ.univSig`): an
  algebra is the same as a signature morphism into such a signature (`EQ.algOf`).

Source: `goguen-burstall-1992` in `references.bib`, Appendix A1,
Definitions 48–54 (signatures, morphisms, algebras and reducts).
-/

namespace Silmaril.Logic.Institution.Examples.EQ

open CategoryTheory Limits

/-! ### Extensionality -/

theorem Signature.Hom.ext' {Sg Sg' : Signature} {f g : Sg ⟶ Sg'} (hs : f.sorts = g.sorts)
    (ho : ∀ {n : ℕ} {w : Fin n → Sg.S} {s : Sg.S} (o : Sg.Op n w s), f.ops o ≍ g.ops o) :
    f = g := by
  obtain ⟨fs, fo⟩ := f
  obtain ⟨gs, go⟩ := g
  dsimp only at hs
  subst hs
  have : @fo = @go := by
    funext n w s o
    exact eq_of_heq (ho o)
  subst this
  rfl

theorem Signature.Hom.congr_ops {Sg Sg' : Signature} {f g : Sg ⟶ Sg'} (h : f = g) {n : ℕ}
    {w : Fin n → Sg.S} {s : Sg.S} (o : Sg.Op n w s) : f.ops o ≍ g.ops o := by
  subst h
  rfl

theorem Signature.Hom.congr_sorts {Sg Sg' : Signature} {f g : Sg ⟶ Sg'} (h : f = g) (s : Sg.S) :
    f.sorts s = g.sorts s := by
  subst h
  rfl

theorem Algebra.ext' {Sg : Signature} {A B : Algebra Sg} (hc : A.carrier = B.carrier)
    (ho : ∀ {n : ℕ} {w : Fin n → Sg.S} {s : Sg.S} (o : Sg.Op n w s), A.op o ≍ B.op o) :
    A = B := by
  obtain ⟨ac, ao⟩ := A
  obtain ⟨bc, bo⟩ := B
  dsimp only at hc
  subst hc
  have : @ao = @bo := by
    funext n w s o
    exact eq_of_heq (ho o)
  subst this
  rfl

theorem Algebra.congr_carrier {Sg : Signature} {A B : Algebra Sg} (h : A = B) (s : Sg.S) :
    A.carrier s = B.carrier s := by
  subst h
  rfl

theorem Algebra.congr_op {Sg : Signature} {A B : Algebra Sg} (h : A = B) {n : ℕ}
    {w : Fin n → Sg.S} {s : Sg.S} (o : Sg.Op n w s) : A.op o ≍ B.op o := by
  subst h
  rfl

theorem Algebra.Hom.ext' {Sg : Signature} {A B : Algebra Sg} {u v : A ⟶ B}
    (h : ∀ s x, u.map s x = v.map s x) : u = v := by
  obtain ⟨um, _⟩ := u
  obtain ⟨vm, _⟩ := v
  have : um = vm := funext fun s => funext (h s)
  subst this
  rfl

theorem Algebra.Hom.map_heq {Sg : Signature} {A A' B B' : Algebra Sg} (hA : A = A') (hB : B = B')
    {u : A ⟶ B} {u' : A' ⟶ B'} (h : u ≍ u') (s : Sg.S) : u.map s ≍ u'.map s := by
  subst hA hB
  obtain rfl := eq_of_heq h
  rfl

/-! ### Auxiliary signatures -/

/-- The signature with sorts `X` and exactly one operation symbol of every arity. -/
def unitSig (X : Type) : Signature := ⟨X, fun _ _ _ => PUnit⟩

/-- The signature morphism into `unitSig X` with sort map `φ`. -/
def toUnitSig {Sg : Signature} {X : Type} (φ : Sg.S → X) : Sg ⟶ unitSig X :=
  ⟨φ, fun _ => PUnit.unit⟩

/-- The signature with sorts `X` whose operation symbols of each arity are propositions. -/
def propSig (X : Type) : Signature := ⟨X, fun _ _ _ => Prop⟩

/-- The signature with sorts `X` whose operation symbols of arity `w → s` are the functions
`(∀ j, El (w j)) → El s`. -/
def univSig (X : Type) (El : X → Type) : Signature :=
  ⟨X, fun _ w s => (∀ j, El (w j)) → El s⟩

/-- An algebra from a signature morphism into `univSig`. -/
def algOf {Sg : Signature} {X : Type} {El : X → Type} (φ : Sg ⟶ univSig X El) : Algebra Sg :=
  ⟨fun s => El (φ.sorts s), fun o => φ.ops o⟩

theorem reduct_algOf {Sg Sg' : Signature} {X : Type} {El : X → Type} (g : Sg ⟶ Sg')
    (φ : Sg' ⟶ univSig X El) : (Algebra.reduct g).obj (algOf φ) = algOf (g ≫ φ) :=
  rfl

/-- The relation on `S₁ ⊕ S₂` generated by a span of signatures. -/
inductive SortRel {S S₁ S₂ : Signature} (f₁ : S ⟶ S₁) (f₂ : S ⟶ S₂) :
    S₁.S ⊕ S₂.S → S₁.S ⊕ S₂.S → Prop
  | glue (s : S.S) : SortRel f₁ f₂ (.inl (f₁.sorts s)) (.inr (f₂.sorts s))

/-! ### Joint coverage and gluing for an arbitrary pushout square -/

section Square

variable {S S₁ S₂ S' : Signature} {f₁ : S ⟶ S₁} {f₂ : S ⟶ S₂} {g₁ : S₁ ⟶ S'} {g₂ : S₂ ⟶ S'}

/-- Sort maps out of a pushout are determined by their restrictions. -/
theorem sorts_ext (h : IsPushout f₁ f₂ g₁ g₂) {X : Type} {φ ψ : S'.S → X}
    (h₁ : ∀ s, φ (g₁.sorts s) = ψ (g₁.sorts s)) (h₂ : ∀ s, φ (g₂.sorts s) = ψ (g₂.sorts s)) :
    φ = ψ := by
  have := h.hom_ext (k := toUnitSig φ) (l := toUnitSig ψ)
    (Signature.Hom.ext' (funext h₁) fun _ => HEq.rfl)
    (Signature.Hom.ext' (funext h₂) fun _ => HEq.rfl)
  exact congrArg Signature.Hom.sorts this

/-- The sorts of a pushout are covered by the two injections. -/
theorem sorts_cover (h : IsPushout f₁ f₂ g₁ g₂) (s : S'.S) :
    (∃ s₁, g₁.sorts s₁ = s) ∨ ∃ s₂, g₂.sorts s₂ = s := by
  have := sorts_ext h (φ := fun s => (∃ s₁, g₁.sorts s₁ = s) ∨ ∃ s₂, g₂.sorts s₂ = s)
    (ψ := fun _ => True) (fun s => eq_true (Or.inl ⟨s, rfl⟩))
    (fun s => eq_true (Or.inr ⟨s, rfl⟩))
  exact of_eq_true (congrFun this s)

/-- An operation symbol of `Sg'` comes from `Sg₁` along `g`. -/
def OpFrom {Sg₁ Sg' : Signature} (g : Sg₁ ⟶ Sg') {n : ℕ} {w : Fin n → Sg'.S} {s : Sg'.S}
    (o : Sg'.Op n w s) : Prop :=
  ∃ (w₁ : Fin n → Sg₁.S) (s₁ : Sg₁.S) (o₁ : Sg₁.Op n w₁ s₁),
    g.sorts ∘ w₁ = w ∧ g.sorts s₁ = s ∧ o ≍ g.ops o₁

theorem opFrom_ops {Sg₁ Sg' : Signature} (g : Sg₁ ⟶ Sg') {n : ℕ} {w : Fin n → Sg₁.S}
    {s : Sg₁.S} (o : Sg₁.Op n w s) : OpFrom g (g.ops o) :=
  ⟨w, s, o, rfl, rfl, HEq.rfl⟩

/-- The operation symbols of a pushout are covered by the two injections. -/
theorem ops_cover (h : IsPushout f₁ f₂ g₁ g₂) {n : ℕ} {w : Fin n → S'.S} {s : S'.S}
    (o : S'.Op n w s) : OpFrom g₁ o ∨ OpFrom g₂ o := by
  let φ : S' ⟶ propSig S'.S := ⟨id, fun o => OpFrom g₁ o ∨ OpFrom g₂ o⟩
  let ψ : S' ⟶ propSig S'.S := ⟨id, fun _ => True⟩
  have hφψ : φ = ψ := h.hom_ext
    (Signature.Hom.ext' rfl fun o => heq_of_eq (eq_true (Or.inl (opFrom_ops g₁ o))))
    (Signature.Hom.ext' rfl fun o => heq_of_eq (eq_true (Or.inr (opFrom_ops g₂ o))))
  exact of_eq_true (eq_of_heq (Signature.Hom.congr_ops hφψ o))

theorem cast_snd_eq {X : Type} {Y : X → Type} {x : Σ s, Y s} {s : X} (e : x.1 = s) {y : Y s}
    (hx : x = ⟨s, y⟩) : cast (congrArg Y e) x.2 = y := by
  subst hx
  rfl

/-- Dependent families over the sorts of a pushout glue. -/
theorem exists_glue (h : IsPushout f₁ f₂ g₁ g₂) (Y : S'.S → Type) (a₁ : ∀ s, Y (g₁.sorts s))
    (a₂ : ∀ s, Y (g₂.sorts s)) (ha : ∀ s, a₁ (f₁.sorts s) ≍ a₂ (f₂.sorts s)) :
    ∃ a : ∀ s, Y s, (∀ s, a (g₁.sorts s) = a₁ s) ∧ ∀ s, a (g₂.sorts s) = a₂ s := by
  let k₁ : S₁ ⟶ unitSig (Σ s, Y s) := ⟨fun s => ⟨g₁.sorts s, a₁ s⟩, fun _ => PUnit.unit⟩
  let k₂ : S₂ ⟶ unitSig (Σ s, Y s) := ⟨fun s => ⟨g₂.sorts s, a₂ s⟩, fun _ => PUnit.unit⟩
  have hk : f₁ ≫ k₁ = f₂ ≫ k₂ := Signature.Hom.ext'
    (funext fun s => Sigma.ext (Signature.Hom.congr_sorts h.w s) (ha s)) fun _ => HEq.rfl
  let d := h.desc k₁ k₂ hk
  have hd₁ : ∀ s, d.sorts (g₁.sorts s) = ⟨g₁.sorts s, a₁ s⟩ := fun s =>
    Signature.Hom.congr_sorts (h.inl_desc k₁ k₂ hk) s
  have hd₂ : ∀ s, d.sorts (g₂.sorts s) = ⟨g₂.sorts s, a₂ s⟩ := fun s =>
    Signature.Hom.congr_sorts (h.inr_desc k₁ k₂ hk) s
  have hfst : (fun s => (d.sorts s).1) = id := sorts_ext h
    (fun s => by simp only [hd₁, id]) (fun s => by simp only [hd₂, id])
  refine ⟨fun s => cast (congrArg Y (congrFun hfst s)) (d.sorts s).2, fun s => ?_, fun s => ?_⟩
  · exact cast_snd_eq (congrFun hfst (g₁.sorts s)) (hd₁ s)
  · exact cast_snd_eq (congrFun hfst (g₂.sorts s)) (hd₂ s)

/-- Algebras over a pushout are determined by their reducts. -/
theorem algebra_ext (h : IsPushout f₁ f₂ g₁ g₂) {A B : Algebra S'}
    (h₁ : (Algebra.reduct g₁).obj A = (Algebra.reduct g₁).obj B)
    (h₂ : (Algebra.reduct g₂).obj A = (Algebra.reduct g₂).obj B) : A = B := by
  refine Algebra.ext' (funext fun s => ?_) fun {n w s} o => ?_
  · rcases sorts_cover h s with ⟨s, rfl⟩ | ⟨s, rfl⟩
    · exact Algebra.congr_carrier h₁ s
    · exact Algebra.congr_carrier h₂ s
  · rcases ops_cover h o with ⟨w₁, s₁, o₁, rfl, rfl, ho⟩ | ⟨w₁, s₁, o₁, rfl, rfl, ho⟩
    · obtain rfl := eq_of_heq ho
      exact Algebra.congr_op h₁ o₁
    · obtain rfl := eq_of_heq ho
      exact Algebra.congr_op h₂ o₁

/-- Algebras agreeing on the common part amalgamate over a pushout. -/
theorem exists_amalgam (h : IsPushout f₁ f₂ g₁ g₂) (M₁ : Algebra S₁) (M₂ : Algebra S₂)
    (hM : (Algebra.reduct f₁).obj M₁ = (Algebra.reduct f₂).obj M₂) :
    ∃ M : Algebra S', (Algebra.reduct g₁).obj M = M₁ ∧ (Algebra.reduct g₂).obj M = M₂ := by
  let El : Quot (SortRel f₁ f₂) → Type := Quot.lift (Sum.elim M₁.carrier M₂.carrier) (by
    rintro _ _ ⟨s⟩
    exact Algebra.congr_carrier hM s)
  let k₁ : S₁ ⟶ univSig _ El := ⟨fun s => Quot.mk _ (.inl s), fun o => M₁.op o⟩
  let k₂ : S₂ ⟶ univSig _ El := ⟨fun s => Quot.mk _ (.inr s), fun o => M₂.op o⟩
  have hk : f₁ ≫ k₁ = f₂ ≫ k₂ :=
    Signature.Hom.ext' (funext fun s => Quot.sound (.glue s)) fun o => Algebra.congr_op hM o
  refine ⟨algOf (h.desc k₁ k₂ hk), ?_, ?_⟩
  · rw [reduct_algOf, h.inl_desc]
    rfl
  · rw [reduct_algOf, h.inr_desc]
    rfl

end Square

/-! ### The pushout of a span of signatures -/

section Pushout

variable {S S₁ S₂ : Signature} (f₁ : S ⟶ S₁) (f₂ : S ⟶ S₂)

/-- The sorts of the pushout. -/
def PushoutSorts : Type := Quot (SortRel f₁ f₂)

/-- The left injection of sorts. -/
def inlS (s : S₁.S) : PushoutSorts f₁ f₂ := Quot.mk _ (.inl s)

/-- The right injection of sorts. -/
def inrS (s : S₂.S) : PushoutSorts f₁ f₂ := Quot.mk _ (.inr s)

/-- Operation symbols of `Σ₁` and `Σ₂`, at their arity in the pushout. -/
inductive PreOp : (n : ℕ) → (Fin n → PushoutSorts f₁ f₂) → PushoutSorts f₁ f₂ → Type
  | inl {n : ℕ} {w : Fin n → S₁.S} {s : S₁.S} (o : S₁.Op n w s) :
      PreOp n (fun j => inlS f₁ f₂ (w j)) (inlS f₁ f₂ s)
  | inr {n : ℕ} {w : Fin n → S₂.S} {s : S₂.S} (o : S₂.Op n w s) :
      PreOp n (fun j => inrS f₁ f₂ (w j)) (inrS f₁ f₂ s)

/-- The identification of `f₁ o` with `f₂ o`. -/
def OpRel {n : ℕ} {w : Fin n → PushoutSorts f₁ f₂} {s : PushoutSorts f₁ f₂}
    (a b : PreOp f₁ f₂ n w s) : Prop :=
  ∃ (w₀ : Fin n → S.S) (s₀ : S.S) (o : S.Op n w₀ s₀),
    (fun j => inlS f₁ f₂ (f₁.sorts (w₀ j))) = w ∧ inlS f₁ f₂ (f₁.sorts s₀) = s ∧
      a ≍ PreOp.inl (f₁ := f₁) (f₂ := f₂) (f₁.ops o) ∧
      b ≍ PreOp.inr (f₁ := f₁) (f₂ := f₂) (f₂.ops o)

/-- The pushout signature.

Source: `goguen-burstall-1992` in `references.bib`, Appendix A1,
Definitions 48–50 (the category of signatures, whose pushouts are computed on sorts and on
operation symbols). -/
def pushout : Signature := ⟨PushoutSorts f₁ f₂, fun n w s => Quot (OpRel f₁ f₂ (n := n) (w := w) (s := s))⟩

/-- The left injection. -/
def pushoutInl : S₁ ⟶ pushout f₁ f₂ := ⟨inlS f₁ f₂, fun o => Quot.mk _ (PreOp.inl o)⟩

/-- The right injection. -/
def pushoutInr : S₂ ⟶ pushout f₁ f₂ := ⟨inrS f₁ f₂, fun o => Quot.mk _ (PreOp.inr o)⟩

theorem inlS_f₁ (s : S.S) : inlS f₁ f₂ (f₁.sorts s) = inrS f₁ f₂ (f₂.sorts s) :=
  Quot.sound (.glue s)

theorem pushout_w : f₁ ≫ pushoutInl f₁ f₂ = f₂ ≫ pushoutInr f₁ f₂ := by
  refine Signature.Hom.ext' (funext (inlS_f₁ f₁ f₂)) fun {n w₀ s₀} o => ?_
  have hw : (fun j => inlS f₁ f₂ (f₁.sorts (w₀ j))) = fun j => inrS f₁ f₂ (f₂.sorts (w₀ j)) :=
    funext fun j => inlS_f₁ f₁ f₂ (w₀ j)
  have key : ∀ {w w' : Fin n → PushoutSorts f₁ f₂} {s s' : PushoutSorts f₁ f₂} (hw : w = w')
      (hs : s = s') (a : PreOp f₁ f₂ n w s) (b : PreOp f₁ f₂ n w' s'),
      (∀ a' : PreOp f₁ f₂ n w' s', a' ≍ a → OpRel f₁ f₂ a' b) →
        (Quot.mk _ a : (pushout f₁ f₂).Op n w s) ≍ (Quot.mk _ b : (pushout f₁ f₂).Op n w' s') := by
    intro w w' s s' hw hs a b hab
    subst hw hs
    exact heq_of_eq (Quot.sound (hab a HEq.rfl))
  exact key hw (inlS_f₁ f₁ f₂ s₀) _ _ fun a' ha' =>
    ⟨w₀, s₀, o, hw, inlS_f₁ f₁ f₂ s₀, ha', HEq.rfl⟩

variable {f₁ f₂} {T : Signature} (k₁ : S₁ ⟶ T) (k₂ : S₂ ⟶ T) (hk : f₁ ≫ k₁ = f₂ ≫ k₂)

/-- The induced map on sorts. -/
def descS : PushoutSorts f₁ f₂ → T.S :=
  Quot.lift (Sum.elim k₁.sorts k₂.sorts) (by
    rintro _ _ ⟨s⟩
    exact Signature.Hom.congr_sorts hk s)

/-- The induced map on pre-operation symbols. -/
def descPre : {n : ℕ} → {w : Fin n → PushoutSorts f₁ f₂} → {s : PushoutSorts f₁ f₂} →
    PreOp f₁ f₂ n w s → T.Op n (descS k₁ k₂ hk ∘ w) (descS k₁ k₂ hk s)
  | _, _, _, .inl o => k₁.ops o
  | _, _, _, .inr o => k₂.ops o

theorem descPre_heq {n : ℕ} {w w' : Fin n → PushoutSorts f₁ f₂} {s s' : PushoutSorts f₁ f₂}
    (hw : w = w') (hs : s = s') (a : PreOp f₁ f₂ n w s) (b : PreOp f₁ f₂ n w' s') (h : a ≍ b) :
    descPre k₁ k₂ hk a ≍ descPre k₁ k₂ hk b := by
  subst hw hs
  obtain rfl := eq_of_heq h
  rfl

/-- The induced map on operation symbols. -/
def descOps {n : ℕ} {w : Fin n → PushoutSorts f₁ f₂} {s : PushoutSorts f₁ f₂} :
    (pushout f₁ f₂).Op n w s → T.Op n (descS k₁ k₂ hk ∘ w) (descS k₁ k₂ hk s) :=
  Quot.lift (descPre k₁ k₂ hk) (by
    rintro a b ⟨w₀, s₀, o, rfl, rfl, ha, hb⟩
    obtain rfl := eq_of_heq ha
    refine eq_of_heq ((Signature.Hom.congr_ops hk o).trans ?_)
    exact descPre_heq k₁ k₂ hk (funext fun j => (inlS_f₁ f₁ f₂ (w₀ j)).symm)
      (inlS_f₁ f₁ f₂ s₀).symm _ _ hb.symm)

/-- The induced map out of the pushout. -/
def pushoutDesc : pushout f₁ f₂ ⟶ T := ⟨descS k₁ k₂ hk, fun o => descOps k₁ k₂ hk o⟩

theorem pushoutInl_desc : pushoutInl f₁ f₂ ≫ pushoutDesc k₁ k₂ hk = k₁ :=
  Signature.Hom.ext' rfl fun _ => HEq.rfl

theorem pushoutInr_desc : pushoutInr f₁ f₂ ≫ pushoutDesc k₁ k₂ hk = k₂ :=
  Signature.Hom.ext' rfl fun _ => HEq.rfl

theorem pushout_hom_ext {m m' : pushout f₁ f₂ ⟶ T}
    (h₁ : pushoutInl f₁ f₂ ≫ m = pushoutInl f₁ f₂ ≫ m')
    (h₂ : pushoutInr f₁ f₂ ≫ m = pushoutInr f₁ f₂ ≫ m') : m = m' := by
  refine Signature.Hom.ext' (funext fun x => ?_) fun {n w s} o => ?_
  · induction x using Quot.ind with
    | mk x =>
      rcases x with s | s
      · exact Signature.Hom.congr_sorts h₁ s
      · exact Signature.Hom.congr_sorts h₂ s
  · induction o using Quot.ind with
    | mk a =>
      cases a with
      | inl o => exact Signature.Hom.congr_ops h₁ o
      | inr o => exact Signature.Hom.congr_ops h₂ o

variable (f₁ f₂) in
/-- The pushout of a span of equational signatures.

Source: `goguen-burstall-1992` in `references.bib`, Appendix A1,
Definition 50 (the category of signatures). -/
theorem pushout_isPushout : IsPushout f₁ f₂ (pushoutInl f₁ f₂) (pushoutInr f₁ f₂) :=
  IsPushout.of_isColimit' ⟨pushout_w f₁ f₂⟩ (PushoutCocone.IsColimit.mk (pushout_w f₁ f₂)
    (fun c => pushoutDesc c.inl c.inr c.condition)
    (fun c => pushoutInl_desc c.inl c.inr c.condition)
    (fun c => pushoutInr_desc c.inl c.inr c.condition)
    fun c _ h₁ h₂ => pushout_hom_ext
      (h₁.trans (pushoutInl_desc c.inl c.inr c.condition).symm)
      (h₂.trans (pushoutInr_desc c.inl c.inr c.condition).symm))

end Pushout

end Silmaril.Logic.Institution.Examples.EQ
