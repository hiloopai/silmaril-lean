module

public import Silmaril.Logic.Metamath.Theory.Cut
public import Mathlib.Order.Closure
public import Mathlib.Order.Antisymmetrization

@[expose] public section

/-!
# Theories and the lattice of axiom sets

Axiom sets and theories consist of well-formed assertions. The consequences of a set of axioms
are the well-formed assertions derivable from it. Taking theorems
is a closure operator: it is extensive because a well-formed axiom derives
itself, and idempotent by cut admissibility. Theories are its closed sets and
form a complete lattice: meets are intersections, joins are theorems of
unions.

Axiom sets are preordered by derivability: `Γ ≤ Δ` when every axiom of `Γ`
is a theorem of `Δ`. Two axiom sets are equivalent exactly when they have the
same theorems, and `antisymmetrizationIso` identifies the resulting partial
order with the lattice of theories.

Idempotence and transitivity use cut admissibility, so they assume an
infinite type of variables.
-/

namespace Silmaril.Logic.Metamath

universe u

variable {C V : Type u}

/-- A well-formed assertion. -/
abbrev WFAssertion (C V : Type u) := {A : Assertion C V // A.WellFormed}

namespace WFAssertion

/-- The underlying assertions of a set of well-formed assertions. -/
def toSet (Γ : Set (WFAssertion C V)) : Set (Assertion C V) := Subtype.val '' Γ

theorem mem_toSet_of_mem {Γ : Set (WFAssertion C V)} {A : WFAssertion C V} (h : A ∈ Γ) :
    A.val ∈ toSet Γ := ⟨A, h, rfl⟩

theorem toSet_mono {Γ Δ : Set (WFAssertion C V)} (h : Γ ⊆ Δ) : toSet Γ ⊆ toSet Δ :=
  Set.image_mono h

theorem toSet_union (Γ Δ : Set (WFAssertion C V)) : toSet (Γ ∪ Δ) = toSet Γ ∪ toSet Δ :=
  Set.image_union _ _ _

/-- The well-formed theorems of an axiom set. -/
def theorems (Γ : Set (WFAssertion C V)) : Set (WFAssertion C V) :=
  {A | Derivable (toSet Γ) A.val}

@[simp] theorem mem_theorems {Γ : Set (WFAssertion C V)} {A : WFAssertion C V} :
    A ∈ theorems Γ ↔ Derivable (toSet Γ) A.val := Iff.rfl

theorem subset_theorems (Γ : Set (WFAssertion C V)) : Γ ⊆ theorems Γ :=
  fun A hA => Derivable.of_mem (mem_toSet_of_mem hA) A.2

theorem theorems_mono : Monotone (theorems : Set (WFAssertion C V) → Set (WFAssertion C V)) :=
  fun _ _ h _ hA => Derivable.mono (toSet_mono h) hA

/-- Everything derivable from the theorems of `Γ` is derivable from `Γ`. -/
theorem derivable_of_derivable_theorems [Infinite V] {Γ : Set (WFAssertion C V)}
    {A : Assertion C V} (h : Derivable (toSet (theorems Γ)) A) : Derivable (toSet Γ) A :=
  Derivable.trans (fun _ hB' => by obtain ⟨B, hB, rfl⟩ := hB'; exact hB) h

theorem theorems_theorems [Infinite V] (Γ : Set (WFAssertion C V)) :
    theorems (theorems Γ) = theorems Γ :=
  le_antisymm (fun _ hA => derivable_of_derivable_theorems hA) (subset_theorems _)

/-- `Γ` derives the axioms of `Δ` exactly when it derives all theorems of `Δ`,
well-formed or not. -/
theorem subset_theorems_iff [Infinite V] {Γ Δ : Set (WFAssertion C V)} :
    Γ ⊆ theorems Δ ↔ ∀ A, Derivable (toSet Γ) A → Derivable (toSet Δ) A := by
  constructor
  · intro h A hA
    exact Derivable.trans (fun _ hB' => by obtain ⟨B, hB, rfl⟩ := hB'; exact h hB) hA
  · exact fun h A hA => h _ (subset_theorems Γ hA)

end WFAssertion

open WFAssertion

/-- Derivable closure on sets of well-formed assertions. -/
def theoryClosure [Infinite V] : ClosureOperator (Set (WFAssertion C V)) :=
  ClosureOperator.mk' theorems theorems_mono subset_theorems fun Γ => (theorems_theorems Γ).le

@[simp] theorem theoryClosure_apply [Infinite V] (Γ : Set (WFAssertion C V)) :
    theoryClosure Γ = theorems Γ := rfl

/-- A theory: a set of well-formed assertions containing all its well-formed
theorems. -/
abbrev Theory (C V : Type u) [Infinite V] := (theoryClosure (C := C) (V := V)).Closeds

namespace Theory

variable [Infinite V]

/-- Theories form a complete lattice, with meets given by intersection. -/
instance : CompleteLattice (Theory C V) := theoryClosure.gi.liftCompleteLattice

/-- The theory generated by an axiom set. -/
def of (Γ : Set (WFAssertion C V)) : Theory C V := theoryClosure.toCloseds Γ

@[simp] theorem val_of (Γ : Set (WFAssertion C V)) : (of Γ).val = theorems Γ := rfl

theorem mem_of {Γ : Set (WFAssertion C V)} {A : WFAssertion C V} :
    A ∈ (of Γ).val ↔ Derivable (toSet Γ) A.val := Iff.rfl

theorem le_iff {T T' : Theory C V} : T ≤ T' ↔ T.val ⊆ T'.val := Iff.rfl

theorem theorems_eq (T : Theory C V) : theorems T.val = T.val := T.2.closure_eq

/-- A well-formed assertion derivable from a theory belongs to it. -/
theorem mem_iff_derivable (T : Theory C V) {A : WFAssertion C V} :
    A ∈ T.val ↔ Derivable (toSet T.val) A.val := by
  have h := T.theorems_eq
  constructor
  · intro hA
    rw [← h] at hA
    exact hA
  · intro hA
    exact h ▸ (hA : A ∈ theorems T.val)

@[simp] theorem of_val (T : Theory C V) : of T.val = T := Subtype.ext T.theorems_eq

theorem of_le_iff {Γ : Set (WFAssertion C V)} {T : Theory C V} : of Γ ≤ T ↔ Γ ⊆ T.val :=
  theoryClosure.gi.gc Γ T

theorem of_mono {Γ Δ : Set (WFAssertion C V)} (h : Γ ⊆ Δ) : of Γ ≤ of Δ :=
  theoryClosure.gi.gc.monotone_l h

@[simp] theorem val_inf (T T' : Theory C V) : (T ⊓ T').val = T.val ∩ T'.val := rfl

@[simp] theorem val_sInf (s : Set (Theory C V)) : (sInf s).val = ⋂ T ∈ s, T.val := by
  change sInf (Subtype.val '' s) = _
  rw [sInf_image]
  rfl

theorem sup_eq (T T' : Theory C V) : T ⊔ T' = of (T.val ∪ T'.val) := rfl

theorem sSup_eq (s : Set (Theory C V)) : sSup s = of (⋃ T ∈ s, T.val) := by
  change of (sSup (Subtype.val '' s)) = _
  rw [sSup_image]
  rfl

/-- The theory of a union is the join of the theories. -/
theorem of_union (Γ Δ : Set (WFAssertion C V)) : of (Γ ∪ Δ) = of Γ ⊔ of Δ :=
  theoryClosure.gi.gc.l_sup

/-- The theory of an indexed union is the join of the theories. -/
theorem of_iUnion {ι : Sort*} (Γ : ι → Set (WFAssertion C V)) :
    of (⋃ i, Γ i) = ⨆ i, of (Γ i) :=
  theoryClosure.gi.gc.l_iSup

/-- The least theory is generated by the empty axiom set. -/
theorem of_empty : of (∅ : Set (WFAssertion C V)) = ⊥ :=
  theoryClosure.gi.gc.l_bot

@[simp] theorem val_top : (⊤ : Theory C V).val = Set.univ := by
  apply Set.eq_univ_of_univ_subset
  exact le_top (a := (of Set.univ : Theory C V)) |> fun h =>
    (subset_theorems _).trans (le_iff.1 h)

end Theory

/-- Axiom sets of well-formed assertions, preordered by derivability. -/
def AxiomSet (C V : Type u) := Set (WFAssertion C V)

namespace AxiomSet

/-- Regard a set of well-formed assertions as an axiom set. -/
def of (Γ : Set (WFAssertion C V)) : AxiomSet C V := Γ

/-- The axioms of an axiom set. -/
def axioms (Γ : AxiomSet C V) : Set (WFAssertion C V) := Γ

@[simp] theorem axioms_of (Γ : Set (WFAssertion C V)) : (of Γ).axioms = Γ := rfl

@[simp] theorem of_axioms (Γ : AxiomSet C V) : of Γ.axioms = Γ := rfl

variable [Infinite V]

/-- `Γ ≤ Δ` when every axiom of `Γ` is derivable from `Δ`. -/
instance : Preorder (AxiomSet C V) where
  le Γ Δ := Γ.axioms ⊆ theorems Δ.axioms
  le_refl Γ := subset_theorems Γ.axioms
  le_trans _ _ _ h₁ h₂ A hA := subset_theorems_iff.1 h₂ _ (h₁ hA)

theorem le_def {Γ Δ : AxiomSet C V} : Γ ≤ Δ ↔ Γ.axioms ⊆ theorems Δ.axioms := Iff.rfl

theorem le_of_subset {Γ Δ : AxiomSet C V} (h : Γ.axioms ⊆ Δ.axioms) : Γ ≤ Δ :=
  h.trans (subset_theorems _)

/-- `Γ ≤ Δ` exactly when `Δ` derives every theorem of `Γ`. -/
theorem le_iff_derivable {Γ Δ : AxiomSet C V} :
    Γ ≤ Δ ↔ ∀ A, Derivable (toSet Γ.axioms) A → Derivable (toSet Δ.axioms) A :=
  subset_theorems_iff

/-- `Γ ≤ Δ` exactly when the theory of `Γ` is contained in that of `Δ`. -/
theorem le_iff_theory {Γ Δ : AxiomSet C V} : Γ ≤ Δ ↔ Theory.of Γ.axioms ≤ Theory.of Δ.axioms :=
  (Theory.of_le_iff (T := Theory.of Δ.axioms)).symm

theorem antisymmRel_iff {Γ Δ : AxiomSet C V} :
    AntisymmRel (· ≤ ·) Γ Δ ↔ Theory.of Γ.axioms = Theory.of Δ.axioms := by
  rw [AntisymmRel, le_iff_theory, le_iff_theory]
  exact le_antisymm_iff.symm

/-- Axiom sets modulo equivalence are the theories. -/
def antisymmetrizationIso : Antisymmetrization (AxiomSet C V) (· ≤ ·) ≃o Theory C V where
  toFun := Quotient.lift (fun Γ : AxiomSet C V => Theory.of Γ.axioms)
    fun _ _ h => antisymmRel_iff.1 h
  invFun T := toAntisymmetrization (· ≤ ·) (of T.val)
  left_inv q := by
    induction q using Quotient.inductionOn with
    | h Γ =>
      refine Quotient.sound (antisymmRel_iff.2 ?_)
      exact Theory.of_val (Theory.of Γ.axioms)
  right_inv T := Theory.of_val T
  map_rel_iff' {a b} := by
    induction a using Quotient.inductionOn with
    | h Γ =>
      induction b using Quotient.inductionOn with
      | h Δ => exact le_iff_theory.symm

@[simp] theorem antisymmetrizationIso_apply (Γ : AxiomSet C V) :
    antisymmetrizationIso (toAntisymmetrization (· ≤ ·) Γ) = Theory.of Γ.axioms := rfl

@[simp] theorem antisymmetrizationIso_symm_apply (T : Theory C V) :
    antisymmetrizationIso.symm T = toAntisymmetrization (· ≤ ·) (of T.val) := rfl

end AxiomSet

end Silmaril.Logic.Metamath
