module

public import Silmaril.Logic.Metamath.Syntax
public import Cslib.Foundations.Logic.InferenceSystem

@[expose] public section

/-!
# Metamath derivations

A derivation inside the frame of an assertion `A` is a tree. Its leaves are
hypotheses of `A`. Each inner node applies an assertion `B` of the axiom set
`Γ` under a substitution `σ`: its children derive every substituted hypothesis
of `B` (floating ones included, so they are the syntax proofs of the
substituted strings), and `σ` respects `B`'s disjoint-variable conditions
relative to `A`. This is the proof semantics of the Metamath specification,
following Carneiro, *Models for Metamath* (2016), §2.

A proof may use dummy variables, which do not occur in the assertion. Each
dummy has exactly one floating hypothesis, as the specification requires. The
dummy floating hypotheses and any disjointness conditions mentioning a dummy
are part of the proof, not the assertion (the specification's optional
hypotheses and optional `$d` statements). We allow any fresh variable at any
typecode. This is Carneiro's "unbounded supply of variables" reading; a
database accepted by the checker uses only declared variables and is a special
case.

Derivations form a CSLib `InferenceSystem` on assertions. `Derivable Γ A` is
its derivability predicate.
-/

namespace Silmaril.Logic.Metamath

open Cslib.Logic

universe u

variable {C V : Type u}

/-- A derivation of `e` from the hypotheses of `A` using the assertions of `Γ`. -/
inductive Derivation (Γ : Set (Assertion C V)) (A : Assertion C V) : Expr C V → Type u
  | hyp {e : Expr C V} (h : e ∈ A.hypExprs) : Derivation Γ A e
  | app (B : Assertion C V) (hB : B ∈ Γ) (σ : Subst C V)
      (premises : ∀ e ∈ B.hypExprs, Derivation Γ A (e.subst σ))
      (dv : B.DVSafe σ A.Disjoint) : Derivation Γ A (B.concl.subst σ)

namespace Assertion

/-- Every variable mentioned by the assertion, including unused floating ones. -/
def allVars (A : Assertion C V) : List V :=
  A.concl.vars ++ A.hyps.flatMap Hyp.vars

end Assertion

/-- The dummy variables of a proof of `A`: fresh floating hypotheses, one per
dummy variable, and extra disjointness conditions, each of which mentions a
dummy. -/
structure Dummies (A : Assertion C V) where
  floats : List (C × V)
  dv : List (V × V)
  fresh : ∀ p ∈ floats, p.2 ∉ A.allVars
  nodup : (floats.map Prod.snd).Nodup
  dv_dummy : ∀ p ∈ dv, p.1 ∈ floats.map Prod.snd ∨ p.2 ∈ floats.map Prod.snd

namespace Dummies

/-- No dummy variables. -/
def none (A : Assertion C V) : Dummies A where
  floats := []
  dv := []
  fresh := by simp
  nodup := .nil
  dv_dummy := by simp

end Dummies

namespace Assertion

/-- The frame of a proof with dummy variables `D`. -/
def extend (A : Assertion C V) (D : Dummies A) : Assertion C V where
  dv := A.dv ++ D.dv
  hyps := A.hyps ++ D.floats.map fun p => .float p.1 p.2
  concl := A.concl

@[simp] theorem extend_none (A : Assertion C V) : A.extend (Dummies.none A) = A := by
  simp [extend, Dummies.none]

end Assertion

/-- A CSLib tag for the Metamath inference system generated by `Γ`. -/
structure System (Γ : Set (Assertion C V)) : Type where

/-- A proof of an assertion: dummy variables and a derivation of the
conclusion in the extended frame. -/
def Proof (Γ : Set (Assertion C V)) (A : Assertion C V) : Type u :=
  Σ D : Dummies A, Derivation Γ (A.extend D) A.concl

instance (Γ : Set (Assertion C V)) : InferenceSystem (System Γ) (Assertion C V) where
  derivation A := Proof Γ A

/-- `A` is a theorem of the axiom set `Γ`. -/
def Derivable (Γ : Set (Assertion C V)) (A : Assertion C V) : Prop :=
  InferenceSystem.DerivableIn (System Γ) A

theorem derivable_iff {Γ : Set (Assertion C V)} {A : Assertion C V} :
    Derivable Γ A ↔ ∃ D : Dummies A, Nonempty (Derivation Γ (A.extend D) A.concl) :=
  ⟨fun ⟨⟨D, d⟩⟩ => ⟨D, ⟨d⟩⟩, fun ⟨D, ⟨d⟩⟩ => ⟨⟨D, d⟩⟩⟩

namespace Derivation

variable {Γ Δ : Set (Assertion C V)} {A : Assertion C V}

/-- Derivations use axioms monotonically. -/
def mono (h : Γ ⊆ Δ) : {e : Expr C V} → Derivation Γ A e → Derivation Δ A e
  | _, hyp he => hyp he
  | _, app B hB σ premises dv => app B (h hB) σ (fun e he => (premises e he).mono h) dv

end Derivation

theorem Derivable.mono {Γ Δ : Set (Assertion C V)} (h : Γ ⊆ Δ) {A : Assertion C V}
    (hA : Derivable Γ A) : Derivable Δ A := by
  obtain ⟨⟨D, d⟩⟩ := hA
  exact ⟨⟨D, d.mono h⟩⟩

/-- A well-formed assertion of `Γ` is a theorem of `Γ`, by applying it to its
own hypotheses under the identity substitution. -/
theorem Derivable.of_mem {Γ : Set (Assertion C V)} {A : Assertion C V} (hA : A ∈ Γ)
    (wf : A.WellFormed) : Derivable Γ A := by
  refine ⟨⟨Dummies.none A, ?_⟩⟩
  rw [Assertion.extend_none]
  have d := Derivation.app (Γ := Γ) (A := A) A hA (fun v => [Sym.var v])
    (fun e he => Derivation.hyp (by simpa using he))
    (fun x y hxy a ha b hb => by
      simp [Str.vars] at ha hb
      subst a b
      exact ⟨wf.dv_irrefl x y hxy, Or.inl hxy⟩)
  simpa using d

end Silmaril.Logic.Metamath
