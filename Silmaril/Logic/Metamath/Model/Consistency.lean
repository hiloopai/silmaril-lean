module

public import Silmaril.Logic.Metamath.Model.Soundness
public import Silmaril.Logic.Metamath.Theory.Systems
public import Silmaril.Logic.Metatheory.Consistency

@[expose] public section

/-!
# Consistency of Metamath systems

A grammatical system is consistent at a provable typecode `c` when some
well-formed tree assertion at `c` is not a theorem (`TConsistent`); this is
non-universality among the meaningful assertions. The designated falsum at
`c` is `|- ph` for a variable `ph` of the syntax sort of `c`
(`TAssertion.falsum`). For an unambiguous grammar, well-formed axioms and an
infinite supply of variables, the falsum is explosive: deriving it derives
every well-formed assertion at `c` (`TDerivable.of_falsum`), by applying it
under the substitution of the goal's conclusion and cut admissibility. So
consistency is exactly not deriving the falsum (`tConsistent_iff_not_falsum`).

A model is trivial at `c` when every value of the syntax sort of `c` is true
(Carneiro's trivial models, `U_c = U_Syn(c)`). A model of `Γ` that is not
trivial at `c` refutes the falsum, hence proves `Γ` consistent at `c`
(`Model.tConsistent`), for the tree system and, for unambiguous grammars, for
the string system of the syntax axioms and the flattened axioms
(`Model.not_derivable_falsum`, `Model.nonUniversal_system`).

In the lattice of theories, the consistent theories are those strictly below
the top theory, and they form a lower set (`Theory.isLowerSet_consistent`).
The theory generated by the string axioms of a system with a nontrivial model
is consistent (`Model.theory_ne_top`).
-/

namespace Silmaril.Logic.Metamath

open Grammar Silmaril.Logic.Metatheory Silmaril.Logic.Metatheory.InferenceSystemCat

universe u w

variable {C V L : Type u} {G : Grammar L C V}

namespace Grammar

section WellFormed

variable [DecidableEq V]

theorem TAssertion.floats_flatten (A : TAssertion L C V) : (A.flatten G).floats = A.floats := by
  simp only [Assertion.floats, flatten, TAssertion.floats, List.filterMap_map]
  congr 1
  funext h
  cases h <;> rfl

/-- The flattening of a well-formed tree assertion is well formed. -/
theorem TAssertion.WellFormed.flatten {A : TAssertion L C V} (hA : A.WellFormed G) :
    (A.flatten G).WellFormed where
  vars_float v hv := by
    have key : ∀ e : TExpr L C V, e.WellTyped G A.ctx → v ∈ Str.vars (G.flatten e.tree) →
        ∃ tc, Hyp.float tc v ∈ (A.flatten G).hyps := by
      rintro e ⟨s, hs, ht⟩ hv
      obtain ⟨s', -, hctx⟩ := ht.sort_of_mem_vars (G.prov_sort hs)
        (mem_vars_of_mem_vars_flatten hv)
      exact ⟨s', float_mem_flatten.2 hctx⟩
    simp only [Assertion.vars, List.mem_append, List.mem_flatMap] at hv
    rcases hv with hv | ⟨e, he, hv⟩
    · exact key _ hA.concl_wellTyped hv
    · obtain ⟨e', he', rfl⟩ := mem_essentials_flatten.1 he
      exact key _ (hA.ess_wellTyped e' he') hv
  floats_nodup := by rw [TAssertion.floats_flatten]; exact hA.floats_nodup
  dv_irrefl := hA.dv_irrefl

omit [DecidableEq V] in
/-- Syntax axioms are well formed. -/
theorem SyntaxRule.wellFormed (r : SyntaxRule C V) : r.toAssertion.WellFormed where
  vars_float v hv := by
    have he : r.toAssertion.essentials = [] := by
      simp [Assertion.essentials, toAssertion, List.filterMap_map]
    simp only [Assertion.vars, he, List.flatMap_nil, List.append_nil] at hv
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 (r.body_perm.subset hv)
    exact ⟨p.1, List.mem_map.2 ⟨p, hp, rfl⟩⟩
  floats_nodup := by
    have hf : r.toAssertion.floats = r.args := by
      simp [Assertion.floats, toAssertion, List.filterMap_map]
    rw [hf]
    exact r.args_nodup
  dv_irrefl := by simp [toAssertion]

theorem wellFormed_of_mem_axioms {Γ : Set (TAssertion L C V)} (hΓ : ∀ B ∈ Γ, B.WellFormed G)
    {A : Assertion C V} (h : A ∈ G.axioms Γ) : A.WellFormed := by
  rcases h with ⟨l, rfl⟩ | ⟨B, hB, rfl⟩
  · exact SyntaxRule.wellFormed _
  · exact (hΓ B hB).flatten

/-- The string axioms of a grammatical system, as well-formed assertions. -/
def wfAxioms (G : Grammar L C V) (Γ : Set (TAssertion L C V)) : Set (WFAssertion C V) :=
  {A | A.1 ∈ G.axioms Γ}

theorem toSet_wfAxioms {Γ : Set (TAssertion L C V)} (hΓ : ∀ B ∈ Γ, B.WellFormed G) :
    WFAssertion.toSet (G.wfAxioms Γ) = G.axioms Γ := by
  ext A
  exact ⟨fun ⟨_, h, e⟩ => e ▸ h, fun h => ⟨⟨A, wellFormed_of_mem_axioms hΓ h⟩, h, rfl⟩⟩

end WellFormed

namespace TAssertion

/-- The falsum `|- ph` of the provable typecode `c`, for a variable `ph` of
its syntax sort `s`. -/
def falsum (c s : C) (v : V) : TAssertion L C V := ⟨[], [.float s v], ⟨c, .var v⟩⟩

theorem falsum_ctx {c s s' : C} {v v' : V} :
    (falsum (L := L) c s v).ctx v' s' ↔ v' = v ∧ s' = s := by
  simp [falsum, ctx, and_comm]

theorem wellFormed_falsum {c s : C} (hc : G.prov c = some s) (v : V) :
    (falsum c s v).WellFormed G where
  floats_nodup := by simp [falsum, floats]
  float_sort _ _ h := (falsum_ctx.1 h).2 ▸ G.prov_sort hc
  ess_wellTyped _ he := by simp [falsum, essentials] at he
  concl_wellTyped := ⟨s, hc, .var (falsum_ctx.2 ⟨rfl, rfl⟩)⟩
  dv_irrefl _ _ h := by simp [falsum] at h
  dv_float _ _ h := by simp [falsum] at h

end TAssertion

open TAssertion

/-- `Γ` is consistent at the provable typecode `c`: some well-formed tree
assertion at `c` is not a theorem. -/
def TConsistent (G : Grammar L C V) (Γ : Set (TAssertion L C V)) (c : C) : Prop :=
  ∃ A : TAssertion L C V, A.WellFormed G ∧ A.concl.tc = c ∧ ¬ TDerivable G Γ A

/-- Consistency at `c` implies consistency of the CSLib tree system. -/
theorem TConsistent.consistent {Γ : Set (TAssertion L C V)} {c : C} (h : TConsistent G Γ c) :
    Consistent (TSystem G Γ) (TAssertion L C V) :=
  let ⟨A, _, _, hA⟩ := h
  ⟨A, hA⟩

theorem TConsistent.mono {Γ Δ : Set (TAssertion L C V)} (hle : Γ ⊆ Δ) {c : C}
    (h : TConsistent G Δ c) : TConsistent G Γ c :=
  let ⟨A, hA, hc, hn⟩ := h
  ⟨A, hA, hc, fun h => hn (h.mono hle)⟩

/-- Not deriving the falsum at `c` is consistency at `c`. -/
theorem tConsistent_of_not_falsum {Γ : Set (TAssertion L C V)} {c s : C}
    (hc : G.prov c = some s) {v : V} (h : ¬ TDerivable G Γ (falsum c s v)) : TConsistent G Γ c :=
  ⟨_, wellFormed_falsum hc v, rfl, h⟩

section Explosion

variable [DecidableEq V] [Infinite V]

/-- The falsum is explosive: a system deriving `|- ph` derives every
well-formed assertion at the same typecode. -/
theorem TDerivable.of_falsum (hG : G.Unambiguous) {Γ : Set (TAssertion L C V)}
    (hΓ : ∀ B ∈ Γ, B.WellFormed G) {c s : C} (hc : G.prov c = some s) {v : V}
    (hF : TDerivable G Γ (falsum c s v)) {A : TAssertion L C V} (hA : A.WellFormed G)
    (hAc : A.concl.tc = c) : TDerivable G Γ A := by
  rw [tderivable_iff_derivable hG hΓ hA]
  obtain ⟨s', hs', ht⟩ := hA.concl_wellTyped
  rw [hAc, hc] at hs'
  cases hs'
  refine hF.flatten.of_instance (fun _ => G.flatten A.concl.tree) ?_ ?_ ?_
  · intro e he
    simp only [Assertion.hypExprs, TAssertion.flatten, falsum, List.map_cons, List.map_nil,
      THyp.flatten, List.mem_singleton, Hyp.expr_float] at he
    subst he
    have := syntax_derivation (Δ := G.axioms Γ) (A := A.flatten G) Set.subset_union_left
      (ht.mono fun _ _ h => (TDerivation.floatCtx_flatten (A := A)).2 h)
    simpa [Expr.subst, Str.subst] using this
  · simp [Assertion.DVSafe, TAssertion.flatten, falsum]
  · simp [TAssertion.flatten, falsum, TExpr.flatten, Expr.subst, Str.subst, hAc]

/-- Consistency at `c` is not deriving the falsum at `c`. -/
theorem tConsistent_iff_not_falsum (hG : G.Unambiguous) {Γ : Set (TAssertion L C V)}
    (hΓ : ∀ B ∈ Γ, B.WellFormed G) {c s : C} (hc : G.prov c = some s) (v : V) :
    TConsistent G Γ c ↔ ¬ TDerivable G Γ (falsum c s v) :=
  ⟨fun ⟨_, hA, hAc, hn⟩ hF => hn (hF.of_falsum hG hΓ hc hA hAc), tConsistent_of_not_falsum hc⟩

/-- Consistency at `c` as consistency of the CSLib tree system at the falsum. -/
theorem consistentAt_falsum_iff (hG : G.Unambiguous) {Γ : Set (TAssertion L C V)}
    (hΓ : ∀ B ∈ Γ, B.WellFormed G) {c s : C} (hc : G.prov c = some s) (v : V) :
    ConsistentAt (TSystem G Γ) (falsum (L := L) c s v) ↔ TConsistent G Γ c :=
  (tConsistent_iff_not_falsum hG hΓ hc v).symm

end Explosion

end Grammar

namespace Theory

variable [Infinite V]

/-- A theory is consistent exactly when some well-formed assertion is not in it. -/
theorem ne_top_iff (T : Theory C V) : T ≠ ⊤ ↔ ∃ A, A ∉ T.val := by
  rw [Ne, ← Subtype.val_injective.eq_iff, val_top, Set.eq_univ_iff_forall, not_forall]

/-- The theory of an axiom set is consistent exactly when some well-formed
assertion is not a theorem. -/
theorem of_ne_top_iff (Γ : Set (WFAssertion C V)) :
    of Γ ≠ ⊤ ↔ ∃ A : WFAssertion C V, ¬ Derivable (WFAssertion.toSet Γ) A.val :=
  ne_top_iff _

/-- Consistent theories form a lower set: a subtheory of a consistent theory
is consistent. -/
theorem isLowerSet_consistent : IsLowerSet {T : Theory C V | T ≠ ⊤} := isLowerSet_ne_top

end Theory

namespace Model

open Grammar.TAssertion

variable (M : Model.{u, w} G)

/-- `M` is trivial at the provable typecode `c` with syntax sort `s`: every
value of `s` is true. -/
def TrivialAt {c s : C} (hc : G.prov c = some s) : Prop := ∀ a : M.Carrier s, M.IsTrue hc a

/-- The falsum at `c` holds exactly in the models that are trivial at `c`. -/
theorem satisfies_falsum_iff {c s : C} (hc : G.prov c = some s) (v : V) :
    M.Satisfies (falsum c s v) ↔ M.TrivialAt hc := by
  constructor
  · intro h a
    let ρ : M.Valuation (falsum (L := L) c s v).ctx := fun _ s' h =>
      (falsum_ctx.1 h.1).2.symm ▸ a
    obtain ⟨s', hs', ht, htrue⟩ := h ρ (by simp [DVHolds, falsum]) (by simp [falsum, essentials])
    obtain rfl : s' = s := Option.some.inj (hs'.symm.trans hc)
    have ht' : G.HasSort _ (.var v) _ := ht
    exact (congrArg (M.IsTrue hc) (eval_var (M := M.toAlgebra) (ρ := ρ) ht')).mp htrue
  · intro h ρ _ _
    exact ⟨s, hc, .var ⟨falsum_ctx.2 ⟨rfl, rfl⟩, G.prov_sort hc⟩, h _⟩

variable {M}

/-- A model of `Γ` that is not trivial at `c` refutes the falsum at `c`. -/
theorem not_tderivable_falsum {Γ : Set (TAssertion L C V)} (hΓ : ∀ B ∈ Γ, B.WellFormed G)
    (hM : M.IsModel Γ) {c s : C} (hc : G.prov c = some s) (hn : ¬ M.TrivialAt hc) (v : V) :
    ¬ TDerivable G Γ (falsum c s v) :=
  M.not_tderivable hΓ hM ((M.satisfies_falsum_iff hc v).not.2 hn)

/-- Consistency from a model (Carneiro, §4.1): a model of `Γ` that is not
trivial at `c` shows that `Γ` is consistent at `c`. -/
theorem tConsistent {Γ : Set (TAssertion L C V)} (hΓ : ∀ B ∈ Γ, B.WellFormed G)
    (hM : M.IsModel Γ) {c s : C} (hc : G.prov c = some s) (hn : ¬ M.TrivialAt hc) (v : V) :
    TConsistent G Γ c :=
  tConsistent_of_not_falsum hc (not_tderivable_falsum hΓ hM hc hn v)

variable [DecidableEq V]

/-- A nontrivial model refutes the flattened falsum in the string system. -/
theorem not_derivable_falsum (hG : G.Unambiguous) {Γ : Set (TAssertion L C V)}
    (hΓ : ∀ B ∈ Γ, B.WellFormed G) (hM : M.IsModel Γ) {c s : C} (hc : G.prov c = some s)
    (hn : ¬ M.TrivialAt hc) (v : V) : ¬ Derivable (G.axioms Γ) ((falsum c s v).flatten G) :=
  M.not_derivable hG hΓ hM (wellFormed_falsum hc v) ((M.satisfies_falsum_iff hc v).not.2 hn)

/-- The string system of a grammatical system with a nontrivial model is
non-universal. -/
theorem nonUniversal_system (hG : G.Unambiguous) {Γ : Set (TAssertion L C V)}
    (hΓ : ∀ B ∈ Γ, B.WellFormed G) (hM : M.IsModel Γ) {c s : C} (hc : G.prov c = some s)
    (hn : ¬ M.TrivialAt hc) (v : V) : (system (G.axioms Γ)).NonUniversal :=
  ⟨_, fun h => not_derivable_falsum hG hΓ hM hc hn v (system_provable_iff.1 h)⟩

/-- The theory generated by the string axioms of a grammatical system with a
nontrivial model is consistent: it lies strictly below the top theory. -/
theorem theory_ne_top [Infinite V] (hG : G.Unambiguous) {Γ : Set (TAssertion L C V)}
    (hΓ : ∀ B ∈ Γ, B.WellFormed G) (hM : M.IsModel Γ) {c s : C} (hc : G.prov c = some s)
    (hn : ¬ M.TrivialAt hc) (v : V) : Theory.of (G.wfAxioms Γ) ≠ ⊤ := by
  refine (Theory.of_ne_top_iff _).2 ⟨⟨_, (wellFormed_falsum hc v).flatten⟩, ?_⟩
  rw [toSet_wfAxioms hΓ]
  exact not_derivable_falsum hG hΓ hM hc hn v

end Model

end Silmaril.Logic.Metamath
