module

public import Mathlib.Logic.Function.Basic
public import Mathlib.Data.Finset.Basic

@[expose] public section

/-!
# Semantics of second-order arithmetic in ω-models

An ω-model of second-order arithmetic has the standard natural numbers as
its first-order part and a collection `𝒮 ⊆ 𝒫(ℕ)` as its second-order part
(Simpson, *Subsystems of Second Order Arithmetic*, Definition I.2.3 and
Section VIII.1). The full model has `𝒮 = 𝒫(ℕ)`.

Names come in two sorts: `inl x` names a number and `inr X` a set, over one
type `N` of names. An environment assigns a number to each number name and a
member of `𝒮` to each set name. Terms denote functions of environments into
`ℕ` and formulas functions into `Prop`. The operations below interpret the
term and formula constructors; quantifiers update the environment.

The definable values are generated by these operations: polynomial terms
(`IsPoly`) and second-order formulas (`IsDef`). The formula classes of
`z2.mm` are the arithmetical formulas (`IsArith`, no set quantifiers), the
bounded ones (`IsBnd`, number quantifiers bounded by a term not mentioning
the bound variable), and the Σ⁰₁ and Π⁰₁ formulas (`IsSig1`, `IsPi1`), with
`IsBnd ⊆ IsSig1, IsPi1 ⊆ IsArith ⊆ IsDef`. Definable values depend on
finitely many names (`IsPoly.exists_dependsOn`, `IsDef.exists_dependsOn`).
-/

namespace Silmaril.Logic.Metamath.SecondOrder.Sem

open Function

variable (𝒮 : Set (Set ℕ)) (N : Type)

/-- The values of names: numbers for number names, members of `𝒮` for set
names. -/
abbrev Val : N ⊕ N → Type
  | .inl _ => ℕ
  | .inr _ => ↥𝒮

/-- An environment. -/
abbrev Env : Type := (n : N ⊕ N) → Val 𝒮 N n

variable {𝒮 N}

/-- A formula is valid when it holds in every environment. -/
def Valid (φ : Env 𝒮 N → Prop) : Prop := ∀ ρ, φ ρ

section Dependence

variable [DecidableEq N]

/-- `f` ignores the value of the name `n`: `n` is not free in `f`. -/
def Ignores {T : Sort*} (f : Env 𝒮 N → T) (n : N ⊕ N) : Prop :=
  ∀ ρ a, f (update ρ n a) = f ρ

/-- `f` only depends on the values of the names in `F`. -/
def DependsOn {T : Sort*} (f : Env 𝒮 N → T) (F : Finset (N ⊕ N)) : Prop :=
  ∀ ρ ρ' : Env 𝒮 N, (∀ n ∈ F, ρ n = ρ' n) → f ρ = f ρ'

theorem DependsOn.ignores {T : Sort*} {f : Env 𝒮 N → T} {F : Finset (N ⊕ N)}
    (h : DependsOn f F) {n : N ⊕ N} (hn : n ∉ F) : Ignores f n :=
  fun ρ _ => h _ _ fun m hm => update_of_ne (by rintro rfl; exact hn hm) _ _

omit [DecidableEq N] in
theorem DependsOn.mono {T : Sort*} {f : Env 𝒮 N → T} {F F' : Finset (N ⊕ N)}
    (h : DependsOn f F) (hF : F ⊆ F') : DependsOn f F' :=
  fun ρ ρ' hρ => h ρ ρ' fun n hn => hρ n (hF hn)

omit [DecidableEq N] in
theorem dependsOn_const {T : Sort*} (t : T) : DependsOn (𝒮 := 𝒮) (N := N) (fun _ => t) ∅ :=
  fun _ _ _ => rfl

omit [DecidableEq N] in
theorem DependsOn.comp {T T' : Sort*} {f : Env 𝒮 N → T} {F : Finset (N ⊕ N)}
    (h : DependsOn f F) (g : T → T') : DependsOn (fun ρ => g (f ρ)) F :=
  fun ρ ρ' hρ => congrArg g (h ρ ρ' hρ)

theorem DependsOn.comp₂ {T T' T'' : Sort*} {f : Env 𝒮 N → T} {f' : Env 𝒮 N → T'}
    {F F' : Finset (N ⊕ N)} (h : DependsOn f F) (h' : DependsOn f' F') (g : T → T' → T'') :
    DependsOn (fun ρ => g (f ρ) (f' ρ)) (F ∪ F') :=
  fun ρ ρ' hρ => congrArg₂ g (h ρ ρ' fun n hn => hρ n (Finset.mem_union_left _ hn))
    (h' ρ ρ' fun n hn => hρ n (Finset.mem_union_right _ hn))

/-- Binding the name `n`: `g` receives `f` as a function of the value of `n`. -/
theorem DependsOn.bind {T T' : Sort*} {f : Env 𝒮 N → T} {F : Finset (N ⊕ N)}
    (h : DependsOn f F) (n : N ⊕ N) (g : (Val 𝒮 N n → T) → T') :
    DependsOn (fun ρ => g fun a => f (update ρ n a)) (F.erase n) := by
  intro ρ ρ' hρ
  refine congrArg g (funext fun a => h _ _ fun m hm => ?_)
  by_cases hmn : m = n
  · subst hmn
    simp
  · rw [update_of_ne hmn, update_of_ne hmn]
    exact hρ m (Finset.mem_erase.2 ⟨hmn, hm⟩)

end Dependence

/-! ## Terms and formulas -/

/-- The number variable `x`. -/
def var (x : N) : Env 𝒮 N → ℕ := fun ρ => ρ (.inl x)

/-- Zero. -/
def zero : Env 𝒮 N → ℕ := fun _ => 0

/-- Successor. -/
def succ (a : Env 𝒮 N → ℕ) : Env 𝒮 N → ℕ := fun ρ => a ρ + 1

/-- Addition. -/
def add (a b : Env 𝒮 N → ℕ) : Env 𝒮 N → ℕ := fun ρ => a ρ + b ρ

/-- Multiplication. -/
def mul (a b : Env 𝒮 N → ℕ) : Env 𝒮 N → ℕ := fun ρ => a ρ * b ρ

/-- `t = u`. -/
def eq (a b : Env 𝒮 N → ℕ) : Env 𝒮 N → Prop := fun ρ => a ρ = b ρ

/-- `t < u`. -/
def lt (a b : Env 𝒮 N → ℕ) : Env 𝒮 N → Prop := fun ρ => a ρ < b ρ

/-- `t e. X`. -/
def mem (a : Env 𝒮 N → ℕ) (X : N) : Env 𝒮 N → Prop := fun ρ => a ρ ∈ (ρ (.inr X)).1

/-- `X = Y`. -/
def seq (X Y : N) : Env 𝒮 N → Prop := fun ρ => ρ (.inr X) = ρ (.inr Y)

/-- `-. ph`. -/
def not (φ : Env 𝒮 N → Prop) : Env 𝒮 N → Prop := fun ρ => ¬ φ ρ

/-- `( ph -> ps )`. -/
def imp (φ ψ : Env 𝒮 N → Prop) : Env 𝒮 N → Prop := fun ρ => φ ρ → ψ ρ

/-- `( ph <-> ps )`. -/
def iff (φ ψ : Env 𝒮 N → Prop) : Env 𝒮 N → Prop := fun ρ => (φ ρ ↔ ψ ρ)

/-- `( ph /\ ps )`. -/
def and (φ ψ : Env 𝒮 N → Prop) : Env 𝒮 N → Prop := fun ρ => φ ρ ∧ ψ ρ

variable [DecidableEq N]

/-- `A. x ph`. -/
def all (x : N) (φ : Env 𝒮 N → Prop) : Env 𝒮 N → Prop :=
  fun ρ => ∀ n : ℕ, φ (update ρ (.inl x) n)

/-- `E. x ph`. -/
def ex (x : N) (φ : Env 𝒮 N → Prop) : Env 𝒮 N → Prop :=
  fun ρ => ∃ n : ℕ, φ (update ρ (.inl x) n)

/-- `A. X ph`: quantification over `𝒮`. -/
def sall (X : N) (φ : Env 𝒮 N → Prop) : Env 𝒮 N → Prop :=
  fun ρ => ∀ A : ↥𝒮, φ (update ρ (.inr X) A)

/-- `E. X ph`. -/
def sex (X : N) (φ : Env 𝒮 N → Prop) : Env 𝒮 N → Prop :=
  fun ρ => ∃ A : ↥𝒮, φ (update ρ (.inr X) A)

/-! ## Definable values and formula classes -/

/-- Polynomial terms. -/
inductive IsPoly : (Env 𝒮 N → ℕ) → Prop
  | var (x : N) : IsPoly (var x)
  | zero : IsPoly zero
  | succ {a} : IsPoly a → IsPoly (succ a)
  | add {a b} : IsPoly a → IsPoly b → IsPoly (add a b)
  | mul {a b} : IsPoly a → IsPoly b → IsPoly (mul a b)

/-- Formulas of second-order arithmetic. -/
inductive IsDef : (Env 𝒮 N → Prop) → Prop
  | eq {a b} : IsPoly a → IsPoly b → IsDef (eq a b)
  | lt {a b} : IsPoly a → IsPoly b → IsDef (lt a b)
  | mem {a} (X : N) : IsPoly a → IsDef (mem a X)
  | seq (X Y : N) : IsDef (seq X Y)
  | not {φ} : IsDef φ → IsDef (not φ)
  | imp {φ ψ} : IsDef φ → IsDef ψ → IsDef (imp φ ψ)
  | iff {φ ψ} : IsDef φ → IsDef ψ → IsDef (iff φ ψ)
  | and {φ ψ} : IsDef φ → IsDef ψ → IsDef (and φ ψ)
  | all (x : N) {φ} : IsDef φ → IsDef (all x φ)
  | ex (x : N) {φ} : IsDef φ → IsDef (ex x φ)
  | sall (X : N) {φ} : IsDef φ → IsDef (sall X φ)
  | sex (X : N) {φ} : IsDef φ → IsDef (sex X φ)

/-- Arithmetical formulas: no set quantifiers. -/
inductive IsArith : (Env 𝒮 N → Prop) → Prop
  | eq {a b} : IsPoly a → IsPoly b → IsArith (eq a b)
  | lt {a b} : IsPoly a → IsPoly b → IsArith (lt a b)
  | mem {a} (X : N) : IsPoly a → IsArith (mem a X)
  | seq (X Y : N) : IsArith (seq X Y)
  | not {φ} : IsArith φ → IsArith (not φ)
  | imp {φ ψ} : IsArith φ → IsArith ψ → IsArith (imp φ ψ)
  | iff {φ ψ} : IsArith φ → IsArith ψ → IsArith (iff φ ψ)
  | and {φ ψ} : IsArith φ → IsArith ψ → IsArith (and φ ψ)
  | all (x : N) {φ} : IsArith φ → IsArith (all x φ)
  | ex (x : N) {φ} : IsArith φ → IsArith (ex x φ)

/-- Bounded (Σ⁰₀) formulas: number quantifiers are bounded by a term in which
the bound variable does not occur. -/
inductive IsBnd : (Env 𝒮 N → Prop) → Prop
  | eq {a b} : IsPoly a → IsPoly b → IsBnd (eq a b)
  | lt {a b} : IsPoly a → IsPoly b → IsBnd (lt a b)
  | mem {a} (X : N) : IsPoly a → IsBnd (mem a X)
  | not {φ} : IsBnd φ → IsBnd (not φ)
  | imp {φ ψ} : IsBnd φ → IsBnd ψ → IsBnd (imp φ ψ)
  | iff {φ ψ} : IsBnd φ → IsBnd ψ → IsBnd (iff φ ψ)
  | and {φ ψ} : IsBnd φ → IsBnd ψ → IsBnd (and φ ψ)
  | ball (x : N) {a φ} : IsPoly a → Ignores a (.inl x) → IsBnd φ →
      IsBnd (all x (imp (lt (var x) a) φ))
  | bex (x : N) {a φ} : IsPoly a → Ignores a (.inl x) → IsBnd φ →
      IsBnd (ex x (and (lt (var x) a) φ))

/-- Σ⁰₁ formulas: `∃ x θ` with `θ` bounded. -/
inductive IsSig1 : (Env 𝒮 N → Prop) → Prop
  | bnd {φ} : IsBnd φ → IsSig1 φ
  | ex (x : N) {φ} : IsBnd φ → IsSig1 (ex x φ)

/-- Π⁰₁ formulas: `∀ x θ` with `θ` bounded. -/
inductive IsPi1 : (Env 𝒮 N → Prop) → Prop
  | bnd {φ} : IsBnd φ → IsPi1 φ
  | all (x : N) {φ} : IsBnd φ → IsPi1 (all x φ)

theorem IsBnd.isArith {φ : Env 𝒮 N → Prop} (h : IsBnd φ) : IsArith φ := by
  induction h with
  | eq ha hb => exact .eq ha hb
  | lt ha hb => exact .lt ha hb
  | mem X ha => exact .mem X ha
  | not _ ih => exact .not ih
  | imp _ _ ih ih' => exact .imp ih ih'
  | iff _ _ ih ih' => exact .iff ih ih'
  | and _ _ ih ih' => exact .and ih ih'
  | ball x ha _ _ ih => exact .all x (.imp (.lt (.var x) ha) ih)
  | bex x ha _ _ ih => exact .ex x (.and (.lt (.var x) ha) ih)

theorem IsSig1.isArith {φ : Env 𝒮 N → Prop} : IsSig1 φ → IsArith φ
  | .bnd h => h.isArith
  | .ex x h => .ex x h.isArith

theorem IsPi1.isArith {φ : Env 𝒮 N → Prop} : IsPi1 φ → IsArith φ
  | .bnd h => h.isArith
  | .all x h => .all x h.isArith

theorem IsArith.isDef {φ : Env 𝒮 N → Prop} (h : IsArith φ) : IsDef φ := by
  induction h with
  | eq ha hb => exact .eq ha hb
  | lt ha hb => exact .lt ha hb
  | mem X ha => exact .mem X ha
  | seq X Y => exact .seq X Y
  | not _ ih => exact .not ih
  | imp _ _ ih ih' => exact .imp ih ih'
  | iff _ _ ih ih' => exact .iff ih ih'
  | and _ _ ih ih' => exact .and ih ih'
  | all x _ ih => exact .all x ih
  | ex x _ ih => exact .ex x ih

/-! ## Finite support -/

theorem IsPoly.exists_dependsOn {a : Env 𝒮 N → ℕ} (h : IsPoly a) : ∃ F, DependsOn a F := by
  induction h with
  | var x => exact ⟨{.inl x}, fun ρ ρ' hρ => hρ _ (Finset.mem_singleton_self _)⟩
  | zero => exact ⟨∅, dependsOn_const 0⟩
  | succ _ ih =>
    obtain ⟨F, hF⟩ := ih
    exact ⟨F, hF.comp (· + 1)⟩
  | add _ _ ih ih' =>
    obtain ⟨F, hF⟩ := ih
    obtain ⟨F', hF'⟩ := ih'
    exact ⟨_, hF.comp₂ hF' (· + ·)⟩
  | mul _ _ ih ih' =>
    obtain ⟨F, hF⟩ := ih
    obtain ⟨F', hF'⟩ := ih'
    exact ⟨_, hF.comp₂ hF' (· * ·)⟩

theorem IsDef.exists_dependsOn {φ : Env 𝒮 N → Prop} (h : IsDef φ) : ∃ F, DependsOn φ F := by
  induction h with
  | eq ha hb =>
    obtain ⟨F, hF⟩ := ha.exists_dependsOn
    obtain ⟨F', hF'⟩ := hb.exists_dependsOn
    exact ⟨_, hF.comp₂ hF' (· = ·)⟩
  | lt ha hb =>
    obtain ⟨F, hF⟩ := ha.exists_dependsOn
    obtain ⟨F', hF'⟩ := hb.exists_dependsOn
    exact ⟨_, hF.comp₂ hF' (· < ·)⟩
  | mem X ha =>
    obtain ⟨F, hF⟩ := ha.exists_dependsOn
    have hX : DependsOn (fun ρ : Env 𝒮 N => ρ (.inr X)) {.inr X} :=
      fun ρ ρ' hρ => hρ _ (Finset.mem_singleton_self _)
    exact ⟨_, hF.comp₂ hX fun n A => n ∈ A.1⟩
  | seq X Y =>
    have hX : DependsOn (fun ρ : Env 𝒮 N => ρ (.inr X)) {.inr X} :=
      fun ρ ρ' hρ => hρ _ (Finset.mem_singleton_self _)
    have hY : DependsOn (fun ρ : Env 𝒮 N => ρ (.inr Y)) {.inr Y} :=
      fun ρ ρ' hρ => hρ _ (Finset.mem_singleton_self _)
    exact ⟨_, hX.comp₂ hY (· = ·)⟩
  | not _ ih =>
    obtain ⟨F, hF⟩ := ih
    exact ⟨F, hF.comp Not⟩
  | imp _ _ ih ih' =>
    obtain ⟨F, hF⟩ := ih
    obtain ⟨F', hF'⟩ := ih'
    exact ⟨_, hF.comp₂ hF' (· → ·)⟩
  | iff _ _ ih ih' =>
    obtain ⟨F, hF⟩ := ih
    obtain ⟨F', hF'⟩ := ih'
    exact ⟨_, hF.comp₂ hF' Iff⟩
  | and _ _ ih ih' =>
    obtain ⟨F, hF⟩ := ih
    obtain ⟨F', hF'⟩ := ih'
    exact ⟨_, hF.comp₂ hF' And⟩
  | all x _ ih =>
    obtain ⟨F, hF⟩ := ih
    exact ⟨_, hF.bind (.inl x) fun P => ∀ n, P n⟩
  | ex x _ ih =>
    obtain ⟨F, hF⟩ := ih
    exact ⟨_, hF.bind (.inl x) fun P => ∃ n, P n⟩
  | sall X _ ih =>
    obtain ⟨F, hF⟩ := ih
    exact ⟨_, hF.bind (.inr X) fun P => ∀ A, P A⟩
  | sex X _ ih =>
    obtain ⟨F, hF⟩ := ih
    exact ⟨_, hF.bind (.inr X) fun P => ∃ A, P A⟩

end Silmaril.Logic.Metamath.SecondOrder.Sem
