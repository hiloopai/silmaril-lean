module

public import Silmaril.Logic.Metamath.Category.Cut
public import Mathlib.Order.Closure
public import Mathlib.Order.Antisymmetrization

@[expose] public section

/-!
# The lattice of tree axiom sets

The tree analogue of `Silmaril.Logic.Metamath.Theory.Lattice`, over a fixed
grammar `G`. The theorems of a set of well-formed tree assertions are the
well-formed tree assertions derivable from it. Taking theorems is a closure
operator: extensive because a well-formed axiom derives itself, idempotent by
tree cut admissibility (`TDerivable.trans`). Tree theories are its closed sets
and form a complete lattice.

Tree axiom sets are preordered by derivability: `Γ ≤ Δ` when every axiom of
`Γ` is a theorem of `Δ`. `TAxiomSet.antisymmetrizationIso` identifies the
quotient partial order with the lattice of tree theories. Idempotence and
transitivity assume an infinite type of variables.
-/

namespace Silmaril.Logic.Metamath.Grammar

universe u

variable {L C V : Type u}

/-- A well-formed tree assertion over the grammar `G`. -/
abbrev TWFAssertion (G : Grammar L C V) := {A : TAssertion L C V // A.WellFormed G}

variable {G : Grammar L C V}

namespace TWFAssertion

/-- The underlying tree assertions. -/
def toSet (Γ : Set (TWFAssertion G)) : Set (TAssertion L C V) := Subtype.val '' Γ

theorem mem_toSet_of_mem {Γ : Set (TWFAssertion G)} {A : TWFAssertion G} (h : A ∈ Γ) :
    A.val ∈ toSet Γ := ⟨A, h, rfl⟩

theorem toSet_mono {Γ Δ : Set (TWFAssertion G)} (h : Γ ⊆ Δ) : toSet Γ ⊆ toSet Δ :=
  Set.image_mono h

theorem wellFormed_of_mem_toSet {Γ : Set (TWFAssertion G)} {A : TAssertion L C V}
    (h : A ∈ toSet Γ) : A.WellFormed G := by
  obtain ⟨B, -, rfl⟩ := h
  exact B.2

/-- The well-formed tree theorems of an axiom set. -/
def theorems (Γ : Set (TWFAssertion G)) : Set (TWFAssertion G) :=
  {A | TDerivable G (toSet Γ) A.val}

@[simp] theorem mem_theorems {Γ : Set (TWFAssertion G)} {A : TWFAssertion G} :
    A ∈ theorems Γ ↔ TDerivable G (toSet Γ) A.val := Iff.rfl

theorem subset_theorems (Γ : Set (TWFAssertion G)) : Γ ⊆ theorems Γ :=
  fun A hA => TDerivable.of_mem (mem_toSet_of_mem hA) A.2

theorem theorems_mono : Monotone (theorems : Set (TWFAssertion G) → Set (TWFAssertion G)) :=
  fun _ _ h _ hA => TDerivable.mono (toSet_mono h) hA

/-- Everything derivable from the theorems of `Γ` is derivable from `Γ`. -/
theorem derivable_of_derivable_theorems [Infinite V] {Γ : Set (TWFAssertion G)}
    {A : TAssertion L C V} (h : TDerivable G (toSet (theorems Γ)) A) :
    TDerivable G (toSet Γ) A :=
  TDerivable.trans (fun _ hB' => by obtain ⟨B, hB, rfl⟩ := hB'; exact hB) h

theorem theorems_theorems [Infinite V] (Γ : Set (TWFAssertion G)) :
    theorems (theorems Γ) = theorems Γ :=
  le_antisymm (fun _ hA => derivable_of_derivable_theorems hA) (subset_theorems _)

/-- `Γ` derives the axioms of `Δ` exactly when it derives all theorems of `Δ`,
well-formed or not. -/
theorem subset_theorems_iff [Infinite V] {Γ Δ : Set (TWFAssertion G)} :
    Γ ⊆ theorems Δ ↔ ∀ A, TDerivable G (toSet Γ) A → TDerivable G (toSet Δ) A := by
  constructor
  · intro h A hA
    exact TDerivable.trans (fun _ hB' => by obtain ⟨B, hB, rfl⟩ := hB'; exact h hB) hA
  · exact fun h A hA => h _ (subset_theorems Γ hA)

end TWFAssertion

open TWFAssertion

variable (G) in
/-- Derivable closure on sets of well-formed tree assertions. -/
def tTheoryClosure [Infinite V] : ClosureOperator (Set (TWFAssertion G)) :=
  ClosureOperator.mk' theorems theorems_mono subset_theorems fun Γ => (theorems_theorems Γ).le

@[simp] theorem tTheoryClosure_apply [Infinite V] (Γ : Set (TWFAssertion G)) :
    tTheoryClosure G Γ = theorems Γ := rfl

/-- A tree theory: a set of well-formed tree assertions containing all its
well-formed theorems. -/
abbrev TTheory (G : Grammar L C V) [Infinite V] := (tTheoryClosure G).Closeds

namespace TTheory

variable [Infinite V]

/-- Tree theories form a complete lattice, with meets given by intersection. -/
instance : CompleteLattice (TTheory G) := (tTheoryClosure G).gi.liftCompleteLattice

/-- The tree theory generated by an axiom set. -/
def of (Γ : Set (TWFAssertion G)) : TTheory G := (tTheoryClosure G).toCloseds Γ

@[simp] theorem val_of (Γ : Set (TWFAssertion G)) : (of Γ).val = theorems Γ := rfl

theorem mem_of {Γ : Set (TWFAssertion G)} {A : TWFAssertion G} :
    A ∈ (of Γ).val ↔ TDerivable G (toSet Γ) A.val := Iff.rfl

theorem le_iff {T T' : TTheory G} : T ≤ T' ↔ T.val ⊆ T'.val := Iff.rfl

theorem theorems_eq (T : TTheory G) : theorems T.val = T.val := T.2.closure_eq

@[simp] theorem of_val (T : TTheory G) : of T.val = T := Subtype.ext T.theorems_eq

theorem of_le_iff {Γ : Set (TWFAssertion G)} {T : TTheory G} : of Γ ≤ T ↔ Γ ⊆ T.val :=
  (tTheoryClosure G).gi.gc Γ T

theorem of_mono {Γ Δ : Set (TWFAssertion G)} (h : Γ ⊆ Δ) : of Γ ≤ of Δ :=
  (tTheoryClosure G).gi.gc.monotone_l h

@[simp] theorem val_inf (T T' : TTheory G) : (T ⊓ T').val = T.val ∩ T'.val := rfl

theorem sup_eq (T T' : TTheory G) : T ⊔ T' = of (T.val ∪ T'.val) := rfl

/-- The theory of a union is the join of the theories. -/
theorem of_union (Γ Δ : Set (TWFAssertion G)) : of (Γ ∪ Δ) = of Γ ⊔ of Δ :=
  (tTheoryClosure G).gi.gc.l_sup

/-- The least tree theory is generated by the empty axiom set. -/
theorem of_empty : of (∅ : Set (TWFAssertion G)) = ⊥ :=
  (tTheoryClosure G).gi.gc.l_bot

@[simp] theorem val_top : (⊤ : TTheory G).val = Set.univ := by
  apply Set.eq_univ_of_univ_subset
  exact le_top (a := (of Set.univ : TTheory G)) |> fun h =>
    (subset_theorems _).trans (le_iff.1 h)

end TTheory

/-- Tree axiom sets over `G`, preordered by derivability. -/
def TAxiomSet (G : Grammar L C V) := Set (TWFAssertion G)

namespace TAxiomSet

/-- Regard a set of well-formed tree assertions as an axiom set. -/
def of (Γ : Set (TWFAssertion G)) : TAxiomSet G := Γ

/-- The axioms of an axiom set. -/
def axioms (Γ : TAxiomSet G) : Set (TWFAssertion G) := Γ

@[simp] theorem axioms_of (Γ : Set (TWFAssertion G)) : (of Γ).axioms = Γ := rfl

@[simp] theorem of_axioms (Γ : TAxiomSet G) : of Γ.axioms = Γ := rfl

variable [Infinite V]

/-- `Γ ≤ Δ` when every axiom of `Γ` is derivable from `Δ`. -/
instance : Preorder (TAxiomSet G) where
  le Γ Δ := Γ.axioms ⊆ theorems Δ.axioms
  le_refl Γ := subset_theorems Γ.axioms
  le_trans _ _ _ h₁ h₂ A hA := subset_theorems_iff.1 h₂ _ (h₁ hA)

theorem le_def {Γ Δ : TAxiomSet G} : Γ ≤ Δ ↔ Γ.axioms ⊆ theorems Δ.axioms := Iff.rfl

theorem le_of_subset {Γ Δ : TAxiomSet G} (h : Γ.axioms ⊆ Δ.axioms) : Γ ≤ Δ :=
  h.trans (subset_theorems _)

/-- `Γ ≤ Δ` exactly when `Δ` derives every tree theorem of `Γ`. -/
theorem le_iff_derivable {Γ Δ : TAxiomSet G} :
    Γ ≤ Δ ↔ ∀ A, TDerivable G (toSet Γ.axioms) A → TDerivable G (toSet Δ.axioms) A :=
  subset_theorems_iff

/-- `Γ ≤ Δ` exactly when the tree theory of `Γ` is contained in that of `Δ`. -/
theorem le_iff_theory {Γ Δ : TAxiomSet G} :
    Γ ≤ Δ ↔ TTheory.of Γ.axioms ≤ TTheory.of Δ.axioms :=
  (TTheory.of_le_iff (T := TTheory.of Δ.axioms)).symm

theorem antisymmRel_iff {Γ Δ : TAxiomSet G} :
    AntisymmRel (· ≤ ·) Γ Δ ↔ TTheory.of Γ.axioms = TTheory.of Δ.axioms := by
  rw [AntisymmRel, le_iff_theory, le_iff_theory]
  exact le_antisymm_iff.symm

/-- Tree axiom sets modulo equivalence are the tree theories. -/
def antisymmetrizationIso : Antisymmetrization (TAxiomSet G) (· ≤ ·) ≃o TTheory G where
  toFun := Quotient.lift (fun Γ : TAxiomSet G => TTheory.of Γ.axioms)
    fun _ _ h => antisymmRel_iff.1 h
  invFun T := toAntisymmetrization (· ≤ ·) (of T.val)
  left_inv q := by
    induction q using Quotient.inductionOn with
    | h Γ =>
      refine Quotient.sound (antisymmRel_iff.2 ?_)
      exact TTheory.of_val (TTheory.of Γ.axioms)
  right_inv T := TTheory.of_val T
  map_rel_iff' {a b} := by
    induction a using Quotient.inductionOn with
    | h Γ =>
      induction b using Quotient.inductionOn with
      | h Δ => exact le_iff_theory.symm

@[simp] theorem antisymmetrizationIso_apply (Γ : TAxiomSet G) :
    antisymmetrizationIso (toAntisymmetrization (· ≤ ·) Γ) = TTheory.of Γ.axioms := rfl

end TAxiomSet

end Silmaril.Logic.Metamath.Grammar
