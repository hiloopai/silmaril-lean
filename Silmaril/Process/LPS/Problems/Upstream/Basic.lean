module

public import Silmaril.Process.LPS.Problems.Basic
public import Silmaril.Process.LPS.Machines.RiscVLPS
public import Silmaril.Data.IncludeBytes

/-!
# OSS Verify's statements on the pinned riscv64 builds: images and pins

The statements of every entry point with a published proof (`Upstream/<Lib>/<Harness>.lean`,
generated by `tools/verification-projects/upstream_statements.py`) are definitions over the
four memory images of the harness's builds (`Images4`), on `Machines.riscvLps`, LPS's own
RV64GC machine. The images are `elf-snapshot`'s images of the ELF files `index/binaries.tsv`
pins by SHA-256; their bytes (about 290 MB of ELF for the 60 entry points) are not in the
repository. What is:

* `ImagePin`: per build, the ELF's name, size and SHA-256, and the shape of the image
  `elf-snapshot` extracts from it: the entry point, the program-header location, and per
  loaded segment its base, size, permission letters, byte count and the SHA-256 of its bytes.
* `ImagePin.AdmitsImage`: an image has the pinned shape (everything but the byte values and
  their hashes, which the generator checks).
* `ImagePin.wfB`, `ImagePin.imageWf`: `Images.v`'s `image_wf` (the anti-vacuity check, here
  `ImageWf riscvLps`) holds of *every* image with the pinned shape, decided on the pin alone.
  The three checks of `image_wf` read only the layout and the byte count of the segments: the
  entry fetch (`fetch_word`/`fetch_word_wx`) needs four bytes of an executable segment at an
  even entry point, the program-header read needs `num * ent` readable bytes, and the break
  check reads only bases and sizes. `wfB` decides the first two by these sufficient
  conditions (a failed `wfB` proves nothing), and the third exactly.

So `image_wf` is proved here, by `decide`, for every pinned image, and the data layer (out of
the repository) proves that each real image has its pin's shape (`AdmitsImage`), from which
`image_wf` of the real image follows. This is the chunked form of `Images.v`'s
`check_image_wf`: no decision procedure reads the segment bytes.

**What is and is not the upstream statement.** Every committed statement `S : Images4 → Prop`
is a family over all images. The upstream statement is `S images` at the real images, which
only the data layer (out of the repository) constructs. `Pins4.Admits` fixes the layout and
byte counts of the images, not their bytes (the segment SHA-256s in the pins are checked by
the generator, never in Lean), so any image of the right shape, all-zero bytes for example,
admits the pins, and `∃ I, pins.Admits I ∧ S I` is *not* the upstream statement. A committed
result about the upstream statement must be either about the real images, or of the form
`∀ I, pins.Admits I → S I`, which is stronger.

TODO(#3532): load the data-layer images through the ELF CST convention (`IsCST`,
`ELFImage.fromCst`; draft #3568, branch `elf/iscst`) once it lands, in place of the Python
port of `elf-snapshot`, and tie the bytes to the pins in Lean (a checked byte hash or the CST
route).
-/

@[expose] public section

namespace Silmaril.Process.LPS.Problems.Upstream

open Silmaril.Process.LPS Silmaril.Process.LPS.Machines

/-! ## The four images of a harness -/

/-- The memory images of the four builds of a harness (`Images.v`). -/
structure Images4 where
  plain : Image
  ubsan : Image
  asan : Image
  asanUbsan : Image

/-- The image of a build. -/
def Images4.get (I : Images4) : Build → Image
  | .plain => I.plain
  | .ubsan => I.ubsan
  | .asan => I.asan
  | .asanUbsan => I.asanUbsan

/-- A harness on `riscvLps` at the images `I`: every build has its image. -/
def Images4.problem (I : Images4) (h : Harness) : Problem where
  harness := h
  isa := riscvLps
  images b := some (I.get b)

theorem Images4.problem_scoped (I : Images4) (h : Harness) : (I.problem h).Scoped :=
  fun _ _ _ _ => rfl

/-- At four images, a statement is untranslated exactly when it needs the distribution and the
harness has none (no image is missing). -/
theorem Images4.problem_isUntranslated (I : Images4) (h : Harness) (s : Statement) :
    (I.problem h).isUntranslated s = (s.needsDistribution && h.distribution.isNone) := by
  simp [Problem.isUntranslated, Images4.problem]

/-- At four images, the untranslated statements are the harness's: those that need the
distribution. -/
theorem Images4.problem_untranslated (I : Images4) (h : Harness) :
    (I.problem h).untranslated = h.untranslated := by
  simp only [Problem.untranslated, Harness.untranslated, Images4.problem_isUntranslated]
  rfl

/-! ## Pins -/

/-- A loaded segment of a pinned image: `[base, base + size)`, its `"rwx"` letters, its byte
count and the SHA-256 of its bytes (checked by the generator, not here). -/
structure SegmentPin where
  base : Nat
  size : Nat
  perms : String
  len : Nat
  sha256 : String
  deriving DecidableEq, Repr

/-- A pinned image: the ELF it comes from and the shape `elf-snapshot` gives it. -/
structure ImagePin where
  file : String
  elfBytes : Nat
  elfSha256 : String
  initPc : Nat
  phdrs : PhdrInfo
  segments : List SegmentPin
  deriving DecidableEq, Repr

/-- A segment has the pinned shape. -/
def SegmentPin.AdmitsSeg (p : SegmentPin) (s : Segment) : Prop :=
  s.base = p.base ∧ s.size = p.size ∧ s.perms = p.perms ∧ s.bytes.length = p.len

/-- An image has the pinned shape: entry point, program headers, and segment by segment.
Only the shape: the bytes are not constrained, so this does not single out the real image. -/
def ImagePin.AdmitsImage (p : ImagePin) (img : Image) : Prop :=
  img.initPc = p.initPc ∧ img.phdrs = p.phdrs ∧ List.Forall₂ SegmentPin.AdmitsSeg p.segments
    img.segments

/-- The pins of the four builds. -/
structure Pins4 where
  plain : ImagePin
  ubsan : ImagePin
  asan : ImagePin
  asanUbsan : ImagePin
  deriving DecidableEq, Repr

def Pins4.get (P : Pins4) : Build → ImagePin
  | .plain => P.plain
  | .ubsan => P.ubsan
  | .asan => P.asan
  | .asanUbsan => P.asanUbsan

/-- Each image has its build's pinned shape. -/
def Pins4.Admits (P : Pins4) (I : Images4) : Prop :=
  P.plain.AdmitsImage I.plain ∧ P.ubsan.AdmitsImage I.ubsan ∧ P.asan.AdmitsImage I.asan ∧
    P.asanUbsan.AdmitsImage I.asanUbsan

theorem Pins4.Admits.get {P : Pins4} {I : Images4} (h : P.Admits I) :
    ∀ b, (P.get b).AdmitsImage (I.get b)
  | .plain => h.1
  | .ubsan => h.2.1
  | .asan => h.2.2.1
  | .asanUbsan => h.2.2.2

/-! ## `image_wf` from the shape -/

/-- The permission letter `c`, through `String.toList` (which reduces in the kernel). -/
def SegmentPin.hasPerm (c : Char) (p : SegmentPin) : Bool := p.perms.toList.contains c

/-- `RiscvSemantics.v` `find_segment` on pins (the ISA port's, over `Nat`). -/
def findPinN : List SegmentPin → Nat → Nat → Option SegmentPin
  | [], _, _ => none
  | p :: rest, a, n => if p.base ≤ a ∧ a + n ≤ p.base + p.size then some p else findPinN rest a n

/-- `find_segment` on pins (the process layer's, over `Int`). -/
def findPinZ : List SegmentPin → Int → Int → Option SegmentPin
  | [], _, _ => none
  | p :: rest, a, n =>
    if (p.base : Int) ≤ a ∧ a + n ≤ p.base + p.size then some p else findPinZ rest a n

/-- The entry point fetches a 32-bit word from an executable segment: a sufficient condition
for `image_entry_fetchable` on `riscvLps`. -/
def ImagePin.entryOk (p : ImagePin) : Bool :=
  decide (p.initPc < 2 ^ 64) && decide (p.initPc % 2 = 0) &&
    match findPinN p.segments p.initPc 4 with
    | some s => s.hasPerm 'x' && decide (p.initPc - s.base + 4 ≤ s.len)
    | none => false

/-- The program-header table is readable: `image_phdrs_readable` on the pin's shape. -/
def ImagePin.phdrsOk (p : ImagePin) : Bool :=
  decide (0 < p.phdrs.num) && decide (0 < p.phdrs.ent) &&
    match findPinZ p.segments (uns (zw p.phdrs.addr)) (p.phdrs.num * p.phdrs.ent : Nat) with
    | some s => s.hasPerm 'r' &&
        decide ((uns (zw p.phdrs.addr) - s.base).toNat + p.phdrs.num * p.phdrs.ent ≤ s.len)
    | none => false

/-- `segment_reservation` of a pinned segment. -/
def SegmentPin.reservation (s : SegmentPin) : Word × Word :=
  (zw (pageRoundDown s.base), zw (pageRoundUp (s.base + s.size) - pageRoundDown s.base))

/-- `image_brk_satisfiable` on the pin's shape. -/
def ImagePin.brkOk (p : ImagePin) : Bool :=
  decide (pageSize * ((reservedTop (p.segments.map SegmentPin.reservation) + (pageSize - 1)) /
    pageSize) < 2 ^ 64)

/-- The three checks of `Images.v` `image_wf`, on the pin. -/
def ImagePin.wfB (p : ImagePin) : Bool := p.entryOk && p.phdrsOk && p.brkOk

/-- Every pin of a harness passes `wfB`. -/
def Pins4.Wf (P : Pins4) : Prop :=
  P.plain.wfB = true ∧ P.ubsan.wfB = true ∧ P.asan.wfB = true ∧ P.asanUbsan.wfB = true

instance (P : Pins4) : Decidable P.Wf := by unfold Pins4.Wf; infer_instance

theorem Pins4.Wf.get {P : Pins4} (h : P.Wf) : ∀ b, (P.get b).wfB = true
  | .plain => h.1
  | .ubsan => h.2.1
  | .asan => h.2.2.1
  | .asanUbsan => h.2.2.2

section Proofs

theorem SegmentPin.AdmitsSeg.hasPerm {p : SegmentPin} {s : Segment} (h : p.AdmitsSeg s)
    (c : Char) : s.perms.contains c = p.hasPerm c := by
  rw [Segment.contains_eq_hasPerm, Segment.hasPerm, SegmentPin.hasPerm, h.2.2.1]

theorem findSegment_admits {ps : List SegmentPin} {segs : List Segment}
    (h : List.Forall₂ SegmentPin.AdmitsSeg ps segs) (a n : Int) :
    Option.Rel SegmentPin.AdmitsSeg (findPinZ ps a n) (findSegment segs a n) := by
  induction h with
  | nil => exact Option.Rel.none
  | @cons p s ps segs hps _ ih =>
    simp only [findPinZ, findSegment, hps.1, hps.2.1]
    split
    · exact Option.Rel.some hps
    · exact ih

/-- A pinned segment and the ISA port's view of an image segment with its shape. -/
def LpsAdmits (p : SegmentPin) (t : RiscV.LPS.Segment) : Prop :=
  ∃ s : Segment, p.AdmitsSeg s ∧ t = lpsSegment s

theorem lpsFindSegment_admits {ps : List SegmentPin} {segs : List Segment}
    (h : List.Forall₂ SegmentPin.AdmitsSeg ps segs) (a n : Nat) :
    Option.Rel LpsAdmits (findPinN ps a n) (RiscV.LPS.findSegment (lpsSegments segs) a n) := by
  induction h with
  | nil => exact Option.Rel.none
  | @cons p s ps segs hps _ ih =>
    show Option.Rel LpsAdmits (findPinN (p :: ps) a n)
      (RiscV.LPS.findSegment (lpsSegment s :: lpsSegments segs) a n)
    simp only [findPinN, RiscV.LPS.findSegment]
    rw [show (lpsSegment s).base = p.base from hps.1, show (lpsSegment s).size = p.size from hps.2.1]
    split
    · exact Option.Rel.some ⟨s, hps, rfl⟩
    · exact ih

/-- A segment image without holes reads every in-range window. -/
theorem segmentReadBytes_some (data : Array (Option RiscV.LPS.Byte))
    (full : ∀ x ∈ data, x.isSome) :
    ∀ (n off : Nat), off + n ≤ data.size →
      ∃ l, RiscV.LPS.segmentReadBytes data off n = some l ∧ l.length = n
  | 0, _, _ => ⟨[], rfl, rfl⟩
  | n + 1, off, h => by
    obtain ⟨l, hl, hlen⟩ := segmentReadBytes_some data full n (off + 1) (by omega)
    have hoff : off < data.size := by omega
    obtain ⟨b, hb⟩ := Option.isSome_iff_exists.1 (full data[off] (Array.getElem_mem hoff))
    refine ⟨b :: l, ?_, by simp [hlen]⟩
    simp only [RiscV.LPS.segmentReadBytes, RiscV.LPS.segmentByteAt, hl]
    rw [Array.getElem?_eq_getElem hoff, hb]
    rfl

theorem lpsSegment_full (s : Segment) : ∀ x ∈ (lpsSegment s).data, x.isSome := by
  intro x hx
  simp only [lpsSegment, RiscV.LPS.Segment.bytesData, List.mem_toArray, List.mem_map] at hx
  obtain ⟨b, -, rfl⟩ := hx
  rfl

theorem list_length_four {α : Type _} {l : List α} (h : l.length = 4) :
    ∃ a b c d, l = [a, b, c, d] := by
  match l, h with
  | [a, b, c, d], _ => exact ⟨a, b, c, d, rfl⟩

theorem _root_.Option.Rel.some_left {α β : Type _} {R : α → β → Prop} {a : Option α}
    {b : Option β} {x : α} (h : Option.Rel R a b) (hx : a = some x) : ∃ y, b = some y ∧ R x y := by
  cases h with
  | none => cases hx
  | some r => cases hx; exact ⟨_, rfl, r⟩

/-- A 2-aligned address four bytes inside an executable segment fetches a word, through
`fetch_word` (not writable) or `fetch_word_wx` (writable). -/
theorem fetch_of_executable (segs : List RiscV.LPS.Segment) (addr : Word) (t : RiscV.LPS.Segment)
    (heven : addr.toNat % 2 = 0) (hf : RiscV.LPS.findSegment segs addr.toNat 4 = some t)
    (hx : t.executable = true) (full : ∀ x ∈ t.data, x.isSome)
    (hsz : addr.toNat - t.base + 4 ≤ t.data.size) :
    (RiscV.LPS.fetchWord segs addr).isSome ∨ (RiscV.LPS.fetchWordWx segs addr).isSome := by
  obtain ⟨l, hl, hll⟩ := segmentReadBytes_some t.data full 4 (addr.toNat - t.base) hsz
  obtain ⟨a, b, c, d, rfl⟩ := list_length_four hll
  cases hw : t.writable
  · left
    simp [RiscV.LPS.fetchWord, RiscV.LPS.codeRead, heven, hf, hx, hw, hl]
  · right
    simp [RiscV.LPS.fetchWordWx, RiscV.LPS.codeReadWx, heven, hf, hx, hw, hl]

theorem ImagePin.entryOk_sound {p : ImagePin} {img : Image} (ha : p.AdmitsImage img)
    (h : p.entryOk = true) : riscvLps.entryFetchable img.segments img.initPc = true := by
  obtain ⟨hpc, -, hsegs⟩ := ha
  simp only [ImagePin.entryOk, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨hlt, heven⟩, hfind⟩ := h
  split at hfind
  · rename_i sp hsp
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hfind
    obtain ⟨hx, hlen⟩ := hfind
    obtain ⟨t, ht, s, hs, rfl⟩ := (lpsFindSegment_admits hsegs p.initPc 4).some_left hsp
    have hnat : (BitVec.ofNat 64 img.initPc).toNat = p.initPc := by
      rw [hpc, BitVec.toNat_ofNat]; exact Nat.mod_eq_of_lt hlt
    have hex : (lpsSegment s).executable = true := by
      simp only [RiscV.LPS.Segment.executable, lpsSegment, Segment.executable, hs.hasPerm, hx]
    have hsize : (BitVec.ofNat 64 img.initPc).toNat - (lpsSegment s).base + 4 ≤
        (lpsSegment s).data.size := by
      simp only [lpsSegment, RiscV.LPS.Segment.bytesData, List.size_toArray, List.length_map,
        hnat, hs.1, hs.2.2.2]; omega
    rw [← hnat] at ht heven
    have := fetch_of_executable _ _ _ heven ht hex (lpsSegment_full s) hsize
    show lpsEntryFetchable img.segments img.initPc = true
    unfold lpsEntryFetchable
    rcases this with h1 | h1
    · obtain ⟨w, hw⟩ := Option.isSome_iff_exists.1 h1
      simp only [hw]
    · obtain ⟨w, hw⟩ := Option.isSome_iff_exists.1 h1
      simp only [hw]
      split <;> rfl
  · exact absurd hfind (by simp)

theorem mapM_range_isSome {α : Type _} (f : Nat → Option α) :
    ∀ n, (∀ k < n, (f k).isSome) → ((List.range n).mapM f).isSome
  | 0, _ => rfl
  | n + 1, h => by
    rw [List.range_succ, List.mapM_append]
    obtain ⟨xs, hxs⟩ := Option.isSome_iff_exists.1
      (mapM_range_isSome f n fun k hk => h k (by omega))
    obtain ⟨x, hx⟩ := Option.isSome_iff_exists.1 (h n (by omega))
    simp [hxs, hx]

theorem ImagePin.phdrsOk_sound {p : ImagePin} {img : Image} (ha : p.AdmitsImage img)
    (h : p.phdrsOk = true) : imagePhdrsReadable img.segments img.phdrs = true := by
  obtain ⟨-, hph, hsegs⟩ := ha
  simp only [ImagePin.phdrsOk, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨hnum, hent⟩, hfind⟩ := h
  split at hfind
  · rename_i sp hsp
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hfind
    obtain ⟨hr, hlen⟩ := hfind
    obtain ⟨s, hs, hsr⟩ := (findSegment_admits hsegs _ _).some_left hsp
    simp only [imagePhdrsReadable, hph, Bool.and_eq_true, decide_eq_true_eq]
    refine ⟨⟨hnum, hent⟩, ?_⟩
    simp only [memoryRead]
    rw [hs]
    have hrd : s.readable = true := by
      simp only [Segment.readable, hsr.hasPerm, hr]
    simp only [hrd, ite_true]
    apply mapM_range_isSome
    intro k hk
    simp only [Segment.byteAt]
    rw [Option.isSome_iff_exists]
    exact ⟨_, List.getElem?_eq_getElem (by rw [hsr.2.2.2, hsr.1]; omega)⟩
  · exact absurd hfind (by simp)

theorem segmentsReserved_admits {ps : List SegmentPin} {segs : List Segment}
    (h : List.Forall₂ SegmentPin.AdmitsSeg ps segs) :
    segmentsReserved segs = ps.map SegmentPin.reservation := by
  induction h with
  | nil => rfl
  | @cons p s ps segs hps _ ih =>
    simp only [segmentsReserved, List.map_cons] at ih ⊢
    rw [ih]
    simp only [segmentReservation, SegmentPin.reservation, hps.1, hps.2.1]

theorem ImagePin.brkOk_sound {p : ImagePin} {img : Image} (ha : p.AdmitsImage img)
    (h : p.brkOk = true) : imageBrkSatisfiable img.segments = true := by
  simp only [imageBrkSatisfiable, imageBrkWitness, segmentsReserved_admits ha.2.2]
  exact h

/-- `Images.v` `image_wf`, for every image with the pinned shape. -/
theorem ImagePin.imageWf {p : ImagePin} (h : p.wfB = true) {img : Image}
    (ha : p.AdmitsImage img) : ImageWf riscvLps img := by
  simp only [ImagePin.wfB, Bool.and_eq_true] at h
  exact ⟨ImagePin.entryOk_sound ha h.1.1, ImagePin.phdrsOk_sound ha h.1.2,
    ImagePin.brkOk_sound ha h.2⟩

/-- `image_wf` of the four images, from the pins. -/
theorem Pins4.imageWf {P : Pins4} (hP : P.Wf) (I : Images4) (h : P.Admits I) (b : Build) :
    ImageWf riscvLps (I.get b) :=
  ImagePin.imageWf (hP.get b) (h.get b)

end Proofs

/-! ## `include_bytes` images have the pinned byte count -/

theorem length_bytesChunks (c : Nat) :
    ∀ (len : Nat) (cs : List Nat),
      (IncludeBytes.bytesChunks c len cs).length = min len (c * cs.length)
  | _, [] => by simp [IncludeBytes.bytesChunks_nil]
  | len, x :: cs => by
    rw [IncludeBytes.bytesChunks_cons, List.length_append, IncludeBytes.length_bytesLE,
      length_bytesChunks c (len - c) cs, List.length_cons, Nat.mul_succ]
    omega

/-- The byte count of a segment whose bytes are `include_bytes`d. -/
theorem length_decode_bytes (c len : Nat) (cs : List Nat) :
    ((IncludeBytes.decode c len cs).data.toList.map UInt8.toBitVec).length =
      min len (c * cs.length) := by
  rw [List.length_map, IncludeBytes.decode_eq, length_bytesChunks]

end Silmaril.Process.LPS.Problems.Upstream
