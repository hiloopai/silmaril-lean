/-- The statements the release proves, each with its definition. -/
def provedStatements : List (String × (Images4 → Prop)) :=
  [("asan_ubsan_agrees", asan_ubsan_agrees)]

/-- `Images.v` `<build>_wf`, through the pins: every image with the pinned shape is
well formed on `riscvLps`. -/
theorem pins_wf : pins.Wf := by decide

theorem images_wf (I : Images4) (h : pins.Admits I) (b : Build) :
    ImageWf riscvLps (I.get b) :=
  pins.imageWf pins_wf I h b

