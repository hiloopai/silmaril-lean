module

public import Silmaril.Data.BinaryImage
public import Silmaril.Data.ByteLiterals.Types
public meta import Lean.Elab.Command

/-! # Binary images from existing chunked byte literals

Generated byte modules (`hex_bv8`, `include_bv8`, the `tools/elf-ast` `Bytes.lean` files) already
store a file as `ByteLiterals.toBitVecBytes (IncludeBytes.decode chunk size [c₀, c₁, …])`, the
same chunk literals as a `binary_image`. `bits_mk_decode` says that the `binary_image` with those
literals has exactly these bytes, for any literals, so the L0 bridge `bits_eq` needs no
evaluation:

```
binary_image foo of_literal Bytes.original
-- noncomputable def foo : Silmaril.BinaryImage := ⟨4096, N, [c₀, …], ""⟩
-- theorem foo.wf : foo.WF
-- theorem foo.bits_eq_source : foo.bits = Bytes.original
```

The command reads the literals from the definition of `src` (following constant aliases); it
does not evaluate `src`, read a file or compute a hash, and the kernel checks
`foo.bits_eq_source` by unfolding both sides to the same literals. -/

@[expose] public section

namespace Silmaril.BinaryImage

open Silmaril.IncludeBytes

theorem toBitVec_eq_ofNat (byte : UInt8) : byte.toBitVec = BitVec.ofNat 8 byte.toNat := by
  apply BitVec.eq_of_toNat_eq
  simp

/-- A `binary_image` built from the chunk literals of a generated byte literal has exactly its
bytes. -/
theorem bits_mk_decode (chunk size : Nat) (chunks : List Nat) (pin : String) :
    (⟨chunk, size, chunks, pin⟩ : BinaryImage).bits =
      ByteLiterals.toBitVecBytes (decode chunk size chunks) := by
  simp only [bits, BinaryImage.bytes, ByteLiterals.toBitVecBytes]
  congr 1
  exact List.map_congr_left fun byte _ => toBitVec_eq_ofNat byte

open Lean Elab Command Meta in
/-- The chunk literals `(chunk, size, chunks)` of a term `toBitVecBytes (decode chunk size cs)`,
following constant definitions. -/
meta partial def literalChunks (env : Environment) (e : Expr) (fuel : Nat := 64) :
    Option (Expr × Expr × Expr) :=
  if e.isAppOfArity ``ByteLiterals.toBitVecBytes 1 then
    let inner := e.appArg!
    if inner.isAppOfArity ``decode 3 then
      let args := inner.getAppArgs
      some (args[0]!, args[1]!, args[2]!)
    else none
  else match fuel, e with
    | fuel + 1, .const name _ => do
      let some (.defnInfo info) := env.find? name | none
      literalChunks env info.value fuel
    | _, _ => none

syntax (name := binaryImageOfLiteralCmd) "binary_image " ident " of_literal " ident : command

open Lean Elab Command Meta in
elab_rules : command
  | `(binary_image $id of_literal $src) => do
  let srcName ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo src
  let env ← getEnv
  let some (chunk, size, chunks) := literalChunks env (mkConst srcName)
    | throwError "binary_image: `{srcName}` does not unfold to `toBitVecBytes (decode …)`"
  let name := (← getCurrNamespace) ++ id.getId
  let image := mkApp4 (mkConst ``BinaryImage.mk) chunk size chunks (mkStrLit "")
  liftCoreM <| addDecl <| .defnDecl
    { name, levelParams := [], type := mkConst ``BinaryImage, value := image,
      hints := .regular 0, safety := .safe }
  let bitsEq := mkApp4 (mkConst ``bits_mk_decode) chunk size chunks (mkStrLit "")
  let bitsType ← liftTermElabM do
    mkEq (mkApp (mkConst ``BinaryImage.bits) (mkConst name)) (mkConst srcName)
  liftCoreM <| addDecl <| .thmDecl
    { name := name ++ `bits_eq_source, levelParams := [], type := bitsType, value := bitsEq }
  let sub (s : Name) := mkIdentFrom id (id.getId ++ s)
  elabCommand (← `(set_option maxRecDepth 100000 in
    theorem $(sub `wf) : ($id).WF := by decide))

end Silmaril.BinaryImage
