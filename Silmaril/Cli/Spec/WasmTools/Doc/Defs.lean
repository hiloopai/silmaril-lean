      ("verbose", "Use verbose output (-v info, -vv debug, -vvv trace)"),
      ("color", "Configuration over whether terminal colors are used in output.\n\nSupports one of `auto|never|always|always-ansi`. The default is to detect what to do based on the terminal environment, for example by using `isatty`."),
      ("wat", "Output the text format of WebAssembly instead of the binary format"),
      ("seed", "The RNG seed used to choose which transformation to apply. Given the same input Wasm and same seed, `wasm-mutate` will always generate the same output Wasm"),
      ("preserve-semantics", "Only perform semantics-preserving transformations on the Wasm module"),
      ("fuel", "Fuel to control the time of the mutation"),
      ("reduce", "Only perform size-reducing transformations on the Wasm module. This allows `wasm-mutate` to be used as a test case reducer"),
