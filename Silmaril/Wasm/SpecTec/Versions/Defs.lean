module

public import Silmaril.Raw.Wasm.SpecTec.Scripts
public import Silmaril.Wasm.SpecTec.Broken.Defs

/-!
# SpecTec versions: the `WebAssembly/spec` main scripts, and defect predicates across versions

`Silmaril.Wasm.SpecTec.Scripts` names the scripts of the pinned revision `608711107b` (the
*original* streams, kept unchanged as the worked example of importing a SpecTec specification
with defects) and their errata-fixed versions.  This module adds, alongside them, the scripts of a
later `WebAssembly/spec` main revision:

* `Versions.Main.Wasm10.original`, `Versions.Main.Wasm20.original`,
  `Versions.Main.Wasm30.original` — the elaborated `--ast` streams of
  `WebAssembly/spec@e7a9df7cdd351df9d8d8546a53248669d51c1aa8` (2026-11-03), vendored under
  `specs/spectec/e7a9df7c/` and generated by `tools/spectec-gen` as
  `Silmaril.Raw.Wasm.SpecTec.Scripts.Main.*`.  (`specification/wasm-latest` at that revision prints
  byte for byte the same stream as `wasm-3.0`, so it is recorded in the manifest as an alias and
  not generated twice.)

and the predicates that a defect needs when its definition was restructured upstream, so that the
pinned predicates of `Silmaril.Wasm.SpecTec.Broken` would hold vacuously (for instance `$utf8` became
`$utf8single` in wasm-3.0).  The theorems are in `Silmaril.Wasm.SpecTec.Versions.Thms`; the table in
`docs/projects/spectec-divergences.md` lists each defect at each revision.
-/

@[expose] public section

namespace Silmaril.Wasm.SpecTec.Versions

open Silmaril.SpecTec
open Silmaril.SpecTec.IL hiding Id Prod
open Silmaril.SpecTec.Sem
open Silmaril.Wasm.SpecTec.Broken

/-- The `WebAssembly/spec` revision of the main scripts. -/
def mainRevision : String := "e7a9df7cdd351df9d8d8546a53248669d51c1aa8"

namespace Main

namespace Wasm10

/-- The wasm-1.0 script of `WebAssembly/spec@e7a9df7c`. -/
noncomputable abbrev original : Script := Silmaril.Wasm.SpecTec.Scripts.Main.Wasm10.Original.script

/-- Lookup environment of `original`. -/
noncomputable abbrev env : Sem.Env := Sem.envOfScript original

end Wasm10

namespace Wasm20

/-- The wasm-2.0 script of `WebAssembly/spec@e7a9df7c`. -/
noncomputable abbrev original : Script := Silmaril.Wasm.SpecTec.Scripts.Main.Wasm20.Original.script

/-- Lookup environment of `original`. -/
noncomputable abbrev env : Sem.Env := Sem.envOfScript original

end Wasm20

namespace Wasm30

/-- The wasm-3.0 (= wasm-latest) script of `WebAssembly/spec@e7a9df7c`. -/
noncomputable abbrev original : Script := Silmaril.Wasm.SpecTec.Scripts.Main.Wasm30.Original.script

/-- Lookup environment of `original`. -/
noncomputable abbrev env : Sem.Env := Sem.envOfScript original

end Wasm30

end Main

/-! ## Predicates parametrised by where the definition lives -/

/-- The four-byte UTF-8 clause `k` of the function `f` rejects U+1F601 with its own spelling
`F0 9F 98 81`.  `Broken.Utf8RejectsGrin s` is `Utf8ClauseRejectsGrin s "utf8" 4`; on the main
wasm-3.0 script the clause is clause 3 of `$utf8single`. -/
def Utf8ClauseRejectsGrin (s : Script) (f : IL.Id) (k : Nat) : Prop :=
  PremsFail s (clausePrems s f k) grinScope

/-- The four-byte UTF-8 clause `k` of `f` accepts U+1F601 with `F0 9F 98 81`. -/
def Utf8ClauseAcceptsGrin (s : Script) (f : IL.Id) (k : Nat) : Prop :=
  PremsHold s (clausePrems s f k) grinScope

/-- The two-byte UTF-8 clause `k` of `f` accepts `C2 C0` for U+00C0 (`C0` is not a continuation
byte; #685).  `Broken.Utf8AcceptsC2C0 s` is `Utf8ClauseAcceptsC2C0 s "utf8" 1`. -/
def Utf8ClauseAcceptsC2C0 (s : Script) (f : IL.Id) (k : Nat) : Prop :=
  PremsHold s (clausePrems s f k) c2c0Scope

/-- The reference type `REF FUNC` (non-null `funcref`) as an IL expression: the `REF` case of
`syntax reftype = REF null? heaptype`, with `null?` empty and the abstract heap type `FUNC`. -/
def refFuncE : Exp := .caseE "REF" (.tupE [.optE none, .caseE "FUNC" (.tupE [])])

/-- **`$sx` is undefined at reference storage types** (sim upstream item U5).  `$sx(REF FUNC)`
has no value at any fuel, so `array.copy-le`/`-gt` (premise `sx? = $sx(zt_2)`) cannot fire on
an array of references. -/
def SxUndefAtRef (s : Script) : Prop := CallUndef s "sx" [.expA refFuncE]

/-- The function `f` is declared with no clauses (and the script installs no builtins), so it has
no value at any argument. -/
def NoClauses (s : Script) (f : IL.Id) : Prop :=
  ∃ ps t, (envOfScript s).findDef? f = some (ps, t, [])

/-- **`$s33_to_u32` is declared and never defined** (`3.1-numerics.scalar.spectec:7`
`def $s33_to_u32(s33) : u32  hint(show %)`, no clauses and no `hint(builtin)`), so the type
index production of `Bheaptype` (`5.2-binary.types.spectec:32`,
`x33:Bs33 => _IDX $s33_to_u32(x33)`) produces nothing. -/
def S33ToU32Undefined (s : Script) : Prop := NoClauses s "s33_to_u32"

/-- **`$ieee_` is declared and never defined** (`6.1-text.values.spectec:55`
`def $ieee_(N, rat) : fNmag(N)`, no clauses and no `hint(builtin)`; the `spectec-gen version`
lint finding at `e7a9df7c`), so the two productions of the text grammar `TfNmag` that read a
decimal or hexadecimal float literal (`q:Tfloat => $ieee_(N, q)` and `q:Thexfloat => …`) have
no value: in the IL only `inf`, `nan` and `nan:0x…` denote a float. -/
def IeeeUndefined (s : Script) : Prop := NoClauses s "ieee_"

end Silmaril.Wasm.SpecTec.Versions
