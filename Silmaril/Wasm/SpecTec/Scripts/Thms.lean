module

public import Silmaril.Wasm.SpecTec.Scripts.Defs
public import Silmaril.Wasm.SpecTec.Scripts.Original.Thms
public import Silmaril.Proofs.Wasm.SpecTec.Scripts.Fixed
import all Silmaril.Raw.Wasm.SpecTec.SpecTec.Specs
import all Silmaril.Raw.Wasm.SpecTec.SpecTec.Errata.Binary51
import all Silmaril.Raw.Wasm.SpecTec.SpecTec.Errata.Text6x
import Silmaril.Raw.Wasm.SpecTec.SpecTec.Errata.Valid

/-!
# SpecTec scripts: what the names denote

The scripts of `Silmaril.Wasm.SpecTec.Scripts` are explicit Lean terms generated by
`tools/spectec-gen`.  Proved here, in the kernel:

* each generated original equals the elaboration-time import (`wasm30_original_eq` and the
  wasm-1.0/2.0 analogues), and each generated fixed script equals the `spectec_erratum` splices
  (`wasm30_binary51_eq`, `wasm30_text6x_eq`, `wasm20_fixed_eq`, `wasm10_fixed_eq`);
* all thirteen wasm-3.0 patches apply to the original and give `fixed`
  (`applyErrata_wasm30_fixed`), which has 976 definitions (`length_wasm30_fixed`), is the
  original with `fixedPatch` mapped over it (`fixed_eq_map`), and differs from it only in
  definitions declaring one of the thirteen targets (`fixedPatch_eq_self`).

**What is not proved.**  These are equalities of Lean terms.  The link from the terms to the
bytes of `specs/spectec/*.ast` is twofold and both halves are compiled code, not kernel proofs:
the unverified Rust generator (re-run by CI with `check`) and the elaboration-time import
(`spectec_import`).  That two independent readers agree is what the equalities establish.
-/

public section

namespace Silmaril.Wasm.SpecTec.Scripts

open Silmaril.SpecTec
open Silmaril.SpecTec.IL hiding Id Prod

set_option maxRecDepth 100000

theorem wasm30_binary51_eq : Wasm30.binary51 = IL.Binary51.wasm30binary51 :=
  generated_wasm30_binary51_eq

theorem wasm30_text6x_eq : Wasm30.text6x = IL.Text6x.wasm30text6x := generated_wasm30_text6x_eq

theorem wasm20_fixed_eq : Wasm20.fixed = IL.Wasm20.wasm20corrected := generated_wasm20_fixed_eq

theorem wasm10_fixed_eq : Wasm10.fixed = IL.Wasm10.wasm10corrected := generated_wasm10_fixed_eq

/-- The wasm-1.0 errata apply to the original and produce `fixed`. -/
theorem applyErrata_wasm10_fixed :
    applyErrata Wasm10.fixedErrata Wasm10.original = some Wasm10.fixed := by
  rw [wasm10_original_eq, wasm10_fixed_eq]
  exact IL.Wasm10.applyErrata_wasm10errata

/-- The wasm-2.0 errata apply to the original and produce `fixed`. -/
theorem applyErrata_wasm20_fixed :
    applyErrata Wasm20.fixedErrata Wasm20.original = some Wasm20.fixed := by
  rw [wasm20_original_eq, wasm20_fixed_eq]
  exact IL.Wasm20.applyErrata_wasm20errata

/-- The combined wasm-3.0 errata are the binary §5.1 ones followed by the text §6.x ones. -/
theorem fixedErrata_eq : Wasm30.fixedErrata = IL.Binary51.binary51 ++ IL.Text6x.text6x := rfl

/-- Applying a concatenation of errata applies the first list, then the second. -/
theorem applyErrata_append : ∀ (es₁ es₂ : List Erratum) (s : Script),
    applyErrata (es₁ ++ es₂) s = (applyErrata es₁ s).bind (applyErrata es₂)
  | [], _, _ => rfl
  | e :: es₁, es₂, s => by
      simp only [List.cons_append, applyErrata_cons]
      cases applyErratum e s with
      | none => rfl
      | some s' => exact applyErrata_append es₁ es₂ s'

set_option maxHeartbeats 2000000 in
/-- The nine text §6.x patches also apply on top of the binary §5.1 corrections: each target is
still declared exactly once and each patch still changes its definition. -/
theorem applyErrata_text6x_binary51 :
    applyErrata IL.Text6x.text6x IL.Binary51.wasm30binary51 = some Wasm30.fixed := by
  rw [Wasm30.fixed, generated_wasm30_fixed_eq]
  rfl

/-- All thirteen wasm-3.0 patches (binary §5.1, then text §6.x) apply in turn to the pinned
script, and `fixed` is their result.  The kernel computes each `Erratum.applies` check. -/
theorem applyErrata_wasm30_fixed :
    applyErrata Wasm30.fixedErrata Wasm30.original = some Wasm30.fixed := by
  rw [fixedErrata_eq, applyErrata_append, wasm30_original_eq, IL.Binary51.applyErrata_binary51,
    Option.bind_some]
  exact applyErrata_text6x_binary51

/-- `applyErrata_wasm30_fixed` with the imported constant as the base, the form
`spectec_revalidate` checks. -/
theorem applyErrata_wasm30_fixed_specs :
    applyErrata Wasm30.fixedErrata Specs.wasm30 = some Wasm30.fixed :=
  wasm30_original_eq ▸ applyErrata_wasm30_fixed

/-- The fixed script has the same 976 top-level definitions as the original. -/
theorem length_wasm30_fixed : Wasm30.fixed.length = 976 := by
  simp only [Wasm30.fixed, generated_wasm30_fixed_eq, length_replaceDefs,
    IL.Binary51.length_wasm30binary51]
  rfl

/-- The patches act on each top-level definition independently and in place. -/
theorem fixed_eq_map : Wasm30.fixed = Wasm30.original.map Wasm30.fixedPatch := by
  rw [Wasm30.fixed, generated_wasm30_fixed_eq, wasm30_original_eq]
  simp [Wasm30.fixedPatch, IL.Text6x.text6xPatch, IL.Binary51.wasm30binary51_eq_map,
    replaceDefs_eq_map, List.map_map, Function.comp_def]

/-- **Nowhere else.**  A definition declaring none of the thirteen wasm-3.0 targets, in any
namespace and at any depth inside a `recD` group, comes through `fixedPatch` untouched. -/
theorem fixedPatch_eq_self {d : Def} (h₁ : countDef "Bi32" d = 0)
    (h₂ : countDef "Bi64" d = 0) (h₃ : countDef "cont" d = 0)
    (h₄ : countDef "utf8" d = 0) (h₅ : countDef "Tstringchar" d = 0)
    (h₆ : countDef "Tfloat" d = 0) (h₇ : countDef "Thexfloat" d = 0)
    (h₈ : countDef "Talign_" d = 0) (h₉ : countDef "Ttypeuse_" d = 0)
    (h₁₀ : countDef "Tblockcomment" d = 0) (h₁₁ : countDef "Tblockchar" d = 0)
    (h₁₂ : countDef "Texporttabledots_" d = 0) (h₁₃ : countDef "Treserved" d = 0) :
    Wasm30.fixedPatch d = d := by
  rw [Wasm30.fixedPatch, IL.Binary51.binary51Patch_eq_self h₁ h₂ h₃ h₄]
  exact IL.Text6x.text6xPatch_eq_self h₅ h₆ h₇ h₈ h₉ h₁₀ h₁₁ h₁₂ h₁₃

end Silmaril.Wasm.SpecTec.Scripts

/-! ## The combined wasm-3.0 script passes the IL checker

Re-reads `wasm-3.0.ast`, applies `fixedErrata` in compiled code, checks the result agrees with
`applyErrata_wasm30_fixed_specs`, and runs the IL validator with its sensitivity checks; the
build fails otherwise.  This is a compiled check, not a kernel proof. -/

spectec_revalidate Silmaril.Wasm.SpecTec.Scripts.Wasm30.fixed
  by Silmaril.Wasm.SpecTec.Scripts.Wasm30.fixedErrata
  on Silmaril.SpecTec.Specs.wasm30 from "specs/spectec/wasm-3.0.ast"
  tying Silmaril.Wasm.SpecTec.Scripts.applyErrata_wasm30_fixed_specs
