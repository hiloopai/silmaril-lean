module

public import Silmaril.Wasm.Models.FunCloCompile.Defs
public import Silmaril.Games.Strategy.Defs

/-!
# FunClo observed at first-order function type: the closure game

`funCloModel` (`Silmaril.Wasm.Models.FunClo`) observes programs at ground type: the word a
program returns. This module observes programs whose result is a **first-order function**, such
as `int → int` or `int → int → bool`, by a game in which closures are moves.

* `Ty.FO`: the first-order types, `int`, `bool` and `arr int τ` for first-order `τ`.
  `Prog.GOk p`: the program has a first-order result type and is within the compiler's limits.
* `Op`, `Ans`, `cloSig`: the closure signature. Opponent asks `main n` (run the program on `n`)
  or `call h m` (apply the closure with **handle** `h` to `m`). Proponent answers with a word
  (`Ans.word w`), or with `Ans.fn`, a closure move: the value is a function, and it gets the next
  handle. Handles are numbered in the order of the `fn` answers of the play, so a handle is a
  pointer to an earlier answer, as in Hyland–Ong games.
* `SrcStep`, `SrcRun`, `srcStrat p`: the **source strategy**. A run keeps the closures returned
  so far (`push`). `main n` evaluates the program, `call h m` the body of closure `h` on `m`.
  `srcStrat p` is the strategy generated by the plays of the runs (`Strategy.generate`; an
  unanswered question is the receptive extension, and divergence is no answer).
* `mainRFunc p`, `mainRInst p`, `storeG p`: the **harness** of the compiled module. `storeG p`
  is `storeOf p` (the store of instantiating `moduleOf p`, `main` at `0` and `apply` at `1`)
  with a third function at address `2`, `mainR`. It shares `apply`'s type and module instance;
  it runs the program's code on its second argument and returns the reference to the result
  instead of unboxing it, so a closure result reaches the environment as a reference.
* `Returns`, `invokeOf`, `WRun`, `wasmStrat P host p`: the **compiled strategy**. A Wasm run
  threads the store through invocations: `main n` invokes `mainR` on `[i31 0, i31 n]` and
  `call h m` invokes `apply` (address `1`) on `[w, i31 m]`, where `w` is the reference returned
  for handle `h`. An answer is read off the returned reference (`readAns`): an `i31` is a word,
  anything else is a closure move. Runs count invocations that return one value (any run, under
  any profile and host relation).

`Thms.wasmStrat_eq`: for every program that `Prog.GOk` accepts, at every profile and host,
`wasmStrat P host p = srcStrat p`, including programs and closures that diverge.

New definitions.
-/

@[expose] public section

namespace Silmaril.Wasm.Models.FunClo

/-! ## Types and programs -/

/-- **First-order types**: ground types, and functions from `int` to a first-order type. -/
def Ty.FO : Ty → Prop
  | .int | .bool => True
  | .arr .int τ => Ty.FO τ
  | _ => False

/-- A program the game reading accepts: its body has a first-order type in `[int]`, and it is
within the compiler's limits. -/
def Prog.GOk (p : Prog) : Prop := HasTy [.int] p.body p.res ∧ p.res.FO ∧ p.Fits

end Silmaril.Wasm.Models.FunClo

namespace Silmaril.Wasm.Models.FunCloGame

open Silmaril.Wasm Silmaril.Wasm.Execution.Core
open Silmaril.Games
open Silmaril.Wasm.Models.FunClo (Tm Ty Prog HasTy eval obsWord)
open Silmaril.Wasm.Models.FunCloCompile (compile instOf storeOf mainInst applyInst dApply)
open Silmaril.Wasm.Models.FunCompile (anyref)

/-! ## The closure signature -/

/-- Opponent's questions. -/
inductive Op where
  /-- Run the program on `n`. -/
  | main (n : BitVec 31)
  /-- Apply the closure with handle `h` to `m`. -/
  | call (h : Nat) (m : BitVec 31)
  deriving DecidableEq, Repr

/-- Proponent's answers. -/
inductive Ans where
  /-- A closure move: the value is a function, named by the next handle. -/
  | fn
  /-- A ground value, as its word. -/
  | word (w : BitVec 31)
  deriving DecidableEq, Repr

/-- **The closure signature.** -/
def cloSig : Sig.{0} := ⟨Op, fun _ => Ans⟩

/-- The play of a sequence of answered questions. -/
def toPlay : List (Op × Ans) → List (Move Sig.empty cloSig)
  | [] => []
  | (o, a) :: t => .inr (.ask o) :: .inr (.ans o a) :: toPlay t

/-! ## The source strategy -/

/-- The answer of a source value. -/
def ansOf : FunClo.Val → Ans
  | .clo _ _ => .fn
  | v => .word (obsWord v)

/-- The handles after answering with `v`: a closure gets the next handle. -/
def push (H : List FunClo.Val) : FunClo.Val → List FunClo.Val
  | .clo b ρ => H ++ [.clo b ρ]
  | _ => H

/-- **One source step**: the value of the question with the handles `H`. -/
def SrcStep (p : Prog) (H : List FunClo.Val) : Op → FunClo.Val → Prop
  | .main n, v => p.Eval n v
  | .call h m, v => ∃ b ρ k, H[h]? = some (.clo b ρ) ∧
      eval k (.int m :: .clo b ρ :: ρ) b = some v

/-- **Source runs** from the handles `H`. -/
inductive SrcRun (p : Prog) : List FunClo.Val → List (Op × Ans) → Prop
  | nil (H : List FunClo.Val) : SrcRun p H []
  | cons {H : List FunClo.Val} {o : Op} {v : FunClo.Val} {t : List (Op × Ans)} :
      SrcStep p H o v → SrcRun p (push H v) t → SrcRun p H ((o, ansOf v) :: t)

/-- The plays of the source runs from no handles. -/
def srcPlays (p : Prog) : Set (List (Move Sig.empty cloSig)) :=
  {s | ∃ t, SrcRun p [] t ∧ s = toPlay t}

/-- **The source strategy** of a program. -/
def srcStrat (p : Prog) : Strategy Sig.empty cloSig := Strategy.generate (srcPlays p)

/-! ## The harness -/

/-- **The harness function** `mainR` (type index `2`, `apply`'s type): the program's code at depth
`1` on the second parameter, returning the reference to the result. -/
def mainRFunc (p : Prog) : Func :=
  ⟨⟨2⟩, List.replicate p.body.depth anyref, compile p.table 1 p.body⟩

/-- The function instance of `mainR`, in the module instance of the compiled module. -/
def mainRInst (p : Prog) : FuncInst Nat := ⟨dApply, instOf, .wasm (mainRFunc p)⟩

/-- **The store of the game**: `storeOf p` with `mainR` at address `2`. -/
def storeG (p : Prog) : Store Nat := { funcs := [mainInst p, applyInst p, mainRInst p] }

/-! ## The compiled strategy -/

/-- The answer read off a returned reference. -/
def readAns : Val → Ans
  | .ref (.i31 x) => .word x
  | _ => .fn

/-- The Wasm handles after the answer `w`: a non-`i31` reference gets the next handle. -/
def wpush (H : List Val) : Val → List Val
  | .ref (.i31 _) => H
  | w => H ++ [w]

/-- The invocation of a question with the Wasm handles `H`: the address and the arguments. -/
def invokeOf (H : List Val) : Op → Option (Nat × List Val)
  | .main n => some (2, [.ref (.i31 0), .ref (.i31 n)])
  | .call h m => H[h]?.map fun w => (1, [w, .ref (.i31 m)])

/-- A run of `$invoke` of `a` on `args` from `s` that returns the single value `w` in `s'`. -/
def Returns (P : Numerics.Profile) (host : HostSemantics Nat) (s : Store Nat) (a : Nat)
    (args : List Val) (s' : Store Nat) (w : Val) : Prop :=
  ∃ f', Steps P host (invoke s a args) ⟨s', f', vals [w]⟩

/-- **Wasm runs** from the store `s` and the handles `H`, threading the store. -/
inductive WRun (P : Numerics.Profile) (host : HostSemantics Nat) :
    Store Nat → List Val → List (Op × Ans) → Prop
  | nil (s : Store Nat) (H : List Val) : WRun P host s H []
  | cons {s s' : Store Nat} {H : List Val} {o : Op} {a : Nat} {args : List Val} {w : Val}
      {t : List (Op × Ans)} : invokeOf H o = some (a, args) → Returns P host s a args s' w →
      WRun P host s' (wpush H w) t → WRun P host s H ((o, readAns w) :: t)

/-- The plays of the Wasm runs from `storeG p` with no handles. -/
def wasmPlays (P : Numerics.Profile) (host : HostSemantics Nat) (p : Prog) :
    Set (List (Move Sig.empty cloSig)) :=
  {s | ∃ t, WRun P host (storeG p) [] t ∧ s = toPlay t}

/-- **The compiled strategy** of a program. -/
def wasmStrat (P : Numerics.Profile) (host : HostSemantics Nat) (p : Prog) :
    Strategy Sig.empty cloSig :=
  Strategy.generate (wasmPlays P host p)

end Silmaril.Wasm.Models.FunCloGame
