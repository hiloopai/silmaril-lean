/-!
# WIT binary goldens

Byte-exact checks against wasm-tools `1.263.0` (wit-component `0.263.0`),
executed by `#guard`:

* four packages of wit-component's test suite (`tests/interfaces/*.wit` of the
  `wit-component-0.263.0` crate, sha256 of the `.crate` file
  `4189bd180353b942b788715519dff886517b540e648c6f6e5129f57429945bf7`), with
  their resolved models written by hand: `encodePackage` writes exactly the
  bytes of `wasm-tools component wit <file> --wasm`, and `decodePackage`
  reads them back to the model (docs included);
* the `component-type` payload of `wasm-tools component embed --dummy
  resources.wit --world some-world`: `decodeWorldType` reads the world, and
  `encodeWorldType` writes the payload again;
* the WASI 0.2.12 packages `wasi:random` and `wasi:clocks` (crate
  `wasip2-1.0.4+wasi-0.2.12`, `wit/deps/{random,clocks}.wit`, sha256
  `48578c40…08f` and `6ed8aa65…7cc`): decoded and encoded again, byte-identical.
  The other WASI 0.2.12 packages (`io`, `filesystem`, `sockets`, `cli`,
  `http`) pass the same check outside the build (see `tools/wasm-tools/README.md`).
-/

@[expose] public section

namespace Silmaril.Wasm.Wit.Binary.Golden

open Silmaril.Wasm.Component.Binary

def hexNibble (c : Char) : UInt8 :=
  if c.toNat ≤ 57 then (c.toNat - 48).toUInt8 else (c.toNat - 87).toUInt8

/-- Bytes from lowercase hexadecimal. -/
def ofHex (s : String) : ByteArray :=
  let rec go : List Char → Array UInt8 → Array UInt8
    | a :: b :: r, acc => go r (acc.push (hexNibble a * 16 + hexNibble b))
    | _, acc => acc
  ⟨go s.toList #[]⟩

/-- `encodePackage` writes `b` and `decodePackage b` reads `p`. -/
def checkPackage (p : Package) (b : ByteArray) : Bool :=
  (match encodePackage [] p with | .ok b' => b' == b | .error _ => false) &&
  (match decodePackage b with | .ok q => decide (q = p) | .error _ => false)

/-- `b` decodes, and encodes again to `b`. -/
def checkReencode (b : ByteArray) : Bool :=
  match decodePackage b, decodeEnv b with
  | .ok p, .ok env => match encodePackage env p with
    | .ok b' => b' == b
    | .error _ => false
  | _, _ => false

def L (n : String) : Ty := .ref ⟨.local, n⟩
def fld (n : String) (t : Ty) : Labeled Ty := { name := n, ty := t }
def fn (n : String) (ps : List (String × Ty)) (r : Option Ty := none) : Func := { name := n, params := ps, result := r }
def u (n : String) : Labeled Unit := { name := n, ty := () }

def foo := PackageName.mk "foo" "foo" none
def simpleWorld : Package := {
  name := foo
  interfaces := [("console", { funcs := [fn "log" [("arg", .prim .string)]] })]
  worlds := [("the-world", { imports := [.ifaceRef ⟨foo, "console"⟩] })]
}

def recs := PackageName.mk "foo" "records" none
def recordsI : Interface := {
  types := [
    { name := "single", kind := .record [fld "f" (.prim .u8)] },
    { name := "scalars", kind := .record [fld "a" (.prim .u32), fld "b" (.prim .u32)] },
    { name := "really-flags", kind := .flags (["a","b","c","d","e","f","g","h","i"].map u) },
    { name := "aggregates", kind := .record [fld "a" (L "scalars"), fld "b" (.prim .u32), fld "c" (L "single"), fld "d" (.prim .string), fld "e" (L "really-flags")] },
    { name := "int-typedef", kind := .type (.prim .s32) },
    { name := "tuple-typedef2", kind := .type (.tuple [L "int-typedef"]) }]
  funcs := [
    fn "tuple-arg" [("x", .tuple [.prim .char, .prim .u32])],
    fn "tuple-result" [] (some (.tuple [.prim .char, .prim .u32])),
    fn "single-arg" [("x", L "single")], fn "single-result" [] (some (L "single")),
    fn "scalar-arg" [("x", L "scalars")], fn "scalar-result" [] (some (L "scalars")),
    fn "flags-arg" [("x", L "really-flags")], fn "flags-result" [] (some (L "really-flags")),
    fn "aggregate-arg" [("x", L "aggregates")], fn "aggregate-result" [] (some (L "aggregates")),
    fn "typedef-inout" [("e", L "tuple-typedef2")] (some (.prim .s32))]
}
def records : Package := {
  name := recs
  interfaces := [("records", recordsI)]
  worlds := [("records-world", { imports := [.ifaceRef ⟨recs, "records"⟩], exports := [.ifaceRef ⟨recs, "records"⟩] })]
}

def bar := PackageName.mk "foo" "bar" none
def own (n : String) : Ty := .own ⟨.local, n⟩
def brw (n : String) : Ty := .borrow ⟨.local, n⟩
def fooI : Interface := {
  types := [{ name := "bar", kind := .resource }, { name := "t", kind := .type (L "bar") },
    { name := "t2", kind := .type (own "bar") }]
  funcs := [{ name := "bar", kind := .constructor "bar", params := [], result := some (own "bar") },
    { name := "a", kind := .static "bar", params := [] },
    { name := "b", kind := .method "bar", params := [("self", brw "bar")] },
    fn "a" [("x", own "bar")] (some (own "bar"))]
}
def bazI : Interface := {
  types := [{ name := "bar", kind := .type (.ref ⟨.iface ⟨bar, "foo"⟩, "bar"⟩) },
    { name := "t", kind := .type (.ref ⟨.iface ⟨bar, "foo"⟩, "t"⟩) }]
  funcs := [fn "a" [("x", own "bar")] (some (own "bar")), fn "b" [] (some (own "t"))]
}
def iohI : Interface := {
  types := [{ name := "a", kind := .resource }]
  funcs := [fn "b" [("a1", own "a"), ("a2", own "a")] (some (own "a")), fn "c" [] (some (.list (own "a")))]
}
def ioh2I : Interface := {
  types := [{ name := "a", kind := .resource, docs := some "the `own` return and list param should be the same `own`" },
    { name := "b", kind := .resource, docs := some "same as above, even when the `list<b>` implicitly-defined `own` comes\nbefore an explicitly defined `own`" }, { name := "c", kind := .resource, docs := some "same as the above, the `own` argument should have the same type as the\nreturn value" }]
  funcs := [{ name := "a", kind := .constructor "a", params := [("a", .list (own "a"))], result := some (own "a") },
    { name := "b", kind := .constructor "b", params := [("a", .list (own "b")), ("b", own "b")], result := some (own "b") },
    { name := "a", kind := .static "c", params := [("a", own "c")], result := some (own "c") }]
}
def anonI : Interface := {
  types := [{ name := "a", kind := .resource }]
  funcs := [{ name := "a", kind := .constructor "a", params := [], result := some (own "a") },
    { name := "b", kind := .static "a", params := [] },
    { name := "c", kind := .method "a", params := [("self", brw "a")] }]
}
def resources : Package := {
  name := bar
  interfaces := [("foo", fooI), ("baz", bazI), ("implicit-own-handles", iohI), ("implicit-own-handles2", ioh2I)]
  worlds := [("some-world", {
      imports := [.ifaceInline "anon" anonI, .ifaceRef ⟨bar, "foo"⟩, .ifaceRef ⟨bar, "baz"⟩,
        .type { name := "bar", kind := .type (.ref ⟨.iface ⟨bar, "baz"⟩, "bar"⟩) },
        .type { name := "a", kind := .resource }, .type { name := "b", kind := .resource },
        .func { name := "a", kind := .constructor "a", params := [], result := some (own "a") },
        .func { name := "b", kind := .constructor "b", params := [], result := some (.result (some (own "b")) (some (.prim .string))) }]
      exports := [.func (fn "x" [] (some (own "a"))), .func (fn "y" [] (some (own "bar")))] }),
    ("implicit-own-handles3", { imports := [.type { name := "a", kind := .resource, docs := some "there should only be one `list` type despite there looking like two\nlist types here" },
        .func { name := "a", kind := .constructor "a", params := [("a", .list (own "a")), ("b", .list (own "a"))], result := some (own "a") }] })]
}

