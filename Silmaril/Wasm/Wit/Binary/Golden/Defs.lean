def emptyPkg : Package := {
  name := ⟨"foo", "empty", none⟩
  interfaces := [("empty", {})]
  worlds := [("empty-world", { imports := [.ifaceRef ⟨⟨"foo", "empty", none⟩, "empty"⟩, .ifaceInline "empty" {}],
                               exports := [.ifaceRef ⟨⟨"foo", "empty", none⟩, "empty"⟩, .ifaceInline "empty2" {}] }),
             ("actually-empty-world", {})]
}

#guard checkPackage emptyPkg emptyBytes
#guard checkPackage simpleWorld simpleWorldBytes
#guard checkPackage records recordsBytes
#guard checkPackage resources resourcesBytes

#guard match decodeWorldType embedResourcesPayload, decodePackage resourcesBytes, decodeEnv resourcesBytes with
  | .ok (pn, n, w, se), .ok p, .ok env =>
    decide (pn = p.name) && n == "some-world" && decide (se = .utf8) &&
    decide (some w = (p.worlds.lookup "some-world").map World.normalize) &&
    (match encodeWorldType (p.env env) pn n w se with
     | .ok b => b == embedResourcesPayload
     | .error _ => false)
  | _, _, _ => false

#guard checkReencode wasiRandomBytes
#guard checkReencode wasiClocksBytes

end Silmaril.Wasm.Wit.Binary.Golden

namespace Silmaril.Wasm.Wit.Binary.Golden

/-! ## `component-name` -/

/-- The `component-name` section `wasm-tools parse` (1.263.0) writes for
`(component $comp (type $t (func)) (type $u (func (param "x" u32)))
(import "f" (func $imp (type $t))))`. -/
def componentNameBytes : ByteArray := ofHex "000504636f6d70010701010003696d7001080302000174010175"

def componentNames : List NameSub :=
  [.component "comp", .sort .func [(0, "imp")], .sort .type [(0, "t"), (1, "u")]]

#guard (match parseNameSec componentNameBytes with | .ok ns => decide (ns = componentNames) | .error _ => false) &&
  (match encodeNameSubs componentNames with | some l => ByteArray.mk l.toArray == componentNameBytes | none => false)

end Silmaril.Wasm.Wit.Binary.Golden

namespace Silmaril.Wasm.Wit.Binary.Golden

/-! ## Canonical order -/

-- The four packages are in wit-component's function order.
#guard decide (emptyPkg.canon = emptyPkg) && decide (simpleWorld.canon = simpleWorld) &&
  decide (records.canon = records) && decide (resources.canon = resources)

/-- A documented freestanding function before a resource's constructor: the
decoded package lists the constructor first, so its `package-docs` JSON, hence
its bytes, differ. encode ∘ decode is not the identity on such bytes. -/
def reorderCounter : Package := {
  name := ⟨"foo", "bar", none⟩
  interfaces := [("i", {
    types := [{ name := "r", kind := .resource }]
    funcs := [{ name := "f", params := [], docs := some "f" },
      { name := "r", kind := .constructor "r", params := [], result := some (.own ⟨.local, "r"⟩),
        docs := some "c" }] })]
}

-- `reorderCounter` re-encodes to different bytes.
#guard match encodePackage [] reorderCounter with
  | .ok b => match decodePackage b with
    | .ok q => decide (q = reorderCounter.canon) && decide (q ≠ reorderCounter) &&
        (match encodePackage [] q with | .ok b' => b' != b | .error _ => false)
    | .error _ => false
  | .error _ => false

end Silmaril.Wasm.Wit.Binary.Golden
