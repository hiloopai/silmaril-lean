/-!
# Elaboration goldens

Surface WIT packages elaborated (`Elab.elaborate`) and encoded
(`Binary.encodePackage`) give exactly the bytes of `wasm-tools component wit
<file> --wasm` (wasm-tools `1.263.0`), and those bytes decode
(`Binary.decodePackage`) to the canonical form of the elaborated package. The
WIT sources are in `docs/projects/wasm-components.md` (sha256 of the files as run):

* `io.wit` (`3c38bef6…7a4f`): `Example.wasiIo`, a fragment of `wasi:io@0.2.0`
  (`use` chains, resources, own/borrow/self sugar, implicit world imports);
* `app/app.wit` (`7593f216…d79d`) with `app/deps/io/io.wit`: `Example.consumer`
  (foreign `use … as`, the implicit imports `error`, `poll` before `streams`);
* `incl.wit` (`cad50eb9…35c6`): forward type references (topological order),
  records, flags, enums, a resource with constructor/method/static function, an
  alias of a resource, doc comments on items and fields, `@since`, an
  `@unstable` function dropped by default, an export whose dependency becomes an
  implicit import, `include … with { log as log2 }`, a world `use` and an inline
  interface import with its own dependency.

Executed by `#guard`.
-/

@[expose] public section

namespace Silmaril.Wasm.Wit.Elab.Golden

open Silmaril.Wasm.Wit.Binary.Golden (ofHex)

def v100 : Version := ⟨1, 0, 0, [], []⟩
def inclName : PackageName := ⟨"test", "incl", some v100⟩

def typesI : Interface :=
  { name := "types", docs := ⟨some "Shared types."⟩, gates := [.since v100],
    items := [
      .type { name := "pair", docs := ⟨some "A pair."⟩, kind := .record [
        { name := "a", ty := .named "point" }, { name := "b", ty := .named "point" }] },
      .type { name := "point", kind := .record [
        { name := "x", ty := .named "coord", docs := ⟨some "The x coordinate."⟩ },
        { name := "y", ty := .named "coord" }] },
      .type { name := "coord", kind := TypeDefKind.alias .s32 },
      .type { name := "perms", kind := .flags [{ name := "read" }, { name := "write" }] },
      .type { name := "color", kind := .enum [{ name := "red" }, { name := "green" }] },
      .type { name := "handle", kind := .resource [
        { kind := .ctor, func := { params := [("p", .named "point")] } },
        { kind := .method "get", func := { result := some (.named "point") } },
        { kind := .static "make", func := { result := some (.named "handle") } }] },
      .type { name := "h2", kind := TypeDefKind.alias (.named "handle") },
      .func { name := "sum", gates := [.since v100], func := {
        params := [("p", .named "pair")], result := some (.named "coord") } },
      .func { name := "fancy", gates := [.unstable "fancy"], func := {} }] }

def apiI : Interface :=
  { name := "api"
    items := [
      .use { path := .local "types", names := [{ name := "point" }, { name := "handle", as := some "h" }] },
      .func { name := "draw", func :=
        { params := [("p", .named "point"), ("h", .borrow "h")], result := some (.list (.named "h")) } }] }

def baseW : World :=
  { name := "base"
    items := [
      .import { ext := .func "log" { params := [("msg", .string)] } },
      .export { ext := .path (.local "api") }] }

def fullW : World :=
  { name := "full"
    items := [
      .use { path := .local "types", names := [{ name := "color" }] },
      .include { path := .local "base", names := [{ name := "log", as := "log2" }] },
      .import { ext := .iface "extra" [
        .use { path := .local "types", names := [{ name := "perms" }] },
        .func { name := "check", func := { params := [("p", .named "perms")], result := some .bool } }] },
      .export { ext := .func "run" { params := [("c", .named "color")] } }] }

def incl : Package :=
  { name := inclName, docs := ⟨some "Elaboration test."⟩,
    items := [.iface typesI, .iface apiI, .world baseW, .world fullW] }

/-- Elaborate, encode and compare with `b`; decode `b` back to the canonical
form of the elaborated package. -/
def checkElab (U : Universe) (p : PackageName) (b : ByteArray) : Bool :=
  match elaborate U p with
  | .ok (P, deps) =>
    (match Binary.encodePackage deps P with | .ok b' => b' == b | .error _ => false) &&
    (match Binary.decodePackage b with | .ok q => decide (q = P.canon) | .error _ => false)
  | .error _ => false

