module

public import Silmaril.Wasm.Execution.Core.Sim.CodeRel
public import Silmaril.Wasm.Execution.Core.Sim.Context

@[expose] public section

/-! # Segment decomposition of the code closure

`AdminsRel BI B x y` is generated by sequencing, so a derivation does not fix how
`x` and `y` split. `Segs BI B x y` is a canonical form: `x` and `y` are
concatenations of *segments*, each a single pointwise-related administrative
instruction (`Seg.one`) or a base pair (`Seg.base`). Related source sequences
(`AdminsRel.src`) are expanded into single plain instructions and lowered source
base pairs, the latter becoming runtime base pairs through a hypothesis `hsrc`
(in `Sim/Closure.lean`, `BaseSim.src`).

`AdminsRel.segs` converts a derivation into segments and `Segs.adminsRel` goes
back. `Sim/Closure.lean` walks the segments of a related pair from the left to
find the first one whose left side is not all values: that is where the next
step of the left configuration happens.

`codeSize_lt_of_infix` is the measure fact behind every stutter of the closure
simulation: removing a nonempty infix makes the code strictly smaller.
-/

namespace Silmaril.Wasm.Execution.Core.Sim

open Silmaril.Wasm.Validation

variable {BI : List Instr → List Instr → Prop} {B : List Admin → List Admin → Prop}

/-- A segment of a related pair: one pointwise-related instruction, or a base
pair. -/
inductive Seg (BI : List Instr → List Instr → Prop) (B : List Admin → List Admin → Prop) :
    List Admin → List Admin → Prop where
  | one {a b : Admin} : AdminRel BI B a b → Seg BI B [a] [b]
  | base {x y : List Admin} : B x y → Seg BI B x y

/-- Two sequences split into corresponding segments. -/
inductive Segs (BI : List Instr → List Instr → Prop) (B : List Admin → List Admin → Prop) :
    List Admin → List Admin → Prop where
  | nil : Segs BI B [] []
  | cons {x y xs ys : List Admin} : Seg BI B x y → Segs BI B xs ys →
      Segs BI B (x ++ xs) (y ++ ys)

theorem Segs.append {x y x' y' : List Admin} (h : Segs BI B x y) (h' : Segs BI B x' y') :
    Segs BI B (x ++ x') (y ++ y') := by
  induction h with
  | nil => simpa using h'
  | cons hs _ ih => simpa [List.append_assoc] using Segs.cons hs ih

theorem Segs.single {x y : List Admin} (h : Seg BI B x y) : Segs BI B x y := by
  simpa using Segs.cons h .nil

theorem Seg.adminsRel {x y : List Admin} : Seg BI B x y → AdminsRel BI B x y
  | .one h => .cons h .nil
  | .base h => .base h

theorem Segs.adminsRel {x y : List Admin} (h : Segs BI B x y) : AdminsRel BI B x y := by
  induction h with
  | nil => exact .nil
  | cons hs _ ih => exact .append hs.adminsRel ih

mutual
/-- A related source instruction, lowered, is one segment. -/
theorem InstrRel.segs {i i' : Instr} : InstrRel BI i i' →
    Segs BI B [.plain i] [.plain i']
  | h => Segs.single (Seg.one (AdminRel.plain h))
/-- Related source sequences, lowered, split into segments. -/
theorem InstrsRel.segs (hsrc : ∀ x y, BI x y → B (expression x) (expression y)) :
    ∀ {x y : List Instr}, InstrsRel BI x y → Segs BI B (expression x) (expression y)
  | _, _, .nil => .nil
  | _, _, .cons h t => by
    have := Segs.cons (Seg.one (AdminRel.plain (B := B) h)) (InstrsRel.segs hsrc t)
    simpa [expression] using this
  | _, _, .base h => Segs.single (.base (hsrc _ _ h))
  | _, _, .append h t => by
    have := (InstrsRel.segs hsrc h).append (InstrsRel.segs hsrc t)
    simpa [expression] using this
end

mutual
/-- A pointwise-related instruction is one segment. -/
theorem AdminRel.segs {a b : Admin} : AdminRel BI B a b → Segs BI B [a] [b]
  | h => Segs.single (Seg.one h)
/-- **Segment decomposition** of the runtime closure. -/
theorem AdminsRel.segs (hsrc : ∀ x y, BI x y → B (expression x) (expression y)) :
    ∀ {x y : List Admin}, AdminsRel BI B x y → Segs BI B x y
  | _, _, .nil => .nil
  | _, _, .cons h t => Segs.cons (Seg.one h) (AdminsRel.segs hsrc t)
  | _, _, .base h => Segs.single (.base h)
  | _, _, .src h => InstrsRel.segs hsrc h
  | _, _, .append h t => (AdminsRel.segs hsrc h).append (AdminsRel.segs hsrc t)
end

/-- A pointwise-related value is related only to itself. -/
theorem AdminRel.eq_of_val {a b : Admin} {v : Val} (h : AdminRel BI B a b)
    (hv : a.val? = some v) : b = a := by
  cases h with
  | refl => rfl
  | plain hi =>
    cases hi with
    | refl => rfl
    | _ => simp [Admin.val?] at hv
  | _ => simp [Admin.val?] at hv

/-- A pointwise-related instruction that is neither a context nor a plain
instruction with a related body is related only to itself. -/
theorem AdminRel.eq_of_flat {a b : Admin} (h : AdminRel BI B a b)
    (hflat : ∀ i, a = .plain i → ∀ i', InstrRel BI i i' → i' = i) (hctx : ¬ a.IsCtx) :
    b = a := by
  cases h with
  | refl => rfl
  | plain hi => rw [hflat _ rfl _ hi]
  | label => exact (hctx trivial).elim
  | handler => exact (hctx trivial).elim
  | frame => exact (hctx trivial).elim

theorem _root_.Silmaril.Wasm.Execution.Core.Admin.isReturnCallRef_cases {c : Admin}
    (h : c.IsReturnCallRef) :
    (∃ x, c = .plain (.returnCallRef x)) ∨ ∃ d, c = .returnCallRefType d := by
  unfold Admin.IsReturnCallRef at h
  split at h
  · exact Or.inl ⟨_, rfl⟩
  · exact Or.inr ⟨_, rfl⟩
  · exact h.elim

/-- The last instruction of an exit kernel is flat: related only to itself. -/
theorem Exit.head_flat {k : List Admin} (hk : Exit k) {pre : List Val} {e : Admin}
    (hke : k = vals pre ++ [e]) :
    (∀ i, e = .plain i → ∀ i', InstrRel BI i i' → i' = i) ∧ ¬ e.IsCtx := by
  have hlast := congrArg List.getLast? hke
  simp at hlast
  cases hk with
  | br l =>
    simp only [List.getLast?_singleton, Option.some.injEq] at hlast
    subst hlast
    exact ⟨fun i hi i' hr => (by cases hi; cases hr; rfl), fun h => h⟩
  | return_ =>
    simp only [List.getLast?_singleton, Option.some.injEq] at hlast
    subst hlast
    exact ⟨fun i hi i' hr => (by cases hi; cases hr; rfl), fun h => h⟩
  | @returnCallRef c hc =>
    simp only [List.getLast?_singleton, Option.some.injEq] at hlast
    subst hlast
    rcases Admin.isReturnCallRef_cases hc with ⟨x, rfl⟩ | ⟨d, rfl⟩
    · exact ⟨fun i hi i' hr => (by cases hi; cases hr; rfl), fun h => h⟩
    · exact ⟨fun i hi => (by cases hi), fun h => h⟩
  | trap =>
    simp only [List.getLast?_singleton, Option.some.injEq] at hlast
    subst hlast
    exact ⟨fun i hi => (by cases hi), fun h => h⟩
  | throw a =>
    simp [throwing] at hlast
    subst hlast
    exact ⟨fun i hi i' hr => (by cases hi; cases hr; rfl), fun h => h⟩

/-- An exit kernel ending in `trap` is `[trap]`; one ending in `THROW_REF` is a
thrown exception. -/
theorem Exit.eq_of_head {k : List Admin} (hk : Exit k) {pre : List Val} {e : Admin}
    (hke : k = vals pre ++ [e]) :
    (e = .trap → k = [.trap]) ∧
      (e = .plain .throwRef → ∃ a, k = throwing a ∧ pre = [.ref (.exn a)]) := by
  have hlast := congrArg List.getLast? hke
  simp at hlast
  cases hk with
  | br l => simp at hlast; subst hlast; simp
  | return_ => simp at hlast; subst hlast; simp
  | @returnCallRef c hc =>
    simp at hlast; subst hlast
    rcases Admin.isReturnCallRef_cases hc with ⟨x, rfl⟩ | ⟨d, rfl⟩ <;> simp
  | trap => exact ⟨fun _ => rfl, fun h => (by simp at hlast; subst hlast; cases h)⟩
  | throw a =>
    refine ⟨fun h => (by simp [throwing] at hlast; subst hlast; cases h), fun _ => ⟨a, rfl, ?_⟩⟩
    have := (List.append_inj' (hke.symm.trans (by simp [throwing, vals, Val.toAdmin] :
      throwing a = vals [.ref (.exn a)] ++ [.plain .throwRef])) rfl).1
    exact List.map_injective_iff.mpr (fun v w h => by
      have := congrArg Admin.val? h; simpa using this) this

/-! ## The stuttering measure -/

theorem codeSize_cons (a : Admin) (l : List Admin) :
    codeSize (a :: l) = 1 + sizeOf a + codeSize l := by
  simp [codeSize]

theorem codeSize_pos (l : List Admin) : 0 < codeSize l := by
  cases l <;> simp [codeSize]
  all_goals omega

/-- Removing a nonempty infix makes the code strictly smaller. -/
theorem codeSize_lt_of_infix (p m q : List Admin) (hm : m ≠ []) :
    codeSize (p ++ q) < codeSize (p ++ m ++ q) := by
  obtain ⟨a, l, rfl⟩ := List.exists_cons_of_ne_nil hm
  have h1 := codeSize_append p q
  have h2 := codeSize_append p ((a :: l) ++ q)
  have h3 := codeSize_append (a :: l) q
  have h4 := codeSize_cons a l
  have h5 := codeSize_pos l
  rw [List.append_assoc]
  omega

theorem codeSize_le_of_infix (p m q : List Admin) :
    codeSize (p ++ q) ≤ codeSize (p ++ m ++ q) := by
  rcases m with _ | ⟨a, l⟩
  · simp
  · exact (codeSize_lt_of_infix p _ q (List.cons_ne_nil a l)).le

/-- Dropping a nonempty infix of a value prefix shrinks the code. -/
theorem codeSize_drop_vals_lt (a w b : List Val) (rest : List Admin) (hw : w ≠ []) :
    codeSize (vals (a ++ b) ++ rest) < codeSize (vals (a ++ w ++ b) ++ rest) := by
  have := codeSize_lt_of_infix (vals a) (vals w) (vals b ++ rest) (by simpa [vals] using hw)
  simpa using this

/-- A `trap`/`throw_ref` discard shrinks the code. -/
theorem codeSize_discard_lt (ws us : List Val) (k r r' : List Admin) (hne : us ≠ [] ∨ r ≠ []) :
    codeSize (vals ws ++ k ++ r') < codeSize (vals (ws ++ us) ++ k ++ (r ++ r')) := by
  have e : vals (ws ++ us) ++ k ++ (r ++ r') = vals ws ++ vals us ++ (k ++ r ++ r') := by simp
  rw [e]
  rcases hne with hus | hr
  · calc codeSize (vals ws ++ k ++ r') ≤ codeSize (vals ws ++ k ++ r ++ r') :=
          codeSize_le_of_infix _ _ _
      _ = codeSize (vals ws ++ (k ++ r ++ r')) := by simp
      _ < codeSize (vals ws ++ vals us ++ (k ++ r ++ r')) :=
          codeSize_lt_of_infix _ _ _ (by simpa [vals] using hus)
  · calc codeSize (vals ws ++ k ++ r') < codeSize (vals ws ++ k ++ r ++ r') :=
          codeSize_lt_of_infix _ _ _ hr
      _ = codeSize (vals ws ++ (k ++ r ++ r')) := by simp
      _ ≤ codeSize (vals ws ++ vals us ++ (k ++ r ++ r')) := codeSize_le_of_infix _ _ _

/-! ## Steps in exit shape

A configuration `val* trap rest` or `val* (REF.EXN_ADDR a) THROW_REF rest` only
discards code around its kernel. This is what makes the exit cuts of
`Sim/Closure.lean` a stuttering simulation. -/

open Silmaril.Wasm.Numerics (Profile)

variable {H : Type} {P : Profile} {host : HostSemantics H}

set_option linter.unusedSimpArgs false in
set_option linter.unusedTactic false in
set_option linter.unreachableTactic false in
/-- A step of the redex `val* trap` drops a nonempty infix of the values. -/
theorem Step.trap_redex_aux {c c' : Config H} (h : Step P host c c') :
    ∀ us : List Val, c.code = vals us ++ [.trap] →
      c'.store = c.store ∧ c'.frame = c.frame ∧
      ∃ p w q, us = p ++ w ++ q ∧ w ≠ [] ∧ c'.code = vals (p ++ q) ++ [.trap] := by
  induction h with
  | @ctxtInstrs s s' f f' vs₀ is is' rest hs hne ih =>
    intro us hc
    dsimp only at hc ⊢
    obtain ⟨u₁, b, is₁, hb, rfl⟩ := exists_head_of_not_all hs.not_all_isVal
    have hc' : vals (vs₀ ++ u₁) ++ b :: (is₁ ++ rest) = vals us ++ Admin.trap :: [] := by
      rw [← hc]; simp
    obtain ⟨h1, rfl, h3⟩ := vals_append_cons_inj hb val?_trap hc'
    obtain ⟨rfl, rfl⟩ := List.append_eq_nil_iff.mp h3
    obtain ⟨hs', hf', p, w, q, hu, hw, he⟩ := ih u₁ rfl
    dsimp only at hs' hf' he
    subst hu h1 he
    exact ⟨hs', hf', vs₀ ++ p, w, q, by simp, hw, by simp⟩
  | @trapInstrs s f vs₀ rest hne =>
    intro us hc
    dsimp only at hc ⊢
    have hc' : vals vs₀ ++ Admin.trap :: rest = vals us ++ Admin.trap :: [] := by
      rw [← hc]; simp
    obtain ⟨rfl, -, rfl⟩ := vals_append_cons_inj val?_trap val?_trap hc'
    exact ⟨rfl, rfl, [], vs₀, [], by simp, by simpa using hne, by simp [vals_nil']⟩
  | @throwRefInstrs s f vs₀ a rest hne =>
    intro us hc
    dsimp only at hc
    have hc' : vals (vs₀ ++ [.ref (.exn a)]) ++ Admin.plain .throwRef :: rest =
        vals us ++ Admin.trap :: [] := by
      rw [← hc]; simp [vals, throwing, Val.toAdmin]
    exact absurd (vals_append_cons_inj val?_throwRef val?_trap hc').2.1 (by simp)
  | _ =>
    intro us hc
    first
      | (have := congrArg List.getLast? hc; simp at this; done)
      | (have := congrArg List.getLast? hc; simp at this; subst this;
          simp_all [Admin.IsCallRef, Admin.IsReturnCallRef]; done)
      | (rename_i hf; cases hf <;>
          (have := congrArg List.getLast? hc; simp [constI32, Val.i32, Val.toAdmin] at this) <;>
          done)

set_option linter.unusedSimpArgs false in
set_option linter.unusedTactic false in
set_option linter.unreachableTactic false in
/-- A step of the redex `val* THROW_REF`: with an exception reference on top, it
drops a nonempty infix of the values below it; with a null reference, it traps. -/
theorem Step.throwRef_redex_aux {c c' : Config H} (h : Step P host c c') :
    ∀ us : List Val, c.code = vals us ++ [.plain .throwRef] →
      c'.store = c.store ∧ c'.frame = c.frame ∧
      ((∃ p w q a, us = p ++ w ++ q ++ [.ref (.exn a)] ∧ w ≠ [] ∧
          c'.code = vals (p ++ q) ++ throwing a) ∨
        (∃ u u', us = u ++ [.ref .null] ∧ c'.code = vals u' ++ [.trap])) := by
  induction h with
  | @ctxtInstrs s s' f f' vs₀ is is' rest hs hne ih =>
    intro us hc
    dsimp only at hc ⊢
    obtain ⟨u₁, b, is₁, hb, rfl⟩ := exists_head_of_not_all hs.not_all_isVal
    have hc' : vals (vs₀ ++ u₁) ++ b :: (is₁ ++ rest) =
        vals us ++ Admin.plain .throwRef :: [] := by
      rw [← hc]; simp
    obtain ⟨h1, rfl, h3⟩ := vals_append_cons_inj hb val?_throwRef hc'
    obtain ⟨rfl, rfl⟩ := List.append_eq_nil_iff.mp h3
    obtain ⟨hs', hf', hdisj⟩ := ih u₁ rfl
    dsimp only at hs' hf' hdisj
    subst h1
    refine ⟨hs', hf', ?_⟩
    rcases hdisj with ⟨p, w, q, a, rfl, hw, he⟩ | ⟨u, u', rfl, he⟩
    · exact Or.inl ⟨vs₀ ++ p, w, q, a, by simp, hw, by rw [he]; simp⟩
    · exact Or.inr ⟨vs₀ ++ u, vs₀ ++ u', by simp, by rw [he]; simp⟩
  | @throwRefInstrs s f vs₀ a rest hne =>
    intro us hc
    dsimp only at hc ⊢
    have hc' : vals (vs₀ ++ [.ref (.exn a)]) ++ Admin.plain .throwRef :: rest =
        vals us ++ Admin.plain .throwRef :: [] := by
      rw [← hc]; simp [vals, throwing, Val.toAdmin]
    obtain ⟨rfl, -, rfl⟩ := vals_append_cons_inj val?_throwRef val?_throwRef hc'
    exact ⟨rfl, rfl, Or.inl ⟨[], vs₀, [], a, by simp, by simpa using hne, by simp [vals_nil']⟩⟩
  | @throwRefNull s f =>
    intro us hc
    dsimp only at hc ⊢
    have hc' : vals [.ref .null] ++ Admin.plain .throwRef :: [] =
        vals us ++ Admin.plain .throwRef :: [] := by
      rw [← hc]; rfl
    obtain ⟨rfl, -, -⟩ := vals_append_cons_inj val?_throwRef val?_throwRef hc'
    exact ⟨rfl, rfl, Or.inr ⟨[], [], rfl, rfl⟩⟩
  | @trapInstrs s f vs₀ rest hne =>
    intro us hc
    dsimp only at hc
    have hc' : vals vs₀ ++ Admin.trap :: rest = vals us ++ Admin.plain .throwRef :: [] := by
      rw [← hc]; simp
    exact absurd (vals_append_cons_inj val?_trap val?_throwRef hc').2.1 (by simp)
  | _ =>
    intro us hc
    first
      | (have := congrArg List.getLast? hc; simp at this; done)
      | (have := congrArg List.getLast? hc; simp at this; subst this;
          simp_all [Admin.IsCallRef, Admin.IsReturnCallRef]; done)
      | (rename_i hf; cases hf <;>
          (have := congrArg List.getLast? hc; simp [constI32, Val.i32, Val.toAdmin] at this) <;>
          done)

/-- **Steps in exit shape.** A step of `val* k X`, with `k` a `trap` or a thrown
exception, keeps store and frame and leads to `val* k X'` with smaller code. -/
theorem Step.exitShape_cut {s s' : Store H} {f f' : Frame} {U : List Val} {k X es' : List Admin}
    (hk : k = [.trap] ∨ ∃ a, k = throwing a)
    (h : Step P host ⟨s, f, vals U ++ k ++ X⟩ ⟨s', f', es'⟩) :
    s' = s ∧ f' = f ∧ (∃ U' X', es' = vals U' ++ k ++ X') ∧
      codeSize es' < codeSize (vals U ++ k ++ X) := by
  rcases hk with rfl | ⟨a, rfl⟩
  · have h' : Step P host ⟨s, f, vals U ++ Admin.trap :: X⟩ ⟨s', f', es'⟩ := by simpa using h
    rcases Step.split_head val?_trap h' with ⟨ws, us, is', rfl, hst, rfl⟩ |
        ⟨-, rfl, rfl, ws, us, r, r', rfl, rfl, hne, rfl⟩ | ⟨hc, -⟩
    · obtain ⟨hs, hf, p, w, q, rfl, hw, he⟩ := Step.trap_redex_aux hst us rfl
      dsimp only at hs hf he
      subst hs hf he
      refine ⟨rfl, rfl, ⟨ws ++ (p ++ q), X, by simp⟩, ?_⟩
      have := codeSize_drop_vals_lt (ws ++ p) w q ([.trap] ++ X) hw
      simpa using this
    · exact ⟨rfl, rfl, ⟨ws, r', rfl⟩, codeSize_discard_lt ws us _ r r' hne⟩
    · cases hc
  · have e : vals U ++ throwing a ++ X =
        vals (U ++ [.ref (.exn a)]) ++ Admin.plain .throwRef :: X := by
      simp [vals, throwing, Val.toAdmin]
    rw [e] at h
    rcases Step.split_head val?_throwRef h with ⟨ws, us, is', hU, hst, rfl⟩ | ⟨hc, -⟩ |
        ⟨-, rfl, rfl, ws, us, x, r, r', hU, rfl, hne, rfl⟩
    · obtain ⟨hs, hf, hdisj⟩ := Step.throwRef_redex_aux hst us rfl
      dsimp only at hs hf hdisj
      subst hs hf
      rcases hdisj with ⟨p, w, q, a', rfl, hw, he⟩ | ⟨u, u', rfl, -⟩
      · have hU' : U ++ [.ref (.exn a)] = (ws ++ p ++ w ++ q) ++ [.ref (.exn a')] := by
          rw [hU]; simp
        obtain ⟨rfl, ha⟩ := List.append_inj' hU' rfl
        have ha' : a = a' := by simpa using ha
        subst ha' he
        refine ⟨rfl, rfl, ⟨ws ++ (p ++ q), X, by simp⟩, ?_⟩
        have := codeSize_drop_vals_lt (ws ++ p) w q (throwing a ++ X) hw
        simpa using this
      · have hU' : U ++ [.ref (.exn a)] = (ws ++ u) ++ [.ref .null] := by
          rw [hU]; simp
        have := (List.append_inj' hU' rfl).2
        simp at this
    · cases hc
    · have hU' : U ++ [.ref (.exn a)] = (ws ++ us) ++ [.ref (.exn x)] := by
        rw [hU]
      obtain ⟨rfl, ha⟩ := List.append_inj' hU' rfl
      have ha' : a = x := by simpa using ha
      subst ha'
      exact ⟨rfl, rfl, ⟨ws, r', rfl⟩, codeSize_discard_lt ws us _ r r' hne⟩

end Silmaril.Wasm.Execution.Core.Sim
