module

public import Silmaril.Wasm.Execution.Core.Sim.Closure.Basic

@[expose] public section

/-! # Structural lemmas for the closure simulation

Three facts about the closure `AdminsRel BI (WithCuts B)` that the sequence and
bubbling cases of `closure_configSim` (`Sim/Closure.lean`) need, proved
separately from the induction on `Step`:

* `AdminsRel.split_vals`: a related pair whose left side is `val* a es`, with `a`
  the first non-value, decomposes into a related value prefix followed by either
  a pointwise `AdminRel` head with a related tail, a base pair whose left side
  starts inside `val* a`, or a cut pair (`ExitCut`) starting there.
* `AdminsRel.values_lift`: if the left side is `val* us`, the right side runs to
  `val* us` (from `BaseSim.values`, lifted by `Steps.append_right`).
* `AdminsRel.exit_lift`: if the left side is `val* us k j` with `Exit k`, the
  right side runs in the same frame, with a related store, to `val* ws k j'`,
  where `ws = us` unless `k` is a `trap` or a thrown exception (from
  `BaseSim.exit` and the cut pairs).

The `ws = us` exception is necessary: a cut pair `val* trap x ~ val* trap y`
relates different value prefixes (for example `[v, trap] ~ [trap]`), and the
right side cannot recreate discarded values. Every bubbling rule of a `trap` or a
thrown exception first discards the values before the kernel, so this suffices.

All three are proved on `SeqRel`, the closure flattened to sequence structure:
`AdminsRel.src` pairs are unfolded with `BaseSim.src`, so that the proofs are
plain inductions on a non-mutual inductive.
-/

namespace Silmaril.Wasm.Execution.Core.Sim

open Silmaril.Wasm.Numerics (Profile)
open Silmaril.Wasm.Validation

variable {rank : List Admin → Nat}

variable {H : Type}

/-! ## Flat sequence derivations -/

/-- A sequence relation generated by a relation `A` on single instructions and
base pairs `C`: pointwise, base pairs, and concatenation. -/
inductive SeqRel (A : Admin → Admin → Prop) (C : List Admin → List Admin → Prop) :
    List Admin → List Admin → Prop where
  | nil : SeqRel A C [] []
  | cons {a a' : Admin} {as as' : List Admin} : A a a' → SeqRel A C as as' →
      SeqRel A C (a :: as) (a' :: as')
  | base {x y : List Admin} : C x y → SeqRel A C x y
  | append {x x' y y' : List Admin} : SeqRel A C x y → SeqRel A C x' y' →
      SeqRel A C (x ++ x') (y ++ y')

variable {BI : List Instr → List Instr → Prop} {B : List Admin → List Admin → Prop}

theorem SeqRel.toAdminsRel {x y : List Admin} (h : SeqRel (AdminRel BI B) B x y) :
    AdminsRel BI B x y := by
  induction h with
  | nil => exact .nil
  | cons ha _ ih => exact .cons ha ih
  | base hb => exact .base hb
  | append _ _ ih ih' => exact .append ih ih'

theorem expression_append (x y : List Instr) :
    expression (x ++ y) = expression x ++ expression y :=
  List.map_append

/-- Lowered source pairs are flat runtime pairs, given lowered base pairs. -/
theorem InstrsRel.toSeqRel (hsrc : ∀ {x y : List Instr}, BI x y → B (expression x) (expression y)) :
    ∀ {x y : List Instr}, InstrsRel BI x y →
      SeqRel (AdminRel BI B) B (expression x) (expression y)
  | _, _, .nil => .nil
  | _, _, .cons hi t => .cons (.plain hi) (InstrsRel.toSeqRel hsrc t)
  | _, _, .base h => .base (hsrc h)
  | _, _, .append h t => by
    rw [expression_append, expression_append]
    exact .append (InstrsRel.toSeqRel hsrc h) (InstrsRel.toSeqRel hsrc t)

/-- The closure is flat, given lowered base pairs. -/
theorem AdminsRel.toSeqRel (hsrc : ∀ {x y : List Instr}, BI x y → B (expression x) (expression y)) :
    ∀ {x y : List Admin}, AdminsRel BI B x y → SeqRel (AdminRel BI B) B x y
  | _, _, .nil => .nil
  | _, _, .cons ha t => .cons ha (AdminsRel.toSeqRel hsrc t)
  | _, _, .base h => .base h
  | _, _, .src h => InstrsRel.toSeqRel hsrc h
  | _, _, .append h t => .append (AdminsRel.toSeqRel hsrc h) (AdminsRel.toSeqRel hsrc t)

/-! ## Rigid instructions -/

/-- Instructions related by `AdminRel` only to themselves: everything except the
structured instructions and the administrative contexts. -/
def AdminRigid : Admin → Prop
  | .plain (.block ..) | .plain (.loop ..) | .plain (.if_ ..) | .plain (.tryTable ..)
  | .label .. | .handler .. | .frame .. => False
  | _ => True

theorem AdminRel.eq_of_rigid {a a' : Admin} (h : AdminRel BI B a a') (hr : AdminRigid a) :
    a' = a := by
  cases h with
  | refl => rfl
  | plain hi => cases hi <;> first | rfl | exact (hr : False).elim
  | label => exact (hr : False).elim
  | handler => exact (hr : False).elim
  | frame => exact (hr : False).elim

theorem AdminRigid.of_val? {a : Admin} {v : Val} (hv : a.val? = some v) : AdminRigid a := by
  obtain rfl := Admin.eq_of_val? hv
  rcases v with ⟨⟨_ | _⟩, _⟩ | _ | _ <;> trivial

theorem not_mem_vals {c : Admin} (hc : c.val? = none) {vs : List Val} : c ∉ vals vs := by
  intro hm
  obtain ⟨v, -, rfl⟩ := List.mem_map.mp hm
  simp at hc

theorem Val.toAdmin_injective : Function.Injective Val.toAdmin := by
  intro v w h
  simpa using congrArg Admin.val? h

theorem vals_injective : Function.Injective vals :=
  List.map_injective_iff.mpr Val.toAdmin_injective

/-- The head of an exit kernel is rigid. -/
theorem Exit.rigid_head {k : List Admin} (hk : Exit k) {pre : List Val} {e : Admin}
    (hke : k = vals pre ++ [e]) : AdminRigid e := by
  have hl : k.getLast? = some e := by rw [hke]; simp
  cases hk with
  | br l => simp at hl; subst hl; trivial
  | return_ => simp at hl; subst hl; trivial
  | returnCallRef hc =>
    simp at hl
    subst hl
    unfold Admin.IsReturnCallRef at hc
    split at hc <;> trivial
  | trap => simp at hl; subst hl; trivial
  | throw a => simp [throwing] at hl; subst hl; trivial

/-- An exit kernel ending in `trap` is `trap`. -/
theorem Exit.eq_trap {k : List Admin} (hk : Exit k) {pre : List Val}
    (hke : k = vals pre ++ [.trap]) : k = [.trap] := by
  have hl : k.getLast? = some .trap := by rw [hke]; simp
  cases hk with
  | br l => simp at hl
  | return_ => simp at hl
  | returnCallRef hc =>
    simp at hl
    subst hl
    simp [Admin.IsReturnCallRef] at hc
  | trap => rfl
  | throw a => simp [throwing] at hl

/-- An exit kernel ending in `THROW_REF` is a thrown exception. -/
theorem Exit.eq_throw {k : List Admin} (hk : Exit k) {pre : List Val}
    (hke : k = vals pre ++ [.plain .throwRef]) :
    ∃ b, pre = [.ref (.exn b)] ∧ k = throwing b := by
  have hl : k.getLast? = some (.plain .throwRef) := by rw [hke]; simp
  cases hk with
  | br l => simp at hl
  | return_ => simp at hl
  | returnCallRef hc =>
    simp at hl
    subst hl
    simp [Admin.IsReturnCallRef] at hc
  | trap => simp at hl
  | throw b =>
    have h := List.append_inj_left'
      (show vals [.ref (.exn b)] ++ [.plain .throwRef] = vals pre ++ [.plain .throwRef]
        from hke) rfl
    exact ⟨b, (vals_injective h).symm, rfl⟩

/-! ## List decompositions -/

theorem steps_append {P : Profile} {host : HostSemantics H} {s s' : Store H} {f f' : Frame}
    {es es' : List Admin} (h : Steps P host ⟨s, f, es⟩ ⟨s', f', es'⟩) (rest : List Admin) :
    Steps P host ⟨s, f, es ++ rest⟩ ⟨s', f', es' ++ rest⟩ :=
  Steps.append_right h rest

/-- Where the first non-value of `val* x x'` lies: after `x` (which is then all
values) or inside `x`. -/
theorem split_append {e : Admin} (he : e.val? = none) {ws : List Val} {r : List Admin} :
    ∀ {x : List Admin} {vs : List Val} {x' : List Admin},
      vals vs ++ x ++ x' = vals ws ++ e :: r →
    (∃ vs₀, x = vals vs₀ ∧ vals (vs ++ vs₀) ++ x' = vals ws ++ e :: r) ∨
    (∃ r₀, vals vs ++ x = vals ws ++ e :: r₀ ∧ r = r₀ ++ x')
  | [], vs, x', h => Or.inl ⟨[], rfl, by simpa using h⟩
  | b :: x, vs, x', h => by
    cases hb : b.val? with
    | some v =>
      obtain rfl := Admin.eq_of_val? hb
      rcases split_append he (x := x) (vs := vs ++ [v]) (x' := x')
          (by simpa [vals_cons', vals_nil'] using h) with ⟨vs₀, rfl, h2⟩ | ⟨r₀, h2, rfl⟩
      · exact Or.inl ⟨v :: vs₀, rfl, by simpa [vals_cons', vals_nil'] using h2⟩
      · exact Or.inr ⟨r₀, by simpa [vals_cons', vals_nil'] using h2, rfl⟩
    | none =>
      obtain ⟨rfl, rfl, rfl⟩ := vals_append_cons_inj (es := x ++ x') (fs := r) hb he
        (vs := vs) (ws := ws) (by simpa using h)
      exact Or.inr ⟨x, rfl, rfl⟩

/-- A value prefix of `val* a es` (with `a` not a value) is a prefix of its values. -/
theorem vals_prefix {a : Admin} (ha : a.val? = none) {es : List Admin} :
    ∀ {vs₀ ws : List Val} {x' : List Admin}, vals vs₀ ++ x' = vals ws ++ a :: es →
    ∃ vs', ws = vs₀ ++ vs' ∧ x' = vals vs' ++ a :: es
  | [], ws, x', h => ⟨ws, rfl, by simpa [vals_nil'] using h⟩
  | v :: vs₀, [], x', h => by
    rw [vals_cons', vals_nil', List.nil_append, List.cons_append, List.cons.injEq] at h
    rw [← h.1, Admin.val?_toAdmin] at ha
    cases ha
  | v :: vs₀, w :: ws, x', h => by
    rw [vals_cons', vals_cons', List.cons_append, List.cons_append, List.cons.injEq] at h
    obtain ⟨h₁, h₂⟩ := h
    obtain rfl := Val.toAdmin_injective h₁
    obtain ⟨vs', rfl, rfl⟩ := vals_prefix ha h₂
    exact ⟨vs', rfl, rfl⟩

/-! ## Decomposition at the first non-value -/

/-- Flat form of `AdminsRel.split_vals`. -/
theorem SeqRel.split_vals {A : Admin → Admin → Prop} {C : List Admin → List Admin → Prop}
    {a : Admin} (ha : a.val? = none) {x y : List Admin} (h : SeqRel A C x y) :
    ∀ {vs : List Val} {es : List Admin}, x = vals vs ++ a :: es →
    ∃ (vs₁ vs₂ : List Val) (y₁ : List Admin), vs = vs₁ ++ vs₂ ∧ SeqRel A C (vals vs₁) y₁ ∧
      ((vs₂ = [] ∧ ∃ a' es', y = y₁ ++ a' :: es' ∧ A a a' ∧ SeqRel A C es es') ∨
       (∃ e₁ e₂ y₂ y₃, es = e₁ ++ e₂ ∧ y = y₁ ++ y₂ ++ y₃ ∧ C (vals vs₂ ++ a :: e₁) y₂ ∧
          SeqRel A C e₂ y₃)) := by
  induction h with
  | nil => intro vs es hx; simp at hx
  | @cons b b' bs bs' hb ht ih =>
    intro vs es hx
    rcases vs with _ | ⟨v, vs⟩
    · rw [vals_nil', List.nil_append, List.cons.injEq] at hx
      obtain ⟨rfl, rfl⟩ := hx
      exact ⟨[], [], [], rfl, .nil, Or.inl ⟨rfl, b', bs', rfl, hb, ht⟩⟩
    · rw [vals_cons', List.cons_append, List.cons.injEq] at hx
      obtain ⟨rfl, h2⟩ := hx
      obtain ⟨vs₁, vs₂, y₁, rfl, h₁, hcase⟩ := ih h2
      refine ⟨v :: vs₁, vs₂, b' :: y₁, rfl, .cons hb h₁, ?_⟩
      rcases hcase with ⟨rfl, a', es', rfl, haa, hes⟩ | ⟨e₁, e₂, y₂, y₃, rfl, rfl, hc, h₃⟩
      · exact Or.inl ⟨rfl, a', es', rfl, haa, hes⟩
      · exact Or.inr ⟨e₁, e₂, y₂, y₃, rfl, rfl, hc, h₃⟩
  | @base x y hc =>
    intro vs es hx
    subst hx
    exact ⟨[], vs, [], rfl, .nil, Or.inr ⟨es, [], y, [], by simp, by simp, hc, .nil⟩⟩
  | @append x x' y y' hxy hxy' ih ih' =>
    intro vs es hx
    rcases split_append ha (vs := []) (x := x) (x' := x') (ws := vs) (r := es)
        (by rw [vals_nil', List.nil_append]; exact hx) with ⟨vs₀, rfl, h2⟩ | ⟨r₀, h2, rfl⟩
    · obtain ⟨vs', rfl, rfl⟩ := vals_prefix ha (vs₀ := vs₀) (ws := vs) (x' := x')
        (by simpa using h2)
      obtain ⟨vs₁, vs₂, y₁, rfl, h₁, hcase⟩ := ih' rfl
      refine ⟨vs₀ ++ vs₁, vs₂, y ++ y₁, by simp, ?_, ?_⟩
      · rw [vals_append]; exact .append hxy h₁
      · rcases hcase with ⟨rfl, a', es', rfl, haa, hes⟩ | ⟨e₁, e₂, y₂, y₃, rfl, rfl, hc, h₃⟩
        · exact Or.inl ⟨rfl, a', es', by simp, haa, hes⟩
        · exact Or.inr ⟨e₁, e₂, y₂, y₃, rfl, by simp, hc, h₃⟩
    · obtain ⟨vs₁, vs₂, y₁, rfl, h₁, hcase⟩ :=
        ih (vs := vs) (es := r₀) (by simpa [vals_nil'] using h2)
      refine ⟨vs₁, vs₂, y₁, rfl, h₁, ?_⟩
      rcases hcase with ⟨rfl, a', es', rfl, haa, hes⟩ | ⟨e₁, e₂, y₂, y₃, rfl, rfl, hc, h₃⟩
      · exact Or.inl ⟨rfl, a', es' ++ y', by simp, haa, .append hes hxy'⟩
      · exact Or.inr ⟨e₁, e₂ ++ x', y₂, y₃ ++ y', by simp, by simp, hc, .append h₃ hxy'⟩

/-- **Decomposition at the first non-value.** A closure pair whose left side is
`val* a es`, with `a` not a value, is a related value prefix `val* vs₁ ~ y₁`
followed by one of: a pointwise `AdminRel` head `a ~ a'` with related tails; a
base pair whose left side `val* vs₂ a e₁` starts inside `val* a`; or a cut pair
starting there. -/
theorem AdminsRel.split_vals
    (hsrc : ∀ {x y : List Instr}, BI x y → B (expression x) (expression y))
    {vs : List Val} {a : Admin} {es y : List Admin}
    (h : AdminsRel BI (WithCuts B) (Core.vals vs ++ a :: es) y) (ha : a.val? = none) :
    ∃ (vs₁ vs₂ : List Val) (y₁ : List Admin), vs = vs₁ ++ vs₂ ∧
      AdminsRel BI (WithCuts B) (Core.vals vs₁) y₁ ∧
      ((vs₂ = [] ∧ ∃ a' es', y = y₁ ++ a' :: es' ∧ AdminRel BI (WithCuts B) a a' ∧
          AdminsRel BI (WithCuts B) es es') ∨
       (∃ e₁ e₂ y₂ y₃, es = e₁ ++ e₂ ∧ y = y₁ ++ y₂ ++ y₃ ∧ B (Core.vals vs₂ ++ a :: e₁) y₂ ∧
          AdminsRel BI (WithCuts B) e₂ y₃) ∨
       (∃ e₁ e₂ y₂ y₃, es = e₁ ++ e₂ ∧ y = y₁ ++ y₂ ++ y₃ ∧ ExitCut (Core.vals vs₂ ++ a :: e₁) y₂ ∧
          AdminsRel BI (WithCuts B) e₂ y₃)) := by
  obtain ⟨vs₁, vs₂, y₁, rfl, h₁, hc⟩ :=
    (h.toSeqRel (fun hxy => Or.inl (hsrc hxy))).split_vals ha rfl
  refine ⟨vs₁, vs₂, y₁, rfl, h₁.toAdminsRel, ?_⟩
  rcases hc with ⟨rfl, a', es', rfl, haa, hes⟩ | ⟨e₁, e₂, y₂, y₃, rfl, rfl, hb | hb, h₃⟩
  · exact Or.inl ⟨rfl, a', es', rfl, haa, hes.toAdminsRel⟩
  · exact Or.inr (Or.inl ⟨e₁, e₂, y₂, y₃, rfl, rfl, hb, h₃.toAdminsRel⟩)
  · exact Or.inr (Or.inr ⟨e₁, e₂, y₂, y₃, rfl, rfl, hb, h₃.toAdminsRel⟩)

/-! ## Values and exits -/

variable {P : Profile} {host : HostSemantics H} {F : FuncInst H → FuncInst H → Prop}

/-- A cut kernel contains a non-value. -/
theorem exists_nonval_of_cut {kc : List Admin} (hkc : kc = [.trap] ∨ ∃ a, kc = throwing a) :
    ∃ c ∈ kc, c.val? = none := by
  rcases hkc with rfl | ⟨a, rfl⟩
  · exact ⟨_, List.mem_singleton_self _, rfl⟩
  · exact ⟨.plain .throwRef, by simp [throwing], rfl⟩

/-- Flat form of `AdminsRel.values_lift`. -/
theorem SeqRel.values_lift (hB : BaseFacts P host F BI B rank) {s : Store H} {f : Frame}
    {x y : List Admin} (h : SeqRel (AdminRel BI (WithCuts B)) (WithCuts B) x y) :
    ∀ {t : Store H} {vs us : List Val}, StoreRel F s t → x = vals us →
    ∃ t', Steps P host ⟨t, f, vals vs ++ y⟩ ⟨t', f, vals vs ++ vals us⟩ ∧ StoreRel F s t' := by
  induction h with
  | nil =>
    intro t vs us hst hx
    rcases us with _ | ⟨u, us⟩
    · exact ⟨t, .refl, hst⟩
    · simp [vals_cons'] at hx
  | @cons a a' as as' ha _ ih =>
    intro t vs us hst hx
    rcases us with _ | ⟨u, us⟩
    · simp [vals_nil'] at hx
    · rw [vals_cons', List.cons.injEq] at hx
      obtain ⟨rfl, h2⟩ := hx
      obtain rfl := ha.eq_of_rigid (AdminRigid.of_val? (Admin.val?_toAdmin u))
      obtain ⟨t', hs, hst'⟩ := ih (vs := vs ++ [u]) hst h2
      exact ⟨t', by simpa [vals_cons', vals_nil'] using hs, hst'⟩
  | base hc =>
    intro t vs us hst hx
    rcases hc with hb | ⟨us', ws', kc, x', y', hkc, rfl, -⟩
    · exact hB.values hst hb hx
    · exfalso
      obtain ⟨c, hc, hcv⟩ := exists_nonval_of_cut hkc
      exact not_mem_vals hcv (by rw [← hx]; simp [hc])
  | @append x x' y y' _ _ ih ih' =>
    intro t vs us hst hx
    obtain ⟨us₁, us₂, rfl, rfl, rfl⟩ := List.map_eq_append_iff.mp hx.symm
    obtain ⟨t₁, hs₁, hst₁⟩ := ih (vs := vs) hst rfl
    obtain ⟨t', hs₂, hst'⟩ := ih' (vs := vs ++ us₁) hst₁ rfl
    refine ⟨t', ?_, hst'⟩
    rw [vals_append] at hs₂
    rw [← List.append_assoc, vals_append, ← List.append_assoc]
    exact (steps_append hs₁ y').trans hs₂

/-- **Values lift.** If the left side of a closure pair is `val* us`, the right
side runs, after any value prefix and in the same frame, to `val* us` with a
related store. -/
theorem AdminsRel.values_lift (hB : BaseFacts P host F BI B rank) {s t : Store H} {f : Frame}
    {vs us : List Val} {x y : List Admin} (hst : StoreRel F s t)
    (h : AdminsRel BI (WithCuts B) x y) (hx : x = Core.vals us) :
    ∃ t' : Store H, Steps P host ⟨t, f, Core.vals vs ++ y⟩ ⟨t', f, Core.vals vs ++ Core.vals us⟩ ∧
      StoreRel F s t' :=
  (h.toSeqRel (fun hxy => Or.inl (hB.src hxy))).values_lift hB hst hx

/-- Flat form of `AdminsRel.exit_lift`. -/
theorem SeqRel.exit_lift (hB : BaseFacts P host F BI B rank) {s : Store H} {f : Frame}
    {k : List Admin} (hk : Exit k)
    {x y : List Admin} (h : SeqRel (AdminRel BI (WithCuts B)) (WithCuts B) x y) :
    ∀ {t : Store H} {vs us : List Val} {j : List Admin}, StoreRel F s t →
    vals vs ++ x = vals us ++ k ++ j →
    ∃ (t' : Store H) (ws : List Val) (j' : List Admin),
      Steps P host ⟨t, f, vals vs ++ y⟩ ⟨t', f, vals ws ++ k ++ j'⟩ ∧ StoreRel F s t' ∧
      (ws = us ∨ k = [.trap] ∨ ∃ a, k = throwing a) := by
  obtain ⟨pre, e, hen, hke⟩ := hk.eq_vals_append
  induction h with
  | nil =>
    intro t vs us j hst hx
    exfalso
    have hm : e ∈ vals us ++ k ++ j := by rw [hke]; simp
    rw [← hx, List.append_nil] at hm
    exact not_mem_vals hen hm
  | @cons a a' as as' ha _ ih =>
    intro t vs us j hst hx
    cases hav : a.val? with
    | some v =>
      obtain rfl := Admin.eq_of_val? hav
      obtain rfl := ha.eq_of_rigid (AdminRigid.of_val? hav)
      obtain ⟨t', ws, j', hs, hst', hw⟩ :=
        ih (vs := vs ++ [v]) (us := us) (j := j) hst (by simpa [vals_cons', vals_nil'] using hx)
      exact ⟨t', ws, j', by simpa [vals_cons', vals_nil'] using hs, hst', hw⟩
    | none =>
      have h1 : vals vs ++ a :: as = vals (us ++ pre) ++ e :: j := by rw [hx, hke]; simp
      obtain ⟨rfl, rfl, rfl⟩ := vals_append_cons_inj hav hen h1
      obtain rfl := ha.eq_of_rigid (hk.rigid_head hke)
      refine ⟨t, us, as', ?_, hst, Or.inl rfl⟩
      rw [hke]
      simp only [vals_append, List.append_assoc, List.singleton_append]
      exact .refl
  | base hc =>
    intro t vs us j hst hx
    rcases hc with hb | ⟨us', ws', kc, x', y', hkc, rfl, rfl⟩
    · obtain ⟨t', j', hs, hst'⟩ := hB.exit hst hb hk hx
      exact ⟨t', us, j', hs, hst', Or.inl rfl⟩
    · rcases hkc with rfl | ⟨a, rfl⟩
      · have h1 : vals (vs ++ us') ++ .trap :: x' = vals (us ++ pre) ++ e :: j := by
          rw [hke] at hx; simpa using hx
        obtain ⟨-, rfl, rfl⟩ := vals_append_cons_inj val?_trap hen h1
        have hkt := hk.eq_trap hke
        refine ⟨t, vs ++ ws', y', ?_, hst, Or.inr (Or.inl hkt)⟩
        rw [hkt, show vals vs ++ (vals ws' ++ [.trap] ++ y') = vals (vs ++ ws') ++ [.trap] ++ y'
          by simp]
      · have h1 : vals (vs ++ us' ++ [.ref (.exn a)]) ++ .plain .throwRef :: x' =
            vals (us ++ pre) ++ e :: j := by
          rw [hke] at hx; simpa [vals_cons', vals_nil', Val.toAdmin, throwing] using hx
        obtain ⟨hv, rfl, rfl⟩ := vals_append_cons_inj val?_throwRef hen h1
        obtain ⟨b, rfl, hkb⟩ := hk.eq_throw hke
        have hab : a = b := by simpa using List.append_inj_right' hv rfl
        subst hab
        refine ⟨t, vs ++ ws', y', ?_, hst, Or.inr (Or.inr ⟨a, hkb⟩)⟩
        rw [hkb, show vals vs ++ (vals ws' ++ throwing a ++ y') =
          vals (vs ++ ws') ++ throwing a ++ y' by simp]
  | @append x x' y y' hxy _ ih ih' =>
    intro t vs us j hst hx
    have h1 : vals vs ++ x ++ x' = vals (us ++ pre) ++ e :: j := by
      rw [hke] at hx; simpa using hx
    rcases split_append hen h1 with ⟨vs₀, rfl, h2⟩ | ⟨r₀, h2, rfl⟩
    · obtain ⟨t₁, hs₁, hst₁⟩ := SeqRel.values_lift hB hxy (f := f) (vs := vs) hst rfl
      obtain ⟨t', ws, j', hs₂, hst', hw⟩ :=
        ih' (vs := vs ++ vs₀) (us := us) (j := j) hst₁ (by rw [hke]; simpa using h2)
      refine ⟨t', ws, j', ?_, hst', hw⟩
      rw [vals_append] at hs₂
      rw [← List.append_assoc]
      exact (steps_append hs₁ y').trans hs₂
    · obtain ⟨t', ws, j', hs, hst', hw⟩ :=
        ih (vs := vs) (us := us) (j := r₀) hst (by rw [hke]; simpa using h2)
      refine ⟨t', ws, j' ++ y', ?_, hst', hw⟩
      rw [← List.append_assoc, ← List.append_assoc (vals ws ++ k)]
      exact steps_append hs y'

/-- **Exit lift.** If the left side of a closure pair, after a value prefix, is
`val* us k j` with `Exit k`, the right side runs, in the same frame and with a
related store, to `val* ws k j'`, where `ws = us` unless `k` is `trap` or a
thrown exception (whose bubbling rules discard the values before the kernel). -/
theorem AdminsRel.exit_lift (hB : BaseFacts P host F BI B rank) {s t : Store H} {f : Frame}
    {vs us : List Val} {x y k j : List Admin} (hst : StoreRel F s t)
    (h : AdminsRel BI (WithCuts B) x y) (hk : Exit k) (hx : Core.vals vs ++ x = Core.vals us ++ k ++ j) :
    ∃ (t' : Store H) (ws : List Val) (j' : List Admin),
      Steps P host ⟨t, f, Core.vals vs ++ y⟩ ⟨t', f, Core.vals ws ++ k ++ j'⟩ ∧ StoreRel F s t' ∧
      (ws = us ∨ k = [.trap] ∨ ∃ a, k = throwing a) :=
  (h.toSeqRel (fun hxy => Or.inl (hB.src hxy))).exit_lift hB hk hst hx

end Silmaril.Wasm.Execution.Core.Sim
