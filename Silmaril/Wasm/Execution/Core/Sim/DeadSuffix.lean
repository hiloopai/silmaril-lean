module

public import Silmaril.Wasm.Execution.Core.Sim.Closure
public import Silmaril.Wasm.Execution.Core.Sim.StepMatch

@[expose] public section

/-! # Probe: dead code after a bottom instruction

The minimal dead-code-elimination relation, as an instance of the generic
simulation theorem (`Sim/Closure.lean`):

* source base `dceBI`: `k ++ b :: j₁` ~ `k ++ b :: j₂` with `b` a bottom
  instruction (`BotInstr`: `unreachable`, `br`, `br_table`, `return`,
  `throw`, `throw_ref`, `return_call`, `return_call_ref`,
  `return_call_indirect` — exactly the Binaryen sketch's `botInstr`);
* runtime base `dceB`: the same with `b` a runtime bottom (`Admin.IsBot`, which
  adds `trap` and the type-annotated `return_call_ref`).

Both relations are symmetric, so one `BaseSim` proof gives both directions. The
shared prefix `k` is part of the base pair (rather than of the closure) because
it runs: `return_call_indirect` reduces to `table.get; ref.cast; return_call_ref`,
whose last instruction is again a bottom.

Results:

* `dceBaseSim`: the obligations, for every function relation inside
  `FuncRel dceBI` and every host respecting it;
* `dce_unreachable_block_behavioursOf_eq`: deleting `es` in
  `block bt (p ++ unreachable :: es)` anywhere in a configuration's code does
  not change its behaviours (store and host arbitrary) — the task's minimal case;
* `dce_behaviours_eq`: invoking a function in two stores whose function bodies
  differ by any number of nested dead-suffix deletions gives the same behaviours,
  for every code-parametric host (`HostParametric`).

**Relation to the sketch's `dce_sound`.** The sketch's `DceCut`
(`Silmaril/Wasm/Binaryen/DCECutTyping.lean`)
is generated by `refl`, `trans`, `append`, `cut` (`a ++ b ~ a` with `a` ending in
`botInstr`) and the four structured congruences. Every generator except `trans`
is an `InstrsRel dceBI` generator; `trans` is handled by composing two
`dce_behaviours_eq` instances. So `dceL_cut` and `dce_behaviours_eq` give
behavioural equality of every function invocation after DCE. Once the corrected
generic theorem `closure_configSim` (over `AdminsRel BI (WithCuts B)`) and
`dceBaseSim` are established, what remains for `dce_sound` is the module/session
layer: instantiation produces `StoreRel (FuncRel dceBI)`-related stores, then
`ExportRefines` sessions. `dce_behaviours_eq` assumes a `HostParametric` host,
which excludes hosts that call back into Wasm.
-/

namespace Silmaril.Wasm.Execution.Core.Sim

open Silmaril.Wasm.Numerics (Profile)
open Silmaril.Wasm.Validation

variable {H : Type}

/-- Stack-polymorphic (bottom) source instructions: control never falls through. -/
def BotInstr : Instr → Prop
  | .unreachable | .br _ | .brTable _ _ | .return_ | .throw _ | .throwRef
  | .returnCall _ | .returnCallRef _ | .returnCallIndirect _ _ => True
  | _ => False

/-- Runtime bottoms: a bottom source instruction, `trap`, or an annotated
`return_call_ref`. -/
def _root_.Silmaril.Wasm.Execution.Core.Admin.IsBot : Admin → Prop
  | .plain i => BotInstr i
  | .trap => True
  | .returnCallRefType _ => True
  | _ => False

theorem _root_.Silmaril.Wasm.Execution.Core.Admin.IsBot.val?_eq_none {b : Admin} (hb : b.IsBot) :
    b.val? = none := by
  cases hv : b.val? with
  | none => rfl
  | some v =>
    obtain rfl := Admin.eq_of_val? hv
    rcases v with ⟨⟨_ | _⟩, _⟩ | _ | _ <;> simp [Val.toAdmin, Admin.IsBot, BotInstr] at hb

/-- Source base relation: equal up to the code after a bottom instruction. -/
def dceBI (x y : List Instr) : Prop :=
  ∃ (k : List Instr) (b : Instr) (j₁ j₂ : List Instr),
    BotInstr b ∧ x = k ++ b :: j₁ ∧ y = k ++ b :: j₂

/-- Runtime base relation: equal up to the code after a runtime bottom. -/
def dceB (x y : List Admin) : Prop :=
  ∃ (k : List Admin) (b : Admin) (j₁ j₂ : List Admin),
    b.IsBot ∧ x = k ++ b :: j₁ ∧ y = k ++ b :: j₂

theorem _root_.Silmaril.Wasm.Execution.Core.Admin.IsBot.not_isCallRef {b : Admin} (hb : b.IsBot) :
    ¬ b.IsCallRef := by
  intro h
  unfold Admin.IsCallRef at h
  split at h <;> simp_all [Admin.IsBot, BotInstr]

theorem _root_.Silmaril.Wasm.Execution.Core.Admin.IsBot.not_isCtx {b : Admin} (hb : b.IsBot) :
    ¬ b.IsCtx := by
  cases b <;> simp_all [Admin.IsCtx, Admin.IsBot]

theorem _root_.Silmaril.Wasm.Execution.Core.Admin.IsCallRef.not_isBot {b : Admin}
    (h : b.IsCallRef) : ¬ b.IsBot := fun hb => hb.not_isCallRef h

section
variable {P : Profile} {host : HostSemantics H}

set_option maxHeartbeats 2000000 in
set_option linter.unusedSimpArgs false in
set_option linter.unusedTactic false in
set_option linter.unreachableTactic false in
/-- A step of code ending in a bottom produces code containing a bottom. -/
theorem Step.bot_of_last {c c' : Config H} (h : Step P host c c') :
    ∀ b, c.code.getLast? = some b → b.IsBot → ∃ d ∈ c'.code, d.IsBot := by
  induction h with
  | @ctxtInstrs s s' f f' vs is is' rest hs hne ih =>
    intro b hl hb
    dsimp only at hl ih ⊢
    rcases List.eq_nil_or_concat rest with rfl | ⟨R, y, rfl⟩
    · rcases List.eq_nil_or_concat is with rfl | ⟨I, z, rfl⟩
      · exact absurd hs.not_all_isVal (by simp)
      · have hz : z = b := by simpa [← List.append_assoc] using hl
        subst hz
        obtain ⟨d, hd, hdb⟩ := ih z (by simp) hb
        exact ⟨d, by simp [hd], hdb⟩
    · have hy : y = b := by simpa [← List.append_assoc] using hl
      subst hy
      exact ⟨y, by simp, hb⟩
  | parametric h | numeric h | vector h | «variable» h | table h | memory h | reference h
    | aggregate h =>
    intro b hl hb
    cases h <;> simp [constI32] at hl <;> subst hl <;>
      simp_all [Admin.IsBot, BotInstr, constI32]
  | _ =>
    intro b hl hb
    first
      | (simp [constI32] at hl; subst hl;
          simp_all [Admin.IsBot, BotInstr, constI32, Admin.IsCallRef.not_isBot]; done)
      | (simp at hl; subst hl
         exact absurd hb (Admin.IsCallRef.not_isBot ‹Admin.IsCallRef _›))
      | simp_all [Admin.IsBot, BotInstr, constI32, Admin.IsCallRef.not_isBot]

end

/-- A discard around an exit kernel strictly decreases `codeSize`. -/
theorem codeSize_discard (ws us : List Val) (k r r' : List Admin) (h : us ≠ [] ∨ r ≠ []) :
    codeSize (vals ws ++ k ++ r') < codeSize (vals ws ++ vals us ++ k ++ (r ++ r')) := by
  simpa using codeSize_discard_lt ws us k r r' h

/-- A `trap` or a thrown exception that discards code on the left is matched on the
right by discarding everything around the kernel (or by a stutter when there is
nothing to discard); the results are a dead-suffix pair. -/
theorem dce_discard {P : Profile} {host : HostSemantics H} {t : Store H} {f : Frame}
    {V : List Val} {a : Admin} {E E' es' : List Admin}
    (hd : (a = .trap ∧ ∃ (ws us : List Val) (r r' : List Admin), V = ws ++ us ∧ E = r ++ r' ∧
        (us ≠ [] ∨ r ≠ []) ∧ es' = vals ws ++ [.trap] ++ r') ∨
      (a = .plain .throwRef ∧ ∃ (ws us : List Val) (x : Nat) (r r' : List Admin),
        V = ws ++ us ++ [.ref (.exn x)] ∧ E = r ++ r' ∧ (us ≠ [] ∨ r ≠ []) ∧
        es' = vals ws ++ throwing x ++ r')) :
    ∃ es'' : List Admin,
      (Relation.TransGen (Step P host) ⟨t, f, vals V ++ a :: E'⟩ ⟨t, f, es''⟩ ∨
        (es'' = vals V ++ a :: E' ∧ codeSize es' < codeSize (vals V ++ a :: E))) ∧
      dceB es' es'' := by
  rcases hd with ⟨rfl, ws, us, r, r', rfl, rfl, hne, rfl⟩ |
      ⟨rfl, ws, us, x, r, r', rfl, rfl, hne, rfl⟩
  · have hdce : dceB (vals ws ++ [.trap] ++ r') (vals ws ++ [.trap]) :=
      ⟨vals ws, .trap, r', [], trivial, by simp, by simp⟩
    have hsz := codeSize_discard ws us [.trap] r r' hne
    have heq : vals (ws ++ us) ++ Admin.trap :: (r ++ r') =
        vals ws ++ vals us ++ [.trap] ++ (r ++ r') := by simp [vals]
    by_cases hz : us = [] ∧ E' = []
    · obtain ⟨rfl, rfl⟩ := hz
      refine ⟨_, Or.inr ⟨rfl, by rw [heq]; exact hsz⟩, ?_⟩
      simpa [vals] using hdce
    · refine ⟨vals ws ++ [.trap], Or.inl (.single ?_), hdce⟩
      have hne' : us ≠ [] ∨ E' ≠ [] := by tauto
      have hs := Step.vals_left (Step.trapInstrs (P := P) (host := host) (s := t) (f := f)
        (vs := us) (rest := E') hne') ws
      have heq' : vals (ws ++ us) ++ Admin.trap :: E' = vals ws ++ (vals us ++ [.trap] ++ E') := by
        simp [vals]
      rw [heq']
      exact hs
  · have hdce : dceB (vals ws ++ throwing x ++ r') (vals ws ++ throwing x) :=
      ⟨vals ws ++ [.ref (.exn x)], .plain .throwRef, r', [], trivial, by simp [throwing],
        by simp [throwing]⟩
    have hsz := codeSize_discard ws us (throwing x) r r' hne
    have heq : vals (ws ++ us ++ [.ref (.exn x)]) ++ Admin.plain .throwRef :: (r ++ r') =
        vals ws ++ vals us ++ throwing x ++ (r ++ r') := by simp [vals, throwing, Val.toAdmin]
    by_cases hz : us = [] ∧ E' = []
    · obtain ⟨rfl, rfl⟩ := hz
      refine ⟨_, Or.inr ⟨rfl, by rw [heq]; exact hsz⟩, ?_⟩
      simpa [vals, throwing, Val.toAdmin] using hdce
    · refine ⟨vals ws ++ throwing x, Or.inl (.single ?_), hdce⟩
      have hne' : us ≠ [] ∨ E' ≠ [] := by tauto
      have hs := Step.vals_left (Step.throwRefInstrs (P := P) (host := host) (s := t) (f := f)
        (vs := us) (a := x) (rest := E') hne') ws
      have heq' : vals (ws ++ us ++ [.ref (.exn x)]) ++ Admin.plain .throwRef :: E' =
          vals ws ++ (vals us ++ throwing x ++ E') := by simp [vals, throwing, Val.toAdmin]
      rw [heq']
      exact hs

/-- An exit inside a dead-suffix pair `val* (k ++ b :: j₁)` lies at or before
the bottom `b`, so the right side `val* (k ++ b :: j₂)` is already in the same
exit shape. -/
theorem dceB_exit {vs us : List Val} {x y kk j : List Admin} (hxy : dceB x y) (hk : Exit kk)
    (he : vals vs ++ x = vals us ++ kk ++ j) :
    ∃ j' : List Admin, vals vs ++ y = vals us ++ kk ++ j' := by
  obtain ⟨k, b, j₁, j₂, hb, rfl, rfl⟩ := hxy
  obtain ⟨pre, e, hen, rfl⟩ := hk.eq_vals_append
  have hbn := Admin.IsBot.val?_eq_none hb
  by_cases hka : k.all Admin.isVal = true
  · obtain ⟨kv, rfl⟩ := exists_vals_of_all hka
    have h1 : vals (vs ++ kv) ++ b :: j₁ = vals (us ++ pre) ++ e :: j := by
      simpa using he
    obtain ⟨h2, h3, -⟩ := vals_append_cons_inj hbn hen h1
    refine ⟨j₂, ?_⟩
    rw [show vals vs ++ (vals kv ++ b :: j₂) = vals (vs ++ kv) ++ b :: j₂ by simp, h2, h3]
    simp
  · obtain ⟨kv, c, kr, hc, rfl⟩ := exists_head_of_not_all (by simpa using hka)
    have h1 : vals (vs ++ kv) ++ c :: (kr ++ b :: j₁) = vals (us ++ pre) ++ e :: j := by
      simpa using he
    obtain ⟨h2, h3, -⟩ := vals_append_cons_inj hc hen h1
    refine ⟨kr ++ b :: j₂, ?_⟩
    rw [show vals vs ++ (vals kv ++ c :: kr ++ b :: j₂) = vals (vs ++ kv) ++ c :: (kr ++ b :: j₂)
      by simp, h2, h3]
    simp

theorem dceBI_symm {x y : List Instr} (h : dceBI x y) : dceBI y x := by
  obtain ⟨k, b, j₁, j₂, hb, rfl, rfl⟩ := h
  exact ⟨k, b, j₂, j₁, hb, rfl, rfl⟩

theorem dceB_symm {x y : List Admin} (h : dceB x y) : dceB y x := by
  obtain ⟨k, b, j₁, j₂, hb, rfl, rfl⟩ := h
  exact ⟨k, b, j₂, j₁, hb, rfl, rfl⟩

theorem dceBI_flip : (fun a b => dceBI b a) = dceBI := by
  funext a b
  exact propext ⟨dceBI_symm, dceBI_symm⟩

theorem dceB_flip : (fun a b => dceB b a) = dceB := by
  funext a b
  exact propext ⟨dceB_symm, dceB_symm⟩

/-- Lowering a source dead suffix gives a runtime dead suffix. -/
theorem dceB_expression {x y : List Instr} (h : dceBI x y) :
    dceB (expression x) (expression y) := by
  obtain ⟨k, b, j₁, j₂, hb, rfl, rfl⟩ := h
  exact ⟨expression k, .plain b, expression j₁, expression j₂, hb,
    by simp [expression], by simp [expression]⟩

/-- `FuncRel` of the converse relation. -/
theorem FuncRel.flip {BI : List Instr → List Instr → Prop} {fi gi : FuncInst H}
    (h : FuncRel BI fi gi) : FuncRel (fun a b => BI b a) gi fi := by
  obtain ⟨ht, hm, hc⟩ := h
  refine ⟨ht.symm, hm.symm, ?_⟩
  rcases hfc : fi.code with f | h₁ <;> rcases hgc : gi.code with g | h₂ <;>
    rw [hfc, hgc] at hc <;> simp only [FuncCodeRel] at hc ⊢
  · exact ⟨hc.1.symm, hc.2.1.symm, hc.2.2.flip⟩
  · exact hc.symm

/-- `FuncRel dceBI` is symmetric. -/
theorem FuncRel.dce_symm {fi gi : FuncInst H} (h : FuncRel dceBI fi gi) : FuncRel dceBI gi fi := by
  simpa only [dceBI_flip] using h.flip

/-- **The probe obligations.** Dead suffixes after a bottom satisfy `BaseSim`
for every function relation inside `FuncRel dceBI` and every host respecting it. -/
theorem dceBaseSim {P : Profile} {host : HostSemantics H} {F : FuncInst H → FuncInst H → Prop}
    (hF : ∀ fi gi, F fi gi → FuncRel dceBI fi gi) (hhost : HostRespects F host) :
    BaseSim P host F dceBI dceB where
  src := dceB_expression
  step := by
    intro s t s' f f' vs x y rest rest' es' hst hxy hrest hstep
    obtain ⟨k, b, j₁, j₂, hb, rfl, rfl⟩ := hxy
    have hbn := Admin.IsBot.val?_eq_none hb
    by_cases hka : k.all Admin.isVal = true
    · obtain ⟨kv, rfl⟩ := exists_vals_of_all hka
      have hL : vals vs ++ (vals kv ++ b :: j₁) ++ rest =
          vals (vs ++ kv) ++ b :: (j₁ ++ rest) := by
        simp [vals]
      have hR : vals vs ++ (vals kv ++ b :: j₂) ++ rest' =
          vals (vs ++ kv) ++ b :: (j₂ ++ rest') := by
        simp [vals]
      rw [hL] at hstep ⊢
      rw [hR]
      rcases Step.split_head hbn hstep with ⟨ws, us, is', hV, hs1, rfl⟩ | hd | hd
      · obtain ⟨t', hs2, hst'⟩ :=
          Step.transport_storeRel hst (Admin.IsBot.not_isCtx hb) (Admin.IsBot.not_isCallRef hb) hs1
        obtain ⟨d, hd, hdb⟩ := Step.bot_of_last hs1 b (by simp) hb
        dsimp only at hd
        obtain ⟨p, q, rfl⟩ := List.append_of_mem hd
        refine ⟨t', vals ws ++ (p ++ d :: q) ++ (j₂ ++ rest'), Or.inl (.single ?_), hst',
          .base ⟨vals ws ++ p, d, q ++ (j₁ ++ rest), q ++ (j₂ ++ rest'), hdb, by simp, by simp⟩⟩
        have heq : vals (vs ++ kv) ++ b :: (j₂ ++ rest') =
            vals ws ++ (vals us ++ [b]) ++ (j₂ ++ rest') := by
          rw [hV]; simp [vals]
        rw [heq]
        exact Step.append_right (Step.vals_left hs2 ws) _
      · obtain ⟨ha, rfl, rfl, hr⟩ := hd
        obtain ⟨es'', h1, h2⟩ := dce_discard (P := P) (host := host) (t := t) (f := f')
          (E' := j₂ ++ rest') (Or.inl ⟨ha, hr⟩)
        exact ⟨t, es'', h1.imp id (fun h => ⟨rfl, rfl, h.1, h.2⟩), hst, .base h2⟩
      · obtain ⟨ha, rfl, rfl, hr⟩ := hd
        obtain ⟨es'', h1, h2⟩ := dce_discard (P := P) (host := host) (t := t) (f := f')
          (E' := j₂ ++ rest') (Or.inr ⟨ha, hr⟩)
        exact ⟨t, es'', h1.imp id (fun h => ⟨rfl, rfl, h.1, h.2⟩), hst, .base h2⟩
    · obtain ⟨kv, c, kr, hc, rfl⟩ := exists_head_of_not_all (by simpa using hka)
      have hL : vals vs ++ (vals kv ++ c :: kr ++ b :: j₁) ++ rest =
          vals (vs ++ kv) ++ c :: ((kr ++ b :: j₁) ++ rest) := by
        simp [vals]
      have hR : vals vs ++ (vals kv ++ c :: kr ++ b :: j₂) ++ rest' =
          vals (vs ++ kv) ++ c :: ((kr ++ b :: j₂) ++ rest') := by
        simp [vals]
      rw [hL] at hstep ⊢
      rw [hR]
      rcases Step.split_head hc hstep with ⟨ws, us, is', hV, hs1, rfl⟩ | hd | hd
      · obtain ⟨t', is'', hs2, hst', hrel⟩ :=
          Step.match_storeRel (B := dceB) hF hhost hs1 t hst
        refine ⟨t', vals ws ++ is'' ++ ((kr ++ b :: j₂) ++ rest'), Or.inl (.single ?_), hst',
          .append (.append (.refl _) hrel) (.append (.base ⟨kr, b, j₁, j₂, hb, rfl, rfl⟩) hrest)⟩
        have heq : vals (vs ++ kv) ++ c :: ((kr ++ b :: j₂) ++ rest') =
            vals ws ++ (vals us ++ [c]) ++ ((kr ++ b :: j₂) ++ rest') := by
          rw [hV]; simp [vals]
        rw [heq]
        exact Step.append_right (Step.vals_left hs2 ws) _
      · obtain ⟨ha, rfl, rfl, hr⟩ := hd
        obtain ⟨es'', h1, h2⟩ := dce_discard (P := P) (host := host) (t := t) (f := f')
          (E' := (kr ++ b :: j₂) ++ rest') (Or.inl ⟨ha, hr⟩)
        exact ⟨t, es'', h1.imp id (fun h => ⟨rfl, rfl, h.1, h.2⟩), hst, .base h2⟩
      · obtain ⟨ha, rfl, rfl, hr⟩ := hd
        obtain ⟨es'', h1, h2⟩ := dce_discard (P := P) (host := host) (t := t) (f := f')
          (E' := (kr ++ b :: j₂) ++ rest') (Or.inr ⟨ha, hr⟩)
        exact ⟨t, es'', h1.imp id (fun h => ⟨rfl, rfl, h.1, h.2⟩), hst, .base h2⟩
  exit := by
    intro s t f vs us x y kk j hst hxy hk he
    obtain ⟨j', hj'⟩ := dceB_exit hxy hk he
    exact ⟨t, j', hj' ▸ Relation.ReflTransGen.refl, hst⟩
  values := by
    intro s t f vs us x y hst hxy hx
    obtain ⟨k, b, j₁, j₂, hb, rfl, rfl⟩ := hxy
    exfalso
    have hmem : b ∈ vals us := by rw [← hx]; simp
    obtain ⟨v, -, rfl⟩ := List.mem_map.mp hmem
    rcases v with ⟨⟨_ | _⟩, _⟩ | _ | _ <;> simp [Val.toAdmin, Admin.IsBot, BotInstr] at hb

/-- **Minimal DCE, end to end.** Deleting the code after `unreachable` at the end
of a block's body, anywhere in a configuration, preserves its behaviours, for any
store and host. -/
theorem dce_unreachable_block_behavioursOf_eq {P : Profile} (host : HostSemantics H)
    (s : Store H) (f : Frame) (pre post : List Admin) (bt : BlockType) (p es : List Instr) :
    behavioursOf P host ⟨s, f, pre ++ [.plain (.block bt (p ++ .unreachable :: es))] ++ post⟩ =
      behavioursOf P host ⟨s, f, pre ++ [.plain (.block bt (p ++ [.unreachable]))] ++ post⟩ := by
  have hF : ∀ fi gi : FuncInst H, fi = gi → FuncRel dceBI fi gi := by
    rintro fi _ rfl; exact FuncRel.refl fi
  have hF' : ∀ fi gi : FuncInst H, gi = fi → FuncRel (fun a b => dceBI b a) fi gi := by
    intro fi gi h; subst h; exact FuncRel.refl _
  have hhost' : HostRespects (fun g f : FuncInst H => f = g) host := by
    intro h s t vs out hst hout
    obtain rfl : t = s := StoreRel.eq hst.symm
    refine ⟨out, hout, ?_⟩
    cases out with
    | diverged => trivial
    | returned s r => exact ⟨StoreRel.refl (F := fun g f => f = g) (fun _ => rfl) s, rfl⟩
  have hB' : BaseSim P host (fun g f : FuncInst H => f = g) (fun a b => dceBI b a)
      (fun a b => dceB b a) := by
    rw [dceBI_flip, dceB_flip]
    exact dceBaseSim (fun fi gi h => FuncRel.dce_symm (hF gi fi h)) hhost'
  refine closure_behavioursOf_eq (F := (· = ·)) (BI := dceBI) (B := dceB) hF hF'
    (hostRespects_eq host) hhost'
    (dceBaseSim hF (hostRespects_eq host)) hB' ⟨StoreRel.refl (fun _ => rfl) s, rfl, ?_⟩
  refine .append (.append (.refl pre) (.cons (.plain (.block bt (.base ?_))) .nil)) (.refl post)
  exact ⟨p, .unreachable, es, [], trivial, rfl, rfl⟩

/-- **DCE on function bodies, at invocation.** Stores whose function bodies are
related by nested dead-suffix deletion give every invocation the same
behaviours, for any code-parametric host. -/
theorem dce_behaviours_eq {P : Profile} {host : HostSemantics H} (hhost : HostParametric host)
    {s t : Store H} (hst : StoreRel (FuncRel dceBI) s t) (a : Nat) (vs : List Val) :
    behaviours P host s a vs = behaviours P host t a vs := by
  have hcode : (invoke s a vs).code = (invoke t a vs).code := by
    simp only [invoke, ← List.getElem?_map, hst.types]
  have hF' : ∀ fi gi : FuncInst H, FuncRel dceBI gi fi → FuncRel (fun a b => dceBI b a) fi gi :=
    fun _ _ h => h.flip
  have hhost' : HostRespects (fun g f : FuncInst H => FuncRel dceBI f g) host :=
    hhost.respects (fun f => FuncRel.refl f)
  have hB' : BaseSim P host (fun g f : FuncInst H => FuncRel dceBI f g) (fun a b => dceBI b a)
      (fun a b => dceB b a) := by
    rw [dceBI_flip, dceB_flip]
    exact dceBaseSim (fun _ _ h => h.dce_symm) hhost'
  have hhost₀ : HostRespects (FuncRel dceBI) host := hhost.respects (fun f => FuncRel.refl f)
  refine closure_behavioursOf_eq (F := FuncRel dceBI) (BI := dceBI) (B := dceB)
    (fun _ _ h => h) hF' hhost₀ hhost' (dceBaseSim (fun _ _ h => h) hhost₀) hB' ⟨hst, rfl, ?_⟩
  rw [hcode]
  exact AdminsRel.refl _

end Silmaril.Wasm.Execution.Core.Sim
