module

public import Silmaril.Wasm.Component.Streams.Kernel.Defs
public import Silmaril.Wasm.JcoTool.WatCert.Defs

/-!
# The text templates of `wasm-streams-gen`, with certificates

`wasm-streams-gen` prints two core modules from text templates: `KM.coreWat` (the core
module of a byte kernel, `Silmaril.Wasm.Component.Streams.Kernel`) and the **tee** (`teeWat`,
moved here from the tool so that a theorem can name it). Neither template is proved correct
for all inputs. Every text the tool prints now carries the certificate of
`Silmaril.Wasm.JcoTool.WatCert`: silmaril's sound WAT reader reads it as a Core 3.0 module and
silmaril's verified encoder encodes that module, and the tool's `-o OUT.wasm` writes those
bytes.

* `coreText name k batch wmax`, `coreBytes …`: `KM.coreWat` with its certificate;
* `teeText name batch`, `teeBytes …`: `teeWat` with its certificate.

Theorems (`KernelWat.Thms`): the printed text denotes, in silmaril's Core 3.0 text grammar,
the module whose encoding the bytes are. What the module computes is not covered here
(`Callback`/`Live` model the driver loop; see `docs/projects/wasm-components.md`).
-/

@[expose] public section

namespace Silmaril.Wasm.Component.Streams.KernelWat

open Silmaril.Wasm.Component.Streams.Kernel
open Silmaril.Wasm.JcoTool.WatCert

/-- The core module of a **tee**: `name: async func(in: stream<u8>) -> tuple<stream<u8>,
stream<u8>>`. Every byte read is written to both outputs (output 0 first); an output whose reader
has gone (`DROPPED`) is dead and skipped; reading stops when the input ends or both are dead. -/
def teeWat (name : String) (batch : Nat) : String :=
  s!";; Generated by wasm-streams-gen: a tee with two output streams.
(module
  (import \"[export]$root\" \"[task-return]{name}\" (func $task.return (param i32 i32)))
  (import \"[export]$root\" \"[stream-new-0]{name}\" (func $stream.new (result i64)))
  (import \"[export]$root\" \"[async-lower][stream-read-0]{name}\" (func $stream.read (param i32 i32 i32) (result i32)))
  (import \"[export]$root\" \"[async-lower][stream-write-0]{name}\" (func $stream.write (param i32 i32 i32) (result i32)))
  (import \"[export]$root\" \"[stream-drop-readable-0]{name}\" (func $stream.drop-readable (param i32)))
  (import \"[export]$root\" \"[stream-drop-writable-0]{name}\" (func $stream.drop-writable (param i32)))
  (import \"$root\" \"[waitable-set-new]\" (func $waitable-set.new (result i32)))
  (import \"$root\" \"[waitable-join]\" (func $waitable.join (param i32 i32)))
  (memory (export \"memory\") 1)
  (func (export \"cabi_realloc\") (param i32 i32 i32 i32) (result i32) (i32.const 0x8000))
  (global $ws (mut i32) (i32.const 0))
  (global $insr (mut i32) (i32.const 0))
  (global $w0 (mut i32) (i32.const 0))
  (global $w1 (mut i32) (i32.const 0))
  (global $len (mut i32) (i32.const 0))
  (global $off0 (mut i32) (i32.const 0))
  (global $off1 (mut i32) (i32.const 0))
  (global $dead0 (mut i32) (i32.const 0))
  (global $dead1 (mut i32) (i32.const 0))
  (global $wp0 (mut i32) (i32.const 0))
  (global $wp1 (mut i32) (i32.const 0))
  (global $rpend (mut i32) (i32.const 0))
  (global $eof (mut i32) (i32.const 0))
  (global $rdropped (mut i32) (i32.const 0))
  (func $wait (result i32) (i32.or (i32.const 2) (i32.shl (global.get $ws) (i32.const 4))))
  (func $stopReading
    (if (i32.and (i32.eqz (global.get $rdropped)) (i32.eqz (global.get $rpend)))
      (then (call $stream.drop-readable (global.get $insr)) (global.set $rdropped (i32.const 1))))
    (global.set $eof (i32.const 1)))
  (func $onread (param $p i32)
    (global.set $len (i32.shr_u (local.get $p) (i32.const 4)))
    (global.set $off0 (i32.const 0))
    (global.set $off1 (i32.const 0))
    (if (i32.ne (i32.and (local.get $p) (i32.const 0xf)) (i32.const 0)) (then (call $stopReading))))
  (func $onw0 (param $p i32)
    (global.set $off0 (i32.add (global.get $off0) (i32.shr_u (local.get $p) (i32.const 4))))
    (if (i32.ne (i32.and (local.get $p) (i32.const 0xf)) (i32.const 0)) (then (global.set $dead0 (i32.const 1)))))
  (func $onw1 (param $p i32)
    (global.set $off1 (i32.add (global.get $off1) (i32.shr_u (local.get $p) (i32.const 4))))
    (if (i32.ne (i32.and (local.get $p) (i32.const 0xf)) (i32.const 0)) (then (global.set $dead1 (i32.const 1)))))
  (func $pump (result i32) (local $r i32) (local $busy i32)
    (loop $l
      (local.set $busy (i32.const 0))
      ;; output 0
      (if (i32.and (i32.eqz (global.get $dead0)) (i32.lt_u (global.get $off0) (global.get $len)))
        (then
          (if (global.get $wp0) (then (local.set $busy (i32.const 1)))
            (else
              (local.set $r (call $stream.write (global.get $w0) (i32.add (i32.const 0x100) (global.get $off0))
                (i32.sub (global.get $len) (global.get $off0))))
              (if (i32.eq (local.get $r) (i32.const -1))
                (then (global.set $wp0 (i32.const 1)) (local.set $busy (i32.const 1)))
                (else (call $onw0 (local.get $r)) (br $l)))))))
      ;; output 1
      (if (i32.and (i32.eqz (global.get $dead1)) (i32.lt_u (global.get $off1) (global.get $len)))
        (then
          (if (global.get $wp1) (then (local.set $busy (i32.const 1)))
            (else
              (local.set $r (call $stream.write (global.get $w1) (i32.add (i32.const 0x100) (global.get $off1))
                (i32.sub (global.get $len) (global.get $off1))))
              (if (i32.eq (local.get $r) (i32.const -1))
                (then (global.set $wp1 (i32.const 1)) (local.set $busy (i32.const 1)))
                (else (call $onw1 (local.get $r)) (br $l)))))))
      (if (local.get $busy) (then (return (call $wait))))
      ;; both outputs have taken the batch (or are dead)
      (if (i32.and (global.get $dead0) (global.get $dead1)) (then (call $stopReading)))
      (if (global.get $eof)
        (then
          (if (global.get $rpend) (then (return (call $wait))))
          (call $stopReading)
          (call $stream.drop-writable (global.get $w0))
          (call $stream.drop-writable (global.get $w1))
          (return (i32.const 0))))
      (if (global.get $rpend) (then (return (call $wait))))
      (local.set $r (call $stream.read (global.get $insr) (i32.const 0x100) (i32.const {batch})))
      (if (i32.eq (local.get $r) (i32.const -1))
        (then (global.set $rpend (i32.const 1)) (return (call $wait))))
      (call $onread (local.get $r))
      (br $l))
    unreachable)
  (func (export \"[async-lift]{name}\") (param i32) (result i32) (local $p i64) (local $q i64)
    (global.set $insr (local.get 0))
    (local.set $p (call $stream.new))
    (local.set $q (call $stream.new))
    (global.set $w0 (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))))
    (global.set $w1 (i32.wrap_i64 (i64.shr_u (local.get $q) (i64.const 32))))
    (global.set $ws (call $waitable-set.new))
    (call $task.return (i32.wrap_i64 (local.get $p)) (i32.wrap_i64 (local.get $q)))
    (call $waitable.join (global.get $insr) (global.get $ws))
    (call $waitable.join (global.get $w0) (global.get $ws))
    (call $waitable.join (global.get $w1) (global.get $ws))
    (call $pump))
  (func (export \"[callback][async-lift]{name}\") (param $code i32) (param $idx i32) (param $p i32) (result i32)
    (if (i32.and (i32.eq (local.get $code) (i32.const 2)) (i32.eq (local.get $idx) (global.get $insr)))
      (then (if (global.get $rpend)
        (then (global.set $rpend (i32.const 0)) (call $onread (local.get $p)))
        (else (call $stopReading)))))
    (if (i32.and (i32.eq (local.get $code) (i32.const 3)) (i32.eq (local.get $idx) (global.get $w0)))
      (then (if (global.get $wp0)
        (then (global.set $wp0 (i32.const 0)) (call $onw0 (local.get $p)))
        (else (global.set $dead0 (i32.const 1))))))
    (if (i32.and (i32.eq (local.get $code) (i32.const 3)) (i32.eq (local.get $idx) (global.get $w1)))
      (then (if (global.get $wp1)
        (then (global.set $wp1 (i32.const 0)) (call $onw1 (local.get $p)))
        (else (global.set $dead1 (i32.const 1))))))
    (call $pump)))
"

/-- The batch the tool uses: clamped to `1..256`. -/
def clampBatch (b : Nat) : Nat := max 1 (min b 256)

/-- **`wasm-streams-gen core NAME KERNEL BATCH [WMAX]`**: the kernel's core module, printed
only with a certificate. -/
def coreText (name : String) (k : KM) (batch wmax : Nat) : Except String String :=
  checkedText (KM.coreWat name k (clampBatch batch) wmax)

/-- **`wasm-streams-gen core NAME KERNEL BATCH [WMAX] -o OUT.wasm`**: the bytes of the module
the text denotes. -/
def coreBytes (name : String) (k : KM) (batch wmax : Nat) : Except String ByteArray :=
  checkedBytes (KM.coreWat name k (clampBatch batch) wmax)

/-- **`wasm-streams-gen tee NAME BATCH`**: the tee, printed only with a certificate. -/
def teeText (name : String) (batch : Nat) : Except String String :=
  checkedText (teeWat name (clampBatch batch))

/-- **`wasm-streams-gen tee NAME BATCH -o OUT.wasm`**. -/
def teeBytes (name : String) (batch : Nat) : Except String ByteArray :=
  checkedBytes (teeWat name (clampBatch batch))

end Silmaril.Wasm.Component.Streams.KernelWat
