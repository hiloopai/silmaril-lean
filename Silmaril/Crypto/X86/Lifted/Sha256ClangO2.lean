/-! ## Control flow -/

/-- The control-flow graph of `sha256_compress`: blocks `⟨start, terminator⟩` and edges
between block starts. -/
def cfg_sha256_compress : CfgSpec where
  func := fn_sha256_compress
  blocks := [⟨0x20, 0x33⟩,
    ⟨0x40, 0x50⟩,
    ⟨0x52, 0x5b⟩,
    ⟨0x60, 0xb4⟩,
    ⟨0xb6, 0xfb⟩,
    ⟨0x100, 0x190⟩,
