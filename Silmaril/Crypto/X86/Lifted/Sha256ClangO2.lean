  (0x20, [.fallthrough 0x40]),
  (0x40, [.branch 0x40, .fallthrough 0x52]),
  (0x52, [.fallthrough 0x60]),
  (0x60, [.branch 0x60, .fallthrough 0xb6]),
  (0xb6, [.fallthrough 0x100]),
  (0x100, [.branch 0x100, .fallthrough 0x196]),
  (0x196, [.ret])]

