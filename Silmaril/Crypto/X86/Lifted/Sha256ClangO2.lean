/-! ## The transcription and its check -/

/-- The transcription. -/
def transcript : Transcript where
  image := image
  region := region
  regionSha256 := bytesSha256
  fuel := fuel
  listing := listing
  partition := partition
  cfgs := [cfg_sha256_compress]
  exits := exits
  relocs := relocs
  constants := constants

/-- **The check**, by kernel reduction: the model's decoder reads `bytes` as
exactly `listing`, and the partition, CFG, exit and relocation checks pass. -/
theorem transcript_verify : transcript.verify = true := by decide +kernel

/-- What `transcript_verify` establishes. -/
theorem verified : transcript.Verified := Transcript.verify_sound transcript_verify

/-- **decode bytes = transcription.** -/
theorem decode_eq : region.decode fuel = .ok listing := verified.decode

/-- The bytes are the canonical encodings of the listed instructions. -/
theorem bytes_eq_encode : bytes = (listing.map fun d => Silmaril.X86.Ext.encode d.instr).flatten :=
  verified.covers

/-- `bytes` is `Silmaril.Crypto.X86.Sha256O2.raw`. -/
theorem bytes_eq_Sha256O2_raw : bytes = Silmaril.Crypto.X86.Sha256O2.raw := by decide +kernel

/-- `const_sha256_compress_K` is `Silmaril.Crypto.X86.Sha256O2.kBytes`. -/
theorem const_sha256_compress_K_eq_Sha256O2_kBytes : const_sha256_compress_K = Silmaril.Crypto.X86.Sha256O2.kBytes := by decide +kernel

