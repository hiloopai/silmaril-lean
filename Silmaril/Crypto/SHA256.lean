module

public import Silmaril.Crypto.Padding
public import Silmaril.Crypto.Word

/-!
# SHA-256 (FIPS 180-4)

The canonical SHA-256 specification for this repository: `UInt32` words, list-based,
covering every stage of FIPS 180-4 — §5.1.1 padding (via `Silmaril.Crypto.paddingMD`),
§5.2.1 block parsing, §6.2.2 message schedule and round function, §6.2 multi-block
iteration from the §5.3.3 initial hash value, and §6.2.3 digest serialisation.

Every consumer in the tree (`Silmaril.Crypto.HMAC`, `Silmaril.Crypto.TestVectors.ECDSA`,
`xcompile/lean/SpecCheck.lean`) calls `digest` from this module.

The `BitVec 32` register-level form used by the x86-64 work lives in
`Silmaril.Crypto.SHA256.Kernel`; `Silmaril.Crypto.SHA256.Equiv` proves the two agree
for *all* states and blocks (`processBlock_eq_compress`), so the two codebases cannot
drift apart silently.

## Theorems
- `digest_length`: the digest is 32 bytes.
- `digest_abc`, `digest_empty`, `digest_448`, `digest_896`: FIPS 180-4 §B.1/§B.2 and
  NIST CAVP byte-test vectors, checked by the kernel at build time.
- `hash_block_length`: every block `hash` cuts out of the padded message really is the
  sixteen-word block §5.2.1 requires.
-/

@[expose] public section

open Silmaril.Crypto

namespace Silmaril.Crypto.SHA256

/-- The eight working variables `a`–`h` (§6.2.2). -/
abbrev State := UInt32 × UInt32 × UInt32 × UInt32 × UInt32 × UInt32 × UInt32 × UInt32

/-! ### Functions (§4.1.2) -/

def rotr (n : Nat) (x : UInt32) : UInt32 :=
  UInt32.ofNat (x.toBitVec.rotateRight (n % 32)).toNat
def shr (n : Nat) (x : UInt32) : UInt32 := UInt32.ofNat (x.toNat >>> n)
def Ch (x y z : UInt32) : UInt32 := (x &&& y) ^^^ ((~~~ x) &&& z)
def Maj (x y z : UInt32) : UInt32 := (x &&& y) ^^^ (x &&& z) ^^^ (y &&& z)
def Sigma0 (x : UInt32) : UInt32 := rotr 2 x ^^^ rotr 13 x ^^^ rotr 22 x
def Sigma1 (x : UInt32) : UInt32 := rotr 6 x ^^^ rotr 11 x ^^^ rotr 25 x
def sigma0 (x : UInt32) : UInt32 := rotr 7 x ^^^ rotr 18 x ^^^ shr 3 x
def sigma1 (x : UInt32) : UInt32 := rotr 17 x ^^^ rotr 19 x ^^^ shr 10 x

/-! ### Constants (§4.2.2) -/

def K : List UInt32 :=
  [0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,
   0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
   0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,
   0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
   0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,
   0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
   0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,
   0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
   0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,
   0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
   0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,
   0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
   0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,
   0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
   0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,
   0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2]

/-! ### Initial hash value (§5.3.3) -/

def H0 : State :=
  (0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
   0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19)

/-! ### Block parsing (§5.2.1) -/

def parseBlock : List UInt8 → List UInt32
  | b0::b1::b2::b3::rest => ofBytesBE32 b0 b1 b2 b3 :: parseBlock rest
  | _ => []

/-- A §5.2.1 block is exactly sixteen 32-bit words.  Short inputs are zero-extended
and over-long inputs are truncated, so the schedule recurrence below always indexes a
well-defined window (the previous array-based implementation silently mis-indexed
inputs longer than sixteen words). -/
def blockWords (M : List UInt32) : List UInt32 := (M ++ List.replicate 16 0).take 16

/-- One step of the §6.2.2 schedule recurrence
`W t = σ₁ (W (t-2)) + W (t-7) + σ₀ (W (t-15)) + W (t-16)`,
where `acc` holds the words produced so far in reverse order, so that `acc[i]`
is `W (t-1-i)`. -/
def nextScheduleWord (acc : List UInt32) : UInt32 :=
  sigma1 (acc.getD 1 0) + acc.getD 6 0 + sigma0 (acc.getD 14 0) + acc.getD 15 0

/-- Extend a reversed schedule by `n` further words. -/
def expandSchedule : Nat → List UInt32 → List UInt32
  | 0, acc => acc
  | n + 1, acc => expandSchedule n (nextScheduleWord acc :: acc)

/-- The 64-word message schedule `W 0 … W 63` of a 512-bit block (§6.2.2 step 1). -/
def messageSchedule (M : List UInt32) : List UInt32 :=
  (expandSchedule 48 (blockWords M).reverse).reverse

/-! ### Round function (§6.2.2 steps 2–3) -/

def compressRound (a b c d e f g h Kt Wt : UInt32) : State :=
  let T1 := h + Sigma1 e + Ch e f g + Kt + Wt
  let T2 := Sigma0 a + Maj a b c
  (T1+T2, a, b, c, d+T1, e, f, g)

/-- One round, taking the pair `(K t, W t)`. -/
def roundStep (st : State) (kw : UInt32 × UInt32) : State :=
  let (Kt, Wt) := kw
  let (a, b, c, d, e, f, g, h) := st
  compressRound a b c d e f g h Kt Wt

/-- Compression of one 512-bit block (§6.2.2). -/
def processBlock (st : State) (block : List UInt32) : State :=
  let W := messageSchedule block
  let (a,b,c,d,e,f,g,h) := st
  let (a',b',c',d',e',f',g',h') := (K.zip W).foldl roundStep st
  (a' + a, b' + b, c' + c, d' + d, e' + e, f' + f, g' + g, h' + h)

/-! ### Hashing a message (§6.2, §6.2.3) -/

def hash (msg : List UInt8) : State :=
  let padded := paddingMD msg
  let n := padded.length / 64
  (List.range n).foldl (fun st i =>
    let block := parseBlock ((padded.drop (64*i)).take 64)
    processBlock st block) H0

def digest (msg : List UInt8) : List UInt8 :=
  let (h0,h1,h2,h3,h4,h5,h6,h7) := hash msg
  (let (b0,b1,b2,b3) := toBytesBE32 h0
   let (b4,b5,b6,b7) := toBytesBE32 h1
   let (b8,b9,b10,b11) := toBytesBE32 h2
   let (b12,b13,b14,b15) := toBytesBE32 h3
   let (b16,b17,b18,b19) := toBytesBE32 h4
   let (b20,b21,b22,b23) := toBytesBE32 h5
   let (b24,b25,b26,b27) := toBytesBE32 h6
   let (b28,b29,b30,b31) := toBytesBE32 h7
   [b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15,
    b16,b17,b18,b19,b20,b21,b22,b23,b24,b25,b26,b27,b28,b29,b30,b31])

theorem digest_length (msg : List UInt8) : (digest msg).length = 32 := rfl

/-! ### Block structure

FIPS 180-4 §5.2.1 fixes a SHA-256 block at exactly sixteen 32-bit words, which is the
precondition `messageSchedule` needs.  `hash` cuts the padded message with
`drop`/`take`, so the fact that every cut really is a sixteen-word block is a property
of the padding, not an evident one; `hash_block_length` establishes it.
-/

/-- `parseBlock` yields one word per four input bytes. -/
theorem parseBlock_length : ∀ l : List UInt8, (parseBlock l).length = l.length / 4
  | [] => by simp [parseBlock]
  | [_] => by simp [parseBlock]
  | [_, _] => by simp [parseBlock]
  | [_, _, _] => by simp [parseBlock]
  | _ :: _ :: _ :: _ :: rest => by
    have ih := parseBlock_length rest
    simp only [parseBlock, List.length_cons, ih]
    omega

/-- Every block `hash` feeds to `processBlock` is a full §5.2.1 block of sixteen
32-bit words. -/
theorem hash_block_length (msg : List UInt8) (i : Nat)
    (hi : i < (paddingMD msg).length / 64) :
    (parseBlock (((paddingMD msg).drop (64 * i)).take 64)).length = 16 := by
  obtain ⟨k, hk⟩ := paddingMD_block_multiple msg
  rw [hk] at hi
  rw [parseBlock_length, List.length_take, List.length_drop, hk]
  omega

/-! ### Official test vectors

These are the published digests, transcribed from FIPS 180-4 Appendix B and the NIST
CAVP `SHA256ShortMsg.rsp` file — not values read back out of this implementation.
They are checked by the Lean kernel every build, so a corrupted `K` table or a swapped
`Sigma`/`sigma` function (the bug class already found in `SHA1.lean`) fails the build.
-/

/-- FIPS 180-4 §B.1: `SHA256("abc")`. -/
theorem digest_abc :
    digest [0x61, 0x62, 0x63] =
      [0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
       0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
       0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
       0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad] := by
  decide +kernel

/-- NIST CAVP `SHA256ShortMsg.rsp`, `Len = 0`: `SHA256("")`. -/
