/-- `flist`, the lowest static address of the allocator. -/
abbrev flistA : Nat := 0x4030a0
/-- `last`. -/
abbrev lastA : Nat := 0x4030c0
/-- `first`. -/
abbrev firstA : Nat := 0x4031c0
/-- `heap`. -/
abbrev heap : Nat := 0x4032c0

/-- Eight little-endian bytes. -/
def le8 (w : Nat) : List Byte := (List.range 8).map fun i => BitVec.ofNat 8 (w >>> (8 * i))

/-- The static data as loaded (`.data`, `[flist, heap + 4096)`): `flist = heap`, padding,
`last` (only the last granule set), `first` (only the first), and the arena as one free block
of 4096 bytes (size word, zero links, footer). -/
def data : List Byte :=
  le8 heap ++ List.replicate 24 0 ++ List.replicate 255 0 ++ [1] ++ [1] ++ List.replicate 255 0 ++
    le8 4096 ++ List.replicate (4096 - 16) 0 ++ le8 4096

/-- The layout. -/
def layout : Layout where
  codeAddr := 0x401330
  code := code
  malloc := 0x401330
  free := 0x401420
  dataAddr := flistA
  data := data

/-! ## The allocator state as clients see it

A free block is `x = (address, size)`. `fs`, the free list in list order, determines
everything `mm` owns: `flist` holds the head, the blocks form a doubly linked list (`dll`),
and the tables mark the first (`firstT`) and last (`lastT`) granule of every free block. A
token owns its block's size word, the padding word after it and the slack after the request;
it never says anything about the tables, and `free` never reads an allocated block. -/

/-- A word holding a natural number. -/
abbrev wd (n : Nat) : Word := BitVec.ofNat 64 n

/-- Free block `x` with links `nx` (next) and `pv` (previous): size, links, unknown
contents, footer. -/
def blk (x : Nat × Nat) (nx pv : Nat) : SProp :=
  wordPt x.1 (wd x.2) ∗ wordPt (x.1 + 8) (wd nx) ∗ wordPt (x.1 + 16) (wd pv) ∗
    blockAny (x.1 + 24) (x.2 - 32) ∗ wordPt (x.1 + x.2 - 8) (wd x.2)

/-- The address of the first block, or `n` for the empty list. -/
def hdOr : List (Nat × Nat) → Nat → Nat
  | [], n => n
  | x :: _, _ => x.1

/-- The address of the last block, or `p` for the empty list. -/
def lastOr : List (Nat × Nat) → Nat → Nat
  | [], p => p
  | x :: l, _ => lastOr l x.1

/-- A doubly linked segment: `p` precedes its first block, `n` follows its last. -/
def dll : List (Nat × Nat) → Nat → Nat → SProp
  | [], _, _ => emp
  | x :: l, p, n => blk x (hdOr l n) p ∗ dll l x.1 n

/-- A well-formed free block of the arena. -/
def Good (x : Nat × Nat) : Prop :=
  heap ≤ x.1 ∧ x.1 + x.2 ≤ heap + 4096 ∧ x.1 % 16 = 0 ∧ x.2 % 16 = 0 ∧ 32 ≤ x.2

/-- Two blocks do not overlap. -/
def Apart (x y : Nat × Nat) : Prop := x.1 + x.2 ≤ y.1 ∨ y.1 + y.2 ≤ x.1

/-- A well-formed free list: good, pairwise disjoint blocks. -/
def WF (fs : List (Nat × Nat)) : Prop := (∀ x ∈ fs, Good x) ∧ fs.Pairwise Apart

/-- `first[j] = 1` iff a free block starts at granule `j`. -/
def firstT (fs : List (Nat × Nat)) (j : Nat) : Byte :=
  if fs.any (fun x => x.1 == heap + 16 * j) then 1 else 0

/-- `last[j] = 1` iff a free block ends with granule `j`. -/
def lastT (fs : List (Nat × Nat)) (j : Nat) : Byte :=
  if fs.any (fun x => x.1 + x.2 == heap + 16 * (j + 1)) then 1 else 0

/-- A table of 256 bytes at `a`, byte `j` holding `t j`. -/
def tblPt (a : Nat) (t : Nat → Byte) : SProp := bytesPt a ((List.range 256).map t)

/-- Everything the allocator owns for the free list `fs`. -/
def mmOf (fs : List (Nat × Nat)) : SProp :=
  wordPt flistA (wd (hdOr fs 0)) ∗ blockAny (flistA + 8) 24 ∗ tblPt lastA (lastT fs) ∗
    tblPt firstA (firstT fs) ∗ dll fs 0 0

/-- **The allocator state**: some well-formed free list. -/
def mm : SProp := sexists fun fs => ⌜WF fs⌝ ∗ mmOf fs

/-- **The token** of the block of size `s` at `p - 16`, with request `n`. -/
def tok (p : Word) (n : Nat) : SProp := sexists fun s : Nat =>
  ⌜heap + 16 ≤ p.toNat ∧ p.toNat - 16 + s ≤ heap + 4096 ∧ p.toNat % 16 = 0 ∧ s % 16 = 0 ∧
    32 ≤ s ∧ n + 16 ≤ s⌝ ∗
  wordPt (p.toNat - 16) (wd s) ∗ blockAny (p.toNat - 8) 8 ∗ blockAny (p.toNat + n) (s - 16 - n)

/-- **The interface** of rung 08: alignment 16, no stack. -/
def iface : Silmaril.X86.Sep.Alloc.Iface where
  mm := mm
  tok := tok
  align := 16
  stack := 0

end Silmaril.Libc.X86Alloc.Ladder.Boundary
