/-- `flist`, the lowest static address of the allocator. -/
abbrev flistA : Nat := 0x4030a0
/-- `heap`. -/
abbrev heap : Nat := 0x4030b0

/-- Eight little-endian bytes. -/
def le8 (w : Nat) : List Byte := (List.range 8).map fun i => BitVec.ofNat 8 (w >>> (8 * i))

/-- The static data as loaded (`.data`, `[flist, heap + 4096)`): `flist = heap + 8`, padding,
the prologue footer (`1`), one free block of 4080 bytes (header, zeros, footer) and the
epilogue header (`1`). -/
def data : List Byte :=
  le8 (heap + 8) ++ List.replicate 8 0 ++ le8 1 ++ le8 4080 ++ List.replicate (4096 - 32) 0 ++
    le8 4080 ++ le8 1

/-- The layout. -/
def layout : Layout where
  codeAddr := 0x401330
  code := code
  malloc := 0x401330
  free := 0x401400
  dataAddr := flistA
  data := data

end Silmaril.Libc.X86Alloc.Ladder.BoundaryTextbook
