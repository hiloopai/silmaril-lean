module

public import Silmaril.Raw.SSA.Isotope.Refinement.Derivation
public import Mathlib.CategoryTheory.Category.Preorder
public import Mathlib.CategoryTheory.Limits.Shapes.Terminal

@[expose] public section

/-! # Closed theories of the written quantitative refinement calculus

Closure includes the native conditional uniformity rule, not just reflexive,
transitive, and contextual closure.  Formation is part of a theory, so its
primitive facts cannot assert a judgment outside the advertised typed fiber.
Pure-substitution or renaming stability of primitive presentations is a separate
hypothesis; it is not inferred from contextuality.
-/

namespace Silmaril.Isotope.Refinement

open CategoryTheory CategoryTheory.Limits
universe u v w
variable {τ : Type u} [TypeFormers τ] [TypeQuantity τ]
variable {Φ : Type v} [HasTy Φ τ]
variable {ε : Type w} [EffectSystem ε] [HasEff Φ ε]

/-- A formed relation closed under every rule of the written calculus. -/
structure Theory (F : Fragment) where
  rel : Relation τ Φ
  formed : ∀ {n} {Γ : QCtx τ n} {a b : Term Φ n} {A}, rel Γ a b A →
    WellTyped (ε := ε) F Γ a A ∧ WellTyped (ε := ε) F Γ b A
  closed : ∀ {n} {Γ : QCtx τ n} {a b : Term Φ n} {A},
    Refines (ε := ε) F rel Γ a b A → rel Γ a b A

namespace Theory

variable {F : Fragment}

@[ext] theorem ext {T U : Theory (τ := τ) (Φ := Φ) (ε := ε) F}
    (h : ∀ {n} (Γ : QCtx τ n) (a b : Term Φ n) (A : τ), T.rel Γ a b A ↔ U.rel Γ a b A) :
    T = U := by
  cases T with
  | mk R hR cR =>
    cases U with
    | mk Q hQ cQ =>
      have hRQ : @R = @Q := funext fun n => funext fun Γ => funext fun a =>
        funext fun b => funext fun A => propext (h Γ a b A)
      cases hRQ
      rfl

instance : LE (Theory (τ := τ) (Φ := Φ) (ε := ε) F) where
  le T U := ∀ {n} {Γ : QCtx τ n} {a b : Term Φ n} {A}, T.rel Γ a b A → U.rel Γ a b A

instance : PartialOrder (Theory (τ := τ) (Φ := Φ) (ε := ε) F) where
  le_refl _ := fun h => h
  le_trans _ _ _ h k := fun p => k (h p)
  le_antisymm T U h k := ext fun _ _ _ _ => ⟨fun p => h p, fun p => k p⟩

/-- The least formed theory generated by a relation of primitive rewrites. -/
def generated (F : Fragment) (R : Relation τ Φ) : Theory (τ := τ) (Φ := Φ) (ε := ε) F where
  rel := Refines (ε := ε) F R
  formed := Refines.wellTyped
  closed h := Refines.idempotent.mp h

/-- The universal property retains judgment-formation premises for arbitrary bases. -/
theorem generated_le_iff (R : Relation τ Φ) (T : Theory (ε := ε) F) :
    generated (ε := ε) F R ≤ T ↔
      ∀ {n} {Γ : QCtx τ n} {a b : Term Φ n} {A},
        R Γ a b A → WellTyped (ε := ε) F Γ a A → WellTyped (ε := ε) F Γ b A → T.rel Γ a b A := by
  constructor
  · intro h _ _ _ _ _ hr ha hb
    exact h (.base hr ha hb)
  · intro h _ _ _ _ _ hr
    exact T.closed (hr.bind (fun r ha hb => .base (h r ha hb) ha hb))

/-- Closing a closed theory does not add judgments. -/
@[simp] theorem generated_rel (T : Theory (τ := τ) (Φ := Φ) (ε := ε) F) :
    generated F T.rel = T := by
  apply ext
  intro n Γ a b A
  exact ⟨T.closed, fun h => .base h (T.formed h).1 (T.formed h).2⟩

/-- Primitive relation inclusion induces inclusion of complete written theories. -/
theorem generated_mono {R Q : Relation τ Φ}
    (h : ∀ {n} {Γ : QCtx τ n} {a b : Term Φ n} {A}, R Γ a b A → Q Γ a b A) :
    generated (ε := ε) F R ≤ generated F Q := Refines.mono h

/-- Further extensions are themselves closed under all rules, including uniformity. -/
abbrev Extensions (T : Theory (τ := τ) (Φ := Φ) (ε := ε) F) := {U : Theory (ε := ε) F // T ≤ U}

def Extensions.initial (T : Theory (τ := τ) (Φ := Φ) (ε := ε) F) : Extensions T :=
  ⟨T, fun h => h⟩

instance (T : Theory (τ := τ) (Φ := Φ) (ε := ε) F) (U : Extensions T) :
    Unique (Extensions.initial T ⟶ U) where
  default := homOfLE (fun h => U.property h)
  uniq _ := Subsingleton.elim _ _

def Extensions.initialIsInitial (T : Theory (τ := τ) (Φ := Φ) (ε := ε) F) :
    IsInitial (Extensions.initial T) := IsInitial.ofUnique _

end Theory
end Silmaril.Isotope.Refinement
