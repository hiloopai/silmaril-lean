module

public import Silmaril.Raw.SSA.Isotope.Refinement.Models.Structures
public import Silmaril.Raw.SSA.Isotope.Refinement.Contexts
public import Silmaril.SSA.Isotope.Types.Thms

/-! # Models of a fixed signature as ordered categories

The objects are signature types. Morphism carriers are arbitrary; they are not
assumed generated by syntax. Model maps preserve objects, order, and all chosen
operations. This is the strict category of models over a fixed signature.
-/

@[expose] public section

universe u v w r

namespace Silmaril.Isotope.Refinement.Models

open CategoryTheory CategoryTheory.Limits
open scoped MonoidalCategory PremonoidalCategory

variable (τ : Type u) [TypeFormers τ] [TypeQuantity τ]
variable (Φ : Type w) [HasTy Φ τ] (ε : Type r) [EffectSystem ε] [HasEff Φ ε]

/-- The categorical carrier and primitive interpretation of a sequential model. -/
structure SeqData where
  category : Category.{v} τ
  homOrder : ∀ A B : τ, PartialOrder (@Quiver.Hom τ category.toQuiver A B)
  premonoidal : @PremonoidalCategory τ category
  symmetric : @SymmetricPremonoidalCategory τ category premonoidal
  ordered : @OrderedPremonoidal τ category homOrder premonoidal
  tensor_obj : ∀ A B, @MonoidalCategoryStruct.tensorObj τ category premonoidal.toMonoidalCategoryStruct A B = product A B
  tensor_unit : @MonoidalCategoryStruct.tensorUnit τ category premonoidal.toMonoidalCategoryStruct = Silmaril.unit
  effects : @EffectfulCategory τ category homOrder premonoidal symmetric ε inferInstance
  copyDiscard : @CopyDiscard τ category homOrder premonoidal symmetric ε inferInstance effects quantity
  instruction (f : Φ) : @Quiver.Hom τ category.toQuiver (instrSrc f) (instrTrg f)
  instruction_effect (f : Φ) : effects.effect (instrEff f) (instruction f)

namespace SeqData

variable {τ Φ ε} (M : SeqData.{u,v,w,r} τ Φ ε)

abbrev Hom (A B : τ) := @Quiver.Hom τ M.category.toQuiver A B

def hasEffect (e : ε) {A B : τ} (f : M.Hom A B) : Prop := by
  let := M.category
  let := M.homOrder
  let := M.premonoidal
  let := M.symmetric
  exact M.effects.effect e f

def le {A B : τ} (f g : M.Hom A B) : Prop := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact f ≤ g

def identity (A : τ) : M.Hom A A := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact 𝟙 A

def compose {A B D : τ} (f : M.Hom A B) (g : M.Hom B D) : M.Hom A D := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact f ≫ g

/-- Tensoring normalized to the signature's chosen type constructor. -/
def left (A : τ) {B D : τ} (f : M.Hom B D) : M.Hom (product A B) (product A D) := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact eqToHom (M.tensor_obj A B).symm ≫ A ◁ f ≫ eqToHom (M.tensor_obj A D)

def right {A B : τ} (f : M.Hom A B) (D : τ) : M.Hom (product A D) (product B D) := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact eqToHom (M.tensor_obj A D).symm ≫ f ▷ D ≫ eqToHom (M.tensor_obj B D)

def discard (A : τ) (h : Quantity.affine ≤ quantity A) : M.Hom A Silmaril.unit := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact M.copyDiscard.discard A h ≫ eqToHom M.tensor_unit

def copy (A : τ) (h : Quantity.relevant ≤ quantity A) : M.Hom A (product A A) := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact M.copyDiscard.copy A h ≫ eqToHom (M.tensor_obj A A)

/-- The chosen coherence arrows are part of the model's preserved operations. -/
def associator (A B D : τ) : M.Hom (product (product A B) D) (product A (product B D)) := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact eqToHom (by rw [M.tensor_obj, M.tensor_obj]) ≫
    (α_ A B D).hom ≫ eqToHom (by rw [M.tensor_obj, M.tensor_obj])

def leftUnitor (A : τ) : M.Hom (product Silmaril.unit A) A := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact eqToHom (by rw [M.tensor_obj, M.tensor_unit]) ≫ (λ_ A).hom

def rightUnitor (A : τ) : M.Hom (product A Silmaril.unit) A := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact eqToHom (by rw [M.tensor_obj, M.tensor_unit]) ≫ (ρ_ A).hom

def braiding (A B : τ) : M.Hom (product A B) (product B A) := by
  letI := M.category
  letI := M.homOrder
  letI := M.premonoidal
  letI := M.symmetric
  exact eqToHom (M.tensor_obj A B).symm ≫ (BraidedPremonoidalCategory.braiding A B).hom ≫
    eqToHom (M.tensor_obj B A)

@[simp] theorem compose_identity {A B : τ} (f : M.Hom A B) :
    M.compose f (M.identity B) = f := by
  let := M.category
  let := M.homOrder
  let := M.premonoidal
  let := M.symmetric
  exact Category.comp_id f
@[simp] theorem identity_compose {A B : τ} (f : M.Hom A B) :
    M.compose (M.identity A) f = f := by
  let := M.category
  let := M.homOrder
  let := M.premonoidal
  let := M.symmetric
  exact Category.id_comp f

theorem compose_assoc {A B D E : τ} (f : M.Hom A B) (g : M.Hom B D) (h : M.Hom D E) :
    M.compose (M.compose f g) h = M.compose f (M.compose g h) := by
  let := M.category
  let := M.homOrder
  let := M.premonoidal
  let := M.symmetric
  exact Category.assoc f g h

def associatorInv (A B D : τ) : M.Hom (product A (product B D)) (product (product A B) D) := by
  letI := M.category
  letI := M.premonoidal
  exact eqToHom (by rw [M.tensor_obj, M.tensor_obj]) ≫
    (α_ A B D).inv ≫ eqToHom (by rw [M.tensor_obj, M.tensor_obj])

def leftUnitorInv (A : τ) : M.Hom (A) (product Silmaril.unit A) := by
  letI := M.category
  letI := M.premonoidal
  exact (λ_ A).inv ≫ eqToHom (by rw [M.tensor_obj, M.tensor_unit])

def rightUnitorInv (A : τ) : M.Hom (A) (product A Silmaril.unit) := by
  letI := M.category
  letI := M.premonoidal
  exact (ρ_ A).inv ≫ eqToHom (by rw [M.tensor_obj, M.tensor_unit])

/-- Left-to-right tensor of independent computations, in the fixed type indices. -/
def tensor {A B D E : τ} (f : M.Hom A B) (g : M.Hom D E) :
    M.Hom (product A D) (product B E) := M.compose (M.right f D) (M.left B g)

/-- Interchange the middle two objects using only pure coherence arrows. -/
def middleSwap (A B D E : τ) :
    M.Hom (product (product A B) (product D E)) (product (product A D) (product B E)) :=
  M.compose (M.associator A B (product D E))
    (M.compose (M.left A (M.associatorInv B D E))
      (M.compose (M.left A (M.right (M.braiding B D) E))
        (M.compose (M.left A (M.associator D B E)) (M.associatorInv A D (product B E)))))

/-- A type tag keeps distinct models' category instances separate. -/
structure Object (M : SeqData.{u,v,w,r} τ Φ ε) where
  type : τ

instance objectCategory : Category (M.Object) where
  Hom A B := M.Hom A.type B.type
  id A := M.identity A.type
  comp f g := M.compose f g
  id_comp := M.identity_compose
  comp_id := M.compose_identity
  assoc := M.compose_assoc

end SeqData

/-- Sequential models satisfy the specified type-former coherence for copy/discard. -/
structure SeqModel extends SeqData.{u,v,w,r} τ Φ ε where
  discard_unit (h : Quantity.affine ≤ quantity (Silmaril.unit : τ)) :
    toSeqData.discard Silmaril.unit h = toSeqData.identity Silmaril.unit
  copy_unit (h : Quantity.relevant ≤ quantity (Silmaril.unit : τ)) :
    toSeqData.copy Silmaril.unit h = toSeqData.leftUnitorInv Silmaril.unit
  discard_product (A B : τ) (hA : Quantity.affine ≤ quantity A)
      (hB : Quantity.affine ≤ quantity B) (hAB : Quantity.affine ≤ quantity (product A B)) :
    toSeqData.discard (product A B) hAB =
      toSeqData.compose (toSeqData.tensor (toSeqData.discard A hA) (toSeqData.discard B hB))
        (toSeqData.leftUnitor Silmaril.unit)
  copy_product (A B : τ) (hA : Quantity.relevant ≤ quantity A)
      (hB : Quantity.relevant ≤ quantity B) (hAB : Quantity.relevant ≤ quantity (product A B)) :
    toSeqData.copy (product A B) hAB =
      toSeqData.compose (toSeqData.tensor (toSeqData.copy A hA) (toSeqData.copy B hB))
        (toSeqData.middleSwap A A B B)

namespace SeqData

variable {τ Φ ε}

/-- Identity-on-types enriched functors preserving the complete sequential model structure. -/
structure HomMap (M N : SeqData.{u,v,w,r} τ Φ ε) where
  map : ∀ {A B}, M.Hom A B → N.Hom A B
  monotone {A B} {f g : M.Hom A B} : M.le f g → N.le (map f) (map g)
  effect {e : ε} {A B} {f : M.Hom A B} : M.hasEffect e f → N.hasEffect e (map f)
  identity (A : τ) : map (M.identity A) = N.identity A
  compose {A B D} (f : M.Hom A B) (g : M.Hom B D) : map (M.compose f g) = N.compose (map f) (map g)
  left (A : τ) {B D} (f : M.Hom B D) : map (M.left A f) = N.left A (map f)
  right {A B} (f : M.Hom A B) (D : τ) : map (M.right f D) = N.right (map f) D
  associator (A B D : τ) : map (M.associator A B D) = N.associator A B D
  associatorInv (A B D : τ) : map (M.associatorInv A B D) = N.associatorInv A B D
  leftUnitor (A : τ) : map (M.leftUnitor A) = N.leftUnitor A
  leftUnitorInv (A : τ) : map (M.leftUnitorInv A) = N.leftUnitorInv A
  rightUnitor (A : τ) : map (M.rightUnitor A) = N.rightUnitor A
  rightUnitorInv (A : τ) : map (M.rightUnitorInv A) = N.rightUnitorInv A
  braiding (A B : τ) : map (M.braiding A B) = N.braiding A B
  discard (A : τ) (h) : map (M.discard A h) = N.discard A h
  copy (A : τ) (h) : map (M.copy A h) = N.copy A h
  instruction (f : Φ) : map (M.instruction f) = N.instruction f

namespace HomMap

variable {M N P : SeqData.{u,v,w,r} τ Φ ε}

@[ext] theorem ext {f g : HomMap M N} (h : ∀ {A B} (a : M.Hom A B), f.map a = g.map a) : f = g := by
  cases f
  cases g
  congr
  funext A B a
  exact h a

def id (M : SeqData.{u,v,w,r} τ Φ ε) : HomMap M M where
  map f := f
  monotone h := h
  effect h := h
  identity _ := rfl
  compose _ _ := rfl
  left := fun _ {_ _} _ => rfl
  right _ _ := rfl
  associator _ _ _ := rfl
  associatorInv _ _ _ := rfl
  leftUnitor _ := rfl
  leftUnitorInv _ := rfl
  rightUnitor _ := rfl
  rightUnitorInv _ := rfl
  braiding _ _ := rfl
  discard _ _ := rfl
  copy _ _ := rfl
  instruction _ := rfl

def comp (g : HomMap N P) (f : HomMap M N) : HomMap M P where
  map a := g.map (f.map a)
  monotone h := g.monotone (f.monotone h)
  effect h := g.effect (f.effect h)
  identity A := (congrArg g.map (f.identity A)).trans (g.identity A)
  compose a b := (congrArg g.map (f.compose a b)).trans (g.compose _ _)
  left := fun A {_ _} a => (congrArg g.map (f.left A a)).trans (g.left _ _)
  right a A := (congrArg g.map (f.right a A)).trans (g.right _ _)
  associator A B D := (congrArg g.map (f.associator A B D)).trans (g.associator _ _ _)
  associatorInv A B D := (congrArg g.map (f.associatorInv A B D)).trans (g.associatorInv _ _ _)
  leftUnitor A := (congrArg g.map (f.leftUnitor A)).trans (g.leftUnitor _)
  leftUnitorInv A := (congrArg g.map (f.leftUnitorInv A)).trans (g.leftUnitorInv _)
  rightUnitor A := (congrArg g.map (f.rightUnitor A)).trans (g.rightUnitor _)
  rightUnitorInv A := (congrArg g.map (f.rightUnitorInv A)).trans (g.rightUnitorInv _)
  braiding A B := (congrArg g.map (f.braiding A B)).trans (g.braiding _ _)
  discard A h := (congrArg g.map (f.discard A h)).trans (g.discard _ _)
  copy A h := (congrArg g.map (f.copy A h)).trans (g.copy _ _)
  instruction a := (congrArg g.map (f.instruction a)).trans (g.instruction _)

/-- Forgetting preservation laws yields an actual functor of the semantic categories. -/
def toFunctor (f : HomMap M N) : M.Object ⥤ N.Object where
  obj A := ⟨A.type⟩
  map := f.map
  map_id A := f.identity A.type
  map_comp := f.compose

end HomMap
end SeqData

instance : Category (SeqModel.{u,v,w,r} τ Φ ε) where
  Hom M N := SeqData.HomMap M.toSeqData N.toSeqData
  id M := SeqData.HomMap.id M.toSeqData
  comp f g := g.comp f
  id_comp _ := SeqData.HomMap.ext (fun _ => rfl)
  comp_id _ := SeqData.HomMap.ext (fun _ => rfl)
  assoc _ _ _ := SeqData.HomMap.ext (fun _ => rfl)

end Silmaril.Isotope.Refinement.Models
