module

public import Silmaril.Raw.SSA.Isotope.Refinement.Theory
public import Silmaril.Raw.SSA.Isotope.Refinement.TheorySubstitution

/-! # Structurally stable rewrite presentations

Primitive rewrites are formed and stable under native pure substitutions.
Renaming stability is also explicit: the literal substitution rules do not
provide every identity substitution at unrestricted binder annotations.
The generated theory inherits both structural properties by the admissibility
theorems, including effectful directed uniformity.
-/

@[expose] public section

namespace Silmaril.Isotope.Refinement

open CategoryTheory

universe u v w

variable {τ : Type u} [TypeFormers τ] [TypeQuantity τ]
variable {Φ : Type v} [HasTy Φ τ]
variable {ε : Type w} [EffectSystem ε] [HasEff Φ ε]

/-- A native rewrite presentation with explicit structural obligations. -/
structure RewriteSystem (F : Fragment) where
  rel : Relation τ Φ
  formed : ∀ {n} {Γ : QCtx τ n} {a b : Term Φ n} {A}, rel Γ a b A →
    WellTyped (ε := ε) F Γ a A ∧ WellTyped (ε := ε) F Γ b A
  renamingClosed : rel.RenamingClosed
  pureSubstitutionClosed : Relation.PureSubstitutionClosed (ε := ε) F rel

namespace RewriteSystem

variable {F : Fragment}

instance : CoeFun (RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F)
    (fun _ => Relation τ Φ) := ⟨fun R => R.rel⟩

@[ext] theorem ext {R S : RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F}
    (h : ∀ {n} (Γ : QCtx τ n) (a b : Term Φ n) (A : τ), R Γ a b A ↔ S Γ a b A) :
    R = S := by
  cases R with
  | mk R hR rR sR =>
    cases S with
    | mk S hS rS sS =>
      have hRS : @R = @S := funext fun n => funext fun Γ => funext fun a =>
        funext fun b => funext fun A => propext (h Γ a b A)
      cases hRS
      rfl

instance : LE (RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F) where
  le R S := ∀ {n} {Γ : QCtx τ n} {a b : Term Φ n} {A}, R Γ a b A → S Γ a b A

instance : PartialOrder (RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F) where
  le_refl _ := fun h => h
  le_trans _ _ _ h k := fun p => k (h p)
  le_antisymm R S h k := ext fun _ _ _ _ => ⟨fun p => h p, fun p => k p⟩

/-- The presentation with no additional primitive rewrites. -/
def empty (F : Fragment) : RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F where
  rel _ _ _ _ := False
  formed := False.elim
  renamingClosed := fun _ _ => False.elim
  pureSubstitutionClosed := fun _ => False.elim

/-- The full native theory generated by this rewrite system. Its relation can
be passed directly to the existing theory and inference-system APIs. -/
def generatedTheory (R : RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F) :
    Theory (τ := τ) (Φ := Φ) (ε := ε) F := Theory.generated F R.rel

theorem generatedTheory_renaming (R : RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F) :
    Relation.RenamingClosed R.generatedTheory.rel :=
  Relation.RenamingClosed.refines R.renamingClosed

theorem generatedTheory_substitution (R : RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F) :
    Relation.PureSubstitutionClosed (ε := ε) F R.generatedTheory.rel :=
  Relation.PureSubstitutionClosed.refines R.pureSubstitutionClosed R.renamingClosed

/-- Generated derivations themselves form a structurally stable presentation. -/
def generated (R : RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F) :
    RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F where
  rel := R.generatedTheory.rel
  formed := Refines.wellTyped
  renamingClosed := R.generatedTheory_renaming
  pureSubstitutionClosed := R.generatedTheory_substitution

theorem le_generated (R : RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F) : R ≤ R.generated :=
  fun h => .base h (R.formed h).1 (R.formed h).2

theorem generated_mono {R S : RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F}
    (h : R ≤ S) : R.generated ≤ S.generated := Refines.mono h

@[simp] theorem generated_idempotent (R : RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F) :
    R.generated.generated = R.generated := by
  apply ext
  intro n Γ a b A
  exact Refines.idempotent

/-- The generation functor retains the actual native relation on judgments. -/
def generatedTheoryFunctor (F : Fragment) :
    RewriteSystem (τ := τ) (Φ := Φ) (ε := ε) F ⥤ Theory (τ := τ) (Φ := Φ) (ε := ε) F where
  obj := generatedTheory
  map f := homOfLE (Theory.generated_mono (leOfHom f))

end RewriteSystem
end Silmaril.Isotope.Refinement
