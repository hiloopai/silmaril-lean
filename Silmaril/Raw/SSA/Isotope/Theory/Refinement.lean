module

public import Silmaril.Raw.SSA.Isotope.Theory.Equational
public import Silmaril.Raw.SSA.Isotope.LetSeq.LocallyNameless.Refinement
public import Silmaril.Raw.SSA.Isotope.LetCase.LocallyNameless.Refinement
public import Silmaril.Raw.SSA.Isotope.LetIter.LocallyNameless.Refinement

/-! # Concrete contextual refinement theories -/

@[expose] public section

universe u v w r

namespace Silmaril.Isotope.LetSeq.LocallyNameless

open Silmaril.Isotope.Theory Silmaril.Logic.Metatheory

variable {ν : Type w} {Φ : Type v} {ε : Type r} [HasEff Φ ε]

/-- The least raw refinement theory containing the primitive rules and equations. -/
def rawRefinementTheory (pureEff : ε) (R : RawRelation ν Φ) :
    RefinementTheory (rawSyntax ν Φ) where
  Rel := RawRefinement pureEff R
  refl := RawRefinement.refl
  trans := RawRefinement.trans
  congr _ hc h := by
    cases hc with
    | op f => exact .op h
    | let₁_left b => exact .let₁ h (.refl b)
    | let₁_right a => exact .let₁ (.refl a) h
    | pair_left b => exact .pair h (.refl b)
    | pair_right a => exact .pair (.refl a) h
    | let₂_left b => exact .let₂ h (.refl b)
    | let₂_right a => exact .let₂ (.refl a) h

variable {τ : Type u} [HasProduct τ] [HasUnit τ] [DecidableEq ν] [HasTy Φ τ]

/-- The least exact typed refinement theory generated by directed primitive rules. -/
def refinementTheory (pureEff : ε) (Γ : Ctx ν τ) (R : TypedRelation ν Φ τ) :
    RefinementTheory (typedSyntax Φ Γ) where
  Rel {i} a b := Refinement pureEff Γ R i.bound a.val b.val i.result
  refl a := Refinement.refl a.property
  trans := Refinement.trans
  congr _ hc h := by
    cases hc with
    | op  => exact .op h
    | let₁_left b => exact .let₁ h (.refl b.property)
    | let₁_right a => exact .let₁ (.refl a.property) h
    | pair_left b => exact .pair h (.refl b.property)
    | pair_right a => exact .pair (.refl a.property) h
    | let₂_left b => exact .let₂ h (.refl b.property)
    | let₂_right a => exact .let₂ (.refl a.property) h

/-- All raw compatible preorders, with inclusions as categorical arrows. -/
abbrev RawRefinementTheories (ν : Type w) (Φ : Type v) :=
  RefinementTheory (rawSyntax ν Φ)

/-- All exactly typed compatible preorders. -/
abbrev TypedRefinementTheories (Φ : Type v) [HasTy Φ τ] (Γ : Ctx ν τ) :=
  RefinementTheory (typedSyntax Φ Γ)

/-- Erasing the directed generators recovers precisely the equational theory. -/
theorem refinementTheory_empty (pureEff : ε) (Γ : Ctx ν τ) :
    refinementTheory (Φ := Φ) pureEff Γ (fun {_} _ _ _ _ => False) =
      (equationalTheory pureEff Γ).toRefinementTheory := by
  apply RefinementTheory.ext
  intro i a b
  exact Refinement.empty_iff

omit [DecidableEq ν] in
/-- The raw empty-generator comparison also holds at the level of theory objects. -/
theorem rawRefinementTheory_empty (pureEff : ε) :
    rawRefinementTheory (ν := ν) (Φ := Φ) pureEff (fun {_} _ _ => False) =
      (rawEquationalTheory pureEff).toRefinementTheory := by
  apply RefinementTheory.ext
  intro i a b
  exact RawRefinement.empty_iff

end Silmaril.Isotope.LetSeq.LocallyNameless

namespace Silmaril.Isotope.LetCase.LocallyNameless

open Silmaril.Isotope.Theory Silmaril.Logic.Metatheory

variable {ν : Type w} {Φ : Type v} {ε : Type r} [HasEff Φ ε]

/-- The least raw refinement theory containing the primitive rules and equations. -/
def rawRefinementTheory (pureEff : ε) (R : RawRelation ν Φ) :
    RefinementTheory (rawSyntax ν Φ) where
