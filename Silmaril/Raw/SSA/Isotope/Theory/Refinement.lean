    | pair_right a => exact .pair (.refl a) h
    | let₂_left b => exact .let₂ h (.refl b)
    | let₂_right a => exact .let₂ (.refl a) h
    | inl  => exact .inl h
    | inr  => exact .inr h
    | case_scrutinee l r => exact .case h (.refl l) (.refl r)
