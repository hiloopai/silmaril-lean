/-- A restatement of `LetIter.LocallyNameless.Models.refinement_iff_all_models`, and derived
from it. -/
theorem iter_entails_iff (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetIter.LocallyNameless.TypedRelation ν Φ τ) {i : TypingIndex τ}
    (a b : LetIter.LocallyNameless.Models.Carrier Φ Γ i) :
    (institution.obj (iterPSig Φ Γ)).Entails (iterTheory pureEff Γ R).sentences
        ([⟨i, a, b⟩] : Sentence (iterPSig Φ Γ)) ↔
      LetIter.LocallyNameless.Refinement pureEff Γ R i.bound a.1 b.1 i.result :=
  (entails_singleton_iff (P := iterPSig Φ Γ)
    (LetIter.LocallyNameless.Models.refinementPreorder pureEff Γ R) a b).trans
