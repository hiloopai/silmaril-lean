/-- A restatement of `LetIter.LocallyNameless.Models.mutual_refinement_iff_all_models`, and
derived from it. -/
theorem iter_entails_toRef_iff (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetIter.LocallyNameless.TypedRelation ν Φ τ) {i : TypingIndex τ}
