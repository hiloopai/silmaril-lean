    (iterTheory pureEff Γ R).Models ≌ LetIter.LocallyNameless.Models.RefinementModels pureEff Γ R :=
  modelsEquiv (P := iterPSig Φ Γ) (LetIter.LocallyNameless.Models.refinementPreorder pureEff Γ R)

end Iter

/-! ### Fragment inclusions as theory morphisms -/

section Morphisms

variable {ν : Type u} {Φ : Type v} {τ : Type w} [TypeFormers τ] [DecidableEq ν] [HasTy Φ τ]
variable {ε : Type r} [HasEff Φ ε]

/-- The let-seq ⊆ let-case operation inclusion, as a morphism of presented signatures. -/
abbrev seqCaseHom (Γ : Ctx ν τ) : seqPSig Φ Γ ⟶ casePSig Φ Γ :=
  Morphism.SeqCase.typedSignatureHom Γ

/-- The let-case ⊆ let-iter operation inclusion, as a morphism of presented signatures. -/
abbrev caseIterHom (Γ : Ctx ν τ) : casePSig Φ Γ ⟶ iterPSig Φ Γ :=
  Morphism.CaseIter.typedSignatureHom Γ

/-- The syntax translation of `seqCaseHom` is the exact typing inclusion
`Morphism.SeqCase.typedAlgebraHom` (by initiality). -/
theorem translate_seqCaseHom (Γ : Ctx ν τ) :
    translate (seqCaseHom (Φ := Φ) Γ) = Morphism.SeqCase.typedAlgebraHom Γ :=
  (seqPSig Φ Γ).isInitial.hom_ext _ _

/-- The syntax translation of `caseIterHom` is the exact typing inclusion
`Morphism.CaseIter.typedAlgebraHom` (by initiality). -/
theorem translate_caseIterHom (Γ : Ctx ν τ) :
    translate (caseIterHom (Φ := Φ) Γ) = Morphism.CaseIter.typedAlgebraHom Γ :=
  (casePSig Φ Γ).isInitial.hom_ext _ _

/-- Preservation of primitive rewrites makes the let-seq ⊆ let-case inclusion a morphism of
refinement theories. Soundness is `Morphism.SeqCase.embed_refinement`. -/
def seqCaseTheoryHom (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetSeq.LocallyNameless.TypedRelation ν Φ τ)
    (Q : LetCase.LocallyNameless.TypedRelation ν Φ τ)
    (hRQ : ∀ {n} {β : BoundCtx τ n} {a b : LetSeq.LocallyNameless.Tm ν Φ n} {A},
      R β a b A → Q β (Morphism.SeqCase.embed a) (Morphism.SeqCase.embed b) A) :
    seqTheory pureEff Γ R ⟶ caseTheory pureEff Γ Q :=
  theoryHom (seqCaseHom Γ) (fun {_ a b} h => by
    rw [translate_seqCaseHom]
    exact Morphism.SeqCase.embed_refinement hRQ h)

/-- Preservation of primitive rewrites makes the let-case ⊆ let-iter inclusion a morphism of
refinement theories. Soundness is `Morphism.CaseIter.embed_refinement`. -/
def caseIterTheoryHom (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetCase.LocallyNameless.TypedRelation ν Φ τ)
    (Q : LetIter.LocallyNameless.TypedRelation ν Φ τ)
    (hRQ : ∀ {n} {β : BoundCtx τ n} {a b : LetCase.LocallyNameless.Tm ν Φ n} {A},
      R β a b A → Q β (Morphism.CaseIter.embed a) (Morphism.CaseIter.embed b) A) :
    caseTheory pureEff Γ R ⟶ iterTheory pureEff Γ Q :=
  theoryHom (caseIterHom Γ) (fun {_ a b} h => by
    rw [translate_caseIterHom]
    exact Morphism.CaseIter.embed_refinement hRQ h)

/-- The let-seq ⊆ let-iter theory morphism, by composition in the category of theories. -/
def seqIterTheoryHom (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetSeq.LocallyNameless.TypedRelation ν Φ τ)
    (Q : LetCase.LocallyNameless.TypedRelation ν Φ τ)
    (S : LetIter.LocallyNameless.TypedRelation ν Φ τ)
    (hRQ : ∀ {n} {β : BoundCtx τ n} {a b : LetSeq.LocallyNameless.Tm ν Φ n} {A},
      R β a b A → Q β (Morphism.SeqCase.embed a) (Morphism.SeqCase.embed b) A)
    (hQS : ∀ {n} {β : BoundCtx τ n} {a b : LetCase.LocallyNameless.Tm ν Φ n} {A},
      Q β a b A → S β (Morphism.CaseIter.embed a) (Morphism.CaseIter.embed b) A) :
    seqTheory pureEff Γ R ⟶ iterTheory pureEff Γ S :=
  seqCaseTheoryHom pureEff Γ R Q hRQ ≫ caseIterTheoryHom pureEff Γ Q S hQS

/-- The reduct along `seqCaseTheoryHom` is the existing ordered-model restriction
`Morphism.SeqCase.refinementModelRestriction`. -/
theorem seqCase_reduct (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetSeq.LocallyNameless.TypedRelation ν Φ τ)
    (Q : LetCase.LocallyNameless.TypedRelation ν Φ τ)
    (hRQ : ∀ {n} {β : BoundCtx τ n} {a b : LetSeq.LocallyNameless.Tm ν Φ n} {A},
      R β a b A → Q β (Morphism.SeqCase.embed a) (Morphism.SeqCase.embed b) A) :
    Silmaril.Logic.Institution.Theory.reduct (seqCaseTheoryHom pureEff Γ R Q hRQ) ⋙
        toOrderedModels (P := seqPSig Φ Γ)
          (LetSeq.LocallyNameless.Models.refinementPreorder pureEff Γ R) =
      toOrderedModels (P := casePSig Φ Γ)
          (LetCase.LocallyNameless.Models.refinementPreorder pureEff Γ Q) ⋙
        Morphism.SeqCase.refinementModelRestriction pureEff Γ R Q hRQ :=
  rfl

/-- The reduct along `caseIterTheoryHom` is the existing ordered-model restriction
`Morphism.CaseIter.refinementModelRestriction`. -/
theorem caseIter_reduct (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetCase.LocallyNameless.TypedRelation ν Φ τ)
    (Q : LetIter.LocallyNameless.TypedRelation ν Φ τ)
    (hRQ : ∀ {n} {β : BoundCtx τ n} {a b : LetCase.LocallyNameless.Tm ν Φ n} {A},
      R β a b A → Q β (Morphism.CaseIter.embed a) (Morphism.CaseIter.embed b) A) :
    Silmaril.Logic.Institution.Theory.reduct (caseIterTheoryHom pureEff Γ R Q hRQ) ⋙
        toOrderedModels (P := casePSig Φ Γ)
          (LetCase.LocallyNameless.Models.refinementPreorder pureEff Γ R) =
      toOrderedModels (P := iterPSig Φ Γ)
          (LetIter.LocallyNameless.Models.refinementPreorder pureEff Γ Q) ⋙
        Morphism.CaseIter.refinementModelRestriction pureEff Γ R Q hRQ :=
  rfl

end Morphisms

end Silmaril.Isotope.Institution.Refinement
