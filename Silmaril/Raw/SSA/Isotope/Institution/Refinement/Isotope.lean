      LetIter.LocallyNameless.Refinement pureEff Γ R i.bound a.1 b.1 i.result ∧
        LetIter.LocallyNameless.Refinement pureEff Γ R i.bound b.1 a.1 i.result :=
  (entails_toRef_iff (P := iterPSig Φ Γ)
    (LetIter.LocallyNameless.Models.refinementPreorder pureEff Γ R) ⟨i, a, b⟩).trans
