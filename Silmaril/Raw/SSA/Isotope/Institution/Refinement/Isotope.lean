module

public import Silmaril.Raw.SSA.Isotope.Institution.Refinement.Comorphism
public import Silmaril.Raw.SSA.Isotope.Morphism.OrderedModels
public import Silmaril.Raw.SSA.Isotope.Theory.Models.Refinement

@[expose] public section

/-!
# The let calculi in the refinement institution

The exactly typed syntax of let-seq, let-case and let-iter in a context `Γ` (with data-valued
typing derivations, `Theory/Models/{LetSeq,LetCase,LetIter}.lean`) is a presented signature
(`seqPSig`, `casePSig`, `iterPSig`). The refinement theory generated by primitive rewrites `R`
(`Isotope.Theory.Refinement`, reaching its models as `Models.refinementPreorder`) is then a
theory of the refinement institution (`seqTheory`, `caseTheory`, `iterTheory`), and:

* consequence of `a ⊑ b` is generated refinement (`seq_entails_iff`, from
  `Models.refinement_iff_all_models`);
* consequence of the translated equation `a ⊑ b ∧ b ⊑ a` is mutual refinement
  (`seq_entails_toRef_iff`, from `Models.mutual_refinement_iff_all_models`);
* the models of the theory are the Isotope ordered refinement models
  (`seqModelsEquiv`, onto `Models.RefinementModels`).

The fragment inclusions are morphisms of presented signatures (`seqCaseHom`, `caseIterHom`, the
operation maps `Morphism.SeqCase.typedSignatureHom` and `Morphism.CaseIter.typedSignatureHom`),
whose syntax translations are the exact typing inclusions (`translate_seqCaseHom`, from
initiality). Preservation of primitive rewrites gives theory morphisms (`seqCaseTheoryHom`,
`caseIterTheoryHom`, from `Morphism.SeqCase.embed_refinement` and
`Morphism.CaseIter.embed_refinement`), whose reducts are the existing ordered-model restrictions
`Morphism.SeqCase.refinementModelRestriction` and `Morphism.CaseIter.refinementModelRestriction`
(`seqCase_reduct`, `caseIter_reduct`). Composition in the category of theories gives the
let-seq ⊆ let-iter theory morphism for free (`seqIterTheoryHom`).
-/

namespace Silmaril.Isotope.Institution.Refinement

open CategoryTheory CategoryTheory.Limits
open Silmaril.Logic.Institution
open Silmaril.Logic.Metatheory Silmaril.Logic.Metatheory.TheoryModel Silmaril.Logic.Metatheory Silmaril.Logic.Metatheory.TheoryModel
open Silmaril.Isotope.Theory
open PSig

universe u v w r

/-! ### Let-seq -/

section Seq

variable {τ : Type u} [HasProduct τ] [HasUnit τ] {ν : Type w} [DecidableEq ν]
variable {Φ : Type v} [HasTy Φ τ] {ε : Type r} [HasEff Φ ε]

/-- Exactly typed let-seq syntax in context `Γ`, as a presented signature. -/
abbrev seqPSig (Φ : Type v) [HasTy Φ τ] (Γ : Ctx ν τ) :=
  PSig.mk (TypingIndex τ) (LetSeq.LocallyNameless.Models.signature Φ Γ)
    (LetSeq.LocallyNameless.Models.syntaxAlgebra Φ Γ)
    (LetSeq.LocallyNameless.Models.syntaxIsInitial Φ Γ)

/-- The let-seq refinement theory generated by primitive rewrites `R`, as a theory of the
refinement institution. -/
abbrev seqTheory (pureEff : ε) (Γ : Ctx ν τ) (R : LetSeq.LocallyNameless.TypedRelation ν Φ τ) :=
  theoryOf (P := seqPSig Φ Γ) (LetSeq.LocallyNameless.Models.refinementPreorder pureEff Γ R)

/-- Consequence of `a ⊑ b` in the let-seq refinement theory is generated refinement. A
restatement of `LetSeq.LocallyNameless.Models.refinement_iff_all_models`, and derived from
it. -/
theorem seq_entails_iff (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetSeq.LocallyNameless.TypedRelation ν Φ τ) {i : TypingIndex τ}
    (a b : LetSeq.LocallyNameless.Models.Carrier Φ Γ i) :
    (institution.obj (seqPSig Φ Γ)).Entails (seqTheory pureEff Γ R).sentences
        ([⟨i, a, b⟩] : Sentence (seqPSig Φ Γ)) ↔
      LetSeq.LocallyNameless.Refinement pureEff Γ R i.bound a.1 b.1 i.result :=
  (entails_singleton_iff (P := seqPSig Φ Γ)
    (LetSeq.LocallyNameless.Models.refinementPreorder pureEff Γ R) a b).trans
    (LetSeq.LocallyNameless.Models.refinement_iff_all_models pureEff Γ R a b)

/-- Consequence of the translated equation `a ⊑ b ∧ b ⊑ a` is mutual refinement. A restatement
of `LetSeq.LocallyNameless.Models.mutual_refinement_iff_all_models`, and derived from it. -/
theorem seq_entails_toRef_iff (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetSeq.LocallyNameless.TypedRelation ν Φ τ) {i : TypingIndex τ}
    (a b : LetSeq.LocallyNameless.Models.Carrier Φ Γ i) :
    (institution.obj (seqPSig Φ Γ)).Entails (seqTheory pureEff Γ R).sentences
        (Pair.toRef (⟨i, a, b⟩ : Pair (seqPSig Φ Γ))) ↔
      LetSeq.LocallyNameless.Refinement pureEff Γ R i.bound a.1 b.1 i.result ∧
        LetSeq.LocallyNameless.Refinement pureEff Γ R i.bound b.1 a.1 i.result :=
  (entails_toRef_iff (P := seqPSig Φ Γ)
    (LetSeq.LocallyNameless.Models.refinementPreorder pureEff Γ R) ⟨i, a, b⟩).trans
    (LetSeq.LocallyNameless.Models.mutual_refinement_iff_all_models pureEff Γ R a b)

/-- Models of the let-seq refinement theory are the Isotope ordered refinement models. -/
def seqModelsEquiv (pureEff : ε) (Γ : Ctx ν τ) (R : LetSeq.LocallyNameless.TypedRelation ν Φ τ) :
    (seqTheory pureEff Γ R).Models ≌ LetSeq.LocallyNameless.Models.RefinementModels pureEff Γ R :=
  modelsEquiv (P := seqPSig Φ Γ) (LetSeq.LocallyNameless.Models.refinementPreorder pureEff Γ R)

end Seq

/-! ### Let-case -/

section Case

variable {τ : Type u} [TypeFormers τ] {ν : Type w} [DecidableEq ν]
variable {Φ : Type v} [HasTy Φ τ] {ε : Type r} [HasEff Φ ε]

/-- Exactly typed let-case syntax in context `Γ`, as a presented signature. -/
abbrev casePSig (Φ : Type v) [HasTy Φ τ] (Γ : Ctx ν τ) :=
  PSig.mk (TypingIndex τ) (LetCase.LocallyNameless.Models.signature Φ Γ)
    (LetCase.LocallyNameless.Models.syntaxAlgebra Φ Γ)
    (LetCase.LocallyNameless.Models.syntaxIsInitial Φ Γ)

/-- The let-case refinement theory generated by primitive rewrites `R`. -/
abbrev caseTheory (pureEff : ε) (Γ : Ctx ν τ) (R : LetCase.LocallyNameless.TypedRelation ν Φ τ) :=
  theoryOf (P := casePSig Φ Γ) (LetCase.LocallyNameless.Models.refinementPreorder pureEff Γ R)

/-- A restatement of `LetCase.LocallyNameless.Models.refinement_iff_all_models`, and derived
from it. -/
theorem case_entails_iff (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetCase.LocallyNameless.TypedRelation ν Φ τ) {i : TypingIndex τ}
    (a b : LetCase.LocallyNameless.Models.Carrier Φ Γ i) :
    (institution.obj (casePSig Φ Γ)).Entails (caseTheory pureEff Γ R).sentences
        ([⟨i, a, b⟩] : Sentence (casePSig Φ Γ)) ↔
      LetCase.LocallyNameless.Refinement pureEff Γ R i.bound a.1 b.1 i.result :=
  (entails_singleton_iff (P := casePSig Φ Γ)
    (LetCase.LocallyNameless.Models.refinementPreorder pureEff Γ R) a b).trans
    (LetCase.LocallyNameless.Models.refinement_iff_all_models pureEff Γ R a b)

/-- A restatement of `LetCase.LocallyNameless.Models.mutual_refinement_iff_all_models`, and
derived from it. -/
theorem case_entails_toRef_iff (pureEff : ε) (Γ : Ctx ν τ)
    (R : LetCase.LocallyNameless.TypedRelation ν Φ τ) {i : TypingIndex τ}
    (a b : LetCase.LocallyNameless.Models.Carrier Φ Γ i) :
    (institution.obj (casePSig Φ Γ)).Entails (caseTheory pureEff Γ R).sentences
        (Pair.toRef (⟨i, a, b⟩ : Pair (casePSig Φ Γ))) ↔
      LetCase.LocallyNameless.Refinement pureEff Γ R i.bound a.1 b.1 i.result ∧
        LetCase.LocallyNameless.Refinement pureEff Γ R i.bound b.1 a.1 i.result :=
  (entails_toRef_iff (P := casePSig Φ Γ)
    (LetCase.LocallyNameless.Models.refinementPreorder pureEff Γ R) ⟨i, a, b⟩).trans
    (LetCase.LocallyNameless.Models.mutual_refinement_iff_all_models pureEff Γ R a b)

/-- Models of the let-case refinement theory are the Isotope ordered refinement models. -/
def caseModelsEquiv (pureEff : ε) (Γ : Ctx ν τ) (R : LetCase.LocallyNameless.TypedRelation ν Φ τ) :
    (caseTheory pureEff Γ R).Models ≌ LetCase.LocallyNameless.Models.RefinementModels pureEff Γ R :=
  modelsEquiv (P := casePSig Φ Γ) (LetCase.LocallyNameless.Models.refinementPreorder pureEff Γ R)

end Case

/-! ### Let-iter -/

section Iter

variable {τ : Type u} [TypeFormers τ] {ν : Type w} [DecidableEq ν]
variable {Φ : Type v} [HasTy Φ τ] {ε : Type r} [HasEff Φ ε]

/-- Exactly typed let-iter syntax in context `Γ`, as a presented signature. -/
abbrev iterPSig (Φ : Type v) [HasTy Φ τ] (Γ : Ctx ν τ) :=
  PSig.mk (TypingIndex τ) (LetIter.LocallyNameless.Models.signature Φ Γ)
    (LetIter.LocallyNameless.Models.syntaxAlgebra Φ Γ)
    (LetIter.LocallyNameless.Models.syntaxIsInitial Φ Γ)

/-- The let-iter refinement theory generated by primitive rewrites `R`. -/
abbrev iterTheory (pureEff : ε) (Γ : Ctx ν τ) (R : LetIter.LocallyNameless.TypedRelation ν Φ τ) :=
