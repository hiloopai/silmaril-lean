module

public import Silmaril.Raw.SSA.Isotope.Institution.Refinement.Equational
public import Silmaril.Raw.SSA.Isotope.Institution.Refinement.Theories
public import Silmaril.Logic.Institution.Borrowing

@[expose] public section

/-!
# Equations as pairs of refinements: the comorphism `EQ → REF`

The equational institution embeds into the refinement institution by the comorphism `eqToRef`
with identity signature functor:

* an equation `a = b` translates to the conjunction `a ⊑ b ∧ b ⊑ a` (`Pair.toRef`);
* an ordered model translates to its underlying algebra (`TheoryModel.OrderedAlgebra.forget`);
* satisfaction is preserved because carriers are partial orders (`toRef_holds_iff`).

Every algebra underlies an ordered algebra (order it by equality, `discrete`), so the comorphism
is model-expansive (`eqToRef_modelExpansive`) and equational consequence can be borrowed from
refinement consequence (`eq_entails_iff_ref`). This is the institutional form of the Isotope
inclusion of equational theories into refinement theories
(`Silmaril.Logic.Metatheory.EquationalTheories.toRefinement`):

* the refinement theory generated by the translated equations of a congruence `E` is `E` itself,
  read as a symmetric preorder (`closure_image_toRef`);
* the equations of a refinement theory `R` are its equational core `R.equationalCore`
  (`toRef_mem_sentencesOf_iff`), and a congruence translates into `R` exactly when it is
  contained in that core (`image_toRef_subset_iff`): the institutional form of the adjunction
  `Silmaril.Logic.Metatheory.RefinementTheories.coreAdjunction`.

The comorphism sends one sentence to one sentence, so the translation of an equation is a
two-element *conjunction*; this is why refinement sentences are lists of inequations.
-/

namespace Silmaril.Isotope.Institution.Refinement

open CategoryTheory CategoryTheory.Limits
open Silmaril.Logic.Institution
open Silmaril.Logic.Metatheory.TheoryModel Silmaril.Logic.Metatheory.TheoryModel
open PSig

universe u v w

variable {P Q : PSig.{u, v, w}}

/-- An equation `a = b` as the conjunction `a ⊑ b ∧ b ⊑ a`. -/
def Pair.toRef (e : Pair P) : Sentence P := [e, e.swap]

theorem Pair.toRef_map (f : P ⟶ Q) (e : Pair P) :
    (e.map f).toRef = Sentence.map f e.toRef := rfl

/-- An ordered algebra satisfies `a ⊑ b ∧ b ⊑ a` iff its underlying algebra satisfies `a = b`. -/
theorem toRef_holds_iff (M : OrderedAlgebra.{u, v, w} P.sig) (e : Pair P) :
    Sentence.Holds M e.toRef ↔ e.EqHolds M.toAlgebra := by
  constructor
  · intro h
    exact le_antisymm (h e (by simp [Pair.toRef])) (h e.swap (by simp [Pair.toRef]))
  · intro h φ hφ
    have hφ' : φ = e ∨ φ = e.swap := by simpa [Pair.toRef] using hφ
    rcases hφ' with rfl | rfl
    · exact le_of_eq h
    · exact ge_of_eq h

/-- The component of `EQ → REF` at a presented signature. -/
def eqToRefCorridor (P : PSig.{u, v, w}) :
    eqInstitution.obj P ⟶ (𝟭 PSig.{u, v, w} ⋙ institution).obj P :=
  ⟨Pair.toRef, OrderedAlgebra.forget,
    fun (M : OrderedAlgebra.{u, v, w} P.sig) e => toRef_holds_iff M e⟩

theorem eqToRefCorridor_naturality (f : P ⟶ Q) :
    eqInstitution.map f ≫ eqToRefCorridor Q =
      eqToRefCorridor P ≫ (𝟭 PSig.{u, v, w} ⋙ institution).map f :=
  Room.hom_ext rfl rfl

/-- The comorphism of institutions `EQ → REF`: equations to pairs of refinements, ordered models
to their underlying algebras. -/
def eqToRef : Inst.CoHom eqInst.{u, v, w} inst.{u, v, w} where
  Φ := 𝟭 _
  ρ :=
    { app := eqToRefCorridor
      naturality := fun _ _ f => eqToRefCorridor_naturality f }

/-- Every algebra underlies an ordered algebra, ordered by equality: `EQ → REF` is
model-expansive. -/
theorem eqToRef_modelExpansive : eqToRef.{u, v, w}.ModelExpansive :=
  fun _ A => ⟨discrete A, rfl⟩

/-- Borrowing: equational consequence is refinement consequence of the translated equations.
Instantiates `Inst.CoHom.entails_iff`. -/
theorem eq_entails_iff_ref (P : PSig.{u, v, w}) (Γ : Set (Pair P)) (e : Pair P) :
    (eqInstitution.obj P).Entails Γ e ↔
      (institution.obj P).Entails (Pair.toRef '' Γ) e.toRef :=
  eqToRef.entails_iff eqToRef_modelExpansive P Γ e

/-- Consequence of the translated equation `a ⊑ b ∧ b ⊑ a` from a refinement theory `R` is
equality in every ordered model of `R`. -/
theorem entails_toRef_iff (R : CompatiblePreorder P.syn) (e : Pair P) :
    (institution.obj P).Entails (sentencesOf R) e.toRef ↔
      ∀ M : OrderedModels P.isInitial R,
        P.eval M.algebra.toAlgebra e.2.1 = P.eval M.algebra.toAlgebra e.2.2 := by
  constructor
  · intro h M
    exact (toRef_holds_iff M.algebra e).1
      (h M.algebra ((mem_modelsOf_sentencesOf R M.algebra).2 M.sound))
  · intro h M hM
    exact (toRef_holds_iff M e).2 (h ⟨M, (mem_modelsOf_sentencesOf R M).1 hM⟩)

/-- Consequence of the translated equation is mutual derivability. A restatement of
`TheoryModel.semanticallyEqual_iff`, and derived from it. -/
theorem entails_toRef_iff_rel (R : CompatiblePreorder P.syn) {i : P.Index}
    (a b : P.syn.Carrier i) :
    (institution.obj P).Entails (sentencesOf R) (Pair.toRef ⟨i, a, b⟩) ↔ R.Rel a b ∧ R.Rel b a :=
  (entails_toRef_iff R ⟨i, a, b⟩).trans (semanticallyEqual_iff P.isInitial R a b)

/-! ### Equational theories and refinement theories -/

/-- A congruence, read as a symmetric compatible preorder. -/
def congruencePreorder {I : Type u} {Sig : Signature.{u, v} I} {A : Algebra.{u, v, w} Sig}
    (E : Congruence A) : CompatiblePreorder A where
  Rel := E.Rel
  refl a := (E.equivalence _).refl a
  trans h k := (E.equivalence _).trans h k
  compatible := E.compatible

/-- The equations whose translations a refinement theory derives are those of its equational
core (`TheoryModel.CompatiblePreorder.equationalCore`). -/
theorem toRef_mem_sentencesOf_iff (R : CompatiblePreorder P.syn) (e : Pair P) :
    e.toRef ∈ sentencesOf R ↔ R.equationalCore.Rel e.2.1 e.2.2 := by
  constructor
  · intro h
    exact ⟨h e (by simp [Pair.toRef]), h e.swap (by simp [Pair.toRef])⟩
  · intro h φ hφ
    have hφ' : φ = e ∨ φ = e.swap := by simpa [Pair.toRef] using hφ
    rcases hφ' with rfl | rfl
    · exact h.1
    · exact h.2

/-- A congruence translates into a refinement theory iff it is contained in the equational core:
the institutional form of `Silmaril.Logic.Metatheory.RefinementTheories.coreHomEquiv` (at identity
syntax translations). -/
theorem image_toRef_subset_iff (E : Congruence P.syn) (R : CompatiblePreorder P.syn) :
    Pair.toRef '' eqSentencesOf E ⊆ sentencesOf R ↔ E ≤ R.equationalCore := by
  constructor
  · intro h i a b hab
    exact (toRef_mem_sentencesOf_iff R ⟨i, a, b⟩).1
      (h (Set.mem_image_of_mem Pair.toRef
        (show (⟨i, a, b⟩ : Pair P) ∈ eqSentencesOf E from hab)))
  · rintro h _ ⟨e, he, rfl⟩
    exact (toRef_mem_sentencesOf_iff R e).2 (h he)

/-- An equation valid in the underlying algebra gives the inequation in the ordered model. -/
theorem Pair.holds_of_eqHolds (M : OrderedAlgebra.{u, v, w} P.sig) (φ : Pair P)
    (h : φ.EqHolds M.toAlgebra) : φ.Holds M :=
  le_of_eq h

/-- The refinement theory generated by the translated equations of a congruence is the
congruence itself, as a symmetric preorder: the institutional form of
`Silmaril.Logic.Metatheory.EquationalTheories.toRefinement`. The proof uses the discrete order on the
quotient `TheoryModel.quotient E` and `TheoryModel.quotientMap_eq_iff`. -/
theorem closure_image_toRef (E : Congruence P.syn) :
    (institution.obj P).closure (Pair.toRef '' eqSentencesOf E) =
      sentencesOf (congruencePreorder E) := by
  have hq : P.isInitial.to (quotient E) = quotientMap E := P.isInitial.hom_ext _ _
  ext s
  constructor
  · intro hs φ hφ
    have hM : discrete (quotient E) ∈
        (institution.obj P).modelsOf (Pair.toRef '' eqSentencesOf E) := by
      rintro _ ⟨e, he, rfl⟩
      refine (toRef_holds_iff (discrete (quotient E)) e).2 ?_
      show (P.isInitial.to (quotient E)).map e.2.1 = (P.isInitial.to (quotient E)).map e.2.2
      rw [hq]
      exact (quotientMap_eq_iff E _ _).2 he
    have h := hs _ hM φ hφ
    change (P.isInitial.to (quotient E)).map φ.2.1 = (P.isInitial.to (quotient E)).map φ.2.2
      at h
    rw [hq] at h
    exact (quotientMap_eq_iff E _ _).1 h
  · intro hs M hM φ hφ
    exact Pair.holds_of_eqHolds M φ ((toRef_holds_iff M φ).1 (hM _ ⟨φ, hs φ hφ, rfl⟩))

/-- The comorphism maps the equational theory of `E` into the refinement theory of `E`. -/
theorem eqTheoryToRef (E : Congruence P.syn) :
    (eqToRef.{u, v, w}.ρ.app P).sen '' (eqTheoryOf E).sentences ⊆
      (theoryOf (congruencePreorder E)).sentences := by
  show Pair.toRef '' eqSentencesOf E ⊆ sentencesOf (congruencePreorder E)
  rw [← closure_image_toRef E]
  exact (institution.obj P).subset_closure _

end Silmaril.Isotope.Institution.Refinement
