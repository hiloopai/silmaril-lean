module

public import Silmaril.Raw.SSA.Isotope.LetIter.ProofRelevant.LocallyNameless.RefinementTheory
public import Silmaril.Logic.Metatheory.InferenceSystemCat.Fixed
public import Mathlib.CategoryTheory.Category.Preorder

@[expose] public section

/-!
# Proof-relevant typed theories as inference systems

Conclusions retain both endpoint typing derivations. Equations embed into every
refinement theory; primitive inclusions induce proof maps functorially. This
keeps proof-relevant inference systems distinct from their derivability preorder.
-/

namespace Silmaril.Isotope.LetIter.ProofRelevant.LocallyNameless.Refinement

open Silmaril.Isotope.LetIter.LocallyNameless
open Silmaril.Logic.Metatheory Cslib.Logic CategoryTheory

universe u w q r

variable {τ : Type u} [TypeFormers τ] [Subtyping τ]
variable {ν : Type w} [DecidableEq ν]
variable {Φ : Type q} [HasTy Φ τ]
variable {ε : Type r} [HasEff Φ ε]

/-- A binary judgment with exact proof-relevant typing evidence at its endpoints. -/
structure Judgment (Γ : Isotope.Ctx ν τ) where
  n : Nat
  bound : BoundCtx τ n
  type : τ
  left : Tm ν Φ n
  right : Tm ν Φ n
  leftTyping : HasType Φ Γ bound left type
  rightTyping : HasType Φ Γ bound right type

/-- The system tag for the existing typed equational derivations. -/
structure EquationalSystem (pureEff : ε) (Γ : Isotope.Ctx ν τ) where

/-- The system tag for refinement generated by a specified primitive theory. -/
structure RefinementSystem (pureEff : ε) (Γ : Isotope.Ctx ν τ)
    (R : Theory (Φ := Φ) Γ) where

instance (pureEff : ε) (Γ : Isotope.Ctx ν τ) :
    InferenceSystem (EquationalSystem pureEff Γ) (Judgment (Φ := Φ) Γ) where
  derivation j := TypedEquiv.Deriv pureEff Γ j.leftTyping j.rightTyping

instance (pureEff : ε) (Γ : Isotope.Ctx ν τ) (R : Theory (Φ := Φ) Γ) :
    InferenceSystem (RefinementSystem pureEff Γ R) (Judgment (Φ := Φ) Γ) where
  derivation j := Deriv pureEff Γ R j.leftTyping j.rightTyping

variable (pureEff : ε) (Γ : Isotope.Ctx ν τ) (R : Theory (Φ := Φ) Γ)

/-- Typed equations map to refinement with precisely the same conclusions. -/
def equationsToRefinement : InferenceMorphism
    (EquationalSystem pureEff Γ) (RefinementSystem pureEff Γ R)
    (Judgment (Φ := Φ) Γ) (Judgment (Φ := Φ) Γ) where
  map := id
  mapDerivation := Deriv.equiv

/-- The reverse comparison for the theory with no primitive directed rewrites. -/
def emptyToEquations : InferenceMorphism
    (RefinementSystem pureEff Γ (EmptyTheory (Φ := Φ) (Γ := Γ)))
    (EquationalSystem pureEff Γ) (Judgment (Φ := Φ) Γ) (Judgment (Φ := Φ) Γ) where
  map := id
  mapDerivation := Deriv.toEquivOfEmpty

variable {pureEff Γ R} {S : Theory (Φ := Φ) Γ}

/-- Primitive extension is an inference morphism that preserves all indices. -/
def Theory.inferenceMorphism (f : R ≤ S) : InferenceMorphism
    (RefinementSystem pureEff Γ R) (RefinementSystem pureEff Γ S)
    (Judgment (Φ := Φ) Γ) (Judgment (Φ := Φ) Γ) where
  map := id
  mapDerivation := Deriv.map f

/-- Bundle the proof-relevant generated system over a fixed conclusion type. -/
def Theory.inferenceSystem (pureEff : ε) (R : Theory (Φ := Φ) Γ) :
    InferenceSystemCat.Fixed (Judgment (Φ := Φ) Γ) where
  Derivation j := Deriv pureEff Γ R j.leftTyping j.rightTyping

/-- The category of primitive theory extensions acts functorially on the
proof-relevant category of fixed-conclusion inference systems. -/
def Theory.inferenceFunctor (pureEff : ε) (Γ : Isotope.Ctx ν τ) :
    Theory (Φ := Φ) Γ ⥤ InferenceSystemCat.Fixed (Judgment (Φ := Φ) Γ) where
  obj R := R.inferenceSystem pureEff
  map f := fun _ d => d.map (fun h => (leOfHom f) h)
  map_id R := by
    funext j d
    exact d.map_id
  map_comp f g := by
    funext j d
    exact (d.map_comp (fun h => (leOfHom f) h) (fun h => (leOfHom g) h)).symm

/-- Refinement's proposition truncation agrees with CSLib derivability. -/
theorem derivable_iff (j : Judgment (Φ := Φ) Γ) :
    Cslib.Logic.InferenceSystem.DerivableIn (RefinementSystem pureEff Γ R) j ↔
      Related pureEff Γ R j.leftTyping j.rightTyping := Iff.rfl

/-- The analogous bridge for the exact typed equational theory. -/
theorem equations_derivable_iff (j : Judgment (Φ := Φ) Γ) :
    Cslib.Logic.InferenceSystem.DerivableIn (EquationalSystem pureEff Γ) j ↔
      TypedEquiv.Related pureEff Γ j.leftTyping j.rightTyping := Iff.rfl

end Silmaril.Isotope.LetIter.ProofRelevant.LocallyNameless.Refinement
