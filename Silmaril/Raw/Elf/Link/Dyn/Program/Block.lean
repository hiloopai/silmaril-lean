module

public import Silmaril.Raw.Elf.Link.Dyn.Program.Frame
public import Silmaril.Elf.Link.Dyn.Cert.Thms
public meta import Lean

/-! # Block steps in `main` proofs

`must_block`: one straight-line block of `main` by its certificate (`Bin.blks`, generated by
a generator through a generator, checked in `Bin.ok`), through
`Cert.must_blk_at`: the block's statements' weakest precondition (`Cert.Wp`), with the goal at
the state the block leaves. `mblock` drives it: the block's statements by `blk_wp`, the terms
by `blk_simp`, the stack permissions from the frame, the return address from the frame. -/

@[expose] public section

open Silmaril.Elf.Link.DynElf

namespace Silmaril.Elf.Link.Dyn.Program

open Silmaril.X86 (Word Byte MState State Reg)
open Silmaril.Process (Memory Access)
open Silmaril.Elf.Link.Dyn
open Silmaril.Elf.Link.Dyn.Proc (PState MustQ)
open Silmaril.Elf.Link.Dyn.Crt (Layout Img)

/-! ## Block steps (certificates of `main`) -/

/-- The certificate of the block starting at offset `o` of `main`. -/
def Bin.blkAt (B : Bin) (o : Nat) : Option Cert.Blk := B.blks.find? (·.off == o)

/-- **One block of `main`** by its certificate (`B.blks`): the block's statements' weakest
precondition, with the goal at the state the block leaves. -/
theorem must_block {B : Bin} {libc ld : LibPin} (F : B.Facts libc ld) {W : Proc.World} {b lb : Word}
    (hW : W.InImage = Img B.layout b) (hb : b.toNat + B.layout.size < 2 ^ 64)
    {Q : PState → Prop} {s : PState} {A : Nat} (hC : Code B b lb s.m.memory) (hd : s.g.done = none)
    (hrip : s.m.core.rip = b + BitVec.ofNat 64 A) (hA : B.layout.main ≤ A % 2 ^ 64)
    {k : Cert.Blk} (hk : B.blkAt (A % 2 ^ 64 - B.layout.main) = some k)
    (h : Cert.Wp k.b.stmts (Cert.env0 s.m) fun env => MustQ W Q (Cert.post k.b s env)) :
    MustQ W Q s := by
  have Fl := Layout.facts F.layout
  have hm := List.mem_of_find?_eq_some hk
  have ho := List.find?_some hk
  simp only [beq_iff_eq] at ho
  refine Cert.must_blk_at k (F.blks k hm) hd (fun n hn => ?_) hC.1.main hC.2.2 ?_ h
  · rw [hW]; exact Crt.img_add hb (by have := Fl.bMain; omega)
  · rw [hrip, ← ofNat_mod64 A, ho]; congr 2; omega

/-! ## The state a block leaves, as the symbolic executor leaves it -/

/-- The register writes of a block's register list, the first entry outermost. -/
def writesOf (env : Silmaril.X86.Bir9.Env) :
    List (Reg × Silmaril.X86.Bir9.E) → Silmaril.Machine.RegisterFile Reg Word → Silmaril.Machine.RegisterFile Reg Word
  | [], R => R
  | (r, e) :: L, R => (writesOf env L R).write r (e.den env)

theorem regs_lookup (env : Silmaril.X86.Bir9.Env) (L : List (Reg × Silmaril.X86.Bir9.E)) :
    (fun r => ((L.lookup r).getD (.reg r)).den env) = writesOf env L env.s0.regs := by
  funext r
  induction L with
  | nil => rfl
  | cons p L ih =>
    obtain ⟨a, e⟩ := p
    by_cases h : r = a
    · subst h; simp [writesOf, Silmaril.Machine.RegisterFile.write]
    · have hb : (r == a) = false := by simpa using h
      simp only [List.lookup_cons, hb] at ih ⊢
      simp [writesOf, Silmaril.Machine.RegisterFile.write, h, ih]

/-- **The post-state normal form**: the register file as a chain of writes on the entry's. -/
theorem post_eq (b : Silmaril.X86.Bir9.Block) (s : PState) (env : Silmaril.X86.Bir9.Env) :
    Cert.post b s env = ⟨⟨⟨writesOf env b.regs env.s0.regs, b.rip.den env, b.flags.den env,
      env.s0.fsBase⟩, env.mem⟩, s.g⟩ := by
  simp only [Cert.post, Silmaril.X86.Bir9.Block.state, Silmaril.X86.Bir9.Block.reg]
  rw [regs_lookup]

/-- A register of a state written out as a structure (the state a block leaves). -/
theorem read_mk (R : Silmaril.Machine.RegisterFile Reg Word) (rip : Word) (fl : Silmaril.X86.Flags)
    (fs : Word) (r : Reg) :
    ({ regs := R, rip := rip, flags := fl, fsBase := fs } : Silmaril.X86.State).read r = R r := rfl

theorem regs_read (s : Silmaril.X86.State) (r : Reg) : s.regs r = s.read r := rfl

/-- **A `ret` (or the last pop of an epilogue) reads the library's gate**, wherever the
frame's return slot is reached from. -/
theorem Fr.ret_at {B : Bin} {W : Proc.World} {b lb : Word} {t : PState} {m : Memory}
    (R : Fr B W b lb t m) {a : Word} (h : a = t.m.core.read .rsp) :
    (m.readBytes a.toNat 8).bind Silmaril.X86.wordOfBytes? = some W.gate := by
  rw [h, R.ret, Option.bind_some, Silmaril.X86.wordOfBytes?_encodeWords]

/-- A backward jump's target, `main + k + (2^64 - d)`, back to `main + (k - d)`. -/
theorem ofNat_add_wrap {n a c : Nat} (h : 2 ^ n ≤ c) :
    BitVec.ofNat n (a + c) = BitVec.ofNat n (a + (c - 2 ^ n)) := by
  apply BitVec.eq_of_toNat_eq
  simp only [BitVec.toNat_ofNat]
  rw [show a + c = a + (c - 2 ^ n) + 2 ^ n by omega, Nat.add_mod_right]

open Lean Elab Tactic Meta in
/-- Unfold the block certificates (`blk…` constants) the goal mentions. -/
elab "unfold_blks" : tactic => do
  let g ← instantiateMVars (← getMainTarget)
  let cs := g.getUsedConstants.filter fun n => match n with
    | .str _ s => s.startsWith "blk" && !s.endsWith "_ok"
    | _ => false
  if cs.isEmpty then throwError "unfold_blks: no block certificate in the goal"
  let args ← cs.mapM fun n => `(Lean.Parser.Tactic.simpLemma| $(mkIdent n):ident)
  evalTactic (← `(tactic| simp only [$args,*]))

/-- `Cert.blk_wp`, naming each loaded value's equation and the condition's equation by the
given names in order (`hv` once they run out). -/
syntax "mblk_wp" (ppSpace colGt ident)* : tactic

/-- The equation of a loaded value or a condition, by the first given name (`hv` without one). -/
syntax "mblk_eq" (ppSpace colGt ident)* : tactic

/-- The outcome `c` of a condition, with its equation (by the first given name, `hv` without one). -/
syntax "mblk_cond" (ppSpace colGt ident)* : tactic

set_option hygiene false in
macro_rules
  | `(tactic| mblk_eq) => `(tactic| (intro _ hv; (try blk_simp at hv); mblk_wp))
  | `(tactic| mblk_eq $h $hs*) => `(tactic| (intro _ $h:ident; (try blk_simp at $h:ident); mblk_wp $hs*))

set_option hygiene false in
macro_rules
  | `(tactic| mblk_cond) => `(tactic| (intro c hv; (try blk_simp at hv); mblk_wp))
  | `(tactic| mblk_cond $h $hs*) => `(tactic| (intro c $h:ident; (try blk_simp at $h:ident); mblk_wp $hs*))

set_option hygiene false in
macro_rules
  | `(tactic| mblk_wp $hs*) => `(tactic| first
    | (refine Cert.wp_store ?_ ?_; pick_goal 2; mblk_wp $hs*)
    | (refine Cert.wp_push ?_ ?_; pick_goal 2; mblk_wp $hs*)
    | (refine Cert.wp_load ?_ ?_; pick_goal 2; mblk_eq $hs*)
    | (refine Cert.wp_pop ?_ ?_; pick_goal 2; mblk_eq $hs*)
    | (refine Cert.wp_cond ?_ ?_; pick_goal 2; mblk_cond $hs*)
    | (refine Cert.wp_align ?_ ?_; pick_goal 2; mblk_wp $hs*)
    | (refine Cert.wp_chk ?_ ?_; pick_goal 2; mblk_wp $hs*)
    | refine Cert.wp_nil ?_)

/-- Frame addresses: `x - a + c` folded (`a`, `c` literals). -/
theorem addr_sub_add (x : Word) {a c : Nat} (h : c ≤ a) :
    x - BitVec.ofNat 64 a + BitVec.ofNat 64 c = x - BitVec.ofNat 64 (a - c) :=
  sub_add_lit x (by omega)

theorem addr_sub_add' (x : Word) {a c : Nat} (h : a < c) :
    x - BitVec.ofNat 64 a + BitVec.ofNat 64 c = x + BitVec.ofNat 64 (c - a) := by
  rw [show BitVec.ofNat 64 c = BitVec.ofNat 64 a + BitVec.ofNat 64 (c - a) by
    rw [← BitVec.ofNat_add]; congr 1; omega, ← BitVec.add_assoc, BitVec.sub_add_cancel]

/-- **The registers of a state a block left** (and of a call's entry): reads through the chain of
writes, rewritten by the register facts in context (`regFacts`), frame addresses folded
(`x - 8 - 8 = x - 16`, `x - 1064 + 1032 = x - 32`). -/
syntax "mregs" (Lean.Parser.Tactic.location)? : tactic

open Lean Elab Tactic Meta in
elab_rules : tactic
  | `(tactic| mregs $[$loc]?) => withMainContext do
    let excl ← match loc with
      | some l => match expandLocation l with
        | .targets hs _ => hs.mapM fun h => getFVarId h
        | .wildcard => pure #[]
      | none => pure #[]
    let fs ← regFacts excl
    evalTactic (← `(tactic| simp (config := {failIfUnchanged := false}) (disch := first | decide | omega | simp)
      only [callEntry_rdi, callEntry_rsi, callEntry_rdx, callEntry_rcx, Proc.callEntry_mem, Proc.callEntry_rsp,
        Proc.callEntry_g, read_mk, Silmaril.Machine.RegisterFile.write_same,
        Silmaril.Machine.RegisterFile.write_other, regs_read, BitVec.sub_sub, BitVec.ofNat_add_ofNat, Nat.reduceAdd, Nat.reduceSub, addr_sub_add,
        addr_sub_add', BitVec.sub_zero, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod, Nat.reduceMul,
        Nat.div_one, Nat.one_mul, Nat.mod_eq_of_lt, Proc.pushMem_permitted, Proc.storeMem_permitted, $fs,*] $[$loc]?))

set_option hygiene false in
/-- Address arithmetic in `Nat`: the register facts (`mregs`), then `(x - n).toNat = x.toNat - n` for
the literals of the frame (the entry's stack pointer is at least 4096, `X.sp`), at the location
(the goal by default). -/
syntax "mnorm" (Lean.Parser.Tactic.location)? : tactic

set_option hygiene false in
macro_rules
  | `(tactic| mnorm $[$loc]?) => `(tactic| (
  have := X.sp
  have := X.lo
  have := X.disj
  mregs $[$loc]?
  (try simp (disch := first | omega | decide) only [Proc.sub_toNat, BitVec.toNat_ofNat, Nat.reducePow,
    Nat.reduceMod, Silmaril.X86.length_encodeWords_singleton, not_false_eq_true, and_true] $[$loc]?)))

/-- `mnorm`, then `omega` (or the goal is closed already). -/
syntax "mnat" (Lean.Parser.Tactic.location)? : tactic

macro_rules
  | `(tactic| mnat $[$loc]?) => `(tactic| (mnorm $[$loc]?; first | done | omega))

open Lean Elab Tactic Meta in
/-- An address equation `sp - a + b + … = sp'` by the register facts and literal folding
(cheaper than `bv_omega`). -/
elab "maddr" : tactic => do
  let fs ← regFacts
  evalTactic (← `(tactic| simp (disch := omega) only [BitVec.add_assoc, BitVec.reduceAdd,
    BitVec.sub_add_cancel, BitVec.sub_sub, BitVec.ofNat_add_ofNat, Nat.reduceAdd, addr_sub_add, addr_sub_add',
    BitVec.sub_zero, $fs,*]))
  evalTactic (← `(tactic| done))

open Lean Elab Tactic Meta in
/-- `blk_simp` with the register facts in context (`regFacts`) and reads through the writes. -/
elab "mblk_simp" : tactic => do
  let fs ← regFacts
  evalTactic (← `(tactic| blk_simp [read_mk, Silmaril.Machine.RegisterFile.write_same,
    Silmaril.Machine.RegisterFile.write_other, regs_read, ne_eq, reduceCtorEq, not_false_eq_true, $fs,*]))

/-- **One certified block of `main`** (no call inside): its statements, the state it leaves in
the symbolic executor's normal form (`post_eq`), the frame's side conditions (stack
permissions, the return address), and a `ret`'s popped value is the library's gate. The names
`h…` name the equations of the block's loads, in order (`hv` without names). The frame, the
state's `done` and `rip` facts are found in context by their statements (`mfind`). -/
syntax "mblock" (ppSpace colGt ident)* : tactic

set_option hygiene false in
macro_rules
  | `(tactic| mblock $hs*) => `(tactic| (
  refine must_block F rfl P.hb (Fr.code (by mfind)) (by mfind) (by first | mfind | rfl) (by decide) rfl ?_
  unfold_blks
  mblk_wp $hs*
  all_goals (try simp only [post_eq, writesOf])
  all_goals first | mblk_simp | blk_simp
  all_goals try (first
    | (mgoal_is Silmaril.Process.Memory.Permitted
       first
         | exact Fr.permitted (by mfind) (Or.inr rfl) (by mnat) (by mnat) X.sp2
         | exact Fr.permitted (by mfind) (Or.inl rfl) (by mnat) (by mnat) X.sp2)
    | (mgoal_is Exists
       refine ⟨_, Fr.ret_at (by mfind) ?_⟩; first | (msimp; done) | maddr | (msimp; bv_omega) | bv_omega))
  try (first
    | (rw [Fr.ret_at (by mfind) ?ha, Option.some.injEq] at hv; subst hv
       case ha => first | (msimp; done) | maddr | (msimp; bv_omega) | bv_omega))))

set_option hygiene false in
/-- The preconditions of a contract at a call site, as far as the frame decides them: the
System V entry, register values, the stack's permissions. What is left is the program's part. -/
macro "mpre" : tactic => `(tactic| (
  repeat' apply And.intro
  all_goals try (first
    | (mgoal_is Silmaril.X86.FnContract.AbiEntry
       exact abiEntry_call (by mnat) (by mnat)
        (Fr.permitted (by mfind) (Or.inl rfl) (by mnat) (by mnat) X.sp2)
        (Fr.permitted (by mfind) (Or.inr rfl) (by mnat) (by mnat) X.sp2))
    | (msimp; done)
    | (mgoal_is Silmaril.Process.Memory.Permitted
       mregs
       first
         | exact Fr.permitted (by mfind) (Or.inr rfl) (by mnat) (by mnat) X.sp2
         | exact Fr.permitted (by mfind) (Or.inl rfl) (by mnat) (by mnat) X.sp2))))

/-- Name the current state: the facts a proof keeps are then about `u`. -/
theorem must_name {W : Proc.World} {Q : PState → Prop} {s : PState} (h : ∀ u, u = s → MustQ W Q u) :
    MustQ W Q s := h s rfl

/-- Name the current state by its parts. -/
theorem must_entry {W : Proc.World} {Q : PState → Prop} {s : PState}
    (h : ∀ u : PState, u.m.core = s.m.core → u.m.memory = s.m.memory → u.g = s.g → MustQ W Q u) :
    MustQ W Q s := h s rfl rfl rfl

open Lean Elab Tactic Meta in
/-- Every memory fact mentioning `e` (`Frm`, `Fr`, `Slots`, `KSlots`, a stream's `file`, `StdoutIs`,
`ErrnoIs`, `CStr`, `Code`, a load) now mentions `l` instead, for `h : l = e` (`rw [← h] at …`,
keeping the names). Other hypotheses (the entry's `StackRoom`, …) keep `e`. -/
meta def transferEq (h : FVarId) : TacticM Unit := withMainContext do
  let some (_, _, rhs) := (← instantiateMVars (← h.getType)).eq? | return
  let heads := [`Silmaril.Elf.Link.Dyn.Program.Frm, `Silmaril.Elf.Link.Dyn.Program.Fr,
    `Silmaril.Elf.Link.Dyn.Program.Slots, `Silmaril.Elf.Link.Dyn.Program.KSlots,
    `Silmaril.Elf.Link.Dyn.Streams.StdoutIs, `Silmaril.Elf.Link.Dyn.Streams.StreamRep.file,
    `Silmaril.Elf.Link.Dyn.Streams.ErrnoIs, `Silmaril.Elf.Link.Dyn.Proc.CStr,
    `Silmaril.Elf.Link.Dyn.Program.Code]
  let mut fvs := #[]
  for d in ← getLCtx do
    if d.isImplementationDetail || d.fvarId == h then continue
    let ty ← instantiateMVars d.type
    let memFact := heads.any (ty.isAppOf ·) ||
      (match ty.eq? with
       | some (_, l, _) => l.isAppOf `Silmaril.X86.Ext.loadN || l.isAppOf `Silmaril.Process.Memory.readBytes
       | none => false)
    if memFact && (ty.find? (· == rhs)).isSome then fvs := fvs.push d.fvarId
  if fvs.isEmpty then return
  let g ← getMainGoal
  let (fvs', g) ← g.revert fvs (preserveOrder := true)
  let g ← g.withContext do
    let r ← g.rewrite (← g.getType) (mkFVar h) (symm := true)
    g.replaceTargetEq r.eNew r.eqProof
  let (_, g) ← g.introNP fvs'.size
  replaceMainGoal [g]

/-- The registers `mname` derives facts for. -/
syntax "mname_regs" ident : tactic

/-- **Name the current state** `u` (`mname u`, or `mname u hm` to keep `hm : u.m.memory = …`):
the memory facts are moved to `u` (`transferEq`), `u.g = …` and `u.g.done = none` are added, and
the registers, `rip` and `fsBase` a block left are derived as facts `u.m.core.read r = …` (by
`mregs`, so in terms of the facts in context, frame addresses folded). The facts have no names:
the steps find them by their statements. -/
syntax "mname " ident (ppSpace colGt ident)? : tactic

open Lean Elab Tactic Meta in
elab_rules : tactic
  | `(tactic| mname $u $[$hm?]?) => do
    let hc := mkIdent (← mkFreshUserName `hc)
    let hg := mkIdent (← mkFreshUserName `hg)
    let hm ← match hm? with | some h => pure h | none => pure (mkIdent (← mkFreshUserName `hm))
    evalTactic (← `(tactic| refine must_entry fun $u $hc $hm $hg => ?_))
    evalTactic (← `(tactic| (try dsimp only at $hc:ident)))
    evalTactic (← `(tactic| (try dsimp only at $hm:ident)))
    evalTactic (← `(tactic| (try dsimp only at $hg:ident)))
    withMainContext do transferEq (← getFVarId hm)
    evalTactic (← `(tactic| (try have := (by rw [$hg:ident]; first | mfind | (mregs; mfind) : ($u).g.done = none))))
    for r in [``Silmaril.X86.Reg.rsp, ``Silmaril.X86.Reg.rbp, ``Silmaril.X86.Reg.rbx, ``Silmaril.X86.Reg.r12,
        ``Silmaril.X86.Reg.r13, ``Silmaril.X86.Reg.r14, ``Silmaril.X86.Reg.r15, ``Silmaril.X86.Reg.rdi,
        ``Silmaril.X86.Reg.rsi, ``Silmaril.X86.Reg.rdx, ``Silmaril.X86.Reg.rcx, ``Silmaril.X86.Reg.r8,
        ``Silmaril.X86.Reg.r9, ``Silmaril.X86.Reg.rax] do
      let ri := mkIdent r
      let hr := mkIdent (← mkFreshUserName `hreg)
      evalTactic (← `(tactic| have $hr := congrArg (fun c => Silmaril.X86.State.read c $ri) $hc:ident))
      evalTactic (← `(tactic| (try dsimp only at $hr:ident)))
      evalTactic (← `(tactic| mregs at $hr:ident))
    for f in [``Silmaril.X86.State.rip, ``Silmaril.X86.State.fsBase] do
      let hr := mkIdent (← mkFreshUserName `hreg)
      evalTactic (← `(tactic| have $hr := congrArg $(mkIdent f) $hc:ident))
      evalTactic (← `(tactic| (try dsimp only at $hr:ident)))
      evalTactic (← `(tactic| mregs at $hr:ident))
    if hm?.isSome then
      evalTactic (← `(tactic| mregs at $hm:ident))
    else
      evalTactic (← `(tactic| clear $hm:ident))
    evalTactic (← `(tactic| clear $hc:ident))

/-- A contract with a clause on its successful outcomes (`errKept`, `fopenErrStep`), as one
contract. -/
theorem Contract.and {pre : Prop} {post X : PState → Prop} {r : Silmaril.X86.RelIsa.Res PState}
    (h : Proc.Contract pre post r) (hx : ∀ t, r = .ok t → X t) :
    Proc.Contract pre (fun t => post t ∧ X t) r := fun hp =>
  let ⟨t, ht, hpost⟩ := h hp
  ⟨t, ht, hpost, hx t ht⟩

set_option hygiene false in
/-- **A call of any contracted import**: the call through its stub to its contract (by name;
a contract with a clause on its outcomes, `c ∧ ∀ t, r = .ok t → X t`, is read by
`Contract.and`), the frame's part of the precondition (`mpre`). Left: the rest of the
precondition, then the continuation from every state the contract allows. -/
macro "mcall" : tactic => `(tactic| (
  first
    | refine call_at F P (Fr.code (by mfind)) (by mfind) (by first | mfind | rfl) ⟨by decide, by decide⟩ rfl rfl
        (Fr.permitted (by mfind) (Or.inr rfl) (by mnat) (by mnat) X.sp2) (by mnat) rfl
        (fun _ h => h) ?_ ?_
    | refine call_at F P (Fr.code (by mfind)) (by mfind) (by first | mfind | rfl) ⟨by decide, by decide⟩ rfl rfl
        (Fr.permitted (by mfind) (Or.inr rfl) (by mnat) (by mnat) X.sp2) (by mnat) rfl
        (by exact fun _ h => Contract.and h.1 h.2) ?_ ?_
  on_goal 1 => mpre))

set_option hygiene false in
/-- `mcall` that discharges only the System V entry of the precondition (`AbiEntry ∧ rest`) and
leaves `rest` whole, for contracts whose remaining precondition is the program's (strings,
arguments). -/
macro "mcallE" : tactic => `(tactic| (
  first
    | refine call_at F P (Fr.code (by mfind)) (by mfind) (by first | mfind | rfl) ⟨by decide, by decide⟩ rfl rfl
        (Fr.permitted (by mfind) (Or.inr rfl) (by mnat) (by mnat) X.sp2) (by mnat) rfl
        (fun _ h => h) ?_ ?_
    | refine call_at F P (Fr.code (by mfind)) (by mfind) (by first | mfind | rfl) ⟨by decide, by decide⟩ rfl rfl
        (Fr.permitted (by mfind) (Or.inr rfl) (by mnat) (by mnat) X.sp2) (by mnat) rfl
        (by exact fun _ h => Contract.and h.1 h.2) ?_ ?_
  on_goal 1 => refine ⟨abiEntry_call (by mnat) (by mnat)
    (Fr.permitted (by mfind) (Or.inl rfl) (by mnat) (by mnat) X.sp2)
    (Fr.permitted (by mfind) (Or.inr rfl) (by mnat) (by mnat) X.sp2), ?_⟩))

/-- **A call at a named entry state** (`mcallN u`): `mname u`, then `mcall`. -/
macro "mcallN " u:ident : tactic => `(tactic| (mname $u; mcall))

/-- `mcallE` at a named entry state. -/
macro "mcallNE " u:ident : tactic => `(tactic| (mname $u; mcallE))

set_option hygiene false in
/-- **A certified block ending in a conditional jump**: `mblock`, then one goal per outcome of
the condition, the taken branch first being the fall-through (`hv : cond = some false`), then
the jump (`hv : cond = some true`), each at its target address. -/
syntax "mbranch" (ppSpace colGt ident)* : tactic

set_option hygiene false in
macro_rules
  | `(tactic| mbranch $hs*) => `(tactic| (
  mblock $hs*
  all_goals try (exact Cert.eval_some (Cert.defined_logic _) _)
  all_goals try (exact Cert.eval_some (Cert.defined_alu _ _ _ _) _)
  cases c <;> simp (config := {decide := true}) only [↓reduceIte] <;>
    (try simp only [Nat.add_assoc, Nat.reduceAdd, Nat.reducePow, Nat.reduceSub, Nat.reduceLeDiff,
      ofNat_add_wrap])))

/-- Membership in an explicit list (elements compared at reducible transparency). -/
macro "mmem" : tactic => `(tactic| repeat (first | (with_reducible exact List.mem_cons_self) |
  apply List.mem_cons_of_mem))

/-- **A saved word or library word** of the frame bundle in context (`Frm`): a load
(`loadN m a 8 = some w`) or a pop (`(m.readBytes a 8).bind wordOfBytes? = some w`). -/
syntax "mslot" : tactic

open Lean Elab Tactic Meta in
elab_rules : tactic
  | `(tactic| mslot) => do
    evalTactic (← `(tactic| mregs))
    let g ← instantiateMVars (← getMainTarget)
    let isPop := match g.eq? with
      | some (_, l, _) => l.isAppOf ``Option.bind
      | none => false
    if isPop then
      evalTactic (← `(tactic| exact Frm.pop (by mfind) (by mmem)))
    else
      evalTactic (← `(tactic| first
        | exact Frm.loadF (by mfind) (by mmem)
        | exact Frm.loadK (by mfind) (by mmem)))

set_option hygiene false in
/-- **The stack-protector check** before `main` returns (`mov slot, rax; sub fs:0x28, rax; jne
__stack_chk_fail`): the canary slot and the guard word are read from the frame bundle in context
(`mslot`); they hold the same value, so the check passes, and the goal is at the fall-through. -/
macro "mcanary" : tactic => `(tactic| (
  refine must_block F rfl P.hb (Fr.code (by mfind)) (by mfind) (by first | mfind | rfl) (by decide) rfl ?_
  unfold_blks
  refine Cert.wp_load ⟨_, by blk_simp; mslot⟩ fun _ h1 => ?_
  blk_simp at h1
  have e1 := (Option.some.inj ((Eq.symm h1).trans (by mslot))).symm
  subst e1
  refine Cert.wp_load ⟨_, by blk_simp; mslot⟩ fun _ h2 => ?_
  blk_simp at h2
  have e2 := (Option.some.inj ((Eq.symm h2).trans (by mslot))).symm
  subst e2
  refine Cert.wp_cond ⟨_, by blk_simp; exact eval_ne_sub _ _⟩ fun c hc => ?_
  blk_simp at hc
  simp [Silmaril.X86.Ext.AluOp.flagsN, eval_ne_sub] at hc
  subst hc
  refine Cert.wp_nil ?_
  simp only [post_eq, writesOf]
  first | mblk_simp | blk_simp
  simp (config := {decide := true}) only [↓reduceIte]))

set_option hygiene false in
/-- **A loop of `main`** with invariant `I`, measured by the input left to read: the goals are
`init` (the invariant now) and `body` (one turn from any state of the invariant, ending in
`mexit` or `mnext`). -/
macro "mloop " I:term:max : tactic => `(tactic| (
  refine must_loop (fun u => u.g.inp.length) $I ?body _ ?init))

/-- **A loop of `main`** with an indexed invariant `I n` (`must_loopN`), entered at index `n`:
the goals are `init` and `body` (one turn from `I n u`, ending in `mexit` or `mnextN`). -/
macro "mloopN " I:term:max n:term:max : tactic => `(tactic| (
  refine must_loopN $I ?body $n _ ?init))

/-- Back to the loop head at index `n'`: `n' < n`, then the invariant. -/
macro "mnextN " n:term:max : tactic => `(tactic| (
  refine Proc.must_done (Or.inr ⟨$n, ?_, ?_⟩)))

/-- Leaving the loop: the goal is the loop's goal. -/
macro "mexit" : tactic => `(tactic| (
  refine Silmaril.X86.RelIsa.Must.mono (fun _ h => h) (fun _ h => Or.inl h) ?_))

/-- Back to the loop head: the invariant again, with less input left. -/
macro "mnext" : tactic => `(tactic| (
  refine Proc.must_done (Or.inr ⟨?_, ?_⟩)))

/-- **`verify_main ok spec`**: `main` from its entry to its `return`: each certified block by
`mblock`, each call by its contract, any other instruction by `mstep`, the end by `mfinish`. -/
macro "verify_main " ok:term:max spec:ident : tactic => `(tactic| (
  main_start $ok
  repeat (first | mcall_puts | mblock | mstep)
  mfinish $spec))

end Silmaril.Elf.Link.Dyn.Program
