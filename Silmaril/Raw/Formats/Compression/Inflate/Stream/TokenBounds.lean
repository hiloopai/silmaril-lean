module

public import Silmaril.Raw.Formats.Compression.Inflate.Stream.ParserPhases
public import Silmaril.Raw.Formats.Compression.Inflate.Stream.TokenOutput

@[expose] public section

namespace Silmaril.Formats.Compression.Inflate.Stream.TokenBounds

open Silmaril.Formats.Compression

/-!
# Parsed DEFLATE token bounds

These bounds follow from the RFC length/distance tables, successful extra-bit
reads, and rejection of reserved symbols. They hold for arbitrary Huffman
tables, without assuming those tables were generated by our encoder. Combining
them with successful token application discharges the bounded-window output
machine's history premise. This concerns mathematical token parsing, not C.
-/

/-- Finite, kernel-decided arithmetic for the RFC's thirty distance rows. -/
theorem distance_row_bounds : ∀ index : Fin 30,
    1 ≤ Deflate.distanceBase.getD index.val 1 ∧
    Deflate.distanceBase.getD index.val 1 +
      2 ^ Deflate.distanceExtraBits.getD index.val 0 ≤ 32769 := by decide

/-- The corresponding twenty-nine literal/length rows, including code 285. -/
theorem length_row_bounds : ∀ index : Fin 29,
    3 ≤ Deflate.lengthBase.getD index.val 3 ∧
    Deflate.lengthBase.getD index.val 3 +
      2 ^ Deflate.lengthExtraBits.getD index.val 0 ≤ 259 := by decide

theorem parseMatch_bounds {dist : HuffmanTable} {symbol length distance : Nat}
    {reader rest : LSBReader} (hlo : 257 ≤ symbol) (hhi : symbol ≤ 285)
    (h : Manual.parseMatch dist symbol reader = .ok (.matchBytes length distance, rest)) :
    3 ≤ length ∧ length ≤ 258 ∧ 0 < distance ∧ distance ≤ 32768 := by
  unfold Manual.parseMatch at h
  dsimp only at h
  cases hl : reader.readBits (Deflate.lengthExtraBits.getD (symbol - 257) 0) with
  | none => rw [hl] at h; cases h
  | some pair =>
    obtain ⟨lengthExtra, r1⟩ := pair
    rw [hl] at h
    dsimp only at h
    cases hs : dist.readSymbolLSB r1 with
    | none => rw [hs] at h; cases h
    | some pair =>
      obtain ⟨distanceSymbol, r2⟩ := pair
      rw [hs] at h
      dsimp only at h
      split at h
      · cases h
      · next hreserved =>
        cases hd : r2.readBits (Deflate.distanceExtraBits.getD distanceSymbol 0) with
        | none => rw [hd] at h; cases h
        | some pair =>
          obtain ⟨distanceExtra, r3⟩ := pair
          rw [hd] at h
          simp only [Except.ok.injEq, Prod.mk.injEq, Manual.Token.matchBytes.injEq] at h
          have hli : symbol - 257 < 29 := by omega
          have hdi : distanceSymbol < 30 := by omega
          have hlengthRow := length_row_bounds ⟨symbol - 257, hli⟩
          have hdistanceRow := distance_row_bounds ⟨distanceSymbol, hdi⟩
          have hlengthExtra := LSBReader.readBits_lt hl
          have hdistanceExtra := LSBReader.readBits_lt hd
          dsimp only at hlengthRow hdistanceRow
          omega

theorem parseToken_match_bounds {litLen dist : HuffmanTable} {length distance : Nat}
    {reader rest : LSBReader}
    (h : Manual.parseToken litLen dist reader = .ok (.matchBytes length distance, rest)) :
    3 ≤ length ∧ length ≤ 258 ∧ 0 < distance ∧ distance ≤ 32768 := by
  unfold Manual.parseToken at h
  cases hs : litLen.readSymbolLSB reader with
  | none => rw [hs] at h; cases h
  | some pair =>
    obtain ⟨symbol, r1⟩ := pair
    rw [hs] at h
    dsimp only at h
    split at h
    · simp at h
    · split at h
      · simp at h
      · split at h
        · exact parseMatch_bounds (by omega) (by assumption) h
        · cases h

/-- A parsed token accepted by the format's history check is accepted by the
bounded-window machine. The reader supplied to `applyToken` can be arbitrary:
the history condition itself is independent of the input cursor. -/
theorem parseToken_fitsHistory {litLen dist : HuffmanTable} {token : Manual.Token}
    {reader rest applicationReader : LSBReader} {output : List UInt8} {step : Deflate.SymbolStep}
    (hparse : Manual.parseToken litLen dist reader = .ok (token, rest))
    (happly : Manual.applyToken output token applicationReader = .ok step) :
    TokenFitsHistory output token := by
  cases token with
  | literal byte => trivial
  | endBlock => trivial
  | matchBytes length distance =>
    have hbounds := parseToken_match_bounds hparse
    have havailable : distance ≤ output.length := by
      simp only [Manual.applyToken] at happly
      split at happly
      · cases happly
      · omega
    exact ⟨hbounds.2.2.1, hbounds.2.2.2, havailable⟩

/-- The same bound directly at the resumable parser's canonical evaluation. -/
theorem parser_match_bounds {litLen dist : HuffmanTable} {length distance : Nat}
    {reader rest : LSBReader}
    (h : (ParserPhases.token litLen dist).eval reader =
      .ok (.matchBytes length distance, rest)) :
    3 ≤ length ∧ length ≤ 258 ∧ 0 < distance ∧ distance ≤ 32768 := by
  rw [ParserPhases.token_eval] at h
  exact parseToken_match_bounds h

theorem parser_fitsHistory {litLen dist : HuffmanTable} {token : Manual.Token}
    {reader rest applicationReader : LSBReader} {output : List UInt8} {step : Deflate.SymbolStep}
    (hparse : (ParserPhases.token litLen dist).eval reader = .ok (token, rest))
    (happly : Manual.applyToken output token applicationReader = .ok step) :
    TokenFitsHistory output token := by
  rw [ParserPhases.token_eval] at hparse
  exact parseToken_fitsHistory hparse happly

end Silmaril.Formats.Compression.Inflate.Stream.TokenBounds
