module

public import Silmaril.Cerberus.Mem.Defs
public import Silmaril.Cerberus.Undefined.Defs

/-! # Cerberus Core syntax

The types of Cerberus's `frontend/model/core.lem` (generated by Ott from
`core.ott`) at commit `b3e11ea334e95359907d4abf9194f0e7fedc6c6a`. Core is the
intermediate language Cerberus elaborates C into: pure expressions (`Pexpr`),
effectful expressions with explicit memory actions and sequencing (`Expr`), and
files of functions and procedures (`File`).

Lem's `generic_x_` types are the unannotated shapes, ported as `XNode`; its
`generic_x` types wrap a shape with annotations, ported as `X`. The Lem type
variables `'a`, `'bty` and `'sym` become the parameters `a`, `bty` and `sym` in the
same order; `M : MemoryModel` is added in front of every type that reaches a memory
value. `bty` is `Unit` before Core type inference and `BaseType` after. Lem's
abbreviations for the untyped and typed instances (`pexpr`, `typed_pexpr`, …) are
not ported: write the instance, such as `Pexpr M Unit Sym`.
`Silmaril.Cerberus.Names` maps each Cerberus name to its Silmaril name.

The Lem equality, ordering, `Show` and `Located` instances and `is_dynamic` are
not ported; `DecidableEq` and `Repr` are derived where Lean can derive them.
-/

@[expose] public section

namespace Silmaril.Cerberus.Core

/-- Types of C objects. -/
inductive ObjectType where
  | integer
  | floating
  | pointer
  | array : ObjectType → ObjectType
  | struct : Sym → ObjectType
  | union : Sym → ObjectType
  deriving DecidableEq, Repr

/-- Core base types. `loaded` is an object type or unspecified; `storable` is
only used by the type system. -/
inductive BaseType where
  | unit
  | boolean
  | ctype
  | list : BaseType → BaseType
  | tuple : List BaseType → BaseType
  | object : ObjectType → BaseType
  | loaded : ObjectType → BaseType
  | storable
  deriving Repr

mutual

/-- Structural equality of base types. Lem's `eq_core_base_type` differs only in
comparing struct and union tags by `Sym.key`. -/
def BaseType.beq : BaseType → BaseType → Bool
  | .unit, .unit | .boolean, .boolean | .ctype, .ctype | .storable, .storable => true
  | .list t, .list u => BaseType.beq t u
  | .tuple ts, .tuple us => BaseType.beqList ts us
  | .object t, .object u | .loaded t, .loaded u => decide (t = u)
  | _, _ => false

/-- `BaseType.beq` on lists. -/
def BaseType.beqList : List BaseType → List BaseType → Bool
  | [], [] => true
  | t :: ts, u :: us => BaseType.beq t u && BaseType.beqList ts us
  | _, _ => false

end

mutual

theorem BaseType.beq_iff : (t u : BaseType) → BaseType.beq t u = true ↔ t = u
  | .list t, u => by
      cases u with
      | list u => simp [BaseType.beq, BaseType.beq_iff t u]
      | _ => simp [BaseType.beq]
  | .tuple ts, u => by
      cases u with
      | tuple us => simp [BaseType.beq, BaseType.beqList_iff ts us]
      | _ => simp [BaseType.beq]
  | .unit, u | .boolean, u | .ctype, u | .storable, u | .object _, u | .loaded _, u => by
      cases u <;> simp [BaseType.beq]

theorem BaseType.beqList_iff : (ts us : List BaseType) → BaseType.beqList ts us = true ↔ ts = us
  | [], [] => by simp [BaseType.beqList]
  | t :: ts, u :: us => by
      simp [BaseType.beqList, BaseType.beq_iff t u, BaseType.beqList_iff ts us]
  | [], _ :: _ | _ :: _, [] => by simp [BaseType.beqList]

end

instance : DecidableEq BaseType := fun t u => decidable_of_iff _ (BaseType.beq_iff t u)

/-- Binary operators. -/
inductive BinOp where
  | add
  | sub
  | mul
  | div
  | remT
  | remF
  | exp
  | eq
  | gt
  | lt
  | ge
  | le
  | and
  | or
  deriving DecidableEq, Repr

/-- Integer operators of `PexprNode.wrapI` and
`PexprNode.catchExceptionalCondition`. -/
inductive IntOp where
  | add
  | sub
  | mul
  | shl
  | shr
  | div
  | remT
  deriving DecidableEq, Repr

/-- Memory-action polarities: `pos` actions are sequenced by `letweak` and
`letstrong`, `neg` actions only by `letstrong`. -/
inductive Polarity where
  | pos
  | neg
  deriving DecidableEq, Repr

/-- A Core identifier or an implementation-defined constant. -/
inductive Name (sym : Type) where
  | sym : sym → Name sym
  | impl : ImplementationConstant → Name sym
  deriving DecidableEq, Repr

mutual

/-- C object values. -/
inductive ObjectValue (M : MemoryModel) where
  | integer : M.IntegerValue → ObjectValue M
  | floating : M.FloatingValue → ObjectValue M
  | pointer : M.PointerValue → ObjectValue M
  | array : List (LoadedValue M) → ObjectValue M
  | struct : Sym → List (Identifier × Ctype × M.MemValue) → ObjectValue M
  | union : Sym → Identifier → M.MemValue → ObjectValue M

/-- Possibly unspecified C object values. -/
inductive LoadedValue (M : MemoryModel) where
  | specified : ObjectValue M → LoadedValue M
  | unspecified : Ctype → LoadedValue M

end

deriving instance Repr for ObjectValue, LoadedValue

/-- Core values. -/
inductive Value (M : MemoryModel) where
  | object : ObjectValue M → Value M
  | loaded : LoadedValue M → Value M
  | unit
  | true
  | false
  | ctype : Ctype → Value M
  | list : BaseType → List (Value M) → Value M
  | tuple : List (Value M) → Value M
  deriving Repr

/-- Data constructors. `nil` is annotated with the item type; `ivNullCap` is the
CHERI null capability. -/
inductive Ctor where
  | nil : BaseType → Ctor
  | cons
  | tuple
  | array
  | ivMax
  | ivMin
  | ivSizeof
  | ivAlignof
  | ivCompl
  | ivAnd
  | ivOr
  | ivXor
  | specified
  | unspecified
  | fvFromInt
  | ivFromFloat
  | ivNullCap : Bool → Ctor
  deriving DecidableEq, Repr

mutual

/-- Pattern shapes: a (possibly wildcard) binder of a base type, or a constructor
applied to subpatterns. -/
inductive PatternNode (sym : Type) where
  | base : (Option sym × BaseType) → PatternNode sym
  | ctor : Ctor → List (Pattern sym) → PatternNode sym

/-- Annotated patterns. -/
inductive Pattern (sym : Type) where
  | mk : List Annot → PatternNode sym → Pattern sym

end

deriving instance Repr for PatternNode, Pattern

mutual

/-- Core pure expressions. -/
inductive PexprNode (M : MemoryModel) (bty sym : Type) where
  | sym : sym → PexprNode M bty sym
  | impl : ImplementationConstant → PexprNode M bty sym
  | val : Value M → PexprNode M bty sym
  | constrained : List (IvConstraint M × Pexpr M bty sym) → PexprNode M bty sym
  | undef : Loc → UndefinedBehaviour → PexprNode M bty sym
  | error : String → Pexpr M bty sym → PexprNode M bty sym
  | ctor : Ctor → List (Pexpr M bty sym) → PexprNode M bty sym
  | case_ : Pexpr M bty sym → List (Pattern sym × Pexpr M bty sym) → PexprNode M bty sym
  | arrayShift : Pexpr M bty sym → Ctype → Pexpr M bty sym → PexprNode M bty sym
  | memberShift : Pexpr M bty sym → sym → Identifier → PexprNode M bty sym
  | memop : PureMemOp → List (Pexpr M bty sym) → PexprNode M bty sym
  | not : Pexpr M bty sym → PexprNode M bty sym
  | op : BinOp → Pexpr M bty sym → Pexpr M bty sym → PexprNode M bty sym
  | convInt : IntegerType → Pexpr M bty sym → PexprNode M bty sym
  | wrapI : IntegerType → IntOp → Pexpr M bty sym → Pexpr M bty sym → PexprNode M bty sym
  | catchExceptionalCondition :
      IntegerType → IntOp → Pexpr M bty sym → Pexpr M bty sym → PexprNode M bty sym
  | struct : sym → List (Identifier × Pexpr M bty sym) → PexprNode M bty sym
  | union : sym → Identifier → Pexpr M bty sym → PexprNode M bty sym
  | cfunction : Pexpr M bty sym → PexprNode M bty sym
  | memberof : sym → Identifier → Pexpr M bty sym → PexprNode M bty sym
  | call : Name sym → List (Pexpr M bty sym) → PexprNode M bty sym
  | let_ : Pattern sym → Pexpr M bty sym → Pexpr M bty sym → PexprNode M bty sym
  | if_ : Pexpr M bty sym → Pexpr M bty sym → Pexpr M bty sym → PexprNode M bty sym
  | isScalar : Pexpr M bty sym → PexprNode M bty sym
  | isInteger : Pexpr M bty sym → PexprNode M bty sym
  | isSigned : Pexpr M bty sym → PexprNode M bty sym
  | isUnsigned : Pexpr M bty sym → PexprNode M bty sym
  | bmcAssume : Pexpr M bty sym → PexprNode M bty sym
  | areCompatible : Pexpr M bty sym → Pexpr M bty sym → PexprNode M bty sym

/-- Annotated pure expressions; `bty` is the type annotation. -/
inductive Pexpr (M : MemoryModel) (bty sym : Type) where
  | mk : List Annot → bty → PexprNode M bty sym → Pexpr M bty sym

end

deriving instance Repr for PexprNode, Pexpr

/-- Whether a `kill` frees a dynamic allocation (`free()`) or ends a static
object's lifetime. -/
inductive KillKind where
  | dynamic
  | static : Ctype → KillKind
  deriving Repr

/-- Memory actions. The `Bool` of `store` is whether the store is locking; that
of `seqRmw` is whether the result is the updated value rather than the value
read. -/
inductive ActionNode (M : MemoryModel) (bty sym : Type) where
  | create : Pexpr M bty sym → Pexpr M bty sym → Prefix → ActionNode M bty sym
  | createReadOnly : Pexpr M bty sym → Pexpr M bty sym → Pexpr M bty sym → Prefix →
      ActionNode M bty sym
  | alloc : Pexpr M bty sym → Pexpr M bty sym → Prefix → ActionNode M bty sym
  | kill : KillKind → Pexpr M bty sym → ActionNode M bty sym
  | store : Bool → Pexpr M bty sym → Pexpr M bty sym → Pexpr M bty sym → MemoryOrder →
      ActionNode M bty sym
  | load : Pexpr M bty sym → Pexpr M bty sym → MemoryOrder → ActionNode M bty sym
  | seqRmw : Bool → Pexpr M bty sym → Pexpr M bty sym → sym → Pexpr M bty sym →
      ActionNode M bty sym
  | rmw : Pexpr M bty sym → Pexpr M bty sym → Pexpr M bty sym → Pexpr M bty sym →
      MemoryOrder → MemoryOrder → ActionNode M bty sym
  | fence : MemoryOrder → ActionNode M bty sym
  | compareExchangeStrong : Pexpr M bty sym → Pexpr M bty sym → Pexpr M bty sym →
      Pexpr M bty sym → MemoryOrder → MemoryOrder → ActionNode M bty sym
  | compareExchangeWeak : Pexpr M bty sym → Pexpr M bty sym → Pexpr M bty sym →
      Pexpr M bty sym → MemoryOrder → MemoryOrder → ActionNode M bty sym
  | linuxFence : LinuxMemoryOrder → ActionNode M bty sym
  | linuxLoad : Pexpr M bty sym → Pexpr M bty sym → LinuxMemoryOrder → ActionNode M bty sym
  | linuxStore : Pexpr M bty sym → Pexpr M bty sym → Pexpr M bty sym → LinuxMemoryOrder →
      ActionNode M bty sym
  | linuxRmw : Pexpr M bty sym → Pexpr M bty sym → Pexpr M bty sym → LinuxMemoryOrder →
      ActionNode M bty sym
  deriving Repr

/-- Located memory actions; `a` is a caller-chosen annotation. -/
inductive Action (M : MemoryModel) (a bty sym : Type) where
  | mk : Loc → a → ActionNode M bty sym → Action M a bty sym
  deriving Repr

/-- Memory actions with a polarity. -/
inductive PolarizedAction (M : MemoryModel) (a bty sym : Type) where
  | mk : Polarity → Action M a bty sym → PolarizedAction M a bty sym
  deriving Repr

/-- Dynamic annotations used during execution. For `neg` the `Nat` is the
action's exclusion ID and the list its exclusion set; for `pos` the list is the
exclusion set. -/
inductive DynAnnotation (M : MemoryModel) where
  | neg : Nat → List Nat → M.Footprint → DynAnnotation M
  | pos : List Nat → M.Footprint → DynAnnotation M
  deriving DecidableEq, Repr

/-- How a `save` label parameter is passed. -/
inductive PassBy where
  | pointer
  | value
  deriving DecidableEq, Repr

mutual

/-- Core effectful expressions. `wait`, `annot` and `excluded` only exist during
execution. -/
inductive ExprNode (M : MemoryModel) (a bty sym : Type) where
  | pure : Pexpr M bty sym → ExprNode M a bty sym
  | memop : MemOp sym → List (Pexpr M bty sym) → ExprNode M a bty sym
  | action : PolarizedAction M a bty sym → ExprNode M a bty sym
  | case_ : Pexpr M bty sym → List (Pattern sym × Expr M a bty sym) → ExprNode M a bty sym
  | let_ : Pattern sym → Pexpr M bty sym → Expr M a bty sym → ExprNode M a bty sym
  | if_ : Pexpr M bty sym → Expr M a bty sym → Expr M a bty sym → ExprNode M a bty sym
  | ccall : a → Pexpr M bty sym → Pexpr M bty sym → List (Pexpr M bty sym) →
      ExprNode M a bty sym
  | proc : a → Name sym → List (Pexpr M bty sym) → ExprNode M a bty sym
  | unseq : List (Expr M a bty sym) → ExprNode M a bty sym
  | wseq : Pattern sym → Expr M a bty sym → Expr M a bty sym → ExprNode M a bty sym
  | sseq : Pattern sym → Expr M a bty sym → Expr M a bty sym → ExprNode M a bty sym
  | bound : Expr M a bty sym → ExprNode M a bty sym
  | nd : List (Expr M a bty sym) → ExprNode M a bty sym
  | save : (sym × BaseType) →
      List (sym × ((BaseType × Option (Ctype × PassBy)) × Pexpr M bty sym)) →
      Expr M a bty sym → ExprNode M a bty sym
  | run : a → sym → List (Pexpr M bty sym) → ExprNode M a bty sym
  | par : List (Expr M a bty sym) → ExprNode M a bty sym
  | wait : ThreadId → ExprNode M a bty sym
  | annot : List (DynAnnotation M) → Expr M a bty sym → ExprNode M a bty sym
  | excluded : Nat → Action M a bty sym → ExprNode M a bty sym

/-- Annotated effectful expressions. -/
inductive Expr (M : MemoryModel) (a bty sym : Type) where
  | mk : List Annot → ExprNode M a bty sym → Expr M a bty sym

end

deriving instance Repr for ExprNode, Expr

/-- Definitions of implementation-defined constants and functions. -/
inductive ImplDecl (M : MemoryModel) (bty : Type) where
  | constant : BaseType → Pexpr M bty Sym → ImplDecl M bty
  | function : BaseType → List (Sym × BaseType) → Pexpr M bty Sym → ImplDecl M bty
  deriving Repr

/-- The implementation-defined environment. -/
abbrev Impl (M : MemoryModel) (bty : Type) := Map ImplementationConstant (ImplDecl M bty)

/-- Function and procedure declarations. The `Option Nat` of `procedure` is its
marker environment. -/
inductive FunDecl (M : MemoryModel) (bty a : Type) where
  | function : BaseType → List (Sym × BaseType) → Pexpr M bty Sym → FunDecl M bty a
  | procedure : Loc → Option Nat → BaseType → List (Sym × BaseType) → Expr M a bty Sym →
      FunDecl M bty a
  | procedureDecl : Loc → BaseType → List BaseType → FunDecl M bty a
  | builtinDecl : Loc → BaseType → List BaseType → FunDecl M bty a
  deriving Repr

/-- Functions and procedures by symbol. -/
abbrev FunMap (M : MemoryModel) (bty a : Type) := Map Sym (FunDecl M bty a)

/-- Linkage of an external identifier. -/
inductive LinkingKind where
  | none
  | tentative : Sym → LinkingKind
  | normal : Sym → LinkingKind
  deriving DecidableEq, Repr

/-- External identifiers and their symbols. -/
abbrev ExternMap := Map Identifier (List Sym × LinkingKind)

/-- Global object definitions and declarations. -/
inductive Global (M : MemoryModel) (a bty : Type) where
  | definition : (BaseType × Ctype) → Expr M a bty Sym → Global M a bty
  | declaration : (BaseType × Ctype) → Global M a bty
  deriving Repr

/-- Struct and union definitions by tag. -/
abbrev TagDefinitions := Map Sym (Loc × TagDefinition)

/-- Objects visible at each marker. -/
abbrev VisibleObjects := Map Nat (List (Sym × Ctype))

/-- Calling conventions. -/
inductive CallingConvention where
  | normal
  | innerArg
  deriving DecidableEq, Repr

/-- A Core file: named functions and procedures together with their
environment. -/
structure File (M : MemoryModel) (bty a : Type) where
  main : Option Sym
  callingConvention : CallingConvention
  tagDefs : TagDefinitions
  stdlib : FunMap M bty a
  impl : Impl M bty
  globs : List (Sym × Global M a bty)
  funs : FunMap M bty a
  extern : ExternMap
  funInfo : Map Sym (Loc × Attributes × Ctype × List (Option Sym × Ctype) × Bool × Bool)
  loopAttributes : LoopAttributes
  visibleObjects : VisibleObjects

end Silmaril.Cerberus.Core
