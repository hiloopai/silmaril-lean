module

public import Silmaril.Raw.Machine.X86.Lift.BirSimp

/-!
# Lifted listings: what a generated module states about each block

A module generated by `x86-lift-ir` gives, for each basic block of a lifted
function, its bytes, its `LInstr` listing and its Bir block, and proves

* `listingOk bytes listing = true`: every `Ext` instruction of the listing is
  what `Ext.decode` reads from its bytes (so the listing is a theorem about the
  bytes, as in `Lift.Transcript`); an extension instruction (`LInstr.x`) is
  only length-checked, because `Ext.decode` does not know it, and is counted
  in the module's trust summary;
* `liftBlock listing = some block`: the block simulation certificate
  (`liftBlock_sound`).

Both are closed by `decide +kernel`.
-/

@[expose] public section

namespace Silmaril.X86.Lift.Bir

open Silmaril.X86 (Reg Byte)

/-- An `Ext.Index` with the `≠ rsp` side condition discharged by `decide`. -/
def ix (r : Reg) (scale : BitVec 2) (h : r ≠ .rsp := by decide) : Ext.Index := ⟨r, scale, h⟩

/-- The decoder check for one listed instruction. -/
def LInstr.decodeOk (bytes : List Byte) : LInstr → Nat → Bool
  | .ext i, len => decide (Ext.decode bytes = some (i, len))
  | .x _, len => bytes.length == len
  | .sse _, len => bytes.length == len

/-- Every instruction of a listing is checked against its bytes. -/
def listingOk : List (List Byte) → List (LInstr × Nat) → Bool
  | [], [] => true
  | b :: bs, (i, len) :: rest => i.decodeOk b len && listingOk bs rest
  | _, _ => false

theorem LInstr.decodeOk_ext {bytes : List Byte} {i : Ext.Instr} {len : Nat}
    (h : (LInstr.ext i).decodeOk bytes len = true) : Ext.decode bytes = some (i, len) := by
  simpa [LInstr.decodeOk] using h

/-- How many instructions of a listing are extension forms (trust tier `ext+`). -/
def extCount (l : List (LInstr × Nat)) : Nat := (l.filter fun p => match p.1 with
  | .ext _ => false
  | _ => true).length

end Silmaril.X86.Lift.Bir
