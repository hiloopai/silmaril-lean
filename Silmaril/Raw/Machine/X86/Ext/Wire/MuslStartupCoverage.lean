/-- Every prior reached byte span decodes with its complete original length. -/
theorem prefix_exact_decode : preGapBytes.all (fun bytes =>
    (decode bytes).map Decoded.length == some bytes.length) = true := by
  decide

/-- REP STOSQ is the first reached local-decoder gap, at PC 0x4011dd. -/
theorem first_gap : decode [0xf3#8, 0x48#8, 0xab#8] = none := by
  decide

