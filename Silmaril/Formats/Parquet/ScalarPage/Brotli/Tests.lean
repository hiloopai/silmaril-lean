module

import Silmaril.Formats.Parquet.ScalarPage.Brotli.Thms
import Init.Data.Option.Basic
meta import Silmaril.Formats.Parquet.ScalarPage.Brotli.Defs
meta import Init.Data.Option.Basic

namespace Silmaril.Formats.Parquet.ScalarPage.Brotli

-- Assembled Compact Thrift frames and IEEE CRCs. The Brotli body for
-- "abc" was generated by pinned libbrotli with an 18-bit standard window.
private def v1 : List UInt8 :=
  [0x15, 0, 0x15, 6, 0x15, 0x0e, 0x15, 0xbb, 0xff, 0x8d, 0xed, 6, 0x1c, 0x15, 2, 0x15, 0,
   0x15, 6, 0x15, 6, 0, 0, 3, 1, 0x80, 0x61, 0x62, 0x63, 3]

private def v2Raw : List UInt8 :=
  [0x15, 6, 0x15, 0x0a, 0x15, 0x0a, 0x15, 0x8f, 0xb6, 0xa4, 0xca, 1, 0x4c, 0x15, 2, 0x15, 0,
   0x15, 2, 0x15, 0, 0x15, 4, 0x15, 0, 0x12, 0, 0, 3, 1, 0x61, 0x62, 0x63]

private def v2Default : List UInt8 :=
  [0x15, 6, 0x15, 0x0a, 0x15, 0x12, 0x15, 0xd2, 0xde, 0xe5, 0xf6, 8, 0x4c, 0x15, 2, 0x15, 0,
   0x15, 2, 0x15, 0, 0x15, 4, 0x15, 0, 0, 0, 3, 1, 3, 1, 0x80, 0x61, 0x62, 0x63, 3]

private def limits : Limits := {
  framing := {}
  page := ⟨9, 5, ⟨16, 16⟩, 0⟩
  window := 262128
  bits := 56
  blocks := 2
  commands := 0
}

private def run (input : List UInt8) (cap := limits) (codec : Int := 4) : Except Error Result :=
  decodeAt cap .optional codec (Bytes.ofList input) ⟨0, input.length⟩ 0

private def resultOf (read : Except Error Result) : Option (Nat × Nat × List UInt8 × Page.Checksum.Status) :=
  read.toOption.map fun page => (page.frame.payload.start, page.frame.payload.stop, page.expanded, page.checksum)

private def errorOf (read : Except Error Result) : Option Error :=
  match read with
  | .ok _ => none
  | .error error => some error

#guard resultOf (run v1) = some (23, 30, [97, 98, 99], .valid 3375251490)
#guard resultOf (run (v1 ++ [0xa5])) = some (23, 30, [97, 98, 99], .valid 3375251490)
#guard resultOf (run v2Raw { limits with window := 0, bits := 0, blocks := 0 }) =
  some (28, 33, [3, 1, 97, 98, 99], .valid 4082856568)
#guard resultOf (run v2Default) = some (27, 36, [3, 1, 97, 98, 99], .valid 1198307241)
#guard errorOf (run v2Default { limits with bits := 0 }) = some (.stream (.envelope ⟨0, none, none, .bitLimit⟩))
#guard errorOf (run v1 limits 6) = some (.codec 6)
#guard errorOf (run v1 { limits with page := { limits.page with compressedBytes := 6 } }) =
  some (.checksum .byteLimit)
#guard errorOf (run v1 { limits with page := { limits.page with uncompressedBytes := 2 } }) =
  some (.page (.payload .outputLimit))
#guard errorOf (run (v1.set 23 0xff) { limits with bits := 0 }) =
  some (.checksum (.mismatch 3375251490 1794117775))
#guard errorOf (run v1.dropLast) = some (.framing .payloadBounds)

end Silmaril.Formats.Parquet.ScalarPage.Brotli
