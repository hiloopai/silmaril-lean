module

public import Silmaril.Formats.Compression.Brotli.Literal.Defs
public import Silmaril.Formats.Compression.Brotli.Distance.Defs
public import Silmaril.Formats.Compression.HistoryCopy.Defs
import Init.Omega

/-! Execute one RFC 7932 compressed command in a standard-window
meta-block with one block type in each category. -/

@[expose] public section

namespace Silmaril.Formats.Compression.Brotli.Execute

structure State where
  output : Array UInt8
  ring : Distance.Ring
  deriving DecidableEq, Repr

def State.start : State := ⟨#[], Distance.Ring.start⟩

/-- The stream's last two bytes, with zero seed bytes before its start. -/
def State.literalHistory (state : State) : Literal.History :=
  let size := state.output.size
  ⟨if size = 0 then 0 else state.output[size - 1]?.getD 0,
    if size < 2 then 0 else state.output[size - 2]?.getD 0⟩

structure Block where
  windowBits : Nat
  /-- Stream output count at the start of this meta-block. -/
  start : Nat
  /-- Advertised regenerated byte count of this meta-block. -/
  length : Nat

def Block.endOutput (block : Block) : Nat := block.start + block.length

structure Limits where
  /-- Total stream output allowed, including existing history. -/
  output : Nat
  /-- Committed source bits for the complete command. -/
  bits : Nat

structure Result where
  state : State
  command : Command.Value
  distance : Option Nat
  deriving DecidableEq, Repr

inductive Error where
  | blockTypes
  | window
  | metaBlockExtent
  | outputLimit
  | command (reason : Command.Error)
  | literal (reason : Literal.Error)
  | distance (reason : Distance.Error)
  | unsupportedDictionary (distance wordLength wordId : Nat)
  | copyBounds
  deriving DecidableEq, Repr

def oneType (header : CompressedHeader.Header) : Bool :=
  match header.initial.controls with
  | ⟨.single, .single, .single⟩ => true
  | _ => false

/-- The terminal path ignores the copy. The copy path records the real
    distance read, resulting ring and bytewise overlap relation. -/
inductive TailWire (header : CompressedHeader.Header) (block : Block) (command : Command.Value)
    (ring : Distance.Ring) (beforeCopy : List UInt8) :
    List Bool → List UInt8 → Option Nat → Distance.Ring → Prop where
  | terminal : beforeCopy.length = block.endOutput → TailWire header block command ring beforeCopy [] [] none ring
  | copy {bits : List Bool} {matched : List UInt8} {distance : Nat} {resolved : Distance.Result} :
      beforeCopy.length < block.endOutput →
      Distance.Wire header command ⟨block.windowBits, beforeCopy.length⟩ ring bits resolved →
      resolved.target = .backReference distance →
      HistoryCopy.Wire distance beforeCopy matched → matched.length = command.copyLength →
      TailWire header block command ring beforeCopy bits matched (some distance) resolved.ring

structure Wire (header : CompressedHeader.Header) (block : Block) (initial : State)
    (bits : List Bool) (result : Result) : Prop where
  parts : ∃ commandBits literalBits tailBits commandTree literalSource literals history matched,
    bits = commandBits ++ literalBits ++ tailBits ∧
    header.insertCopyTrees = [commandTree] ∧ Command.Wire commandTree commandBits result.command ∧
    Literal.FromHeader header literalSource ∧
    Literal.Wire literalSource initial.literalHistory literalBits literals history ∧
    literals.length = result.command.insertLength ∧
    TailWire header block result.command initial.ring (initial.output.toList ++ literals)
      tailBits matched result.distance result.state.ring ∧
    result.state.output.toList = initial.output.toList ++ literals ++ matched

namespace Internal

/-- Resolve the distance before applying the back-reference size debit.
    A dictionary's base length is not a regenerated output count. -/
def copyTail (header : CompressedHeader.Header) (block : Block) (limits : Limits)
    (initial : State) (command : Command.Value) (literals : List UInt8)
    (bitLimit : Nat) (before : LSBReader) : Except Error (Result × LSBReader) := do
  let produced := initial.output.size + literals.length
  let (resolved, after) ←
    (Distance.read header command ⟨block.windowBits, produced⟩ initial.ring bitLimit before).mapError Error.distance
  match resolved.target with
  | .staticDictionary distance length wordId => .error (.unsupportedDictionary distance length wordId)
  | .backReference distance =>
    if block.endOutput < produced + command.copyLength then .error .metaBlockExtent
    else if limits.output < produced + command.copyLength then .error .outputLimit
    else if valid : 0 < distance ∧ distance ≤ produced then
      let history := initial.output ++ literals.toArray
      let output := HistoryCopy.copy distance valid.1 command.copyLength history (by simpa [history] using valid.2)
      .ok (⟨⟨output, resolved.ring⟩, command, some distance⟩, after)
    else .error .copyBounds

end Internal

/-- Execute from the command symbol and return a successor only after
    the complete admitted command. All lengths are checked before copy. -/
def read (header : CompressedHeader.Header) (block : Block) (limits : Limits)
    (initial : State) (before : LSBReader) : Except Error (Result × LSBReader) :=
  if !oneType header then .error .blockTypes
  else if block.windowBits < 10 ∨ 24 < block.windowBits then .error .window
  else if initial.output.size < block.start ∨ block.endOutput ≤ initial.output.size then .error .metaBlockExtent
  else if limits.output < initial.output.size then .error .outputLimit
  else do
    let (command, atLiterals) ← (Command.readSingle header limits.bits before).mapError Error.command
    let (inserted, atDistance) ← (Literal.read header command block.length
      ⟨limits.output - block.start, limits.bits - (atLiterals.totalRead - before.totalRead)⟩
      ⟨initial.output.size - block.start, initial.literalHistory⟩ atLiterals).mapError Error.literal
    match inserted.next with
    | .endOfMetaBlock =>
      let output := initial.output ++ inserted.bytes.toArray
      pure (⟨⟨output, initial.ring⟩, command, none⟩, atDistance)
    | .copyPending =>
      Internal.copyTail header block limits initial command inserted.bytes
        (limits.bits - (atDistance.totalRead - before.totalRead)) atDistance

end Silmaril.Formats.Compression.Brotli.Execute
