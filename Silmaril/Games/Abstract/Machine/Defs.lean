module

public import Silmaril.Games.Abstract.Game.Defs

/-!
# Abstract state machines over a game

A `Machine G` is a component given by internal abstract state and interaction
transitions: a type of states, an initial state, and steps that are silent
(`none`) or labelled by a move of `G` (an import call or answer, an export call
or answer, a stream or future event, a startup event, whatever `G` provides).
Steps form a relation, so machines are nondeterministic in general.

*State erasure* forgets the states and keeps the visible behaviour: `traces M`
is the set of finite move sequences the machine can perform, and `denote M` is
the trace model it generates. The square

```
  concrete component ──► Machine G
          │                 │ denote
          └───────────────► TraceModel G
```

commutes for the existing `LTS → Strategy` semantics of `E ↠ F`
(`Silmaril.Games.Abstract.SigBridge.Thms`).

## Determinism

Two notions, both stated about the machine:

* `SDet`: *strategy determinism*. At each state the component has at most one
  non-Opponent option (a silent step or a single Proponent move, with a single
  successor); Opponent moves have a single successor and are only offered at
  states where the component has no option of its own (it is waiting). The
  component's choices are then a function of the history, which includes every
  input; nothing is said about which inputs arrive. Environmental
  nondeterminism (host answers, scheduling when scheduling is a move, NaN bits
  when chosen by the host or profile and delivered as a move) is therefore
  compatible with `SDet`. Nondeterminism *internal* to the component (a
  relaxed-SIMD or NaN choice made by the engine with no move recording it,
  racing threads) is not.
* `LDet`: the machine is a deterministic labelled transition system: no silent
  steps, and each label has at most one successor. `SDet` without silent steps
  implies `LDet` (`SDet.lDet`).

For `LDet` machines, trace equality and bisimilarity coincide
(`Silmaril.Games.Abstract.Machine.Thms`), so state erasure is injective on the
bisimulation quotient. For nondeterministic machines it is not.
-/

@[expose] public section

namespace Silmaril.Games.Abstract

universe u

/-- A component as an abstract state machine over the moves of `G`. -/
structure Machine (G : Game.{u}) : Type (u + 1) where
  /-- States. -/
  State : Type u
  /-- The initial state. -/
  init : State
  /-- Transitions: silent (`none`) or labelled by a move. -/
  step : State → Option G.Move → State → Prop

namespace Machine

variable {G : Game.{u}}

/-- `M.Run x s y`: from `x`, `M` can reach `y` performing the visible moves
`s`, with silent steps in between. -/
inductive Run (M : Machine G) : M.State → List G.Move → M.State → Prop
  /-- No step. -/
  | nil (x : M.State) : Run M x [] x
  /-- A silent step. -/
  | tau {x y z : M.State} {s : List G.Move} : M.step x none y → Run M y s z → Run M x s z
  /-- A visible step. -/
  | vis {x y z : M.State} {o : G.Move} {s : List G.Move} :
      M.step x (some o) y → Run M y s z → Run M x (o :: s) z

/-- The traces of `M` from the state `x`. -/
def tracesFrom (M : Machine G) (x : M.State) : Set (List G.Move) := {s | ∃ y, M.Run x s y}

/-- The traces of `M`: its visible behaviours from the initial state. -/
def traces (M : Machine G) : Set (List G.Move) := M.tracesFrom M.init

/-- State erasure: the trace model generated by the traces of `M`. -/
def denote (M : Machine G) : TraceModel G := TraceModel.generate M.traces

/-- A label that is not an Opponent move: a silent step or a Proponent move. -/
def NonO : Option G.Move → Prop
  | none => True
  | some m => ¬ G.IsO m

/-- Strategy determinism: the component's own options are unique, Opponent
moves are deterministic and only offered while the component waits. -/
structure SDet (M : Machine G) : Prop where
  /-- At most one silent-or-Proponent option, with one successor. -/
  nonO : ∀ {x y y' : M.State} {l l' : Option G.Move}, M.step x l y → M.step x l' y' →
    NonO l → NonO l' → l = l' ∧ y = y'
  /-- Opponent moves have one successor. -/
  oDet : ∀ {x y y' : M.State} {o : G.Move}, M.step x (some o) y → M.step x (some o) y' →
    G.IsO o → y = y'
  /-- Opponent moves are only offered where the component has no option. -/
  oStable : ∀ {x y y' : M.State} {o : G.Move} {l : Option G.Move}, M.step x (some o) y →
    G.IsO o → M.step x l y' → ¬ NonO l

/-- A deterministic labelled transition system: no silent steps, one successor
per label. -/
structure LDet (M : Machine G) : Prop where
  /-- No silent steps. -/
  tau_free : ∀ {x y : M.State}, ¬ M.step x none y
  /-- One successor per label. -/
  det : ∀ {x y y' : M.State} {o : G.Move}, M.step x (some o) y → M.step x (some o) y' → y = y'

/-- A strong bisimulation between the states of two machines. -/
structure IsBisim (M N : Machine G) (R : M.State → N.State → Prop) : Prop where
  /-- Steps of `M` are matched by `N`. -/
  forth : ∀ {x x' y l}, R x y → M.step x l x' → ∃ y', N.step y l y' ∧ R x' y'
  /-- Steps of `N` are matched by `M`. -/
  back : ∀ {x y y' l}, R x y → N.step y l y' → ∃ x', M.step x l x' ∧ R x' y'

/-- Two machines are bisimilar when a strong bisimulation relates their initial
states. -/
def Bisim (M N : Machine G) : Prop := ∃ R, IsBisim M N R ∧ R M.init N.init

end Machine

end Silmaril.Games.Abstract
