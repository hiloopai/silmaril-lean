module

public import Silmaril.Games.Abstract.Game.Defs

/-!
# Partial game morphisms: hiding moves

A partial morphism `f : G.PHom H` sends each move of `G` to a move of `H` or
hides it (`none`). The image of a play is `s.filterMap f.map`. Legal plays
must map to legal plays, and visible Opponent moves to Opponent moves.

* `pull f T`, for `T : TraceModel H`, is the set of legal plays of `G` whose
  visible part is a play of `T`. Hidden moves are unconstrained.
* `hide f T`, for `T : TraceModel G`, is the model generated by the visible
  parts of the plays of `T`. It is the left adjoint of `pull f`
  (`Silmaril.Games.Abstract.Hiding.Thms`).

A total morphism `Game.Hom` is a partial one that hides nothing
(`Game.Hom.toPHom`), and then `pull` is `comap`. Hiding is what startup
erasure (`Silmaril.Games.Abstract.Startup`) and linking (internal interface
moves) do.
-/

@[expose] public section

namespace Silmaril.Games.Abstract

universe u v w

namespace Game

/-- A partial morphism of games: moves map to moves or are hidden; legal plays
map to legal plays and visible Opponent moves to Opponent moves. -/
structure PHom (G : Game.{u}) (H : Game.{v}) where
  /-- The image of a move, or `none` when it is hidden. -/
  map : G.Move → Option H.Move
  /-- The visible part of a legal play is legal. -/
  legal : ∀ {s}, s ∈ G.Legal → s.filterMap map ∈ H.Legal
  /-- Visible Opponent moves map to Opponent moves. -/
  isO : ∀ {m n}, map m = some n → G.IsO m → H.IsO n

/-- A total morphism hides nothing. -/
def Hom.toPHom {G : Game.{u}} {H : Game.{v}} (f : G.Hom H) : G.PHom H where
  map m := some (f.map m)
  legal h := by
    have : ∀ s : List G.Move, s.filterMap (fun m => some (f.map m)) = s.map f.map := by
      intro s; induction s <;> simp_all
    rw [this]; exact f.legal h
  isO h ho := by cases h; exact f.isO ho

end Game

namespace TraceModel

variable {G : Game.{u}} {H : Game.{v}}

/-- The legal plays of `G` whose visible part is a play of `T`. -/
def pull (f : G.PHom H) (T : TraceModel H) : TraceModel G where
  plays := {s | s ∈ G.Legal ∧ s.filterMap f.map ∈ T}
  closed := {
    nil_mem := ⟨G.nil_legal, T.closed.nil_mem⟩
    legal := fun h => h.1
    of_prefix := fun ⟨ht, h⟩ hst =>
      ⟨G.legal_of_prefix ht hst, T.closed.of_prefix h (hst.filterMap f.map)⟩
    receptive := fun {s o} ⟨_, h⟩ hl ho => ⟨hl, by
      cases hm : f.map o with
      | none => simpa [List.filterMap_append, hm] using h
      | some n =>
        have hl' := f.legal hl
        simp only [List.filterMap_append, List.filterMap_cons, hm, List.filterMap_nil] at hl' ⊢
        exact T.closed.receptive h hl' (f.isO hm ho)⟩ }

/-- Hiding: the model generated by the visible parts of the plays of `T`. -/
def hide (f : G.PHom H) (T : TraceModel G) : TraceModel H :=
  generate ((List.filterMap f.map) '' (T : Set (List G.Move)))

end TraceModel

end Silmaril.Games.Abstract
