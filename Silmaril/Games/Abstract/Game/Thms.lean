module

public import Silmaril.Games.Abstract.Game.Defs
public import Mathlib.Order.CompleteLattice.Basic
public import Mathlib.Order.GaloisConnection.Defs
public import Mathlib.Order.Setoid.Basic
import Silmaril.Proofs.Games.Abstract.Game.Lattice

/-!
# Trace models of an abstract game: the lattice, determinism and morphisms

* `generate S` is the least model containing the legal plays of `S`
  (`generate_le_iff`) and fixes every model (`generate_coe`).
* The lattice: `⊤` is every legal play (`mem_top`), `⊥` only lets Opponent move
  (`mem_bot`), meets are intersections (`mem_sInf`, in the definitions), and
  joins are the *closure* of unions (`sSup_eq_generate`). The closure only
  matters for the empty join: a nonempty union of models is a model
  (`mem_sSup_of_nonempty`), while `sSup ∅ = ⊥` is not the empty set (it
  contains the empty play and every run of Opponent moves).
* Determinism is inherited by submodels (`Det.mono`); `⊥` is deterministic.
* Pullback along a game morphism is functorial (`comap_id`, `comap_comp`),
  monotone, and right adjoint to pushforward (`gc_map_comap`), so it preserves
  arbitrary meets.
* Observing through a morphism is coarser than equality of models:
  `obsKer_le` says that two programs with the same model have the same
  observation, for any denotation `den : P → TraceModel H`. The converse fails
  in general (an observer that forgets moves identifies more), which is exactly
  why a trace-level quotient is not, by itself, a full abstraction result.

The longer proofs are in `Silmaril.Proofs.Games.Abstract.Game.Lattice`.
-/

public section

namespace Silmaril.Games.Abstract

universe u v w

namespace TraceModel

variable {G : Game.{u}}

/-- Unfolding `generate`. -/
theorem mem_generate {S : Set (List G.Move)} {p : List G.Move} :
    p ∈ generate S ↔ p ∈ G.generateSet S := Iff.rfl

/-- Every legal play of `S` is a play of `generate S`. -/
theorem subset_generate {S : Set (List G.Move)} {s : List G.Move} (hs : s ∈ S)
    (hl : s ∈ G.Legal) : s ∈ generate S :=
  Silmaril.Proofs.Games.Abstract.Game.subset_generate hs hl

/-- `generate S` is the least model containing the legal plays of `S`. -/
theorem generate_le_iff {S : Set (List G.Move)} {T : TraceModel G} :
    generate S ≤ T ↔ ∀ s ∈ S, s ∈ G.Legal → s ∈ T :=
  Silmaril.Proofs.Games.Abstract.Game.generate_le_iff

/-- `generate` is monotone. -/
theorem generate_mono {S S' : Set (List G.Move)} (h : S ⊆ S') : generate S ≤ generate S' :=
  generate_le_iff.2 fun _ hs hl => subset_generate (h hs) hl

/-- A model generates itself. -/
theorem generate_coe (T : TraceModel G) : generate (T : Set (List G.Move)) = T :=
  Silmaril.Proofs.Games.Abstract.Game.generate_coe T

/-- The top model contains every legal play. -/
theorem mem_top {p : List G.Move} : p ∈ (⊤ : TraceModel G) ↔ p ∈ G.Legal :=
  Silmaril.Proofs.Games.Abstract.Game.mem_top

/-- The bottom model never moves: its plays are the legal runs of Opponent
moves. -/
theorem mem_bot {p : List G.Move} :
    p ∈ (⊥ : TraceModel G) ↔ p ∈ G.Legal ∧ ∀ o ∈ p, G.IsO o :=
  Silmaril.Proofs.Games.Abstract.Game.mem_bot

/-- Joins are generated by unions. -/
theorem sSup_eq_generate (S : Set (TraceModel G)) :
    sSup S = generate {p | ∃ T ∈ S, p ∈ T} :=
  Silmaril.Proofs.Games.Abstract.Game.sSup_eq_generate S

/-- Nonempty joins are unions. -/
theorem mem_sSup_of_nonempty {S : Set (TraceModel G)} (hS : S.Nonempty) {p : List G.Move} :
    p ∈ sSup S ↔ ∃ T ∈ S, p ∈ T :=
  Silmaril.Proofs.Games.Abstract.Game.mem_sSup_of_nonempty hS

/-- Binary meets are intersections. -/
theorem mem_inf {T U : TraceModel G} {p : List G.Move} : p ∈ T ⊓ U ↔ p ∈ T ∧ p ∈ U := by
  rw [← sInf_pair, mem_sInf]
  exact ⟨fun ⟨_, h⟩ => ⟨h T (by simp), h U (by simp)⟩,
    fun ⟨h₁, h₂⟩ => ⟨T.closed.legal h₁, by rintro V (rfl | rfl) <;> assumption⟩⟩

/-- Binary joins are unions. -/
theorem mem_sup {T U : TraceModel G} {p : List G.Move} : p ∈ T ⊔ U ↔ p ∈ T ∨ p ∈ U := by
  rw [← sSup_pair, mem_sSup_of_nonempty (Set.insert_nonempty _ _)]
  simp

/-- Determinism is inherited by submodels. -/
theorem Det.mono {T U : TraceModel G} (h : T ≤ U) (hU : U.Det) : T.Det :=
  Silmaril.Proofs.Games.Abstract.Game.Det.mono h hU

/-- The model that never moves is deterministic. -/
theorem det_bot : (⊥ : TraceModel G).Det := fun _ p _ hp _ hpo _ =>
  absurd ((mem_bot.1 hp).2 p (by simp)) hpo

variable {H : Game.{v}} {K : Game.{w}}

/-- Membership in a pullback. -/
theorem mem_comap {f : G.Hom H} {T : TraceModel H} {s : List G.Move} :
    s ∈ comap f T ↔ s ∈ G.Legal ∧ s.map f.map ∈ T := Iff.rfl

/-- Pullback along the identity. -/
@[simp] theorem comap_id (T : TraceModel G) : comap (Game.Hom.id G) T = T :=
  ext fun s => ⟨fun h => by simpa [Game.Hom.id] using h.2,
    fun h => ⟨T.closed.legal h, by simpa [Game.Hom.id] using h⟩⟩

/-- Pullback along a composite. -/
theorem comap_comp (f : G.Hom H) (g : H.Hom K) (T : TraceModel K) :
    comap (f.comp g) T = comap f (comap g T) :=
  ext fun _ => ⟨fun ⟨h₁, h₂⟩ => ⟨h₁, f.legal h₁, by simpa [Game.Hom.comp, Function.comp_def] using h₂⟩,
    fun ⟨h₁, _, h₂⟩ => ⟨h₁, by simpa [Game.Hom.comp, Function.comp_def] using h₂⟩⟩

/-- Pushforward is left adjoint to pullback. -/
theorem gc_map_comap (f : G.Hom H) : GaloisConnection (map f) (comap f) :=
  Silmaril.Proofs.Games.Abstract.Game.gc_map_comap f

/-- Pullback is monotone. -/
theorem comap_mono (f : G.Hom H) : Monotone (comap f) := (gc_map_comap f).monotone_u

/-- Pullback preserves arbitrary meets. -/
theorem comap_sInf (f : G.Hom H) (S : Set (TraceModel H)) :
    comap f (sInf S) = ⨅ T ∈ S, comap f T := (gc_map_comap f).u_sInf

/-- Two programs are *observationally equivalent through `f`* when their models
pull back to the same model of `G`. -/
def obsKer {P : Type w} (f : G.Hom H) (den : P → TraceModel H) : Setoid P :=
  Setoid.ker (comap f ∘ den)

/-- Observing through `f` is coarser than equality of models. -/
theorem obsKer_le {P : Type w} (f : G.Hom H) (den : P → TraceModel H) :
    Setoid.ker den ≤ obsKer f den := fun _ _ h => by
  change comap f (den _) = comap f (den _)
  rw [show den _ = den _ from h]

end TraceModel

end Silmaril.Games.Abstract
