module

public import Mathlib.Basic.SetLike.Basic
public import Mathlib.Order.CompleteLattice.Defs

/-!
# Abstract games and their trace models

This topic is the generic layer under the component models: it fixes a *game*
and studies sets of finite traces over it, without committing to the
sequential, well-bracketed game `E ↠ F` of `Silmaril.Games.Play` (which is one
instance, `Silmaril.Games.Abstract.SigBridge`).

* A `Game` has a type of moves, a polarity (`IsO`: the move is made by the
  environment, the Opponent; every other move is the component's, the
  Proponent's) and a nonempty prefix-closed set of legal plays. Nothing forces
  alternation, so asynchronous games, where the environment may deliver several
  stream or future events in a row, are games too.
* A `TraceModel G` is a set of plays that contains the empty play, is legal,
  prefix-closed and *receptive*: it accepts every legal Opponent move after any
  of its plays. These are the closure conditions; `TraceModel G` is a complete
  lattice under inclusion (`Silmaril.Games.Abstract.Game.Thms`), with meets
  intersections and joins the closure of unions.
* `generate S` is the least trace model containing the legal plays of `S`; it
  closes under prefixes and appends any legal run of Opponent moves.
* `TraceModel.Det` is determinism *of the component's choices given the
  history*: two plays that agree up to a point and continue with a Proponent
  move continue with the same move. Opponent moves (inputs, host answers,
  scheduler choices delivered as moves) remain unconstrained, so a
  deterministic model is a function of its inputs, not a single play.
* A `Game.Hom` maps moves, preserving legality and Opponent polarity; trace
  models pull back along it (`comap`) and push forward (`map`), and the two
  form a Galois connection.

## What a finite trace model does not see

Plays are finite and the order is inclusion, so this is the safety ("may")
reading, as in `Silmaril.Games.Strategy`. A model that deadlocks after `s`, one
that diverges silently after `s`, and one that is still computing after `s` all
contain exactly the prefixes up to `s`. `TraceModel.Det` therefore cannot say
that a deterministic component *must* move; it only says that when it moves,
the move is determined. Refusals and divergence are handled by richer
observations (`Silmaril.Games.Abstract.Machine`), not by this lattice.
-/

@[expose] public section

namespace Silmaril.Games.Abstract

universe u v w

/-- A game: moves with a polarity and a nonempty prefix-closed set of legal
plays. `IsO m` says that the environment (Opponent) makes the move `m`; all
other moves are made by the component (Proponent). -/
structure Game : Type (u + 1) where
  /-- The moves. -/
  Move : Type u
  /-- Opponent (environment) moves. -/
  IsO : Move → Prop
  /-- The legal plays. -/
  Legal : Set (List Move)
  /-- The empty play is legal. -/
  nil_legal : [] ∈ Legal
  /-- Legal plays are closed under prefixes. -/
  legal_of_prefix : ∀ {s t : List Move}, t ∈ Legal → s <+: t → s ∈ Legal

namespace Game

/-- The free game on a type of moves: every play is legal, and `IsO` says
which moves are the environment's. -/
abbrev free (Move : Type u) (IsO : Move → Prop) : Game.{u} :=
  ⟨Move, IsO, Set.univ, trivial, fun _ _ => trivial⟩

variable (G : Game.{u})

/-- The closure conditions of a trace model: the set contains the empty play,
is legal, prefix-closed and receptive. -/
structure Closed (T : Set (List G.Move)) : Prop where
  /-- The empty play belongs to the set. -/
  nil_mem : [] ∈ T
  /-- Every play is legal. -/
  legal : ∀ {s}, s ∈ T → s ∈ G.Legal
  /-- Closed under prefixes. -/
  of_prefix : ∀ {s t}, t ∈ T → s <+: t → s ∈ T
  /-- Every legal Opponent move is accepted. -/
  receptive : ∀ {s o}, s ∈ T → s ++ [o] ∈ G.Legal → G.IsO o → s ++ [o] ∈ T

/-- The plays generated by `S`: legal plays that are a prefix of the empty play
or of a legal play of `S`, followed by a (possibly empty) run of Opponent moves. -/
def generateSet (S : Set (List G.Move)) : Set (List G.Move) :=
  {p | p ∈ G.Legal ∧ ∃ s, (s = [] ∨ (s ∈ S ∧ s ∈ G.Legal)) ∧
    ∃ p₀ w, p = p₀ ++ w ∧ p₀ <+: s ∧ ∀ o ∈ w, G.IsO o}

/-- `generateSet S` satisfies the closure conditions. -/
theorem closed_generateSet (S : Set (List G.Move)) : G.Closed (G.generateSet S) where
  nil_mem := ⟨G.nil_legal, [], .inl rfl, [], [], rfl, List.prefix_refl _, by simp⟩
  legal h := h.1
  of_prefix := by
    rintro s t ⟨ht, u, hu, p₀, w, rfl, hp₀, hw⟩ hst
    refine ⟨G.legal_of_prefix ht hst, u, hu, ?_⟩
    obtain ⟨r, hr⟩ := hst
    rcases List.append_eq_append_iff.1 hr with ⟨a', h₁, -⟩ | ⟨c', h₁, h₂⟩
    · exact ⟨s, [], by simp, (h₁ ▸ List.prefix_append s a').trans hp₀, by simp⟩
    · exact ⟨p₀, c', h₁, hp₀, fun o ho => hw o (h₂ ▸ List.mem_append_left _ ho)⟩
  receptive := by
    rintro s o ⟨-, u, hu, p₀, w, rfl, hp₀, hw⟩ hl ho
    refine ⟨hl, u, hu, p₀, w ++ [o], by simp, hp₀, ?_⟩
    intro o' ho'
    rcases List.mem_append.1 ho' with h | h
    · exact hw o' h
    · rw [List.mem_singleton.1 h]; exact ho

end Game

/-- A trace model of the game `G`: a set of plays satisfying the closure
conditions (`Game.Closed`). -/
structure TraceModel (G : Game.{u}) : Type u where
  /-- The plays. -/
  plays : Set (List G.Move)
  /-- The closure conditions. -/
  closed : G.Closed plays

namespace TraceModel

variable {G : Game.{u}}

/-- A trace model is its set of plays. -/
instance : SetLike (TraceModel G) (List G.Move) where
  coe T := T.plays
  coe_injective T U h := by cases T; cases U; congr

/-- Membership in `plays` is membership in the model. -/
@[simp] theorem mem_plays {T : TraceModel G} {s : List G.Move} : s ∈ T.plays ↔ s ∈ T :=
  Iff.rfl

/-- Models with the same plays are equal. -/
@[ext] theorem ext {T U : TraceModel G} (h : ∀ s, s ∈ T ↔ s ∈ U) : T = U := SetLike.ext h

/-- Refinement is inclusion of plays: `T ≤ U` says every behaviour of `T` is
allowed by `U`. -/
instance : PartialOrder (TraceModel G) where
  le T U := ∀ ⦃s⦄, s ∈ T → s ∈ U
  le_refl _ _ h := h
  le_trans _ _ _ h₁ h₂ _ h := h₂ (h₁ h)
  le_antisymm _ _ h₁ h₂ := SetLike.ext fun _ => ⟨fun h => h₁ h, fun h => h₂ h⟩

/-- Unfolding the order. -/
theorem le_def {T U : TraceModel G} : T ≤ U ↔ ∀ ⦃s⦄, s ∈ T → s ∈ U := Iff.rfl

/-- The model generated by a set of plays: the least model containing its legal
plays (`Silmaril.Games.Abstract.TraceModel.generate_le_iff`). -/
def generate (S : Set (List G.Move)) : TraceModel G := ⟨G.generateSet S, G.closed_generateSet S⟩

/-- Meets are intersections (with the legal plays, for the empty meet). -/
instance : InfSet (TraceModel G) where
  sInf S := ⟨{p | p ∈ G.Legal ∧ ∀ T ∈ S, p ∈ T}, {
    nil_mem := ⟨G.nil_legal, fun T _ => T.closed.nil_mem⟩
    legal := fun h => h.1
    of_prefix := fun ⟨ht, h⟩ hst =>
      ⟨G.legal_of_prefix ht hst, fun T hT => T.closed.of_prefix (h T hT) hst⟩
    receptive := fun ⟨_, h⟩ hl ho => ⟨hl, fun T hT => T.closed.receptive (h T hT) hl ho⟩ }⟩

/-- Membership in a meet. -/
theorem mem_sInf {S : Set (TraceModel G)} {p : List G.Move} :
    p ∈ sInf S ↔ p ∈ G.Legal ∧ ∀ T ∈ S, p ∈ T := Iff.rfl

/-- `sInf S` is the greatest lower bound of `S`. -/
theorem isGLB_sInf (S : Set (TraceModel G)) : IsGLB S (sInf S) :=
  ⟨fun _ hT _ hp => hp.2 _ hT,
    fun U hU _ hp => ⟨U.closed.legal hp, fun _ hT => hU hT hp⟩⟩

/-- Trace models form a complete lattice. The joins are characterised in
`Silmaril.Games.Abstract.TraceModel.sSup_eq_generate`. -/
instance : CompleteLattice (TraceModel G) := completeLatticeOfInf _ isGLB_sInf

/-- Determinism of the component's choices: after any play, at most one
Proponent move can follow. Opponent moves are not constrained. -/
def Det (T : TraceModel G) : Prop :=
  ∀ ⦃s p q⦄, s ++ [p] ∈ T → s ++ [q] ∈ T → ¬ G.IsO p → ¬ G.IsO q → p = q

/-- Determinism up to exceptional moves `X` (for Wasm: trapping answers):
after a play with no `X` move, two Proponent continuations are equal or one of
them is in `X`. Plays after an exceptional move are not constrained. -/
def DetUpTo (X : G.Move → Prop) (T : TraceModel G) : Prop :=
  ∀ ⦃s p q⦄, s ++ [p] ∈ T → s ++ [q] ∈ T → ¬ G.IsO p → ¬ G.IsO q → (∀ m ∈ s, ¬ X m) →
    p = q ∨ X p ∨ X q

end TraceModel

namespace Game

/-- A morphism of games: a map of moves that sends legal plays to legal plays
and Opponent moves to Opponent moves. Trace models pull back along it. -/
structure Hom (G : Game.{u}) (H : Game.{v}) where
  /-- The map of moves. -/
  map : G.Move → H.Move
  /-- Legal plays map to legal plays. -/
  legal : ∀ {s}, s ∈ G.Legal → s.map map ∈ H.Legal
  /-- Opponent moves map to Opponent moves. -/
  isO : ∀ {m}, G.IsO m → H.IsO (map m)

namespace Hom

/-- The identity morphism. -/
def id (G : Game.{u}) : Hom G G := ⟨fun m => m, fun h => by simpa using h, fun h => h⟩

/-- Composition (diagrammatic order: first `f`, then `g`). -/
def comp {G : Game.{u}} {H : Game.{v}} {K : Game.{w}} (f : Hom G H) (g : Hom H K) : Hom G K :=
  ⟨fun m => g.map (f.map m), fun h => by simpa [Function.comp_def] using g.legal (f.legal h),
    fun h => g.isO (f.isO h)⟩

end Hom

end Game

namespace TraceModel

variable {G : Game.{u}} {H : Game.{v}}

/-- Pullback of a trace model along a game morphism: the legal plays of `G`
whose image is a play of `T`. This is how a coarser observer, who sees `G`
through `f`, reads `T`. -/
def comap (f : G.Hom H) (T : TraceModel H) : TraceModel G where
  plays := {s | s ∈ G.Legal ∧ s.map f.map ∈ T}
  closed := {
    nil_mem := ⟨G.nil_legal, T.closed.nil_mem⟩
    legal := fun h => h.1
    of_prefix := fun ⟨ht, h⟩ hst =>
      ⟨G.legal_of_prefix ht hst, T.closed.of_prefix h (hst.map f.map)⟩
    receptive := fun {s o} ⟨_, h⟩ hl ho => ⟨hl, by
      have := T.closed.receptive h (by simpa using f.legal hl) (f.isO ho)
      simpa using this⟩ }

/-- Pushforward: the model generated by the images of the plays of `T`. -/
def map (f : G.Hom H) (T : TraceModel G) : TraceModel H :=
  generate ((List.map f.map) '' (T : Set (List G.Move)))

end TraceModel

end Silmaril.Games.Abstract
