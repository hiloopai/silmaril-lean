module

public import Silmaril.Games.Strategy.Defs
public import Mathlib.Order.CompleteLattice.Basic
import Silmaril.Proofs.Games.Strategy.Lattice

/-!
# The lattice of strategies

Membership in the lattice operations:

* `⊤` contains every legal play (`mem_top`);
* `⊥` is the strategy that never moves: it contains the empty play and the
  one-move plays in which Opponent asks a question (`mem_bot`);
* meets are intersections (`mem_sInf`, `mem_inf`);
* joins are unions together with `⊥` (`mem_sSup`), hence plain unions for
  nonempty families (`mem_sSup_of_nonempty`, `mem_sup`).

The longer proofs are in `Silmaril.Proofs.Games.Strategy.Lattice`.
-/

public section

namespace Silmaril.Games.Strategy

universe u

variable {E F : Sig.{u}}

/-- Unfolding `generate`. -/
theorem mem_generate {S : Set (List (Move E F))} {p : List (Move E F)} :
    p ∈ generate S ↔ p ∈ generatePlays S := Iff.rfl

/-- The top strategy contains every legal play. -/
theorem mem_top {p : List (Move E F)} : p ∈ (⊤ : Strategy E F) ↔ Legal p := by
  rw [← sInf_empty, mem_sInf]
  simp

/-- Binary meets are intersections. -/
theorem mem_inf {σ τ : Strategy E F} {p : List (Move E F)} : p ∈ σ ⊓ τ ↔ p ∈ σ ∧ p ∈ τ :=
  Silmaril.Proofs.Games.Strategy.mem_inf

/-- The bottom strategy is generated by no play. -/
theorem bot_eq_generate : (⊥ : Strategy E F) = generate ∅ :=
  Silmaril.Proofs.Games.Strategy.bot_eq_generate

/-- The bottom strategy never moves: it only lets Opponent ask a first question. -/
theorem mem_bot {p : List (Move E F)} :
    p ∈ (⊥ : Strategy E F) ↔ p = [] ∨ ∃ q, p = [.inr (.ask q)] :=
  Silmaril.Proofs.Games.Strategy.mem_bot

/-- Plays of `⊥` belong to every strategy. -/
theorem bot_le_of_mem {σ : Strategy E F} {p : List (Move E F)} (h : p ∈ (⊥ : Strategy E F)) :
    p ∈ σ := (bot_le : ⊥ ≤ σ) h

/-- The plays of a join: those of `⊥` and of the joined strategies. -/
theorem mem_sSup {S : Set (Strategy E F)} {p : List (Move E F)} :
    p ∈ sSup S ↔ p ∈ (⊥ : Strategy E F) ∨ ∃ σ ∈ S, p ∈ σ :=
  Silmaril.Proofs.Games.Strategy.mem_sSup

/-- Nonempty joins are unions. -/
theorem mem_sSup_of_nonempty {S : Set (Strategy E F)} (hS : S.Nonempty)
    {p : List (Move E F)} : p ∈ sSup S ↔ ∃ σ ∈ S, p ∈ σ :=
  Silmaril.Proofs.Games.Strategy.mem_sSup_of_nonempty hS

/-- Binary joins are unions. -/
theorem mem_sup {σ τ : Strategy E F} {p : List (Move E F)} : p ∈ σ ⊔ τ ↔ p ∈ σ ∨ p ∈ τ := by
  rw [← sSup_pair, mem_sSup_of_nonempty (Set.insert_nonempty _ _)]
  simp

end Silmaril.Games.Strategy
