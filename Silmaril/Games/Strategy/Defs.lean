module

public import Silmaril.Games.Play.Defs
public import Mathlib.Basic.SetLike.Basic
public import Mathlib.Order.CompleteLattice.Defs

/-!
# Strategies for `E ↠ F` and refinement

A strategy `σ : Strategy E F` is a set of legal plays of `E ↠ F` that

* contains the empty play,
* is closed under prefixes, and
* is *receptive*: it accepts every legal Opponent move after any of its plays.

This is the angelic ("may", downset) model `D` of Koenig and Shao (LICS 2020,
§3.1), presented over whole plays of the multi-question game `!E ⊸ !F` rather
than per question; a strategy may keep state from one `F`-question to the
next. Receptiveness is the play-level form of their convention that Opponent
moves are not constrained by the strategy (their plays end with Proponent
moves). It is what makes copycat a two-sided unit
(`Silmaril.Games.Composition.Thms`), because copycat may have received an
Opponent move that it has not yet forwarded.

## What is (not) observed

Plays are finite, and a strategy is the set of its finite behaviours. A
strategy that has stopped responding (deadlock), one that computes forever
without an observable move (silent divergence), and one that is merely still
computing are indistinguishable: the model observes safety (which moves may
happen) and not liveness. In particular composition hides internal
divergence (an infinite chatter between the two components shows up as the
play reached before it began), and the least strategy `⊥` is the component
that never answers. Refinement `σ ⊑ τ` is plain inclusion of plays ("every
behaviour of `σ` is allowed by `τ`"); strategies form a complete lattice under
it, with joins as angelic choice.
-/

@[expose] public section

namespace Silmaril.Games

universe u

/-- A strategy for the game `E ↠ F`: a nonempty, prefix-closed, receptive set
of legal plays. -/
structure Strategy (E F : Sig.{u}) : Type u where
  /-- The plays the strategy may produce. -/
  plays : Set (List (Move E F))
  /-- The empty play belongs to every strategy. -/
  nil_mem : [] ∈ plays
  /-- Every play is legal. -/
  legal : ∀ {s}, s ∈ plays → Legal s
  /-- Plays are closed under prefixes. -/
  of_prefix : ∀ {s t}, t ∈ plays → s <+: t → s ∈ plays
  /-- Every legal Opponent move is accepted. -/
  receptive : ∀ {s x y o}, s ∈ plays → Path .idle s x → Step x o y → Move.IsO o →
    s ++ [o] ∈ plays

namespace Strategy

variable {E F : Sig.{u}}

/-- A strategy is its set of plays. -/
instance : SetLike (Strategy E F) (List (Move E F)) where
  coe σ := σ.plays
  coe_injective σ τ h := by cases σ; cases τ; congr

/-- Membership in `plays` is membership in the strategy. -/
@[simp] theorem mem_plays {σ : Strategy E F} {s : List (Move E F)} : s ∈ σ.plays ↔ s ∈ σ :=
  Iff.rfl

/-- Strategies with the same plays are equal. -/
@[ext] theorem ext {σ τ : Strategy E F} (h : ∀ s, s ∈ σ ↔ s ∈ τ) : σ = τ := SetLike.ext h

/-- Refinement: every play of `σ` is a play of `τ`. Read `σ.Refines τ` as "`σ`
refines `τ`" or "`σ ⊑ τ`"; it is the order `σ ≤ τ` of the lattice. -/
protected def Refines (σ τ : Strategy E F) : Prop := ∀ ⦃s⦄, s ∈ σ → s ∈ τ

/-- Strategies are ordered by refinement. -/
instance : PartialOrder (Strategy E F) where
  le := Strategy.Refines
  le_refl _ _ h := h
  le_trans _ _ _ h₁ h₂ _ h := h₂ (h₁ h)
  le_antisymm _ _ h₁ h₂ := SetLike.ext fun _ => ⟨fun h => h₁ h, fun h => h₂ h⟩

/-- Refinement is the order of strategies. -/
theorem refines_iff_le {σ τ : Strategy E F} : σ.Refines τ ↔ σ ≤ τ := Iff.rfl

/-- Unfolding the order. -/
theorem le_def {σ τ : Strategy E F} : σ ≤ τ ↔ ∀ ⦃s⦄, s ∈ σ → s ∈ τ := Iff.rfl

/-! ## The strategy generated by a set of plays -/

/-- The plays of `generate S`: legal prefixes of legal plays of `S` (or of the
empty play), possibly followed by one Opponent move. -/
def generatePlays (S : Set (List (Move E F))) : Set (List (Move E F)) :=
  {p | Legal p ∧ ∃ s, (s = [] ∨ (s ∈ S ∧ Legal s)) ∧
    (p <+: s ∨ ∃ p₀ o, p = p₀ ++ [o] ∧ p₀ <+: s ∧ Move.IsO o)}

/-- The least strategy containing the legal plays of `S`. -/
def generate (S : Set (List (Move E F))) : Strategy E F where
  plays := generatePlays S
  nil_mem := ⟨Legal.nil, [], .inl rfl, .inl (List.nil_prefix)⟩
  legal h := h.1
  of_prefix := by
    rintro s t ⟨ht, u, hu, hp⟩ hst
    refine ⟨ht.of_prefix hst, u, hu, ?_⟩
    rcases hp with hp | ⟨p₀, o, rfl, hp₀, ho⟩
    · exact .inl (hst.trans hp)
    · rcases List.prefix_concat_iff.1 hst with rfl | h
      · exact .inr ⟨p₀, o, rfl, hp₀, ho⟩
      · exact .inl (h.trans hp₀)
  receptive := by
    rintro s x y o ⟨hs, u, hu, hp⟩ hx hxy ho
    refine ⟨⟨y, hx.append (Path.single hxy)⟩, u, hu, ?_⟩
    rcases hp with hp | ⟨p₀, o', rfl, -, ho'⟩
    · exact .inr ⟨s, o, rfl, hp, ho⟩
    · exfalso
      obtain ⟨x', -, hx'⟩ := Path.concat_iff.1 hx
      exact Move.not_isO_of_isP (hx'.isP_of_isO ho' hxy) ho

/-- Every legal play of `S` is a play of `generate S`. -/
theorem subset_generate {S : Set (List (Move E F))} {s : List (Move E F)} (hs : s ∈ S)
    (hl : Legal s) : s ∈ generate S :=
  ⟨hl, s, .inr ⟨hs, hl⟩, .inl (List.prefix_refl s)⟩

/-- `generate S` is the least strategy containing the legal plays of `S`. -/
theorem generate_le {S : Set (List (Move E F))} {τ : Strategy E F}
    (h : ∀ s ∈ S, Legal s → s ∈ τ) : generate S ≤ τ := by
  rintro p ⟨hpl, u, hu, hp⟩
  have hu' : u ∈ τ := by
    rcases hu with rfl | ⟨hu, hl⟩
    · exact τ.nil_mem
    · exact h u hu hl
  rcases hp with hp | ⟨p₀, o, rfl, hp₀, ho⟩
  · exact τ.of_prefix hu' hp
  · obtain ⟨_, hpath⟩ := hpl
    obtain ⟨x, hx, hxo⟩ := Path.concat_iff.1 hpath
    exact τ.receptive (τ.of_prefix hu' hp₀) hx hxo ho

/-- `generate` is monotone. -/
theorem generate_mono {S T : Set (List (Move E F))} (h : S ⊆ T) : generate S ≤ generate T :=
  generate_le fun _ hs hl => subset_generate (h hs) hl

/-! ## The complete lattice of strategies -/

/-- Meets are intersections (the empty meet is the set of all legal plays). -/
instance : InfSet (Strategy E F) where
  sInf S :=
    { plays := {p | Legal p ∧ ∀ σ ∈ S, p ∈ σ}
      nil_mem := ⟨Legal.nil, fun σ _ => σ.nil_mem⟩
      legal h := h.1
      of_prefix := fun ⟨hl, h⟩ hst => ⟨hl.of_prefix hst, fun σ hσ => σ.of_prefix (h σ hσ) hst⟩
      receptive := fun ⟨_, h⟩ hx hxy ho =>
        ⟨⟨_, hx.append (Path.single hxy)⟩, fun σ hσ => σ.receptive (h σ hσ) hx hxy ho⟩ }

/-- The plays of a meet. -/
theorem mem_sInf {S : Set (Strategy E F)} {p : List (Move E F)} :
    p ∈ sInf S ↔ Legal p ∧ ∀ σ ∈ S, p ∈ σ := Iff.rfl

/-- Intersections are greatest lower bounds. -/
theorem isGLB_sInf (S : Set (Strategy E F)) : IsGLB S (sInf S) :=
  ⟨fun σ hσ _ h => h.2 σ hσ, fun τ hτ _ hp => ⟨τ.legal hp, fun _ hσ => hτ hσ hp⟩⟩

/-- Strategies form a complete lattice under refinement. Joins are generated by
unions: `sSup S = generate (⋃ σ ∈ S, σ)`. -/
instance : CompleteLattice (Strategy E F) :=
  { completeLatticeOfInf (Strategy E F) isGLB_sInf with
    sSup := fun S => generate {p | ∃ σ ∈ S, p ∈ σ}
    isLUB_sSup := fun _ =>
      ⟨fun σ hσ _ hp => subset_generate ⟨σ, hσ, hp⟩ (σ.legal hp),
        fun _ hτ => generate_le fun _ ⟨_, hσ, hp⟩ _ => hτ hσ hp⟩ }

/-- Joins are generated by unions. -/
theorem sSup_def (S : Set (Strategy E F)) : sSup S = generate {p | ∃ σ ∈ S, p ∈ σ} := rfl

end Strategy

end Silmaril.Games
