module

public import Silmaril.Games.Strategy.Defs
public import Mathlib.Logic.Relation

/-!
# Strategies of transition systems and reduction semantics

Operational descriptions of a component `E ↠ F` denote strategies through
their observable traces.

* `LTS E F`: a labelled transition system whose visible labels are the moves
  of `E ↠ F` and whose silent steps are labelled `none`. Its state may persist
  across `F`-questions (memory, globals, …). Opponent moves are inputs: an LTS
  that refuses one is completed by receptiveness.
* `Strategy.ofLTS L`: the strategy generated by the traces of `L` from its
  initial state (`Strategy.generate`). Silent steps are not observed, so
  internal divergence is invisible (`Silmaril.Games.Strategy.Defs`).
* `Reduction E F`: a small-step reduction semantics with external calls, the
  shape in which language semantics are usually given: a configuration type
  for each `F`-question, an initial configuration per question, internal
  reduction, configurations that call `m : E.Op` and resume with the answer
  through a continuation, and final configurations returning an answer. Each
  `F`-question starts afresh (no state persists between questions; use `LTS`
  directly for that). `Reduction.toLTS` is its transition system.
* `LTS.Simulation` and `Reduction.Simulation`: weak forward simulations. A
  simulation implies refinement of the strategies
  (`Silmaril.Games.LTS.Thms`), which is how reduction semantics are compared with
  game semantics.
-/

@[expose] public section

namespace Silmaril.Games

universe u

/-- A labelled transition system over the moves of `E ↠ F`, with silent steps
labelled `none`. -/
structure LTS (E F : Sig.{u}) : Type (u + 1) where
  /-- States. -/
  State : Type u
  /-- The initial state. -/
  init : State
  /-- Transitions: silent (`none`) or labelled by a move. -/
  step : State → Option (Move E F) → State → Prop

namespace LTS

variable {E F : Sig.{u}}

/-- `L.Run x s y`: from `x`, the system can reach `y` performing the visible
moves `s`, with any silent steps in between. -/
inductive Run (L : LTS E F) : L.State → List (Move E F) → L.State → Prop
  /-- No step. -/
  | nil (x : L.State) : Run L x [] x
  /-- A silent step. -/
  | tau {x y z : L.State} {s : List (Move E F)} : L.step x none y → Run L y s z → Run L x s z
  /-- A visible step. -/
  | vis {x y z : L.State} {o : Move E F} {s : List (Move E F)} :
      L.step x (some o) y → Run L y s z → Run L x (o :: s) z

/-- The traces of `L`: the visible behaviours from the initial state. -/
def Traces (L : LTS E F) : Set (List (Move E F)) := {s | ∃ y, L.Run L.init s y}

/-- A weak forward simulation: each step of `L₁` is matched by a run of `L₂`
with the same visible label. -/
structure Simulation (L₁ L₂ : LTS E F) where
  /-- The simulation relation. -/
  R : L₁.State → L₂.State → Prop
  /-- Initial states are related. -/
  init : R L₁.init L₂.init
  /-- Steps are matched. -/
  step : ∀ {x x' : L₁.State} {y : L₂.State} {l : Option (Move E F)},
    R x y → L₁.step x l x' → ∃ y', L₂.Run y l.toList y' ∧ R x' y'

end LTS

/-- The strategy of a transition system: generated by its traces. -/
def Strategy.ofLTS {E F : Sig.{u}} (L : LTS E F) : Strategy E F :=
  Strategy.generate L.Traces

/-- A small-step reduction semantics of a component `E ↠ F` with external
calls; see the module documentation. -/
structure Reduction (E F : Sig.{u}) : Type (u + 1) where
  /-- Configurations of a run answering the question `q`. -/
  Conf : F.Op → Type u
  /-- The initial configuration for the question `q`. -/
  start : (q : F.Op) → Conf q
  /-- Internal (silent) reduction. -/
  step : {q : F.Op} → Conf q → Conf q → Prop
  /-- `call c m k`: `c` calls `m` and continues with `k n` on the answer `n`. -/
  call : {q : F.Op} → Conf q → (m : E.Op) → (E.Ar m → Conf q) → Prop
  /-- `done c r`: `c` is final and answers `r`. -/
  done : {q : F.Op} → Conf q → F.Ar q → Prop

namespace Reduction

variable {E F : Sig.{u}}

/-- States of the transition system of a reduction semantics. -/
inductive State (R : Reduction E F) : Type u
  /-- Between questions. -/
  | idle
  /-- Answering `q` in configuration `c`. -/
  | run (q : F.Op) (c : R.Conf q)
  /-- Answering `q`, waiting for the answer to the call `m`. -/
  | wait (q : F.Op) (m : E.Op) (k : E.Ar m → R.Conf q)

/-- Transitions of the transition system of a reduction semantics. -/
inductive Step (R : Reduction E F) : R.State → Option (Move E F) → R.State → Prop
  /-- Accept a question: start a run. -/
  | ask (q : F.Op) : Step R .idle (some (.inr (.ask q))) (.run q (R.start q))
  /-- Internal reduction. -/
  | tau {q : F.Op} {c c' : R.Conf q} : R.step c c' → Step R (.run q c) none (.run q c')
  /-- Call below. -/
  | call {q : F.Op} {c : R.Conf q} {m : E.Op} {k : E.Ar m → R.Conf q} :
      R.call c m k → Step R (.run q c) (some (.inl (.ask m))) (.wait q m k)
  /-- Resume with the answer. -/
  | resume (q : F.Op) (m : E.Op) (k : E.Ar m → R.Conf q) (n : E.Ar m) :
      Step R (.wait q m k) (some (.inl (.ans m n))) (.run q (k n))
  /-- Return the answer. -/
  | ret {q : F.Op} {c : R.Conf q} {r : F.Ar q} :
      R.done c r → Step R (.run q c) (some (.inr (.ans q r))) .idle

/-- The transition system of a reduction semantics. -/
@[reducible] def toLTS (R : Reduction E F) : LTS E F := ⟨R.State, .idle, R.Step⟩

/-- A weak forward simulation between reduction semantics, question by
question: related configurations reduce, call and return alike, up to internal
reduction of the simulating side. -/
structure Simulation (R₁ R₂ : Reduction E F) where
  /-- The simulation relation on configurations. -/
  rel : {q : F.Op} → R₁.Conf q → R₂.Conf q → Prop
  /-- Initial configurations are related. -/
  start : ∀ q, rel (R₁.start q) (R₂.start q)
  /-- Internal reduction is matched by zero or more internal reductions. -/
  step : ∀ {q} {c c' : R₁.Conf q} {d : R₂.Conf q}, rel c d → R₁.step c c' →
    ∃ d', Relation.ReflTransGen R₂.step d d' ∧ rel c' d'
  /-- Calls are matched, with related continuations. -/
  call : ∀ {q} {c : R₁.Conf q} {d : R₂.Conf q} {m : E.Op} {k : E.Ar m → R₁.Conf q},
    rel c d → R₁.call c m k →
    ∃ d', Relation.ReflTransGen R₂.step d d' ∧ ∃ k', R₂.call d' m k' ∧ ∀ n, rel (k n) (k' n)
  /-- Returns are matched. -/
  done : ∀ {q} {c : R₁.Conf q} {d : R₂.Conf q} {r : F.Ar q}, rel c d → R₁.done c r →
    ∃ d', Relation.ReflTransGen R₂.step d d' ∧ R₂.done d' r

end Reduction

/-! ## Transition systems of strategies, composition and pairing -/

/-- Transitions of the transition system of a strategy: extend the play. -/
inductive Strategy.TStep {E F : Sig.{u}} (σ : Strategy E F) :
    List (Move E F) → Option (Move E F) → List (Move E F) → Prop
  /-- Extend a play by a move. -/
  | mk (s : List (Move E F)) (o : Move E F) : s ++ [o] ∈ σ → TStep σ s (some o) (s ++ [o])

/-- The transition system of a strategy: its states are its plays. -/
@[reducible] def Strategy.toLTS {E F : Sig.{u}} (σ : Strategy E F) : LTS E F := ⟨List (Move E F), [], σ.TStep⟩

namespace LTS

variable {E F G F₁ F₂ : Sig.{u}}

/-- Transitions of the parallel composition of two transition systems, with
the shared interface hidden. -/
inductive CompStep (L₁ : LTS E F) (L₂ : LTS F G) :
    L₁.State × L₂.State → Option (Move E G) → L₁.State × L₂.State → Prop
  /-- A silent step of the lower system. -/
  | tau₁ {x x' : L₁.State} {y : L₂.State} : L₁.step x none x' → CompStep L₁ L₂ (x, y) none (x', y)
  /-- A silent step of the upper system. -/
  | tau₂ {x : L₁.State} {y y' : L₂.State} : L₂.step y none y' → CompStep L₁ L₂ (x, y) none (x, y')
  /-- A visible lower move. -/
  | left {x x' : L₁.State} {y : L₂.State} (e : Ev E) :
      L₁.step x (some (.inl e)) x' → CompStep L₁ L₂ (x, y) (some (.inl e)) (x', y)
  /-- A visible upper move. -/
  | right {x : L₁.State} {y y' : L₂.State} (g : Ev G) :
      L₂.step y (some (.inr g)) y' → CompStep L₁ L₂ (x, y) (some (.inr g)) (x, y')
  /-- A hidden synchronisation on the shared interface. -/
  | sync {x x' : L₁.State} {y y' : L₂.State} (f : Ev F) :
      L₁.step x (some (.inr f)) x' → L₂.step y (some (.inl f)) y' →
      CompStep L₁ L₂ (x, y) none (x', y')

/-- The parallel composition of transition systems, hiding the shared
interface; it denotes `Strategy.comp` (`LTS.Denotes.comp`). -/
def comp (L₁ : LTS E F) (L₂ : LTS F G) : LTS E G :=
  ⟨L₁.State × L₂.State, (L₁.init, L₂.init), CompStep L₁ L₂⟩

/-- Transitions of the pairing of two transition systems: each round goes to
the side of its question; the game position is tracked. -/
inductive PairStep (L₁ : LTS E F₁) (L₂ : LTS E F₂) :
    Pos E (F₁ ⊕ₛ F₂) × L₁.State × L₂.State → Option (Move E (F₁ ⊕ₛ F₂)) →
    Pos E (F₁ ⊕ₛ F₂) × L₁.State × L₂.State → Prop
  /-- A silent step of the left system. -/
  | tau₁ {p : Pos E (F₁ ⊕ₛ F₂)} {x x' : L₁.State} {y : L₂.State} :
      L₁.step x none x' → PairStep L₁ L₂ (p, x, y) none (p, x', y)
  /-- A silent step of the right system. -/
  | tau₂ {p : Pos E (F₁ ⊕ₛ F₂)} {x : L₁.State} {y y' : L₂.State} :
      L₂.step y none y' → PairStep L₁ L₂ (p, x, y) none (p, x, y')
  /-- A left question. -/
  | askL {x x' : L₁.State} {y : L₂.State} (q : F₁.Op) :
      L₁.step x (some (.inr (.ask q))) x' →
      PairStep L₁ L₂ (.idle, x, y) (some (.inr (.ask (.inl q)))) (.run (.inl q), x', y)
  /-- A call during a left round. -/
  | callL {x x' : L₁.State} {y : L₂.State} (q : F₁.Op) (m : E.Op) :
      L₁.step x (some (.inl (.ask m))) x' →
      PairStep L₁ L₂ (.run (.inl q), x, y) (some (.inl (.ask m))) (.wait (.inl q) m, x', y)
  /-- An answer to a call during a left round. -/
  | replyL {x x' : L₁.State} {y : L₂.State} (q : F₁.Op) (m : E.Op) (n : E.Ar m) :
      L₁.step x (some (.inl (.ans m n))) x' →
      PairStep L₁ L₂ (.wait (.inl q) m, x, y) (some (.inl (.ans m n))) (.run (.inl q), x', y)
  /-- The answer to a left question. -/
  | retL {x x' : L₁.State} {y : L₂.State} (q : F₁.Op) (r : F₁.Ar q) :
      L₁.step x (some (.inr (.ans q r))) x' →
      PairStep L₁ L₂ (.run (.inl q), x, y) (some (.inr (.ans (.inl q) r))) (.idle, x', y)
  /-- A right question. -/
  | askR {x : L₁.State} {y y' : L₂.State} (q : F₂.Op) :
      L₂.step y (some (.inr (.ask q))) y' →
      PairStep L₁ L₂ (.idle, x, y) (some (.inr (.ask (.inr q)))) (.run (.inr q), x, y')
  /-- A call during a right round. -/
  | callR {x : L₁.State} {y y' : L₂.State} (q : F₂.Op) (m : E.Op) :
      L₂.step y (some (.inl (.ask m))) y' →
      PairStep L₁ L₂ (.run (.inr q), x, y) (some (.inl (.ask m))) (.wait (.inr q) m, x, y')
  /-- An answer to a call during a right round. -/
  | replyR {x : L₁.State} {y y' : L₂.State} (q : F₂.Op) (m : E.Op) (n : E.Ar m) :
      L₂.step y (some (.inl (.ans m n))) y' →
      PairStep L₁ L₂ (.wait (.inr q) m, x, y) (some (.inl (.ans m n))) (.run (.inr q), x, y')
  /-- The answer to a right question. -/
  | retR {x : L₁.State} {y y' : L₂.State} (q : F₂.Op) (r : F₂.Ar q) :
      L₂.step y (some (.inr (.ans q r))) y' →
      PairStep L₁ L₂ (.run (.inr q), x, y) (some (.inr (.ans (.inr q) r))) (.idle, x, y')

/-- The pairing of transition systems; it denotes `Strategy.pair`
(`LTS.Denotes.pair`). -/
def pair (L₁ : LTS E F₁) (L₂ : LTS E F₂) : LTS E (F₁ ⊕ₛ F₂) :=
  ⟨Pos E (F₁ ⊕ₛ F₂) × L₁.State × L₂.State, (.idle, L₁.init, L₂.init), PairStep L₁ L₂⟩

/-- `L` denotes `σ`: the traces of `L` are exactly the plays of `σ`. -/
def Denotes (L : LTS E F) (σ : Strategy E F) : Prop := ∀ p, p ∈ L.Traces ↔ p ∈ σ

end LTS

/-- The strategy of a reduction semantics. -/
def Strategy.ofReduction {E F : Sig.{u}} (R : Reduction E F) : Strategy E F :=
  Strategy.ofLTS R.toLTS

end Silmaril.Games
