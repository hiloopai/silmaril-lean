module

public import Silmaril.Numeric.Ieee754.Std.TestFloat
public meta import Silmaril.Numeric.Ieee754.Std.TestFloat

/-!
# Build-time vector checks

A sample of the Berkeley TestFloat 3e level-1 vectors (generated by
`testfloat_gen` from SoftFloat 3e's `8086-SSE`, `RISCV` and `8086`
specializations) and of the same operands recomputed on x86 hardware
(an Intel i7-8700: SSE/AVX/FMA/F16C and x87), checked with `#guard` against the
`Std` profiles. Each block is `ISA FUNCTION MODE EXACT PRECISION TININESS`
followed by vectors. The full level-1 runs are made by
`scripts/ieee754/testfloat-check.sh` and `scripts/ieee754/x86-hw-check.sh`
(both keep every 32nd `mulAdd` vector) and, for every `mulAdd` vector with a NaN
operand, `scripts/ieee754/fma-nan-check.sh` (SoftFloat and x86 hardware).

Kernel-checked (`decide +kernel`) samples are in `Std.KernelExamples`; the same
operands are compared with the older implementations in `Std.BridgeTests`.
-/

@[expose] public section

namespace Silmaril.Numeric.Ieee754.Std.Vectors

open Silmaril.Numeric.Ieee754 Silmaril.Numeric.Ieee754.Std TestFloat

/-- Check every block of a vector text; returns the failing lines. -/
def checkBlocks (text : String) : List String := Id.run do
  let mut bad : List String := []
  let mut cfg : Option Config := none
  for line in text.splitOn "\n" do
    if line.all Char.isWhitespace then continue
    if line.startsWith "#" then
      let w := ((line.drop 1).toString.splitOn " ").filter (· ≠ "")
      cfg := match w with
        | [isaName, fn, modeName, exactName, prec, tinName] => do
          let isa ← isa? isaName
          let mode ← mode? modeName
          let tin : TininessDetection :=
            if tinName == "before" then .beforeRounding else .afterRounding
          pure { isa := { isa with tin }, fn, mode, exact := exactName == "exact",
                 precision := (match prec with | "32" => 24 | "64" => 53 | _ => 64),
                 reading := if isaName == "x87hw" then .hardware else .softfloat }
        | _ => none
      if cfg.isNone then bad := line :: bad
    else
      match cfg with
      | none => bad := line :: bad
      | some c => if checkLine c line != some true then bad := line :: bad
  return bad

