module

public import Silmaril.ProofFormats.LeanNDJSON.Arithmetic.Thms
public import Silmaril.Logic.Consequence.Arithmetic.Derivation.Exported
public meta import Silmaril.ProofFormats.LeanNDJSON.Arithmetic.Thms
public meta import Silmaril.Logic.Consequence.Arithmetic.Derivation.Exported

/-!
# PA proofs from a real lean4export file

The fixture `tests/lean-ndjson/pa-derivations.ndjson` is lean4export's output (format 3.1.0, no
options) for the proof declarations of `…Arithmetic.Derivation.Exported` and for
`Examples.zeroAdd`, with all their dependencies (14 636 records, regenerated by
`scripts/lean-ndjson/export-fixtures.sh`). The checks below read it at build time:

* **accepted**, with the conclusion of the Lean proof object: `zeroAddZero` (Q and PA),
  `instAddZero` and `eqSymm` (Q), `zeroAdd` (PA, by induction);
* **rejected by the checker**: `zeroAdd` in Q (induction is not a Q axiom), `wrongAxiom`;
* **refused before checking**: `Examples.zeroAdd` (an unsupported encoding: `closed` applied to an
  argument), `Exported.body` (a formula, not a proof: rejected as syntax), a theorem, a library
  function (`Nat.add`, a λ-abstraction), a missing name;
* **mutations of the real file**, each refused with its reason: a duplicated record, a forward
  reference, a self-reference (a cycle), an unknown field, an `mdata` record, a wrong format
  version, an empty line, and the proof declaration turned into an axiom;
* **the declared type is not evidence**: replacing the proof's declared type with an unrelated
  expression changes nothing, while replacing its value with another proof's value changes the
  conclusion.
-/

public section

namespace Silmaril.ProofFormats.LeanNDJSON.Arithmetic.Examples

open Silmaril.Formats.LeanNDJSON Silmaril.Consequence Silmaril.Consequence.Arithmetic.ND

/-- The fixture, relative to the repository root. -/
def fixture : String := "tests/lean-ndjson/pa-derivations.ndjson"

/-- A declaration's full name. -/
def ex (n : String) : String := "Silmaril.Consequence.Arithmetic.ND.Exported." ++ n

meta def expect (what : String) (ok : Bool) : IO Unit :=
  unless ok do throw (IO.userError s!"Lean-NDJSON regression: {what}")

meta def accepted (T : Theory) (es : List Event) (d : String) (s : Seq) : IO Unit :=
  expect s!"{d} accepted" (importCheckFrom T es d == .ok s)

meta def rejectedBy (T : Theory) (es : List Event) (d : String) (p : ImportError → Bool) : IO Unit :=
  expect s!"{d} refused" (match importCheckFrom T es d with | .error e => p e | .ok _ => false)

/-- Lines of the fixture, edited, as bytes. -/
meta def edit (lines : List String) : List UInt8 := ("\n".intercalate lines ++ "\n").toUTF8.toList

#eval do
  let text ← IO.FS.readFile fixture
  let some es := (readFile text.toUTF8.toList).toOption | throw (IO.userError "fixture refused")
  -- accepted, with the proof objects' own conclusions
  accepted .q es (ex "zeroAddZero") Exported.zeroAddZero.concl
  accepted .pa es (ex "zeroAddZero") Exported.zeroAddZero.concl
  accepted .q es (ex "instAddZero") Exported.instAddZero.concl
  accepted .q es (ex "eqSymm") Exported.eqSymm.concl
  accepted .pa es (ex "zeroAdd") Exported.zeroAdd.concl
  -- rejected by the checker
  rejectedBy .q es (ex "zeroAdd") (· == ImportError.rejected .check)
  rejectedBy .pa es (ex "wrongAxiom") (· == ImportError.rejected .check)
  -- refused before checking
  rejectedBy .pa es "Silmaril.Consequence.Arithmetic.ND.Examples.zeroAdd"
    fun | .unsupported _ why => (why.splitOn "Examples.closed").length > 1 | _ => false
  rejectedBy .pa es (ex "body") (· == ImportError.rejected .syntax)
  rejectedBy .pa es "Nat.add" fun | .unsupported _ why => (why.splitOn "λ").length > 1 | _ => false
  rejectedBy .pa es (ex "nope") (· == ImportError.missing (ex "nope"))
  -- the declared type is not evidence; the value is
  let swap (d : String) (f : Declaration → Declaration) : List Event :=
    let t := Tables.ofEvents es
    es.map fun
      | Event.declaration dc => if dc.names.any (fun n => t.name? t.names.size n == some d) then
          Event.declaration (f dc) else Event.declaration dc
      | e => e
  let other := (Tables.ofEvents es).decl? (ex "zeroAddZero")
  accepted .q (swap (ex "eqSymm") fun
      | .definitionCode n ps _ v h s a => .definitionCode n ps 0 v h s a | d => d) (ex "eqSymm")
    Exported.eqSymm.concl
  match other with
  | some (.definitionCode _ _ _ v₀ _ _ _) =>
    accepted .q (swap (ex "eqSymm") fun
        | .definitionCode n ps t _ h s a => .definitionCode n ps t v₀ h s a | d => d) (ex "eqSymm")
      Exported.zeroAddZero.concl
  | _ => throw (IO.userError "no zeroAddZero")
  -- an axiom is not a proof
  rejectedBy .q (swap (ex "zeroAddZero") fun
      | .definitionCode n ps t _ _ _ _ => .axiomCode n ps t false | d => d) (ex "zeroAddZero")
    (· == ImportError.notDefinition (ex "zeroAddZero") "axiom")
  -- the declared kind matters too: a theorem record is not a proof object of this format
  rejectedBy .q (swap (ex "zeroAddZero") fun
      | .definitionCode n ps t v _ _ a => .theoremCode n ps t v a | d => d) (ex "zeroAddZero")
    (· == ImportError.notDefinition (ex "zeroAddZero") "theorem")
  -- mutations of the bytes
  let lines := (text.splitOn "\n").filter (· ≠ "")
  let refuse (what : String) (ls : List String) (p : ImportError → Bool) : IO Unit :=
    expect what (match importCheck .q (edit ls) (ex "zeroAddZero") with | .error e => p e | .ok _ => false)
  refuse "duplicated record" (lines.take 3 ++ [lines[1]!] ++ lines.drop 3)
    fun | .invalid 4 _ => true | _ => false
  refuse "forward reference" (lines.take 1 ++ ["{\"app\":{\"arg\":1,\"fn\":0},\"ie\":0}"] ++ lines.drop 1)
    fun | .invalid 2 _ => true | _ => false
  let firstExpr := (lines.findIdx? (fun (l : String) =>
    (l.splitOn "\"ie\":0}").length > 1 || (l.splitOn "\"ie\":0,").length > 1)).getD 0
  refuse "self-reference" (lines.set firstExpr "{\"app\":{\"arg\":0,\"fn\":0},\"ie\":0}")
    fun | .invalid n _ => n == firstExpr + 1 | _ => false
  refuse "unknown field" (lines.set 1 ((lines[1]!.dropEnd 1).toString ++ ",\"extra\":1}"))
    fun | .decode (.record 2 _) => true | _ => false
  refuse "mdata" (lines.set firstExpr "{\"ie\":0,\"mdata\":{\"data\":{},\"expr\":0}}")
    fun | .decode (.record _ why) => (why.splitOn "mdata").length > 1 | _ => false
  refuse "format version" (lines.set 0 (lines[0]!.replace "\"format\":{\"version\":\"3.1.0\"}"
      "\"format\":{\"version\":\"3.0.0\"}"))
    fun | .decode (.envelope _) => true | _ => false
  refuse "empty line" (lines.take 2 ++ [""] ++ lines.drop 2)
    fun | .decode (.envelope _) => true | _ => false

end Silmaril.ProofFormats.LeanNDJSON.Arithmetic.Examples
