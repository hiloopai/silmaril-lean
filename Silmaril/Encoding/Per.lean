module

public import Silmaril.Encoding.Lattice

/-!
# The partial equivalence induced by an encoding

Two spellings are the *same* (`E.same`) when they encode a common abstract
value; `E.per` is the transitive closure, always a partial equivalence relation
(symmetric, transitive) whose reflexive part is exactly the encodable carrier
values.  For a functional encoding `same` is already transitive, so
`E.per = E.same = E.Lift Eq`, and the classes of encodable spellings are in
bijection with the image of `E`.

Dually, `E.ambig a a'` says that one spelling encodes both `a` and `a'`;
functionality is exactly the absence of nontrivial ambiguity.
-/

@[expose] public section

namespace Silmaril

/-- A partial equivalence relation: symmetric and transitive. -/
structure IsPartialEquivalence {τ : Type} (R : τ → τ → Prop) : Prop where
  symm : ∀ ⦃a b⦄, R a b → R b a
  trans : ∀ ⦃a b c⦄, R a b → R b c → R a c

/-- A preorder restricted to a domain: reflexive on `S`, transitive everywhere. -/
structure IsPreorderOn {τ : Type} (S : τ → Prop) (R : τ → τ → Prop) : Prop where
  refl : ∀ a, S a → R a a
  trans : ∀ ⦃a b c⦄, R a b → R b c → R a c

namespace EncRel

variable {σ α β : Type}

section
variable (E : EncRel σ α)

/-- Spellings of a common abstract value. -/
def same (s s' : σ) : Prop := ∃ a, E s a ∧ E s' a

/-- The partial equivalence generated by `same`. -/
def per : σ → σ → Prop := Relation.TransGen E.same

/-- One spelling encodes both values. -/
def ambig (a a' : α) : Prop := ∃ s, E s a ∧ E s a'

end

variable {E F : EncRel σ α}

theorem same_symm {s s' : σ} (h : E.same s s') : E.same s' s := by
  obtain ⟨a, h, h'⟩ := h
  exact ⟨a, h', h⟩

theorem same_refl_iff {s : σ} : E.same s s ↔ E.Encodable s :=
  ⟨fun ⟨a, h, _⟩ => ⟨a, h⟩, fun ⟨a, h⟩ => ⟨a, h, h⟩⟩

theorem per_symm {s s' : σ} (h : E.per s s') : E.per s' s := by
  induction h with
  | single h => exact .single (same_symm h)
  | tail _ h ih => exact Relation.TransGen.head (same_symm h) ih

theorem per_trans {s s' s'' : σ} (h : E.per s s') (h' : E.per s' s'') : E.per s s'' :=
  Relation.TransGen.trans h h'

theorem per_isPartialEquivalence : IsPartialEquivalence E.per :=
  ⟨fun _ _ h => per_symm h, fun _ _ _ h h' => per_trans h h'⟩

theorem encodable_of_per_left {s s' : σ} (h : E.per s s') : E.Encodable s := by
  induction h with
  | single h => exact ⟨h.choose, h.choose_spec.1⟩
  | tail _ _ ih => exact ih

theorem per_refl_iff {s : σ} : E.per s s ↔ E.Encodable s :=
  ⟨encodable_of_per_left, fun h => .single (same_refl_iff.mpr h)⟩

theorem same_le_per {s s' : σ} (h : E.same s s') : E.per s s' := .single h

theorem same_eq_lift_eq : E.same = E.Lift Eq := by
  funext s s'
  apply propext
  constructor
  · rintro ⟨a, h, h'⟩
    exact ⟨a, a, h, h', rfl⟩
  · rintro ⟨a, a', h, h', rfl⟩
    exact ⟨a, h, h'⟩

/-- For a functional encoding, `same` is already transitive. -/
theorem Functional.same_trans (hF : E.Functional) {s s' s'' : σ}
    (h : E.same s s') (h' : E.same s' s'') : E.same s s'' := by
  obtain ⟨a, ha, ha'⟩ := h
  obtain ⟨b, hb, hb'⟩ := h'
  exact ⟨a, ha, hF hb ha' ▸ hb'⟩

theorem Functional.per_eq_same (hF : E.Functional) : E.per = E.same := by
  funext s s'
  apply propext
  constructor
  · intro h
    induction h with
    | single h => exact h
    | tail _ h ih => exact hF.same_trans ih h
  · exact same_le_per

theorem same_mono (hEF : E ≤ F) {s s' : σ} (h : E.same s s') : F.same s s' := by
  obtain ⟨a, h, h'⟩ := h
  exact ⟨a, hEF _ _ h, hEF _ _ h'⟩

theorem per_mono (hEF : E ≤ F) {s s' : σ} (h : E.per s s') : F.per s s' :=
  by
    induction h with
    | single h => exact .single (same_mono hEF h)
    | tail _ h ih => exact .tail ih (same_mono hEF h)

theorem functional_iff_ambig : E.Functional ↔ ∀ a a', E.ambig a a' → a = a' := by
  constructor
  · rintro hF a a' ⟨s, h, h'⟩
    exact hF h h'
  · intro h s a a' ha ha'
    exact h a a' ⟨s, ha, ha'⟩

theorem deterministic_iff_same : E.Deterministic ↔ ∀ s s', E.same s s' → s = s' := by
  constructor
  · rintro hD s s' ⟨a, h, h'⟩
    exact hD h h'
  · intro h s s' a ha ha'
    exact h s s' ⟨a, ha, ha'⟩

/-! ## Quotient by the PER -/

/-- The PER, restricted to encodable spellings, is an equivalence relation. -/
def encSetoid (E : EncRel σ α) : Setoid {s : σ // E.Encodable s} where
  r s s' := E.per s.1 s'.1
  iseqv :=
    ⟨fun s => per_refl_iff.mpr s.2, fun h => per_symm h, fun h h' => per_trans h h'⟩

/-- For a functional encoding, classes of encodable spellings correspond
exactly to encodable abstract values. -/
noncomputable def quotientEquivImage (hF : E.Functional) :
    Quotient E.encSetoid ≃ E.image where
  toFun := Quotient.lift (fun s => ⟨s.2.choose, s.1, s.2.choose_spec⟩) (by
    rintro ⟨s, hs⟩ ⟨t, ht⟩ (h : E.per s t)
    rw [hF.per_eq_same] at h
    obtain ⟨a, ha, ha'⟩ := h
    apply Subtype.ext
    change hs.choose = ht.choose
    rw [hF hs.choose_spec ha, hF ht.choose_spec ha'])
  invFun a := ⟦⟨a.2.choose, a.1, a.2.choose_spec⟩⟧
  left_inv := by
    rintro ⟨s, hs⟩
    apply Quotient.sound
    change E.per _ s
    exact same_le_per ⟨hs.choose, Exists.choose_spec (p := fun t => E t hs.choose) _,
      hs.choose_spec⟩
  right_inv := by
    rintro ⟨a, ha⟩
    apply Subtype.ext
    exact hF (Exists.choose_spec (⟨a, ha.choose_spec⟩ : E.Encodable ha.choose))
      ha.choose_spec

/-! ## Lifting relations on syntax -/

theorem Lift.isPartialEquivalence (hF : E.Functional) {R : α → α → Prop}
    (hR : IsPartialEquivalence R) : IsPartialEquivalence (E.Lift R) where
  symm := by
    rintro s s' ⟨a, a', ha, ha', hr⟩
    exact ⟨a', a, ha', ha, hR.symm hr⟩
  trans := by
    rintro s s' s'' ⟨a, a', ha, ha', hr⟩ ⟨c, c', hc, hc', hr'⟩
    rw [hF hc ha'] at hr'
    exact ⟨a, c', ha, hc', hR.trans hr hr'⟩

theorem Lift.isPreorderOn (hF : E.Functional) {R : α → α → Prop}
    (hrefl : ∀ a, R a a) (htrans : ∀ ⦃a b c⦄, R a b → R b c → R a c) :
    IsPreorderOn E.Encodable (E.Lift R) where
  refl := by
    rintro s ⟨a, ha⟩
    exact ⟨a, a, ha, ha, hrefl a⟩
  trans := by
    rintro s s' s'' ⟨a, a', ha, ha', hr⟩ ⟨c, c', hc, hc', hr'⟩
    rw [hF hc ha'] at hr'
    exact ⟨a, c', ha, hc', htrans hr hr'⟩

/-! ## Encoding-preserving maps preserve the PER -/

/-- `f` preserves encodings from `E` to `G` (the morphism condition of
`EncCat`). -/
def Preserves (E : EncRel σ α) (G : EncRel σ β) (f : α → β) : Prop :=
  ∀ s a, E s a → G s (f a)

theorem preserves_iff_le_comap {G : EncRel σ β} {f : α → β} :
    Preserves E G f ↔ E ≤ comap f G := Iff.rfl

theorem Preserves.same {G : EncRel σ β} {f : α → β} (hf : Preserves E G f) {s s' : σ}
    (h : E.same s s') : G.same s s' := by
  obtain ⟨a, h, h'⟩ := h
  exact ⟨f a, hf _ _ h, hf _ _ h'⟩

theorem Preserves.per {G : EncRel σ β} {f : α → β} (hf : Preserves E G f) {s s' : σ}
    (h : E.per s s') : G.per s s' :=
  by
    induction h with
    | single h => exact .single (hf.same h)
    | tail _ h ih => exact .tail ih (hf.same h)

end EncRel

end Silmaril
