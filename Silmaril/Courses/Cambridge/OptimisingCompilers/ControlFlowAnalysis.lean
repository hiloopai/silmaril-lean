module

public import Silmaril.Courses.Cambridge.OptimisingCompilers.ConstraintBased

/-! # §14 Control-flow analysis (0CFA) for λ-terms (notes pp. 26–28;
slides pp. 99–104)

Terms `e ::= x | c | λx.e | e₁ e₂ | let x = e₁ in e₂ | if e₁ then e₂ else e₃`
(notes p. 26), plus `e₁ ⊕ e₂` from exercise sheet 3, with every node and every
binding occurrence labelled by a program point. Flow values are labelled
constants `cˡ` and λ-abstractions, identified by their label.

`Sat` is the constraint system of notes p. 27, one clause per syntactic form:

* `xⁱ`: `αᵢ ⊇ αⱼ` where `xʲ` is the binding;
* `cⁱ`: `αᵢ ⊇ {cⁱ}`;  `(λxʲ.eᵏ)ⁱ`: `αᵢ ⊇ {(λxʲ.eᵏ)ⁱ}`;
* `(e₁ʲ e₂ᵏ)ⁱ`: `αⱼ ⊇ {(λx_q.e_r)ₚ} ⇒ α_q ⊇ αₖ ∧ αᵢ ⊇ α_r`;
* `(let xˡ = e₁ʲ in e₂ᵏ)ⁱ`: `αᵢ ⊇ αₖ` and `αₗ ⊇ αⱼ`;
* `(if e₁ʲ then e₂ᵏ else e₃ˡ)ⁱ`: `αᵢ ⊇ αₖ` and `αᵢ ⊇ αₗ`;
* `(e₁ ⊕ e₂)ⁱ`: no constraint on `αᵢ` (0CFA does not compute arithmetic).

The solutions form a Moore family (`sat_isMoore`), so the least solution
`cfa` exists (notes p. 27, "the constraint set generated by walking a program
has a unique least solution"). `notesExample_cfa` is the notes' worked example
`let id = λx.x in id id 7`.
-/

@[expose] public section

namespace Silmaril.Courses.Cambridge.OptimisingCompilers.ControlFlowAnalysis

open ConstraintBased

/-- Labelled terms. -/
inductive Term where
  | var (l : ℕ) (x : String)
  | const (l : ℕ) (c : ℤ)
  /-- `(λxᵇ.e)ˡ`, with `b` the label of the binding occurrence. -/
  | lam (l : ℕ) (b : ℕ) (x : String) (body : Term)
  | app (l : ℕ) (f a : Term)
  /-- `(let xᵇ = e₁ in e₂)ˡ`. -/
  | letE (l : ℕ) (b : ℕ) (x : String) (bound body : Term)
  | ite (l : ℕ) (c t e : Term)
  | binop (l : ℕ) (a b : Term)

/-- Flow values: labelled constants and λ-abstractions (by label). -/
inductive FlowVal where
  | const (c : ℤ) (l : ℕ)
  | lam (l : ℕ)
  deriving DecidableEq

namespace Term

/-- The label of a term's root. -/
def label : Term → ℕ
  | var l _ | const l _ | lam l _ _ _ | app l _ _ | letE l _ _ _ _ | ite l _ _ _ | binop l _ _ => l

/-- The λ-abstractions of a term, as `(p, q, r)` for `(λx_q.e_r)ₚ`. -/
def lams : Term → List (ℕ × ℕ × ℕ)
  | var .. | const .. => []
  | lam l b _ e => (l, b, e.label) :: e.lams
  | app _ f a => f.lams ++ a.lams
  | letE _ _ _ e₁ e₂ => e₁.lams ++ e₂.lams
  | ite _ c t e => c.lams ++ t.lams ++ e.lams
  | binop _ a b => a.lams ++ b.lams

/-- The constraints of notes p. 27, under binding environment `ρ` (variable
to binding label) and the program's λ-abstractions `L`. -/
def Sat (L : List (ℕ × ℕ × ℕ)) (α : ℕ → Set FlowVal) : (String → Option ℕ) → Term → Prop
  | ρ, var l x => ∀ j, ρ x = some j → α j ⊆ α l
  | _, const l c => FlowVal.const c l ∈ α l
  | ρ, lam l b x e => FlowVal.lam l ∈ α l ∧ Sat L α (Function.update ρ x (some b)) e
  | ρ, app i f a =>
    Sat L α ρ f ∧ Sat L α ρ a ∧
      ∀ p q r, (p, q, r) ∈ L → FlowVal.lam p ∈ α f.label → α a.label ⊆ α q ∧ α r ⊆ α i
  | ρ, letE i b x e₁ e₂ =>
    Sat L α ρ e₁ ∧ Sat L α (Function.update ρ x (some b)) e₂ ∧
      α e₂.label ⊆ α i ∧ α e₁.label ⊆ α b
  | ρ, ite i c t e => Sat L α ρ c ∧ Sat L α ρ t ∧ Sat L α ρ e ∧ α t.label ⊆ α i ∧ α e.label ⊆ α i
  | ρ, binop _ a b => Sat L α ρ a ∧ Sat L α ρ b

/-- The solutions of a closed program's constraints. -/
def solutions (P : Term) : Set (ℕ → Set FlowVal) := {α | Sat P.lams α (fun _ => none) P}

/-- Constraints valid in every member of `S` are valid in its meet. -/
theorem sat_sInf (L : List (ℕ × ℕ × ℕ)) (S : Set (ℕ → Set FlowVal)) :
    ∀ (e : Term) (ρ : String → Option ℕ), (∀ α ∈ S, Sat L α ρ e) → Sat L (sInf S) ρ e
  | var l x, ρ, h => by
    simp only [Sat] at h ⊢
    exact fun j hj => sInf_apply_subset fun α hα => h α hα j hj
  | const l c, ρ, h => by
    simp only [Sat] at h ⊢
    exact mem_sInf_apply.2 h
  | lam l b x e, ρ, h => by
    simp only [Sat] at h ⊢
    exact ⟨mem_sInf_apply.2 fun α hα => (h α hα).1, sat_sInf L S e _ fun α hα => (h α hα).2⟩
  | app i f a, ρ, h => by
    simp only [Sat] at h ⊢
    refine ⟨sat_sInf L S f ρ fun α hα => (h α hα).1, sat_sInf L S a ρ fun α hα => (h α hα).2.1,
      fun p q r hL hp => ⟨sInf_apply_subset fun α hα => ?_, sInf_apply_subset fun α hα => ?_⟩⟩
    · exact ((h α hα).2.2 p q r hL (mem_sInf_apply.1 hp α hα)).1
    · exact ((h α hα).2.2 p q r hL (mem_sInf_apply.1 hp α hα)).2
  | letE i b x e₁ e₂, ρ, h => by
    simp only [Sat] at h ⊢
    exact ⟨sat_sInf L S e₁ ρ fun α hα => (h α hα).1, sat_sInf L S e₂ _ fun α hα => (h α hα).2.1,
      sInf_apply_subset fun α hα => (h α hα).2.2.1, sInf_apply_subset fun α hα => (h α hα).2.2.2⟩
  | ite i c t e, ρ, h => by
    simp only [Sat] at h ⊢
    exact ⟨sat_sInf L S c ρ fun α hα => (h α hα).1, sat_sInf L S t ρ fun α hα => (h α hα).2.1,
      sat_sInf L S e ρ fun α hα => (h α hα).2.2.1,
      sInf_apply_subset fun α hα => (h α hα).2.2.2.1,
      sInf_apply_subset fun α hα => (h α hα).2.2.2.2⟩
  | binop i a b, ρ, h => by
    simp only [Sat] at h ⊢
    exact ⟨sat_sInf L S a ρ fun α hα => (h α hα).1, sat_sInf L S b ρ fun α hα => (h α hα).2⟩

/-- The constraints form a Moore family. -/
theorem sat_isMoore (P : Term) : IsMoore P.solutions := fun S hS =>
  sat_sInf P.lams S P _ hS

/-- The least solution: 0CFA. -/
def cfa (P : Term) : ℕ → Set FlowVal := sInf P.solutions

theorem cfa_isLeast (P : Term) : IsLeast P.solutions P.cfa := (sat_isMoore P).isLeast_sInf

/-- Rewriting the application clause's quantifier over `L` as a list quantifier. -/
theorem forall_mem_triple_iff {L : List (ℕ × ℕ × ℕ)} {Q : ℕ → ℕ → ℕ → Prop} :
    (∀ p q r, (p, q, r) ∈ L → Q p q r) ↔ ∀ t ∈ L, Q t.1 t.2.1 t.2.2 :=
  ⟨fun h _ ht => h _ _ _ ht, fun h _ _ _ hm => h _ hm⟩

theorem cfa_le {P : Term} {f : ℕ → Set FlowVal} (hf : f ∈ P.solutions) : P.cfa ≤ f :=
  sInf_le hf

theorem le_cfa {P : Term} {f : ℕ → Set FlowVal} (h : ∀ α ∈ P.solutions, f ≤ α) : f ≤ P.cfa :=
  le_sInf h

/-- To compute 0CFA, exhibit a solution below every solution. -/
theorem cfa_eq_of {P : Term} {f : ℕ → Set FlowVal} (hf : f ∈ P.solutions)
    (h : ∀ α ∈ P.solutions, f ≤ α) : P.cfa = f :=
  le_antisymm (cfa_le hf) (le_cfa h)

/-- 0CFA at one point, from a solution and a lower bound at that point. -/
theorem cfa_apply_eq {P : Term} {f : ℕ → Set FlowVal} {l : ℕ} {s : Set FlowVal}
    (hf : f ∈ P.solutions) (hfl : f l = s) (h : ∀ α ∈ P.solutions, s ⊆ α l) : P.cfa l = s :=
  Set.Subset.antisymm (hfl ▸ cfa_le hf l) fun _ hx => mem_sInf_apply.2 fun α hα => h α hα hx

end Term

/-- The notes' program `(let id¹⁰ = (λx²⁰.x²¹)²² in ((id³⁰ id³¹)³² 7³³)³⁴)¹`. -/
def notesExample : Term :=
  .letE 1 10 "id" (.lam 22 20 "x" (.var 21 "x"))
    (.app 34 (.app 32 (.var 30 "id") (.var 31 "id")) (.const 33 7))

/-- The least solution of notes p. 28:
`α₁ = α₃₄ = α₃₂ = α₂₁ = α₂₀ = {(λx²⁰.x²¹)²², 7³³}`,
`α₃₀ = α₃₁ = α₁₀ = α₂₂ = {(λx²⁰.x²¹)²²}`, `α₃₃ = {7³³}`, and `{}` elsewhere. -/
theorem notesExample_cfa :
    notesExample.cfa = fun l =>
      if l ∈ [1, 34, 32, 21, 20] then {.lam 22, .const 7 33}
      else if l ∈ [30, 31, 10, 22] then {.lam 22}
      else if l = 33 then {.const 7 33}
      else ∅ := by
  refine Term.cfa_eq_of ?_ ?_
  · simp only [Term.solutions, Set.mem_ofPred_eq, notesExample, Term.Sat, Term.lams, Term.label,
      List.append_nil, Term.forall_mem_triple_iff,
      List.forall_mem_cons]
    simp
  · intro α hα
    obtain ⟨⟨h22, hx⟩, ⟨⟨h30, h31, a32⟩, h33, a34⟩, s1, s10⟩ := hα
    have hL : ((22 : ℕ), (20 : ℕ), (21 : ℕ)) ∈ notesExample.lams := by
      simp [notesExample, Term.lams, Term.label]
    have m22 : FlowVal.lam 22 ∈ α 22 := h22
    have m10 : FlowVal.lam 22 ∈ α 10 := s10 m22
    have m30 : FlowVal.lam 22 ∈ α 30 := h30 10 (by simp) m10
    have m31 : FlowVal.lam 22 ∈ α 31 := h31 10 (by simp) m10
    have m20 : FlowVal.lam 22 ∈ α 20 := (a32 22 20 21 hL m30).1 m31
    have m21 : FlowVal.lam 22 ∈ α 21 := hx 20 (by simp) m20
    have m32 : FlowVal.lam 22 ∈ α 32 := (a32 22 20 21 hL m30).2 m21
    have c33 : FlowVal.const 7 33 ∈ α 33 := h33
    have c20 : FlowVal.const 7 33 ∈ α 20 := (a34 22 20 21 hL m32).1 c33
    have c21 : FlowVal.const 7 33 ∈ α 21 := hx 20 (by simp) c20
    have c32 : FlowVal.const 7 33 ∈ α 32 := (a32 22 20 21 hL m30).2 c21
    have m34 : FlowVal.lam 22 ∈ α 34 := (a34 22 20 21 hL m32).2 m21
    have c34 : FlowVal.const 7 33 ∈ α 34 := (a34 22 20 21 hL m32).2 c21
    have m1 : FlowVal.lam 22 ∈ α 1 := s1 m34
    have c1 : FlowVal.const 7 33 ∈ α 1 := s1 c34
    refine Pi.le_def.2 fun l => ?_
    split_ifs with h1 h2 h3
    · simp at h1
      rcases h1 with rfl | rfl | rfl | rfl | rfl <;>
        exact Set.insert_subset_iff.2 ⟨‹_›, Set.singleton_subset_iff.2 ‹_›⟩
    · simp at h2
      rcases h2 with rfl | rfl | rfl | rfl <;> exact Set.singleton_subset_iff.2 ‹_›
    · subst h3
      exact Set.singleton_subset_iff.2 c33
    · exact Set.empty_subset _

/-- The analysis is imprecise (notes p. 28): `λx.x` flows to the result,
although the program always evaluates to `7`. -/
theorem notesExample_imprecise : FlowVal.lam 22 ∈ notesExample.cfa 1 := by
  rw [notesExample_cfa]
  simp

end Silmaril.Courses.Cambridge.OptimisingCompilers.ControlFlowAnalysis
