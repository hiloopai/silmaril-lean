/-! ## Adler-32 -/

/-- zlib's `BASE`, the largest prime below `2^16`. -/
def BASE : Nat := 65521

/-- zlib's `NMAX`. -/
def NMAX : Nat := 5552

/-- The two sums of an incoming Adler-32 value, reduced. -/
def adlerStart (a : Nat) : Nat × Nat := AccumFold.red BASE (a % 65536, a / 65536 % 65536)

/-- Pack the two sums. -/
def adlerPack (s : Nat × Nat) : Nat := s.2 * 65536 + s.1

/-- **Adler-32** of `bs` continuing from `a`: reduce after every byte. -/
def adler32 (a : Nat) (bs : List Byte) : Nat := adlerPack (AccumFold.modFold BASE (adlerStart a) bs)

/-- zlib's deferred form: raw sums over `NMAX`-byte chunks, one reduction per chunk. -/
def adler32Chunked (a : Nat) (bs : List Byte) : Nat :=
  adlerPack (AccumFold.chunked BASE NMAX (by decide) (adlerStart a) bs)

end Silmaril.X86.Ladder.ZlibChecksums
