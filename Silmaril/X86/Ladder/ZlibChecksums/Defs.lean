/-- `crc32_z`'s address in the rung-03 `-O2` binary. -/
def crc32zAddr : Word := 0x401990

/-- `crc_table`'s address in the rung-03 `-O2` binary (the code's `disp32`). -/
def crcTblAddr : BitVec 32 := 0x004021e0#32

/-- The CRC of the input: the low 32 bits of `rdi`, inverted (`not %eax`). -/
def crcIn (m : MState) : BitVec 32 := ~~~((m.core.read .rdi).setWidth 32)

/-- The buffer as a byte list. -/
def buf (m : MState) : List Byte := bytesAt m.memory (arg1 m) (arg2 m)

/-- **The `crc32_z` contract** at `entry`. -/
def crc32zContract (entry : Word) : FnContract.Spec MState where
  entry m := m.core.rip = entry ∧ Loaded m.memory entry crc32zCode ∧
    TableAt m.memory crcTblAddr.toNat 256 crcT ∧ (arg1 m ≠ 0 → Readable m.memory (arg1 m) (arg2 m))
  footprint _ _ := False
  post m t := t.core.read .rax =
    if arg1 m = 0 then 0 else (crc32 ((m.core.read .rdi).setWidth 32) (buf m)).setWidth 64

/-! ## Listings -/

theorem rax_ne_rsp : Reg.rax ≠ Reg.rsp := by decide
theorem rdx_ne_rsp : Reg.rdx ≠ Reg.rsp := by decide

/-- `mov %rdi,%rax; mov %rsi,%rcx; mov %rdx,%rdi; test %rsi,%rsi; je 0x120`. -/
def zL00 : List LI :=
  [(.base (.mov .q (.reg .rax) .rdi), 3), (.base (.mov .q (.reg .rcx) .rsi), 3),
   (.base (.mov .q (.reg .rdi) .rdx), 3), (.base (.test .q (.reg .rsi) .rsi), 3),
   (.base (.jcc .e 0x10e#32), 6)]

/-- `not %eax; cmp $7,%rdx; jbe 0xe7`. -/
def zL12 : List LI :=
  [(.base (.unary .d .not (.reg .rax)), 2), (.base (.aluI8 .q .cmp (.reg .rdx) 0x07#8), 4),
   (.base (.jcc .be 0xc9#32), 6)]

/-- `lea -8(%rdx),%rdx; shr $3,%rdx; lea 8(%rsi,%rdx,8),%rsi; nopl`. -/
def zL1e : List LI :=
  [(.base (.lea .q .rdx (Mem.ofReg .rdx none 0xfffffff8#32)), 4),
   (.base (.shift .q .shr (.reg .rdx) (.imm 0x03#8)), 4),
   (.base (.lea .q .rsi (Mem.ofReg .rsi (some ⟨.rdx, 3#2, by decide⟩) 0x8#32)), 5),
   (.base (.nop 4), 5)]

/-- The displacement of byte `g` (`1 ≤ g ≤ 7`) after `rcx` advanced by 8: `g - 8`. -/
def kOf (g : Nat) : BitVec 32 := BitVec.ofNat 32 (2 ^ 32 + g - 8)

/-- The unrolled body: eight table-fold steps (results alternate between `rdx` and `rax`),
then `cmp %rsi,%rcx; jne 0x30`. -/
def zL30 : List LI :=
  stepAddL .rax .rdx .rcx 0 crcTblAddr 8#8 rax_ne_rsp ++ stepL .rdx .rax .rcx (kOf 1) crcTblAddr rdx_ne_rsp ++
  stepL .rax .rdx .rcx (kOf 2) crcTblAddr rax_ne_rsp ++ stepL .rdx .rax .rcx (kOf 3) crcTblAddr rdx_ne_rsp ++
  stepL .rax .rdx .rcx (kOf 4) crcTblAddr rax_ne_rsp ++ stepL .rdx .rax .rcx (kOf 5) crcTblAddr rdx_ne_rsp ++
  stepL .rax .rdx .rcx (kOf 6) crcTblAddr rax_ne_rsp ++ stepL .rdx .rax .rcx (kOf 7) crcTblAddr rdx_ne_rsp ++
  [(.base (.alu .q .cmp (.reg .rcx) .rsi), 3), (.base (.jcc .ne 0xffffff4c#32), 6)]

/-- `and $7,%edi`. -/
def zLe4 : List LI := [(.base (.aluI8 .d .and (.reg .rdi) 0x07#8), 3)]

/-- `test %rdi,%rdi; je 0x111`. -/
def zLe7 : List LI := [(.base (.test .q (.reg .rdi) .rdi), 3), (.base (.jcc8 .e 0x25#8), 2)]

/-- `add %rsi,%rdi; nop`. -/
def zLec : List LI := [(.base (.alu .q .add (.reg .rdi) .rsi), 3), (.base (.nop 0), 1)]

/-- The tail loop: `add $1,%rsi; mov %rax,%rdx; xor -1(%rsi),%al; shr $8,%rdx;
movzbl %al,%eax; xor T(,%rax,8),%rdx; mov %rdx,%rax; cmp %rdi,%rsi; jne 0xf0`. -/
def zLf0 : List LI :=
  [(.base (.aluI8 .q .add (.reg .rsi) 0x01#8), 4), (.base (.mov .q (.reg .rdx) .rax), 3),
   (.new (.aluR .xor (.low .rax) (.mem (Mem.ofReg .rsi none 0xffffffff#32))), 3),
   (.base (.shift .q .shr (.reg .rdx) (.imm 8#8)), 4),
   (.base (.movx false .d .b .rax (.reg .rax)), 3),
   (.base (.aluR .q .xor .rdx (.mem (tblMem .rax rax_ne_rsp crcTblAddr))), 8),
   (.base (.mov .q (.reg .rax) .rdx), 3),
   (.base (.alu .q .cmp (.reg .rsi) .rdi), 3), (.base (.jcc8 .ne 0xdf#8), 2)]

/-- `mov $0xffffffff,%edx; xor %rdx,%rax; ret`. -/
def zL111 : List LI :=
  [(.base (.movI32 .rdx 0xffffffff#32), 5), (.base (.alu .q .xor (.reg .rax) .rdx), 3),
   (.base .ret, 1)]

/-- `xor %eax,%eax; ret`. -/
def zL120 : List LI := [(.base (.alu .d .xor (.reg .rax) .rax), 2), (.base .ret, 1)]

/-- The blocks of `crc32_z`. -/
def crc32zBlocks : List Blk :=
  [⟨0x00, zL00⟩, ⟨0x12, zL12⟩, ⟨0x1e, zL1e⟩, ⟨0x30, zL30⟩, ⟨0xe4, zLe4⟩, ⟨0xe7, zLe7⟩,
   ⟨0xec, zLec⟩, ⟨0xf0, zLf0⟩, ⟨0x111, zL111⟩, ⟨0x120, zL120⟩]

/-! ## The certificate -/

/-- The fold of the first `t` buffer bytes from the inverted input CRC. -/
def F (m0 : MState) (t : Nat) : BitVec 32 := (bytesAt m0.memory (arg1 m0) t).foldl crcByte (crcIn m0)

/-- A 32-bit value zero-extended. -/
abbrev W (x : BitVec 32) : Word := x.setWidth 64

/-- What every annotation of a nonempty-buffer block keeps. -/
structure Base (entry : Word) (m0 m : MState) : Prop where
  frame : BlockCert.Frame m0 m
  pre : (crc32zContract entry).entry m0
  nz : arg1 m0 ≠ 0

/-- The annotations: register contents in terms of the entry state and the bytes folded. -/
def zAnn (entry : Word) : Nat → MState → MState → Prop
  | 0x00, m0, m => m = m0 ∧ FnContract.AbiEntry m.core m.memory ∧ (crc32zContract entry).entry m0
  | 0x12, m0, m => Base entry m0 m ∧ m.core.read .rax = m0.core.read .rdi ∧
      m.core.read .rcx = m0.core.read .rsi ∧ m.core.read .rsi = m0.core.read .rsi ∧ m.core.read .rdx = m0.core.read .rdx ∧
      m.core.read .rdi = m0.core.read .rdx
  | 0x1e, m0, m => Base entry m0 m ∧ 8 ≤ arg2 m0 ∧ m.core.read .rax = W (F m0 0) ∧
      m.core.read .rcx = m0.core.read .rsi ∧ m.core.read .rsi = m0.core.read .rsi ∧
      m.core.read .rdx = m0.core.read .rdx ∧ m.core.read .rdi = m0.core.read .rdx
  | 0x30, m0, m => Base entry m0 m ∧ ∃ j, j < arg2 m0 / 8 ∧ m.core.read .rax = W (F m0 (8 * j)) ∧
      m.core.read .rcx = m0.core.read .rsi + BitVec.ofNat 64 (8 * j) ∧
      m.core.read .rsi = m0.core.read .rsi + BitVec.ofNat 64 (8 * (arg2 m0 / 8)) ∧
      m.core.read .rdi = m0.core.read .rdx
  | 0xe4, m0, m => Base entry m0 m ∧ m.core.read .rax = W (F m0 (8 * (arg2 m0 / 8))) ∧
      m.core.read .rsi = m0.core.read .rsi + BitVec.ofNat 64 (8 * (arg2 m0 / 8)) ∧
      m.core.read .rdi = m0.core.read .rdx
  | 0xe7, m0, m => Base entry m0 m ∧ m.core.read .rax = W (F m0 (8 * (arg2 m0 / 8))) ∧
      m.core.read .rsi = m0.core.read .rsi + BitVec.ofNat 64 (8 * (arg2 m0 / 8)) ∧
      m.core.read .rdi = BitVec.ofNat 64 (arg2 m0 % 8)
  | 0xec, m0, m => Base entry m0 m ∧ m.core.read .rax = W (F m0 (8 * (arg2 m0 / 8))) ∧
      m.core.read .rsi = m0.core.read .rsi + BitVec.ofNat 64 (8 * (arg2 m0 / 8)) ∧
      m.core.read .rdi = BitVec.ofNat 64 (arg2 m0 % 8) ∧ arg2 m0 % 8 ≠ 0
  | 0xf0, m0, m => Base entry m0 m ∧ ∃ t, 8 * (arg2 m0 / 8) ≤ t ∧ t < arg2 m0 ∧
      m.core.read .rax = W (F m0 t) ∧ m.core.read .rsi = m0.core.read .rsi + BitVec.ofNat 64 t ∧
      m.core.read .rdi = m0.core.read .rsi + m0.core.read .rdx
  | 0x111, m0, m => Base entry m0 m ∧ m.core.read .rax = W (F m0 (arg2 m0))
  | 0x120, m0, m => BlockCert.Frame m0 m ∧ (crc32zContract entry).entry m0 ∧ arg1 m0 = 0
  | _, _, _ => False

/-- The measures: the bytes left, ordered along the control flow. -/
def zMeasure : Nat → MState → MState → Nat
  | 0x00, m0, _ => arg2 m0 + 30
  | 0x12, m0, _ => arg2 m0 + 29
  | 0x1e, m0, _ => arg2 m0 + 28
  | 0x30, m0, m => arg2 m0 / 8 - (m.core.read .rcx - m0.core.read .rsi).toNat / 8 + 20
  | 0xe4, _, _ => 13
  | 0xe7, _, _ => 12
  | 0xec, _, _ => 11
  | 0xf0, m0, m => arg2 m0 - (m.core.read .rsi - m0.core.read .rsi).toNat + 1
  | _, _, _ => 0

/-- **The `crc32_z` certificate** at `entry`. -/
def crc32zCert (entry : Word) : Cert where
  code := crc32zCode
  base := entry
  blocks := crc32zBlocks
  ann := zAnn entry
  measure := zMeasure

/-! ## The wrappers and `adler32_z` -/

/-- `crc32` (`0x401ac0`): `mov %edx,%edx; jmp crc32_z` (`crc32_z` is `0x130` bytes before). -/
def crc32WrapCode : List Byte := [0x89, 0xd2, 0xe9, 0xc9, 0xfe, 0xff, 0xff]

/-- `adler32` (`0x401880`): `mov %edx,%edx; jmp adler32_z` (`adler32_z` is `0x470` bytes
before). -/
def adler32WrapCode : List Byte := [0x89, 0xd2, 0xe9, 0x89, 0xfb, 0xff, 0xff]

/-- **The `crc32` contract** at `entry` (`uLong crc32(uLong, const Bytef *, uInt)`): as
`crc32_z` with the length's low 32 bits; `crc32_z`'s code at `entry - 0x130`. -/
def crc32Contract (entry : Word) : FnContract.Spec MState where
  entry m := m.core.rip = entry ∧ Loaded m.memory entry crc32WrapCode ∧
    Loaded m.memory (entry - 0x130#64) crc32zCode ∧
    TableAt m.memory crcTblAddr.toNat 256 crcT ∧
    (arg1 m ≠ 0 → Readable m.memory (arg1 m) (arg2 m % 2 ^ 32))
  footprint _ _ := False
  post m t := t.core.read .rax =
    if arg1 m = 0 then 0
    else (crc32 ((m.core.read .rdi).setWidth 32)
      (bytesAt m.memory (arg1 m) (arg2 m % 2 ^ 32))).setWidth 64

