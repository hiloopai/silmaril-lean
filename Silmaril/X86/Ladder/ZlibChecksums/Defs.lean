/-- `adler32_z`'s stack footprint: six pushes and a 48-byte red-zone spill area, the 96 bytes
below the entry stack pointer. -/
def adlerFrame (m : MState) (a : Nat) : Prop :=
  (m.core.read .rsp).toNat - 96 ≤ a ∧ a < (m.core.read .rsp).toNat

/-- The 96 bytes of `adler32_z`'s stack area may be read (it reloads its spills and pops
the callee-saved registers). Asking only `Writable` would not do: a write-only stack mapping
satisfies it and makes the first reload fault. -/
def StackReadable (mem : Silmaril.Process.Memory) (a : Nat) : Prop :=
  ∀ i < 96, mem.permits .read (a + i) = true

/-- **The caller's side of `adler32_z`** (with `len` the length argument):

* the incoming value is a valid Adler-32 value, both 16-bit halves `< BASE`. zlib reduces an
  out-of-range half lazily: on the `len = 1` fast path it subtracts `BASE` once from the new
  `s2 = s2 + s1`, so with `adler = 0xfffffff0` and the byte `0` zlib returns `0xfffefff0`
  while the reduced reference `adler32` gives `0x000dfff0` (checked against the rung's
  zlib 1.3.1 with `gcc -O2 -DZ_SOLO`);
* a null buffer comes with `len ≠ 1`: zlib tests `len == 1` *before* `buf == Z_NULL`, so
  `adler32_z(a, NULL, 1)` reads address `0` instead of returning `1`. -/
def AdlerOk (m : MState) (len : Nat) : Prop :=
  (m.core.read .rdi).toNat % 65536 < BASE ∧ (m.core.read .rdi).toNat / 65536 % 65536 < BASE ∧
    (arg1 m = 0 → len ≠ 1)

/-- **The `adler32_z` contract** at `entry`: `rax = 1` for a null buffer, else
`adler32 (rdi) (bytes)`; writes only its 96-byte stack area. Requires `AdlerOk` (a valid incoming
value; no null buffer of length 1): without it the contract is false of zlib's code. -/
def adler32zContract (entry : Word) : FnContract.Spec MState where
  entry m := m.core.rip = entry ∧ Loaded m.memory entry adler32zCode ∧
    96 ≤ (m.core.read .rsp).toNat ∧
    Silmaril.X86.Stencils.ByteLoop.Writable m.memory ((m.core.read .rsp).toNat - 96) 96 ∧
    StackReadable m.memory ((m.core.read .rsp).toNat - 96) ∧
    Silmaril.X86.Stencils.ByteLoop.Apart ((m.core.read .rsp).toNat - 96) 96
      entry.toNat adler32zCode.length ∧
    (arg1 m ≠ 0 → Readable m.memory (arg1 m) (arg2 m) ∧
      Silmaril.X86.Stencils.ByteLoop.Apart ((m.core.read .rsp).toNat - 96) 96
        (arg1 m) (arg2 m)) ∧
    AdlerOk m (arg2 m)
  footprint := adlerFrame
  post m t := t.core.read .rax = if arg1 m = 0 then 1
    else BitVec.ofNat 64 (adler32 (m.core.read .rdi).toNat (buf m))

/-- `adler32zContract` restricted to `len < 16`: the inputs that never reach the two `DO16`
loops (proved without the loop VCs). -/
def adler32zShortContract (entry : Word) : FnContract.Spec MState :=
  { adler32zContract entry with
    entry := fun m => (adler32zContract entry).entry m ∧ Silmaril.X86.Stencils.ByteLoop.arg2 m < 16 }

/-- **The `adler32` contract** at `entry` (`adler32_z` at `entry - 0x470`). -/
def adler32Contract (entry : Word) : FnContract.Spec MState where
  entry m := m.core.rip = entry ∧ Loaded m.memory entry adler32WrapCode ∧
    Loaded m.memory (entry - 0x470#64) adler32zCode ∧
    96 ≤ (m.core.read .rsp).toNat ∧
    Silmaril.X86.Stencils.ByteLoop.Writable m.memory ((m.core.read .rsp).toNat - 96) 96 ∧
    StackReadable m.memory ((m.core.read .rsp).toNat - 96) ∧
    Silmaril.X86.Stencils.ByteLoop.Apart ((m.core.read .rsp).toNat - 96) 96
      (entry - 0x470#64).toNat adler32zCode.length ∧
    (arg1 m ≠ 0 → Readable m.memory (arg1 m) (arg2 m % 2 ^ 32) ∧
      Silmaril.X86.Stencils.ByteLoop.Apart ((m.core.read .rsp).toNat - 96) 96
        (arg1 m) (arg2 m % 2 ^ 32)) ∧
    AdlerOk m (arg2 m % 2 ^ 32)
  footprint := adlerFrame
  post m t := t.core.read .rax = if arg1 m = 0 then 1
    else BitVec.ofNat 64 (adler32 (m.core.read .rdi).toNat
      (bytesAt m.memory (arg1 m) (arg2 m % 2 ^ 32)))

end Silmaril.X86.Ladder.ZlibChecksums
