module

public import Silmaril.X86.Link.Blob.Defs

/-! # Pinned ladder executables: code literals as slices of the loaded file

The ladder modules (`Ladder/LibMini/Transcript.lean`, `Ladder/LibMini/StrlenTranscript.lean`,
`Ladder/ZlibChecksums/Defs.lean`, `Ladder/ZlibChecksums/Spec/Defs.lean`) transcribe compiled
code as Lean byte literals. Their headers name the `-O2` executable and its SHA-256; on their
own they are **transcript ties**: the literal is what was extracted from the file.

`Ladder/Pinned/Thms.lean` upgrades them to **binary ties**. The executables are committed under
`examples/elf-ladder/<rung>/pinned/` and embedded byte-exactly as `Link.Blob`s
(`Ladder/Pinned/<Rung>.lean`, generated by `examples/elf-ladder/pin.sh`; `pin.sh --check`
re-derives each module from the committed file and checks its `.sha256`).

* `sliceAt seg addr len`: the `len` bytes of a loaded segment at virtual address `addr`, if
  they lie inside it.
* `LoadedAt exe perms addr code`: the public LPS loader `ELFImage.parse x86Policy` accepts the
  file `exe.bytes`, and one of the loaded segments of its image, with permission string
  `perms`, holds exactly `code` at virtual address `addr`.
* `check`, `checkAll`: the kernel-fast decision procedures (through `Link.Blob.parseN`);
  `check_sound` and `checkAll_sound` (`Ladder/Pinned/Thms.lean`) turn `check … = true`,
  proved by `decide +kernel`, into `LoadedAt`.

Trusted: the LPS ELF loading rules (`ELFImage.parse`, `Records.image`), the `Blob` encoding
of the committed file (checked outside Lean by `pin.sh --check`), and the kernel.
-/

@[expose] public section

namespace Silmaril.X86.Ladder.Pinned

open Silmaril.Process.LPS
open Silmaril.X86.Link

/-- The `len` bytes of a loaded segment at virtual address `addr`, if they lie inside it. -/
def sliceAt (seg : Segment) (addr len : Nat) : Option (List (BitVec 8)) :=
  if seg.base ≤ addr ∧ addr + len ≤ seg.base + seg.bytes.length then
    some ((seg.bytes.drop (addr - seg.base)).take len)
  else none

/-- `code` is what the executable `exe` loads at `addr`, in a segment with permissions
`perms` (`"rx"` for code, `"r"` for read-only data). -/
def LoadedAt (exe : Blob) (perms : String) (addr : Nat) (code : List (BitVec 8)) : Prop :=
  ∃ records, ELFImage.parse ELFImage.x86Policy exe.bytes = some records ∧
    ∃ seg ∈ (records.image exe.bytes).segments,
      seg.perms = perms ∧ sliceAt seg addr code.length = some code

/-- The decision procedure, through the kernel-fast reader `Blob.parseN`. -/
def check (exe : Blob) (perms : String) (addr : Nat) (code : List (BitVec 8)) : Bool :=
  match Blob.parseN ELFImage.x86Policy exe.n exe.len with
  | some records =>
    (records.image exe.bytes).segments.any fun seg =>
      seg.perms == perms && sliceAt seg addr code.length == some code
  | none => false

/-- Several slices of one file under one parse: `(perms, addr, code)` triples. -/
def checkAll (exe : Blob) (slices : List (String × Nat × List (BitVec 8))) : Bool :=
  match Blob.parseN ELFImage.x86Policy exe.n exe.len with
  | some records =>
    slices.all fun (perms, addr, code) =>
      (records.image exe.bytes).segments.any fun seg =>
        seg.perms == perms && sliceAt seg addr code.length == some code
  | none => false

end Silmaril.X86.Ladder.Pinned
