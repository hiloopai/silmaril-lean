module

public import Silmaril.X86.Ladder.LeafArith.Defs
public import Silmaril.X86.Open.Thms
import Silmaril.Proofs.X86.Ladder.LeafArith.Bswap
import Silmaril.Proofs.X86.Ladder.LeafArith.SatAdd
import Silmaril.Proofs.X86.Ladder.LeafArith.Clamp
import Silmaril.Proofs.X86.Ladder.LeafArith.Gcd
import Silmaril.Proofs.X86.Ladder.LeafArith.Realizes
/-!
# Ladder rung 01 (gcc -O2): System V function contracts

For `bswap32_manual`, `sat_add_u32`, `clamp_i32` and `gcd_u32` of the pinned `-O2` executable:
from every open-machine state with the transcribed code loaded at `0x401370`, `rip` at the
function's entry and the System V entry obligations (`rsp ≡ 8 mod 16`, a readable return
address), the open machine reaches a state with `rip` at the return address, `rsp` popped,
the callee-saved registers and all of memory unchanged, and `rax` the C function's value on
the 32-bit arguments in `edi`, `esi`, `edx` (`*_total`, packaged as `FnContract Open.isa`
in `*_contract`).

`*_realizes`: the same contracts as integer System V `Silmaril.Machine.SystemV.Realizes`
certificates (`FnContract.toRealizes`) for the C signatures `u32(u32)`, `u32(u32, u32)` and
`int(int, int, int)`: from every ABI-admitted call whose entry is the function with the code
loaded, an open run to a System V return with the C result in `eax` and no memory written.
The typed FFI form (`FnContract.toFfiRealizes`, the ABI model's `Abi.Ffi.Realizes`) is not
instantiated here: it needs `Ffi.ObjectSpec`s and call plans for `uint32`/`int32`.

`*_rejected`: mutations of the hand listings that `listingAt` rejects against the bytes.

Each is assembled by `BlockCert.FunCert.total` from checked listings (`FunCert.checked`,
`decide +kernel` against `Transcript.bytes`), Bir lifts (`liftBlock_sound`) and block VCs over
pure Bir terms (proofs in `Silmaril/Proofs/Machine/X86/Ladder/LeafArith/`). `gcd_u32` has a
loop cut with a measure, so its contract is total.

Effort (proof lines exclude blanks, comments and headers; annotations and hand listings are
in `Defs.lean`; kernel time is Lean's `type checking` profile of the proof module, one run
on the development machine, 2026-10-29):

| function | blocks | proof lines | kernel | by hand |
|---|---|---|---|---|
| `bswap32_manual` | 1 | 22 | 0.9 s | the 32-bit `bswap` identity (bitwise, 32 cases) |
| `sat_add_u32` | 5 | 62 | 0.3 s | a case split on the carry per branch block |
| `clamp_i32` | 3 | 47 | 0.6 s | CMOV listing; `sle` vs `slt` in the post |
| `gcd_u32` | 7 | 123 | 2.2 s | Euclid invariant and measure; the `div` block |

Automatic in every block: the listing check against the bytes, the Bir lift, the run to the
final state (`bir_simp`), the System V frame (memory, `rsp`, callee-saved registers) and the
successor's program counter (`bir_close`).

Trusted: the handwritten `X86.Ext` semantics, and that `Transcript.bytes` are the bytes of
the pinned executable at `0x401370` (recorded by `tools/x86-lift`, regenerated by
`tools/x86-lift/regen-ladder.sh` against the pinned SHA-256).
-/

@[expose] public section

namespace Silmaril.X86.Ladder.LeafArith

/-- `bswap32_manual` (-O2) is totally correct on the open machine. -/
theorem bswap32_manual_total : bswapSpec.Total Open.isa :=
  Silmaril.Proofs.X86.Ladder.LeafArith.bswap_total

/-- `sat_add_u32` (-O2) is totally correct on the open machine. -/
theorem sat_add_u32_total : satSpec.Total Open.isa :=
  Silmaril.Proofs.X86.Ladder.LeafArith.sat_total

/-- `clamp_i32` (-O2) is totally correct on the open machine. -/
theorem clamp_i32_total : clampSpec'.Total Open.isa :=
  Silmaril.Proofs.X86.Ladder.LeafArith.clamp_total

/-- `gcd_u32` (-O2), a loop with `div`, is totally correct on the open machine. -/
theorem gcd_u32_total : gcdSpec'.Total Open.isa :=
  Silmaril.Proofs.X86.Ladder.LeafArith.gcd_total

/-- x86 `bswap` at 32 bits is the C expression of `bswap32_manual`. -/
theorem byteSwap32_eq (x : BitVec 32) : Silmaril.X86.Ext.byteSwap32 x = bswap32Spec x :=
  Silmaril.Proofs.X86.Ladder.LeafArith.byteSwap32_eq x

/-- `bswap32_manual` realizes `u32 bswap32_manual(u32)`. -/
theorem bswap32_manual_realizes :
    Silmaril.Machine.SystemV.Realizes sigU1 bswapResult noWrites (loadedAt 0xb0)
      (fun call final => Silmaril.Machine.Execution.Reaches Open.step call.initial final) :=
  Silmaril.Proofs.X86.Ladder.LeafArith.bswap_realizes

/-- `sat_add_u32` realizes `u32 sat_add_u32(u32, u32)`. -/
theorem sat_add_u32_realizes :
    Silmaril.Machine.SystemV.Realizes sigU2 satResult noWrites (loadedAt 0x90)
      (fun call final => Silmaril.Machine.Execution.Reaches Open.step call.initial final) :=
  Silmaril.Proofs.X86.Ladder.LeafArith.sat_realizes

/-- `clamp_i32` realizes `int clamp_i32(int, int, int)`. -/
theorem clamp_i32_realizes :
    Silmaril.Machine.SystemV.Realizes sigI3 clampResult noWrites (loadedAt 0x30)
      (fun call final => Silmaril.Machine.Execution.Reaches Open.step call.initial final) :=
  Silmaril.Proofs.X86.Ladder.LeafArith.clamp_realizes

/-- `gcd_u32` realizes `u32 gcd_u32(u32, u32)`. -/
theorem gcd_u32_realizes :
    Silmaril.Machine.SystemV.Realizes sigU2 gcdResult noWrites (loadedAt 0x0)
      (fun call final => Silmaril.Machine.Execution.Reaches Open.step call.initial final) :=
  Silmaril.Proofs.X86.Ladder.LeafArith.gcd_realizes

/-- The contract of `bswap32_manual`. -/
def bswap32_manual_contract : FnContract Open.isa := ⟨bswapSpec, bswap32_manual_total⟩

/-- The contract of `sat_add_u32`. -/
def sat_add_u32_contract : FnContract Open.isa := ⟨satSpec, sat_add_u32_total⟩

/-- The contract of `clamp_i32`. -/
def clamp_i32_contract : FnContract Open.isa := ⟨clampSpec', clamp_i32_total⟩

/-- The contract of `gcd_u32`. -/
def gcd_u32_contract : FnContract Open.isa := ⟨gcdSpec', gcd_u32_total⟩

/-! ## Certificate checks and verification conditions

Exported for proofs that need more than `Spec.Total` from the certificates, such as the
runs-inside-the-code form in `Silmaril.Machine.Abi.OpenMachine` (round 2). -/

theorem sat_add_u32_checked : satCert.checked = true :=
  Silmaril.Proofs.X86.Ladder.LeafArith.sat_checked

theorem sat_add_u32_vc : satCert.VC fun m0 t => satSpec.Result Open.isa m0 t :=
  Silmaril.Proofs.X86.Ladder.LeafArith.sat_vc

theorem clamp_i32_checked : clampCert.checked = true :=
  Silmaril.Proofs.X86.Ladder.LeafArith.clamp_checked

theorem clamp_i32_vc : clampCert.VC fun m0 t => clampSpec'.Result Open.isa m0 t :=
  Silmaril.Proofs.X86.Ladder.LeafArith.clamp_vc

/-! ## The listing check rejects wrong hand listings

`clamp_i32` and `gcd_u32` are listed by hand; these mutations of them (and of their offsets)
are rejected by `listingAt` against the transcribed bytes, so `FunCert.checked` is not
vacuous. -/

/-- `cmovl` in place of the binary's `cmovle`. -/
theorem clamp_cmovl_rejected :
    BlockCert.listingAt code 0x34
      [(.ext (.alu .d .cmp (.reg .rdi) .rdx), 2), (.ext (.mov .d (.reg .rax) .rdx), 2),
       (.x (.cmov .d .l .rax (.reg .rdi)), 3), (.ext .ret, 1)] = false := by decide +kernel

/-- `jle` in place of the binary's `jl`. -/
theorem clamp_jle_rejected :
    BlockCert.listingAt code 0x30
      [(.ext (.alu .d .cmp (.reg .rdi) .rsi), 2), (.ext (.jcc8 .le 0xc), 2)] = false := by
  decide +kernel

/-- A block may not run through a jump that is not its last instruction. -/
theorem clamp_through_jump_rejected :
    BlockCert.listingAt code 0x30 (clampL30 ++ clampL34) = false := by
  decide +kernel

/-- Signed `idiv` in place of the binary's `div`. -/
theorem gcd_idiv_rejected :
    BlockCert.listingAt code 0x14 [(.ext (.div .d true (.reg .rcx)), 2)] = false := by
  decide +kernel

/-- The right listing at the wrong offset. -/
theorem gcd_offset_rejected : BlockCert.listingAt code 0x16 gcdL14 = false := by decide +kernel

/-! ## Out of reach of the open machine

`popcount32` and `ilog2_u32` (gcc -O2) each contain an instruction that neither `X86.Ext` nor
`Ext8` decodes, so `Open.step` has no step there and no contract of either function on
`Open.isa` can be proved without extending the instruction set (and its trusted semantics). -/

/-- `imul $0x1010101,%eax,%eax` (`popcount32` at `0x40135a`) is not decoded. -/
theorem popcount32_imul_undecoded :
    Open.decode [0x69, 0xc0, 0x01, 0x01, 0x01, 0x01] = none := by decide +kernel

/-- `bsr %edi,%eax` (`ilog2_u32` at `0x401434`) is not decoded. -/
theorem ilog2_u32_bsr_undecoded : Open.decode [0x0f, 0xbd, 0xc7] = none := by decide +kernel

end Silmaril.X86.Ladder.LeafArith
