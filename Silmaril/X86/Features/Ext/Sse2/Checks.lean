module

public import Silmaril.X86.Features.Ext.Sse2.Extension
public import Silmaril.X86.Features.Checks

/-!
# Checks of the SSE/SSE2 lane

`checkVector` is the checker of the differential vectors in `Vectors.lean`
(generated by `scripts/x86-features/gen_sse2_vectors.py`, which executes every
form natively). A vector fixes YMM0 and YMM1 (256 bits each, through
`vmovdqu`), RAX, a 32-byte data buffer and an offset into it held in RDI; the
form executes once and the vector records YMM0, RAX and the buffer afterwards.
The checker runs `sse2Ext.exec` on the extended state with that data, ZMM0 bits
511:256 set to a tag, and requires the same YMM0 with the tag kept, the same
RAX, the same buffer, YMM1 unchanged and RIP advanced.

The examples below are representative instances checked by `decide`/`rfl` and
small algebraic facts.
-/

@[expose] public section

namespace Silmaril.X86.Features.Sse2.Checks

open Silmaril.X86
open Silmaril.Process (Memory Region)

/-- The data buffer of the vectors. -/
def vbase : Nat := 0x10000

def vregion : Region := ⟨vbase, 32, ⟨true, true, false⟩⟩

/-- The `k` little-endian bytes of `n`. -/
def bytesOf (n k : Nat) : List Byte := (List.range k).map fun i => BitVec.ofNat 8 (n >>> (8 * i))

def vmemory (mem : Nat) : Memory := ⟨[vregion], Memory.install ∅ vbase (bytesOf mem 32)⟩

/-- Bits 511:256 of ZMM0 in the vectors' initial state (the host has no
AVX-512, so the model's claim that legacy SSE keeps them is checked against
itself only). -/
def upperTag : Nat := 0x0123_4567_89AB_CDEF_FEDC_BA98_7654_3210_DEAD_BEEF_CAFE_F00D * 2 ^ 256

def vcore (rax rdi : Nat) : X86.State :=
  { regs := fun r => if r = .rax then BitVec.ofNat 64 rax else if r = .rdi then BitVec.ofNat 64 rdi
      else 0
    rip := 0x1000, flags := ⟨none, none, none, none, none, none⟩ }

def vstate (a b rax rdi : Nat) : State :=
  ((State.ofCore (vcore rax rdi)).writeZmm 0 (BitVec.ofNat 512 (upperTag + a))).writeZmm 1
    (BitVec.ofNat 512 b)

/-- Execute `i` on the vector's inputs and compare with the recorded outputs. -/
def checkVector (i : Instr) (a b rax off mem ra rax' mem' : Nat) : Bool :=
  match sse2Ext.exec i 5 (vstate a b rax (vbase + off)) (vmemory mem) with
  | .retired s m =>
    s.zmm 0 == BitVec.ofNat 512 (upperTag + ra) && s.zmm 1 == BitVec.ofNat 512 b &&
      s.core.read .rax == BitVec.ofNat 64 rax' && s.core.read .rdi == BitVec.ofNat 64 (vbase + off) &&
      s.rip == 0x1005 && m.readBytes vbase 32 == some (bytesOf mem' 32)
  | _ => false

/-! ## Representative instances -/

theorem pxor_self (a : BitVec 128) : (BinOp.logic .xor).eval a a = 0 := by
  simp [BinOp.eval, Logic.eval]

theorem pandn_self (a : BitVec 128) : (BinOp.logic .andn).eval a a = 0 := by
  simp [BinOp.eval, Logic.eval]

example : encode (.binop (.logic .xor) .xmm0 (.reg .xmm3)) = [0x66, 0x0F, 0xEF, 0xC3] := by decide
example : encode (.movRR .dqa .xmm2 .xmm1) = [0x66, 0x0F, 0x6F, 0xD1] := by decide
example : encode (.shiftImm .srld .xmm4 0x1F) = [0x66, 0x0F, 0x72, 0xD4, 0x1F] := by decide
example : decode [0x66, 0x41, 0x0F, 0x72, 0xD4, 0x1F] = some (.shiftImm .srld .xmm12 0x1F, 6) := by
  decide
example : decode [0xF3, 0x41, 0x0F, 0x6F, 0x40, 0x10] =
    some (.movLoad .dqu .xmm0 { base := .r8, disp := 0x10 }, 6) := by decide
/-- MOVAPS `0F 28` with a register operand is `floatExt`'s, not this lane's. -/
example : decode [0x0F, 0x28, 0xD6] = none := by decide
example : Float.decode [0x0F, 0x28, 0xD6] = some (.movap .single .xmm2 .xmm6, 3) := by decide
example : decode [0x0F, 0x29, 0x45, 0xB0] =
    some (.movStore .aps { base := .rbp, disp := 0xFFFFFFB0 } .xmm0, 4) := by decide

example : pshufd 0x1B 0x00000003_00000002_00000001_00000000#128 =
    0x00000000_00000001_00000002_00000003#128 := by decide
example : movmsk 0x80000000_00000000_00000000_00000080#128 = 0x8001#16 := by decide
example : (BinOp.add .d).eval 0xFFFFFFFF#128 1#128 = 0#128 := by decide
example : (BinOp.unpackLo .b).eval 0x0201#128 0x0403#128 = 0x04020301#128 := by decide
example : shiftLanes .srad 40 0x80000000_00000000_00000000_7FFFFFFF#128 =
    0xFFFFFFFF_00000000_00000000_00000000#128 := by decide
example : shiftBytes true 16 (-1) = 0 := by decide

/-- A misaligned MOVDQA load is #GP(0), before the access. -/
example : (match sse2Ext.exec (.movLoad .dqa .xmm0 { base := .rdi }) 4 (vstate 0 0 0 (vbase + 1))
    (vmemory 0) with
    | .fault .generalProtection => true
    | _ => false) = true := by decide +kernel

end Silmaril.X86.Features.Sse2.Checks
