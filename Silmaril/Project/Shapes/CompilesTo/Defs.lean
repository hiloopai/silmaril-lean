silmaril instance silmaril.shapes.c.compiles_to.canonical_entry.open
    (title := "compiles_to.canonical_entry, on the open machine (Open)") :=
  silmaril.shapes.c.compiles_to.canonical_entry (M := Silmaril.X86.Open.isa)
