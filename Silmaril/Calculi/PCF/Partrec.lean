module

public import Silmaril.Calculi.PCF.Examples
public import Mathlib.Computability.PartrecBasis

/-! # Partial recursive functions in PCF

Example 19 of the denotational semantics notes (§5.2): every partial recursive
function `φ : ℕ ⇀ ℕ` has a PCF term `φ'` that evaluates to `φ(n)` whenever
`φ(n)` is defined (`partrec_definable`). This result simulates defined outputs;
it does not require divergence where `φ` is undefined. For total recursive
functions, it gives the specified result at every input.

The proof goes through Mathlib's basis `Nat.Partrec'` of partial recursive
functions `ℕⁿ ⇀ ℕ` on vectors, generated by zero, successor, projections,
composition, primitive recursion and minimisation. An `n`-ary function is
coded, curried, by a closed term of type `nat -> ⋯ -> nat -> nat`
(`Ty.arrows n`). The codings of primitive recursion (`precTerm`) and
minimisation (`rfindTerm`) are those of the notes, with the recursion and
search variable first, as in Mathlib.

Since application is call by name, a coded function may be applied to
arguments that are not yet numerals, for instance in a composition. The
invariant `Realizes t f` therefore asks that `t` applied to *any* closed
arguments evaluating to the numerals of `v` evaluates to the numeral of every
`y ∈ f v`.
-/

@[expose] public section

namespace Silmaril.Calculi.PCF


open TypedLambda Cslib.LambdaCalculus.LocallyNameless.Stlc

/-! ### Curried functions of several arguments -/

/-- The type `nat -> ⋯ -> nat -> nat` of curried functions of `n` numbers. -/
@[reducible] def Ty.arrows : ℕ → Ty
  | 0 => Ty.nat
  | n + 1 => Ty.nat ⤳ arrows n

/-- The context `Γ` extended by `n` variables of type `nat`, the first of
which is bound outermost. -/
def ctxN : ℕ → Ctx Base → Ctx Base
  | 0, Γ => Γ
  | n + 1, Γ => ctxN n (Ty.nat :: Γ)

namespace Term

variable {p : Bool}

/-- The abstraction `fun x₀ ⋯ xₙ₋₁ : nat. b` of `n` numbers. -/
def lams : {Γ : Ctx Base} → (n : ℕ) → Term p (ctxN n Γ) .nat → Term p Γ (Ty.arrows n)
  | _, 0, b => b
  | _, n + 1, b => .lam (lams n b)

/-- The application `t u₀ ⋯ uₙ₋₁` to `n` arguments. -/
def apps : {Γ : Ctx Base} → {n : ℕ} → Term p Γ (Ty.arrows n) → (Fin n → Term p Γ .nat) →
    Term p Γ .nat
  | _, 0, t, _ => t
  | _, _ + 1, t, us => apps (.app t (us 0)) (Fin.tail us)

/-- A variable of `Γ`, as a variable of `ctxN n Γ`. -/
def liftVar {a : Ty} : {Γ : Ctx Base} → (n : ℕ) → Var Γ a → Var (ctxN n Γ) a
  | _, 0, x => x
  | _, n + 1, x => liftVar n (.succ x)

/-- The variable `xᵢ` bound by `lams n`. -/
def argVar : {Γ : Ctx Base} → (n : ℕ) → Fin n → Var (ctxN n Γ) Ty.nat
  | _, n + 1, ⟨0, _⟩ => liftVar n .zero
  | _, n + 1, ⟨i + 1, h⟩ => argVar n ⟨i, Nat.lt_of_succ_lt_succ h⟩

/-- The variables `x₀, …, xₙ₋₁` bound by `lams n`. -/
abbrev args {Γ : Ctx Base} (n : ℕ) : Fin n → Term p (ctxN n Γ) .nat := fun i => .var (argVar n i)

theorem apps_cons {Γ : Ctx Base} {n : ℕ} (t : Term p Γ (Ty.arrows (n + 1))) (u : Term p Γ .nat)
    (us : Fin n → Term p Γ .nat) : apps t (Fin.cons u us) = apps (.app t u) us := rfl

@[simp] theorem subst_apps {Γ Δ : Ctx Base} (s : Subst (sig p) Γ Δ) :
    {n : ℕ} → (t : Term p Γ (Ty.arrows n)) → (us : Fin n → Term p Γ .nat) →
    (apps t us).subst s = apps (t.subst s) (fun i => (us i).subst s)
  | 0, _, _ => rfl
  | _ + 1, t, us => subst_apps s (.app t (us 0)) (Fin.tail us)

end Term

/-- Extend a substitution by terms for the `n` variables of `ctxN n Γ`. -/
def Subst.extendN {p : Bool} {Δ : Ctx Base} : {Γ : Ctx Base} → (n : ℕ) →
    Subst (sig p) Γ Δ → (Fin n → Term p Δ .nat) → Subst (sig p) (ctxN n Γ) Δ
  | _, 0, s, _ => s
  | _, n + 1, s, us => extendN n (us 0 ::ₜ s) (Fin.tail us)

namespace Subst

variable {p : Bool} {Δ : Ctx Base}

@[simp] theorem extendN_liftVar {a : Ty} : {Γ : Ctx Base} → (n : ℕ) → (s : Subst (sig p) Γ Δ) →
    (us : Fin n → Term p Δ .nat) → (x : Var Γ a) → extendN n s us _ (Term.liftVar n x) = s _ x
  | _, 0, _, _, _ => rfl
  | _, n + 1, s, us, x => extendN_liftVar n (us 0 ::ₜ s) (Fin.tail us) (.succ x)

@[simp] theorem extendN_argVar : {Γ : Ctx Base} → (n : ℕ) → (s : Subst (sig p) Γ Δ) →
    (us : Fin n → Term p Δ .nat) → (i : Fin n) → extendN n s us _ (Term.argVar n i) = us i
  | _, n + 1, s, us, ⟨0, _⟩ => extendN_liftVar n (us 0 ::ₜ s) (Fin.tail us) .zero
  | _, n + 1, s, us, ⟨i + 1, h⟩ =>
      extendN_argVar n (us 0 ::ₜ s) (Fin.tail us) ⟨i, Nat.lt_of_succ_lt_succ h⟩

end Subst

/-! ### Head expansion of applications -/

namespace Expands

variable {p : Bool}

/-- Head expansion is a congruence for application to several arguments. -/
theorem apps : {n : ℕ} → {t t' : Closed p (Ty.arrows n)} → Expands t t' →
    (us : Fin n → Closed p .nat) → Expands (Term.apps t us) (Term.apps t' us)
  | 0, _, _, h, _ => h
  | _ + 1, _, _, h, us => apps (h.app (us 0)) (Fin.tail us)

/-- β-expansion for `n` arguments. -/
theorem apps_lams : {Γ : Ctx Base} → {n : ℕ} → (b : Term p (ctxN n Γ) .nat) →
    (s : Subst (sig p) Γ []) → (us : Fin n → Closed p .nat) →
    Expands (b.subst (Subst.extendN n s us)) (Term.apps ((Term.lams n b).subst s) us)
  | _, 0, _, _, _ => refl _
  | Γ, n + 1, b, s, us => by
      refine (apps_lams (Γ := Ty.nat :: Γ) (n := n) b (us 0 ::ₜ s) (Fin.tail us)).trans
        (apps ?_ (Fin.tail us))
      rw [← TypedLambda.Term.subst_lift_subst1]
      exact beta _ (us 0)

/-- β-expansion for `n` arguments, for a closed abstraction. -/
theorem apps_lams_closed {n : ℕ} (b : Term p (ctxN n []) .nat) (us : Fin n → Closed p .nat) :
    Expands (b.subst (Subst.extendN n (Subst.id []) us)) (Term.apps (Term.lams n b) us) := by
  have h := apps_lams b (Subst.id []) us
  rwa [TypedLambda.Term.subst_id] at h

/-- Unfolding a recursive function of `n` arguments,
`fix(fun f. fun x₀ ⋯ xₙ₋₁. b)`. -/
theorem apps_fix_lams {n : ℕ} (b : Term p (ctxN n [Ty.arrows n]) .nat)
    (us : Fin n → Closed p .nat) :
    Expands (b.subst (Subst.extendN n (Subst.single (Term.fix (.lam (Term.lams n b)))) us))
      (Term.apps (Term.fix (.lam (Term.lams n b))) us) :=
  (apps_lams b _ us).trans (apps ((beta _ _).trans (fix _)) us)

end Expands

/-! ### Realizers -/

/-- The closed term `t` realizes the partial function `f : ℕⁿ ⇀ ℕ`: applied to
closed arguments that evaluate to the numerals of `v`, it evaluates to the
numeral of every `y ∈ f v`. This is a defined-result simulation: it imposes
no condition on inputs outside the domain of `f`. For total `f`,
`Realizes.total` gives computation at every input. -/
def Realizes {p : Bool} {n : ℕ} (t : Closed p (Ty.arrows n)) (f : List.Vector ℕ n →. ℕ) :
    Prop :=
  ∀ (us : Fin n → Closed p .nat) (v : List.Vector ℕ n),
    (∀ i, us i ⇓ Term.num (v.get i)) → ∀ y ∈ f v, Term.apps t us ⇓ Term.num y

namespace Realizes

variable {p : Bool}

/-- Realizing a total function. -/
theorem of_total {n : ℕ} {t : Closed p (Ty.arrows n)} {f : List.Vector ℕ n → ℕ}
    (h : ∀ (us : Fin n → Closed p .nat) (v : List.Vector ℕ n),
      (∀ i, us i ⇓ Term.num (v.get i)) → Term.apps t us ⇓ Term.num (f v)) :
    Realizes t (f : List.Vector ℕ n →. ℕ) := by
  intro us v hv y hy
  rw [PFun.coe_val, Part.mem_some_iff] at hy
  exact hy ▸ h us v hv

/-- A realizer of a total function computes it. -/
theorem total {n : ℕ} {t : Closed p (Ty.arrows n)} {f : List.Vector ℕ n → ℕ}
    (h : Realizes t (f : List.Vector ℕ n →. ℕ)) {us : Fin n → Closed p .nat}
    {v : List.Vector ℕ n} (hv : ∀ i, us i ⇓ Term.num (v.get i)) :
    Term.apps t us ⇓ Term.num (f v) :=
  h us v hv _ (by rw [PFun.coe_val]; exact Part.mem_some _)

/-- The constant `0` of no arguments. -/
theorem zero : Realizes (n := 0) (Term.zero : Closed p .nat) fun _ => (0 : ℕ) :=
  of_total fun _ _ _ => .val .zero

/-- The successor function `fun x. succ(x)`. -/
theorem succ :
    Realizes (Term.lams 1 (Term.succ (Term.args 1 0)) : Closed p (Ty.arrows 1))
      fun v => v.head.succ :=
  of_total fun us v hv => Expands.apps_lams_closed _ us (by
    simp only [Term.args, TypedLambda.Term.subst_var, Term.subst_succ, Subst.extendN_argVar]
    rw [← List.Vector.get_zero]
    exact .succ' (hv 0))

/-- The projection `fun x₀ ⋯ xₙ₋₁. xᵢ`. -/
theorem get {n : ℕ} (i : Fin n) :
    Realizes (Term.lams n (Term.args n i) : Closed p (Ty.arrows n)) fun v => v.get i :=
  of_total fun us _ hv => Expands.apps_lams_closed _ us (by
    simp only [Term.args, TypedLambda.Term.subst_var, Subst.extendN_argVar]
    exact hv i)

/-- The composition `fun x. f' (g'₀ x) ⋯ (g'ₙ₋₁ x)`. -/
def compTerm {m n : ℕ} (f' : Closed p (Ty.arrows n)) (g' : Fin n → Closed p (Ty.arrows m)) :
    Closed p (Ty.arrows m) :=
  Term.lams m (Term.apps (TypedLambda.Term.ofClosed f') fun i =>
    Term.apps (TypedLambda.Term.ofClosed (g' i)) (Term.args m))

/-- The composition `compTerm f' g'` applied to `us` head-expands to
`f' (g'₀ us) ⋯ (g'ₙ₋₁ us)`. -/
theorem comp_expands {m n : ℕ} (f' : Closed p (Ty.arrows n))
    (g' : Fin n → Closed p (Ty.arrows m)) (us : Fin m → Closed p .nat) :
    Expands (Term.apps f' fun i => Term.apps (g' i) us) (Term.apps (compTerm f' g') us) :=
  Expands.trans (.of_eq (by simp)) (Expands.apps_lams_closed _ us)

/-- Composition of total functions, as in `Nat.Primrec'.comp`. -/
theorem comp_total {m n : ℕ} {f : List.Vector ℕ n → ℕ} {g : Fin n → List.Vector ℕ m → ℕ}
    {f' : Closed p (Ty.arrows n)} {g' : Fin n → Closed p (Ty.arrows m)}
    (hf : Realizes f' (f : List.Vector ℕ n →. ℕ))
    (hg : ∀ i, Realizes (g' i) (g i : List.Vector ℕ m →. ℕ)) :
    Realizes (compTerm f' g')
      ((fun v => f (List.Vector.ofFn fun i => g i v)) : List.Vector ℕ m →. ℕ) :=
  of_total fun us _ hv => comp_expands f' g' us (hf.total fun i => by
    rw [List.Vector.get_ofFn]
    exact (hg i).total hv)

/-- The components of a vector in `mOfFn g` lie in the corresponding `g i`. -/
theorem mem_mOfFn : {n : ℕ} → {g : Fin n → Part ℕ} → {w : List.Vector ℕ n} →
    w ∈ List.Vector.mOfFn g → ∀ i, w.get i ∈ g i
  | 0, _, _, _, i => i.elim0
  | n + 1, g, w, h, i => by
    simp only [List.Vector.mOfFn, Part.bind_eq_bind, Part.mem_bind_iff] at h
    obtain ⟨a, ha, v, hv, hw⟩ := h
    rw [Part.mem_some_iff.mp hw]
    refine Fin.cases ?_ (fun i => ?_) i
    · rwa [List.Vector.get_cons_zero]
    · rw [List.Vector.get_cons_succ]
      exact mem_mOfFn hv i

/-- Composition of partial functions, as in `Nat.Partrec'.comp`. -/
theorem comp {m n : ℕ} {f : List.Vector ℕ n →. ℕ} {g : Fin n → List.Vector ℕ m →. ℕ}
    {f' : Closed p (Ty.arrows n)} {g' : Fin n → Closed p (Ty.arrows m)}
    (hf : Realizes f' f) (hg : ∀ i, Realizes (g' i) (g i)) :
    Realizes (compTerm f' g') fun v => (List.Vector.mOfFn fun i => g i v) >>= f := by
  intro us v hv y hy
  obtain ⟨w, hw, hy⟩ := Part.mem_bind_iff.mp hy
  exact comp_expands f' g' us (hf _ w (fun i => hg i us v hv _ (mem_mOfFn hw i)) y hy)

/-- The body of `precTerm`. -/
def precBody {n : ℕ} (f' : Closed p (Ty.arrows n)) (g' : Closed p (Ty.arrows (n + 2))) :
    Term p (ctxN (n + 1) [Ty.arrows (n + 1)]) .nat :=
  Term.ite (Term.isZero (Term.args (n + 1) 0))
    (Term.apps (TypedLambda.Term.ofClosed f') fun i => Term.args (n + 1) i.succ)
    (Term.apps
      (.app (.app (TypedLambda.Term.ofClosed g')
        (Term.pred (Term.args (n + 1) 0)))
        (Term.apps (.app (.var (Term.liftVar (n + 1) .zero)) (Term.pred (Term.args (n + 1) 0)))
          fun i => Term.args (n + 1) i.succ))
      fun i => Term.args (n + 1) i.succ)

/-- Example 19: primitive recursion. If `f'` codes `f` and `g'` codes `g`, then
`H = fix(fun h. fun y x. if zero?(y) then f' x else g' (pred y) (h (pred y) x) x)`
codes the function `h` with `h(0, x) = f(x)` and `h(y+1, x) = g(y, h(y, x), x)`. -/
def precTerm {n : ℕ} (f' : Closed p (Ty.arrows n)) (g' : Closed p (Ty.arrows (n + 2))) :
    Closed p (Ty.arrows (n + 1)) :=
  Term.fix (.lam (Term.lams (n + 1) (precBody f' g')))

/-- Correctness of `precTerm`, by induction on the value `k` of the recursion
argument, for any `h` satisfying the recursion equations. -/
theorem prec_eval {n : ℕ} {f' : Closed p (Ty.arrows n)} {g' : Closed p (Ty.arrows (n + 2))}
    {us : Fin n → Closed p .nat} (h : ℕ → ℕ) (h0 : Term.apps f' us ⇓ Term.num (h 0))
    (hs : ∀ k {u w : Closed p .nat}, u ⇓ Term.num k → w ⇓ Term.num (h k) →
      Term.apps (.app (.app g' u) w) us ⇓ Term.num (h (k + 1)))
    (k : ℕ) {u : Closed p .nat} (hu : u ⇓ Term.num k) :
    Term.apps (.app (precTerm f' g') u) us ⇓ Term.num (h k) := by
  induction k generalizing u with
  | zero =>
    rw [← Term.apps_cons]
    refine Expands.apps_fix_lams _ _ ?_
    simp [precBody, Subst.single]
    exact .iteT' (.isZeroZ' hu) h0
  | succ k ih =>
    rw [← Term.apps_cons]
    refine Expands.apps_fix_lams _ _ ?_
    simp [precBody, Subst.single]
    exact .iteF' (.isZeroS' hu) (hs k (.pred' hu) (ih (.pred' hu)))

/-- Primitive recursion, as in `Nat.Primrec'.prec`. -/
theorem prec {n : ℕ} {f : List.Vector ℕ n → ℕ} {g : List.Vector ℕ (n + 2) → ℕ}
    {f' : Closed p (Ty.arrows n)} {g' : Closed p (Ty.arrows (n + 2))}
    (hf : Realizes f' (f : List.Vector ℕ n →. ℕ))
    (hg : Realizes g' (g : List.Vector ℕ (n + 2) →. ℕ)) :
    Realizes (precTerm f' g') (PFun.lift fun v : List.Vector ℕ (n + 1) =>
      v.head.rec (f v.tail) fun y IH => g (y ::ᵥ IH ::ᵥ v.tail)) :=
  of_total fun ws v hv => by
    have hus : ∀ i, Fin.tail ws i ⇓ Term.num (v.tail.get i) := fun i => by
      rw [List.Vector.get_tail_succ]
      exact hv i.succ
    have h0 : ws 0 ⇓ Term.num v.head := by
      rw [← List.Vector.get_zero]
      exact hv 0
    refine prec_eval (fun k => Nat.rec (motive := fun _ => ℕ) (f v.tail)
      (fun y IH => g (y ::ᵥ IH ::ᵥ v.tail)) k) (hf.total hus) (fun k u w hu hw => ?_) v.head h0
    refine hg.total (us := Fin.cons u (Fin.cons w (Fin.tail ws))) (fun i => ?_)
    refine Fin.cases ?_ (fun i => Fin.cases ?_ (fun i => ?_) i) i
    · simpa using hu
    · simp only [Fin.cons_succ, Fin.cons_zero, List.Vector.get_cons_succ,
        List.Vector.get_cons_zero]
      exact hw
    · simpa using hus i

/-- The body of `rfindAux`. -/
def rfindBody {n : ℕ} (k' : Closed p (Ty.arrows (n + 1))) :
    Term p (ctxN (n + 1) [Ty.arrows (n + 1)]) .nat :=
  Term.ite (Term.isZero (Term.apps (TypedLambda.Term.ofClosed k') (Term.args (n + 1))))
    (Term.args (n + 1) 0)
    (Term.apps (.app (.var (Term.liftVar (n + 1) .zero)) (Term.succ (Term.args (n + 1) 0)))
      fun i => Term.args (n + 1) i.succ)

/-- Example 19: the search of a minimisation,
`m' = fix(fun m'. fun y x. if zero?(k' y x) then y else m' (succ(y)) x)`. -/
def rfindAux {n : ℕ} (k' : Closed p (Ty.arrows (n + 1))) : Closed p (Ty.arrows (n + 1)) :=
  Term.fix (.lam (Term.lams (n + 1) (rfindBody k')))

/-- Example 19: minimisation. If `k'` codes `k`, then `fun x. m' 0 x` codes the
function `m` with `m(x)` the least `y` such that `k(y, x) = 0`. -/
def rfindTerm {n : ℕ} (k' : Closed p (Ty.arrows (n + 1))) : Closed p (Ty.arrows n) :=
  Term.lams n (Term.apps (.app (TypedLambda.Term.ofClosed (rfindAux k')) Term.zero) (Term.args n))

/-- Correctness of the search `rfindAux`, started at an argument evaluating to
`z ≤ y`, where `y` is the least zero of `c`; by induction on `d = y - z`. -/
theorem rfind_eval {n : ℕ} {k' : Closed p (Ty.arrows (n + 1))} {us : Fin n → Closed p .nat}
    (c : ℕ → ℕ)
    (hc : ∀ z {u : Closed p .nat}, u ⇓ Term.num z → Term.apps k' (Fin.cons u us) ⇓ Term.num (c z))
    {y : ℕ} (hy : c y = 0) (hlt : ∀ z < y, c z ≠ 0) (d : ℕ) :
    ∀ z {u : Closed p .nat}, z + d = y → u ⇓ Term.num z →
      Term.apps (.app (rfindAux k') u) us ⇓ Term.num y := by
  induction d with
  | zero =>
    intro z u hz hu
    rw [← Term.apps_cons]
    refine Expands.apps_fix_lams _ _ ?_
    simp [rfindBody, Subst.single]
    obtain rfl : z = y := hz
    have h := hc z hu
    rw [hy] at h
    exact .iteT' (.isZeroZ' h) hu
  | succ d ih =>
    intro z u hz hu
    rw [← Term.apps_cons]
    refine Expands.apps_fix_lams _ _ ?_
    simp [rfindBody, Subst.single]
    obtain ⟨c', hc'⟩ := Nat.exists_eq_succ_of_ne_zero (hlt z (by omega))
    have h := hc z hu
    rw [hc'] at h
    exact .iteF' (.isZeroS' h) (ih (z + 1) (by omega) (.succ' hu))

/-- Minimisation, as in `Nat.Partrec'.rfind`. -/
theorem rfind {n : ℕ} {f : List.Vector ℕ (n + 1) → ℕ} {k' : Closed p (Ty.arrows (n + 1))}
    (hf : Realizes k' (f : List.Vector ℕ (n + 1) →. ℕ)) :
    Realizes (rfindTerm k') fun v => Nat.rfind fun y => Part.some (decide (f (y ::ᵥ v) = 0)) := by
  intro us v hv y hy
  have hc : ∀ z {u : Closed p .nat}, u ⇓ Term.num z →
      Term.apps k' (Fin.cons u us) ⇓ Term.num (f (z ::ᵥ v)) := fun z u hu =>
    hf.total fun i => Fin.cases (by simpa using hu) (fun i => by simpa using hv i) i
  have hy0 : f (y ::ᵥ v) = 0 := by simpa using Nat.rfind_spec hy
  have hlt : ∀ z < y, f (z ::ᵥ v) ≠ 0 := fun z hz => by simpa using Nat.rfind_min hy hz
  refine Expands.apps_lams_closed _ us ?_
  simp
  exact rfind_eval _ hc hy0 hlt y 0 (Nat.zero_add y) (.val .zero)

end Realizes

/-! ### Example 19 -/

variable {p : Bool}

/-- Every primitive recursive function (in the sense of `Nat.Primrec'`) has a
realizer. -/
theorem exists_realizes_of_primrec' {n : ℕ} {f : List.Vector ℕ n → ℕ} (hf : Nat.Primrec' f) :
    ∃ t : Closed p (Ty.arrows n), Realizes t (f : List.Vector ℕ n →. ℕ) := by
  induction hf with
  | zero => exact ⟨_, Realizes.zero⟩
  | succ => exact ⟨_, Realizes.succ⟩
  | get i => exact ⟨_, Realizes.get i⟩
  | comp g _ _ ihf ihg =>
    obtain ⟨f', hf'⟩ := ihf
    choose g' hg' using ihg
    exact ⟨_, Realizes.comp_total hf' hg'⟩
  | prec _ _ ihf ihg =>
    obtain ⟨f', hf'⟩ := ihf
    obtain ⟨g', hg'⟩ := ihg
    exact ⟨_, Realizes.prec hf' hg'⟩

/-- Every partial recursive function (in the sense of `Nat.Partrec'`) has a
realizer. -/
theorem exists_realizes {n : ℕ} {f : List.Vector ℕ n →. ℕ} (hf : Nat.Partrec' f) :
    ∃ t : Closed p (Ty.arrows n), Realizes t f := by
  induction hf with
  | prim hf => exact exists_realizes_of_primrec' hf
  | comp g _ _ ihf ihg =>
    obtain ⟨f', hf'⟩ := ihf
    choose g' hg' using ihg
    exact ⟨_, Realizes.comp hf' hg'⟩
  | rfind _ ih =>
    obtain ⟨k', hk'⟩ := ih
    exact ⟨_, Realizes.rfind hk'⟩

/-- Example 19 for functions of several arguments: every partial recursive
`f : ℕⁿ ⇀ ℕ` is coded by a closed PCF term `t : nat -> ⋯ -> nat -> nat` such
that `t v̄₀ ⋯ v̄ₙ₋₁ ⇓ f(v)` whenever `f(v)` is defined. -/
theorem partrec'_definable {n : ℕ} {f : List.Vector ℕ n →. ℕ} (hf : Nat.Partrec' f) :
    ∃ t : Closed false (Ty.arrows n), ∀ v, ∀ y ∈ f v,
      Term.apps t (fun i => Term.num (v.get i)) ⇓ Term.num y := by
  obtain ⟨t, ht⟩ := exists_realizes hf
  exact ⟨t, fun v => ht _ v fun i => Eval.num _⟩

/-- Example 19: every partial recursive function `φ : ℕ ⇀ ℕ` is coded by a
closed PCF term `φ' : nat -> nat` such that `φ' n̄ ⇓ φ(n)` whenever `φ(n)` is
defined. -/
theorem partrec_definable {f : ℕ →. ℕ} (hf : Partrec f) :
    ∃ t : Closed false (Ty.nat ⤳ Ty.nat), ∀ n, ∀ y ∈ f n, .app t (Term.num n) ⇓ Term.num y := by
  obtain ⟨t, ht⟩ := partrec'_definable (Nat.Partrec'.part_iff₁.mpr hf)
  exact ⟨t, fun n y hy => ht (n ::ᵥ List.Vector.nil) y hy⟩

/-- Example 19, for `Nat.Partrec`. -/
theorem nat_partrec_definable {f : ℕ →. ℕ} (hf : Nat.Partrec f) :
    ∃ t : Closed false (Ty.nat ⤳ Ty.nat), ∀ n, ∀ y ∈ f n, .app t (Term.num n) ⇓ Term.num y :=
  partrec_definable (Partrec.nat_iff.mpr hf)

end Silmaril.Calculi.PCF
