(rec
  (def
    "disjoint_"
    (typ "X")
    (exp "_" (iter (var "X") list))
    bool
    (clause (typ "X") (typ (var "X")) (exp (list)) (bool true))
    (clause
      (typ "X")
      (exp "x" (var "X"))
      (exp "x'*" (iter (var "X") list))
      (typ (var "X"))
      (exp (cat (list (var "x")) (iter (var "x'") list (dom "x'" (var "x'*")))))
      (bin
        and
        bool
        (un
          not
          bool
          (mem (var "x") (iter (var "x'") list (dom "x'" (var "x'*"))))
        )
        (call
          "disjoint_"
          (typ (var "X"))
          (exp (iter (var "x'") list (dom "x'" (var "x'*"))))
        )
      )
    )
  )
)
(def
  "equiv_"
  (typ "X")
  (exp "_" (iter (var "X") list))
  (exp "_" (iter (var "X") list))
  bool
  (clause
    (typ "X")
    (exp "x_1*" (iter (var "X") list))
    (exp "x_2*" (iter (var "X") list))
    (typ (var "X"))
    (exp (iter (var "x_1") list (dom "x_1" (var "x_1*"))))
    (exp (iter (var "x_2") list (dom "x_2" (var "x_2*"))))
    (bool true)
    (iter
      (if (mem (var "x_1") (iter (var "x_2") list (dom "x_2" (var "x_2*")))))
      list
      (dom "x_1" (var "x_1*"))
    )
    (iter
      (if (mem (var "x_2") (iter (var "x_1") list (dom "x_1" (var "x_1*")))))
      list
      (dom "x_2" (var "x_2*"))
    )
  )
  (clause
    (typ "X")
    (exp "x_1*" (iter (var "X") list))
    (exp "x_2*" (iter (var "X") list))
    (typ (var "X"))
    (exp (iter (var "x_1") list (dom "x_1" (var "x_1*"))))
    (exp (iter (var "x_2") list (dom "x_2" (var "x_2*"))))
    (bool false)
    else
  )
)
(rec
  (def
    "transpose_"
    (typ "X")
    (exp "_" (iter (iter (var "X") list) list))
    (iter (iter (var "X") list) list)
    (clause
      (typ "X")
      (exp "n" nat)
      (typ (var "X"))
      (exp (iter (list) (listn (var "n"))))
      (list)
    )
    (clause
      (typ "X")
      (exp "x**" (iter (iter (var "X") list) list))
      (exp "x_1*" (iter (var "X") list))
      (typ (var "X"))
      (exp
        (iter
          (cat (list (var "x_1")) (iter (var "x") list (dom "x" (var "x*"))))
          list
          (dom "x*" (var "x**"))
          (dom "x_1" (var "x_1*"))
        )
      )
      (cat
        (list (iter (var "x_1") list (dom "x_1" (var "x_1*"))))
        (call
          "transpose_"
          (typ (var "X"))
          (exp
            (iter
              (iter (var "x") list (dom "x" (var "x*")))
              list
              (dom "x*" (var "x**"))
            )
          )
        )
      )
    )
  )
)
