import Silmaril.Wasm.Wit.Binary.Embed.Defs

/-!
The generator of the component ASTs of `Silmaril/Project/WasmComponents/Kernel/*/Defs.lean`: the
`wasi:io` packages (`wasi:io@0.2.12` as published and as the `tests/wat` fixture, and
`wasi:io@0.2.6`) and the `component-type` payloads the two v50.0.1 preview1 adapters embed. Each
AST is what Silmaril's verified component parser (`Silmaril.Wasm.Component.Binary.parse`) gives on
the file, by compiled evaluation, printed as Lean source. Byte payloads (custom sections) are
printed as `Silmaril.IncludeBytes.decode` terms with 4 KiB little-endian chunk literals, the
representation of `include_bytes`. Run from the repository root:

    lake env lean --run examples/wasm-components/gen/Kernel.lean

Nothing here is trusted: `Silmaril.Project.WasmComponents.Kernel.*.Thms` proves in the kernel that
Silmaril's encoder (`Binary.Encode.ast`) writes exactly the registered bytes from each AST, so
the parser reads them back (`Binary.parse_encode`).
-/

open Silmaril.Wasm.Component.Binary

def hexDigits : List Char := "0123456789abcdef".toList

/-- A little-endian chunk as a hexadecimal literal (most significant byte first). -/
def hexLE (bs : List UInt8) : String := Id.run do
  let mut s := ""
  for b in bs.reverse do
    s := (s.push (hexDigits[b.toNat / 16]!)).push (hexDigits[b.toNat % 16]!)
  return if s.isEmpty then "0" else "0x" ++ s

def chunks : Nat → List UInt8 → List (List UInt8)
  | 0, _ => []
  | fuel + 1, l => if l.isEmpty then [] else l.take 4096 :: chunks fuel (l.drop 4096)

def ppBytes (b : ByteArray) : String :=
  let l := b.data.toList
  s!"(Silmaril.IncludeBytes.decode 4096 {l.length} [{", ".intercalate ((chunks l.length l).map hexLE)}])"

def r {α : Type} [Repr α] (a : α) : String := Std.Format.pretty (repr a) 100000
def par (s : String) : String := "(" ++ s ++ ")"
def lst (l : List String) : String := "[" ++ ", ".intercalate l ++ "]"
def B : String := "Silmaril.Wasm.Component.Binary."

mutual
partial def ppDefType : DefType → String
  | .val d => s!"{B}DefType.val {par (r d)}"
  | .func f => s!"{B}DefType.func {par (r f)}"
  | .component ds => s!"{B}DefType.component {lst (ds.map ppComponentDecl)}"
  | .instance ds => s!"{B}DefType.instance {lst (ds.map ppInstanceDecl)}"
  | .resource rep d => s!"{B}DefType.resource {par (r rep)} {par (r d)}"
partial def ppInstanceDecl : InstanceDecl → String
  | .coreType t => s!"{B}InstanceDecl.coreType {par (r t)}"
  | .type t => s!"{B}InstanceDecl.type {par (ppDefType t)}"
  | .alias a => s!"{B}InstanceDecl.alias {par (r a)}"
  | .export n d => s!"{B}InstanceDecl.export {par (r n)} {par (r d)}"
partial def ppComponentDecl : ComponentDecl → String
  | .import n d => s!"{B}ComponentDecl.import {par (r n)} {par (r d)}"
  | .inst d => s!"{B}ComponentDecl.inst {par (ppInstanceDecl d)}"
end

mutual
partial def ppSection : Section → String
  | .custom n d => s!"{B}Section.custom {r n} {ppBytes d}"
  | .coreModule b => s!"{B}Section.coreModule {ppBytes b}"
  | .coreInstances xs => s!"{B}Section.coreInstances {r xs}"
  | .coreTypes xs => s!"{B}Section.coreTypes {r xs}"
  | .component c => s!"{B}Section.component {par (ppAst c)}"
  | .instances xs => s!"{B}Section.instances {r xs}"
  | .aliases xs => s!"{B}Section.aliases {r xs}"
  | .types xs => s!"{B}Section.types {lst (xs.map ppDefType)}"
  | .canons xs => s!"{B}Section.canons {r xs}"
  | .start s => s!"{B}Section.start {par (r s)}"
  | .imports xs => s!"{B}Section.imports {r xs}"
  | .exports xs => s!"{B}Section.exports {r xs}"
  | .values _ => "(panic! \"value sections are not printed\")"
partial def ppAst : Ast → String
  | .mk ss => s!"{B}Ast.mk {ppSections ss}"
partial def ppSections (ss : List Section) : String :=
  "[\n    " ++ ",\n    ".intercalate (ss.map ppSection) ++ "]"
end

def parseFile (b : ByteArray) (what : String) : IO Ast :=
  match parse b with
  | .ok c => pure c
  | .error e => throw (IO.userError s!"{what}: parse error at {e.pos}")

def header (title doc imports : String) : String :=
  s!"module\n\n{imports}\n/-!\n# {title}\n\nGENERATED by `lake env lean --run examples/wasm-components/gen/Kernel.lean` (compiled\n" ++
  "evaluation of Silmaril's verified component parser on the registered files); do not edit.\n" ++
  s!"{doc}\n-/\n\n@[expose] public section\n\nnamespace Silmaril.Project.WasmComponents.Kernel\n\nopen Silmaril.Wasm.Component.Binary\n\n"

/-- Drop the namespace prefix (the modules `open Silmaril.Wasm.Component.Binary`). -/
def short (s : String) : String :=
  ((s.replace "Silmaril.Wasm.Component.Binary." "").replace "import Defs" "import Silmaril.Wasm.Component.Binary.Defs").replace "open Binary" "open Silmaril.Wasm.Component.Binary"

def footer : String := "end Silmaril.Project.WasmComponents.Kernel\n\nend\n"

def defn (doc name ty val : String) : String :=
  s!"/-- {doc} -/\ndef {name} : {ty} :=\n  {val}\n\n"

def writeModule (path : System.FilePath) (s : String) : IO Unit := do
  IO.FS.writeFile path (short s)
  IO.println s!"wrote {path}"

def imps : String := "public import Silmaril.Wasm.Component.Binary.Defs\npublic import Silmaril.Data.IncludeBytes.Types\n"

def dir : System.FilePath := "Silmaril/Project/WasmComponents/Kernel"

/-- The `wasi:io` packages: the published 0.2.12 and the fixture share their item sections and
`package-docs`, which is checked here and is what `Io0212.Defs` states. -/
def genIo : IO Unit := do
  let oci ← parseFile (← IO.FS.readBinFile "examples/wasm-components/components/wasi/io-0.2.12.wasm") "io-0.2.12"
  let fix ← parseFile (← IO.FS.readBinFile "tests/wat/fixtures/wasi-io-0.2.12.wasm") "fixture"
  let ss := oci.sections
  let fs := fix.sections
  let shared := ss.take 9
  unless (fs.take 9).map ppSection == shared.map ppSection do
    throw (IO.userError "the fixture's first nine sections differ")
  let doc := "The item sections of `wasi:io@0.2.12` (shared by the published file and the fixture), its\n" ++
    "`package-docs` section, and the trailing custom sections of each file."
  let mut s := header "`wasi:io@0.2.12`: the component ASTs of the two files" doc imps
  s := s ++ defn "The eight item sections (types and exports) of `wasi:io@0.2.12`." "io0212Items"
    s!"List {B}Section" (ppSections (shared.take 8))
  s := s ++ defn "The `package-docs` section of `wasi:io@0.2.12` (both files)." "io0212Docs"
    s!"{B}Section" (String.join ((shared.drop 8).take 1 |>.map ppSection))
  s := s ++ defn "The trailing custom sections of the published file: `producers`, `component-name`, `version`."
    "io0212OciTail" s!"List {B}Section" (ppSections (ss.drop 9))
  s := s ++ defn "The trailing custom section of the fixture: `producers`." "io0212FixtureTail"
    s!"List {B}Section" (ppSections (fs.drop 9))
  s := s ++ defn "The published `wasi:io@0.2.12` (`components/wasi/io-0.2.12.wasm`)." "io0212OciAst"
    s!"{B}Ast" s!"{B}Ast.mk (io0212Items ++ io0212Docs :: io0212OciTail)"
  s := s ++ defn "The fixture `tests/wat/fixtures/wasi-io-0.2.12.wasm`." "io0212FixtureAst"
    s!"{B}Ast" s!"{B}Ast.mk (io0212Items ++ io0212Docs :: io0212FixtureTail)"
  writeModule (dir / "Io0212" / "Defs.lean") (s ++ footer)
  let v6 ← parseFile (← IO.FS.readBinFile "examples/wasm-components/components/wasi/io-0.2.6.wasm") "io-0.2.6"
  let mut t := header "`wasi:io@0.2.6`: the component AST of the published file" "" imps
  t := t ++ defn "The published `wasi:io@0.2.6` (`components/wasi/io-0.2.6.wasm`)." "io026Ast"
    s!"{B}Ast" (ppAst v6)
  writeModule (dir / "Io026" / "Defs.lean") (t ++ footer)

/-- The `component-type` payload a core module embeds. -/
def payload (f : String) : IO ByteArray := do
  match Silmaril.Wasm.Wit.Binary.extractPayload (← IO.FS.readBinFile f) with
  | .ok p => pure p
  | .error e => throw (IO.userError s!"{f}: {e}")

def genAdapter (kind modName : String) : IO Unit := do
  let f := s!"examples/wasm-components/adapter/wasi_snapshot_preview1.{kind}.wasm"
  let c ← parseFile (← payload f) f
  let mut s := header s!"The {kind} adapter: the component AST of its embedded world"
    s!"The `component-type` custom section of `adapter/wasi_snapshot_preview1.{kind}.wasm` (wasmtime\nv50.0.1) is a component; this is its AST." imps
  s := s ++ defn s!"The `component-type` payload of the {kind} adapter." s!"{kind}PayloadAst" s!"{B}Ast" (ppAst c)
  writeModule (dir / modName / "Defs.lean") (s ++ footer)

def main : IO Unit := do
  genIo
  genAdapter "reactor" "Reactor"
  genAdapter "command" "Command"
