import Silmaril.Project.Shapes.Component.Via.Defs

/-!
The generator of `Silmaril/Project/WasmComponents/Versions/Defs.lean`: the worlds the wasmtime
v50.0.1 preview1 adapters embed (`wasm.module.world`, `Wit.Binary.extractWorldType`), their core
imports (`wasm.module`, the core decoder) and the summaries (`Shapes.Component.summary`) of
`wasi:io@0.2.6` and `wasi:io@0.2.12` (`wit.binary`, `Wit.Binary.decodePackage`), each by
compiled evaluation of Silmaril's decoders on the registered files. Run from the repository root:

    lake env lean --run examples/wasm-components/gen/Versions.lean > Silmaril/Project/WasmComponents/Versions/Defs.lean

`Silmaril.Project.WasmComponents.Versions.Thms` states the equations between these terms and the
registered values as frozen `Task`s (the kernel does not evaluate the decoders on files of this
size); this script is their compiled check.
-/

open Silmaril.Project.Formats Silmaril.Project.Shapes.Component

def dir : System.FilePath := "examples/wasm-components"

def world (f : String) : IO EmbeddedWorld := do
  match wasmModuleWorld.parse ⟨← IO.FS.readBinFile (dir / f)⟩ with
  | some w => pure w
  | none => throw (IO.userError s!"{f}: no embedded world")

def imports (f : String) : IO (List CoreImport) := do
  match wasm.parse ⟨← IO.FS.readBinFile (dir / f)⟩ with
  | some m => pure (coreImports m)
  | none => throw (IO.userError s!"{f}: the core decoder failed")

def pkg (f : String) : IO PackageSummary := do
  match witBinary.parse ⟨← IO.FS.readBinFile (dir / f)⟩ with
  | some p => pure (summary p)
  | none => throw (IO.userError s!"{f}: not a WIT package")

/-- A core import as Lean source, one per line (`repr` breaks structure instances). -/
def importSrc : CoreImport → String
  | (none, n) => s!"(none, {repr n})"
  | (some i, n) =>
    s!"(some ⟨⟨{repr i.pkg.ns}, {repr i.pkg.name}, {repr i.pkg.version}⟩, {repr i.name}⟩, {repr n})"

def importsSrc (l : List CoreImport) : Std.Format :=
  Std.Format.text ("[" ++ ",\n   ".intercalate (l.map importSrc) ++ "]")

def defn (doc name ty : String) (val : Std.Format) : String :=
  s!"/-- {doc} -/\ndef {name} : {ty} :=\n  {Std.Format.pretty val 100 2}\n\n"

def main : IO Unit := do
  let r := "adapter/wasi_snapshot_preview1.reactor.wasm"
  let c := "adapter/wasi_snapshot_preview1.command.wasm"
  let mut out := "module\n\npublic import Silmaril.Project.Shapes.Component.Via.Defs\n\n" ++
    "/-!\n# WASI versions of registered releases: decoded terms\n\n" ++
    "GENERATED by `lake env lean --run examples/wasm-components/gen/Versions.lean` (compiled\n" ++
    "evaluation of Silmaril's decoders on the registered files); do not edit. The equations between\n" ++
    "these terms and the registered values are the frozen `Task`s of\n" ++
    "`Silmaril.Project.WasmComponents.Versions.Thms`.\n-/\n\n" ++
    "@[expose] public section\n\nnamespace Silmaril.Project.WasmComponents.Versions\n\n" ++
    "open Silmaril.Wasm.Wit.Binary\n\n"
  out := out ++ defn s!"The world `{r}` embeds." "reactorWorld" "Silmaril.Project.Formats.EmbeddedWorld" (repr (← world r))
  out := out ++ defn s!"The world `{c}` embeds." "commandWorld" "Silmaril.Project.Formats.EmbeddedWorld" (repr (← world c))
  out := out ++ defn s!"The core imports of `{r}`, read (`coreImports`)." "reactorImports" "List Silmaril.Project.Shapes.Component.CoreImport" (importsSrc (← imports r))
  out := out ++ defn s!"The core imports of `{c}`, read (`coreImports`)." "commandImports" "List Silmaril.Project.Shapes.Component.CoreImport" (importsSrc (← imports c))
  out := out ++ defn "The summary of `wasi:io@0.2.6` (`components/wasi/io-0.2.6.wasm`)." "io026Summary" "Silmaril.Project.Shapes.Component.PackageSummary" (repr (← pkg "components/wasi/io-0.2.6.wasm"))
  out := out ++ defn "The summary of `wasi:io@0.2.12` (`components/wasi/io-0.2.12.wasm`)." "io0212Summary" "Silmaril.Project.Shapes.Component.PackageSummary" (repr (← pkg "components/wasi/io-0.2.12.wasm"))
  out := out ++ "end Silmaril.Project.WasmComponents.Versions\n\nend\n"
  IO.print out
