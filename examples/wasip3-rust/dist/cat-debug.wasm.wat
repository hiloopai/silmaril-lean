\a7\1c \06\03\d9c\d6\06\03\a8\1c \06\03\d8c\d6\06\03\a9\1c \06\03\d7c\d6\06\03\aa\1c \06\03\d6c\d6\06\03\ab\1c \06\03\d5c\d6\06\03\ac\1c \06\03\d4c\d6\06\03\ad\1c \06\03\d3c\d6\06\03\ae\1c \06\03\d2c\d6\06\03\af\1c \06\03\d1c\d6\06\03\b0\1c \06\03\d0c\d6\06\03\b1\1c \06\03\cfc\d6\06\03\b2\1c \06\03\cec\d6\06\03\b3\1c \06\03\cdc\d6\059\06\03\b5\1c \06\82\03\cbc\02s\01\05N\06\03\b9\1c \05J\06\08\ba\03\c7c\08.\05N\03\b9\1c \03\c7c\08<\04\03\05\12\06\03\ca\07\08\12\04\02\05A\03\ee\14\e4\05G\e3\05=\87\06\03\c4c\c8\05J\06\03\b9\1c \06\03\c7c\08<\05F\06\03\d0\1c \06\03\b0c\d6\06\03\bd\1c \06\03\c3c\9e\05V\06\03\c1\1c \05R\06\08\ba\03\bfc\08.\05V\03\c1\1c \03\bfc\08<\04\03\05\12\06\03\ca\07\08\12\04\02\05S\03\f6\14\e4\05V\e8\06\03\bcc\08\12\05R\06\03\c1\1c \06\03\bfc\08<\06\03\c4\1c \06\03\bcc\08.\05V\03\c4\1c \03\bcc\08<\04\03\05\12\06\03\ca\07\08\12\04\02\05S\03\f9\14\e4\05W\08j\05I\08%\05E\02*\14\05A\08u\06\03\b1c.\05R\06\03\c4\1c \06\03\bcc\08<\05J\06\03\d3\1c \059\06\08t\03\adc\08t\051\06\03\d6\1c \05-\08v\05)\02$\13\06\03\a7c.\05O\06\03\b3\1b \059\06\08t\03\cdd\08t\05>\06\03\b7\1b \05:\06\02=\12\03\c9d\08.\05>\03\b7\1b \03\c9d\08<\04\03\05\12\06\03\ca\07\08\12\04\02\05:\03\ec\13\e4\05?\e8\06\03\c6d\08\12\05:\06\03\b7\1b \06\03\c9d\08<\06\03\ba\1b \06\03\c6d\08.\05?\03\ba\1b \03\c6d\08<\04\03\05\12\06\03\ca\07\08\12\04\02\05:\03\ef\13\e4\05C\e9\06\03\c2d\08\12\05:\06\03\ba\1b \06\03\c6d\08<\05>\06\03\be\1b \06\03\c2d\08.\05C\03\be\1b \03\c2d\08<\04\03\05\12\06\03\ca\07\08\12\04\02\055\03\f3\13\e4\04\06\05\11\03\8be\e4\04\02\05:\03\f4\1a\82\05C\89\06\03\bdd\08\12\05>\06\03\be\1b \06\03\c2d\08<\06\03\c3\1b \06\03\bdd\08.\05C\03\c3\1b \03\bdd\08<\04\03\05\12\06\03\ca\07\08\12\04\02\055\03\f8\13\e4\04\06\05\11\03\86e\e4\04\02\05;\03\f9\1a\82\05C\89\06\03\b8d\08\12\05>\06\03\c3\1b \06\03\bdd\08<\06\03\c8\1b \06\03\b8d\08J\05C\03\c8\1b \03\b8d\08<\04\03\05\12\06\03\ca\07\08\12\04\02\055\03\fd\13\e4\05;\e3\05<\88\05L\08w\06\03\b1d\c8\05>\06\03\c8\1b \06\03\b8d\08<\06\03\e0\1b