ff\ff\ff\ff\03\cf\df\00\01\05,\0a\03\0c\02&\01\05\1d\02)\13\05<\081\05,\03\0b\ac\05=\06\82\05\19\ac\05,\06\02)\13\05\22\06\e4\05'\06\83\06\03\93\a0\7f\08J\05\22\06\03\ac\e0\00 \06\03\d4\9f\7f\d6\05!\06\03\f0\df\00 \05\1du\06\03\8f\a0\7f.\04\02\05\12\06\03\ca\07\08t\04\01\05)\03\ab\d8\00\d6\05.\e3\85\06\03\89\a0\7f\02=\01\05)\06\03\86\e0\00 \05-u\06\02#\12\03\f9\9f\7f\08 \05.\06\03\f8\df\00 \06\03\88\a0\7f\c8\06\03\f9\df\00 \06\03\87\a0\7f\c8\06\03\fa\df\00 \06\03\86\a0\7f\c8\06\03\fb\df\00 \06\03\85\a0\7f\c8\06\03\fc\df\00 \06\03\84\a0\7f\c8\06\03\fd\df\00 \06\03\83\a0\7f\c8\06\03\fe\df\00 \06\03\82\a0\7f\c8\06\03\ff\df\00 \06\03\81\a0\7f\c8\06\03\80\e0\00 \06\03\80\a0\7f\c8\06\03\81\e0\00 \06\03\ff\9f\7f\c8\05/\06\03\82\e0\00 \06\03\fe\9f\7f\c8\06\03\83\e0\00 \06\03\fd\9f\7f\c8\06\03\84\e0\00 \06\03\fc\9f\7f\c8\06\03\85\e0\00 \06\03\fb\9f\7f\c8\05-\06\03\87\e0\00 \06\82\03\f9\9f\7f\02s\01\05>\06\03\8b\e0\00 \06\03\f5\9f\7f\08\82\04\02\05\12\06\03\ca\07\08.\04\01\055\03\c0\d8\00\08 \05:\e3\051\87\06\03\f2\9f\7f\c8\05>\06\03\8b\e0\00 \06\03\f5\9f\7f\08<\05:\06\03\a2\e0\00 \06\03\de\9f\7f\d6\06\03\8f\e0\00 \06\03\f1\9f\7f\90\05F\06\03\93\e0\00 \06\03\ed\9f\7f\08J\04\02\05\12\06\03\ca\07\08.\04\01\05F\03\c8\d8\00\08 \e8\06\03\ea\9f\7f\08\12\06\03\93\e0\00 \06\03\ed\9f\7f\08<\04\02\05\12\06\03\ca\07\08<\04\01\05F\03\cb\d8\00\08 \05J\08j\05=\08%\059\02*\14\055\08Y\06\03\df\9f\7f.\05F\06\03\96\e0\00 \06\03\ea\9f\7f\08<\05>\06\03\a5\e0\00 \05-\06\08X\03\db\9f\7f\08X\05%\06\03\a8\e0\00 \05!\08>\06\03\d6\9f\7f\08<\05\19\06\03\ae\e0\00 \05\12\08>\02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\b4\e0\00\01\05,\0a\03\0a\02#\01\05\1d\02)\13\05<\081\05,\03\0b\ac\05\19\06\82\05,\06\02)\13\05\22\06\e4\05(\06\83\06\03\b0\9f\7f\08J\05\22\06\03\90\e1\00 \06\03\f0\9e\7f\c8\04\02\05\12\06\03\ca\07\08<\04\01\05.\03\89\d9\00\d6\05%\e5\05!\84\05\1d\d7\06\03\a9\9f\7f.\04\02\05\12\06\03\ca\07\08t\04\01\058\03\90\d9\00\d6\05.\06\e4\06\83\06\03\a5\9f\7f\02=\01\05)\06\03\ea\e0\00 \05-u\06\02#\12\03\95\9