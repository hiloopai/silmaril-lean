import Silmaril.Wasm.Component.BinaryP3.Defs

/-!
The generator of `Silmaril/Project/WasmP3Rust/CommandWorld/Defs.lean`: the world
`wasi:cli/command@0.3.0` as a `Silmaril.Wasm.Wit.Project.WorldType`, read from the binary encoding
of the WIT package `wasi:cli@0.3.0` that the pinned `wasm-tools` writes. Run from the repository
root:

    W=vendor/wasip3-0.9.0-wit
    mkdir -p build/cw/wit/deps && cp $W/cli.wit build/cw/wit/ && cp $W/{clocks,filesystem,random,sockets}.wit build/cw/wit/deps/
    ~/.cache/silmaril-tools/wasm-tools-1.262.0/wasm-tools component wit build/cw/wit --wasm -o build/cw/cli.wasm
    lake env lean --run examples/wasip3-rust/gen/World.lean build/cw/cli.wasm Silmaril/Project/WasmP3Rust/CommandWorld/Defs.lean

The package component exports, for each world, a component type `(component (type (component
<world>)) (export "wasi:cli/command@0.3.0" (component (type 0))))`; the generator prints the
declarations `<world>` of the export `command`. Nothing here is trusted: the generated module is
checked in the kernel (`CommandWorld.Thms`: the world resolves, and the examples target it).
-/

open Silmaril.Wasm.Component.Binary (DefType ComponentDecl InstanceDecl)

namespace WorldGen

def r {α : Type} [Repr α] (a : α) : String := Std.Format.pretty (repr a) 100000
def par (s : String) : String := "(" ++ s ++ ")"
def lst (l : List String) : String := "[" ++ ",\n    ".intercalate l ++ "]"
def lst1 (l : List String) : String := "[" ++ ", ".intercalate l ++ "]"
def B : String := "Silmaril.Wasm.Component.Binary."

mutual
partial def ppDefType : DefType → String
  | .val d => s!"{B}DefType.val {par (r d)}"
  | .func f => s!"{B}DefType.func {par (r f)}"
  | .component ds => s!"{B}DefType.component {lst1 (ds.map ppComponentDecl)}"
  | .instance ds => s!"{B}DefType.instance {lst1 (ds.map ppInstanceDecl)}"
  | .resource rep d => s!"{B}DefType.resource {par (r rep)} {par (r d)}"
partial def ppInstanceDecl : InstanceDecl → String
  | .coreType t => s!"{B}InstanceDecl.coreType {par (r t)}"
  | .type t => s!"{B}InstanceDecl.type {par (ppDefType t)}"
  | .alias a => s!"{B}InstanceDecl.alias {par (r a)}"
  | .export n d => s!"{B}InstanceDecl.export {par (r n)} {par (r d)}"
partial def ppComponentDecl : ComponentDecl → String
  | .import n d => s!"{B}ComponentDecl.import {par (r n)} {par (r d)}"
  | .inst d => s!"{B}ComponentDecl.inst {par (ppInstanceDecl d)}"
end

/-- The world declarations of the type exported as `name`. -/
def worldOf (c : Silmaril.Wasm.Component.BinaryP3.Ast) (name : String) : Option (List ComponentDecl) :=
  Id.run do
    let mut types : Array DefType := #[]
    let mut found : Option (List ComponentDecl) := none
    for s in c.sections do
      match s with
      | .types xs => types := types ++ xs.toArray
      | .exports es =>
        for e in es do
          if e.name.name = name then
            -- `(export "name" (type k))`: the type `k` is `(component (type (component W)) …)`.
            match types[e.item.idx]? with
            | some (.component (.inst (.type (.component w)) :: _)) => found := some w
            | _ => pure ()
          -- exports of types also define a type index
          if e.item.sort = .type then
            types := types.push (types[e.item.idx]?.getD (.val (.prim .bool)))
      | _ => pure ()
    return found

end WorldGen

open WorldGen in
def main (args : List String) : IO UInt32 := do
  let [inp, out] := args | IO.eprintln "usage: World.lean <cli.wasm> <out.lean>"; return 2
  let bytes ← IO.FS.readBinFile inp
  match Silmaril.Wasm.Component.BinaryP3.parse bytes with
  | .error e => IO.eprintln s!"parse error: {repr e}"; return 1
  | .ok c =>
    match worldOf c "command" with
    | none => IO.eprintln "no world `command`"; return 1
    | some w =>
      let body := s!"module\n\npublic import Silmaril.Wasm.Wit.Project.Defs\n\n/-!\n# The world `wasi:cli/command@0.3.0`, whole\n\n`command` is the component type of the world `command` of `wasi:cli@0.3.0` as `wit-component`\nencodes it (`wasm-tools 1.262.0 component wit --wasm` on the WIT of `wasip3 0.9.0+wasi-0.3.0`,\nvendored in `vendor/wasip3-0.9.0-wit`): {w.length} declarations, with the imports\nof `wasi:cli`, `wasi:clocks`, `wasi:filesystem`, `wasi:sockets` and `wasi:random` (the\n`@unstable` `wasi:clocks/timezone` is not part of it) and the export `wasi:cli/run@0.3.0`.\n\nGENERATED by `lake env lean --run examples/wasip3-rust/gen/World.lean`; do not edit.\n-/\n\n@[expose] public section\n\nnamespace Silmaril.Project.WasmP3Rust.CommandWorld\n\nset_option maxRecDepth 100000 in\n/-- **`wasi:cli/command@0.3.0`**, every import. -/\ndef command : Silmaril.Wasm.Wit.Project.WorldType :=\n  {lst (w.map ppComponentDecl)}\n\nend Silmaril.Project.WasmP3Rust.CommandWorld\n\nend\n"
      IO.FS.writeFile out body
      IO.println s!"wrote {out}: {w.length} declarations"
      return 0
