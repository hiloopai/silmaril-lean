import Silmaril.Wasm.Component.Streams.Run.Thms

/-!
# `wasm-streams`: executable tests of the stream transformer components

Runs the pipeline `producer → transformer → consumer` of `Silmaril.Wasm.Component.Streams.Proc`
(every step a call of the Component Model built-ins `Async.step`) under pseudo-random schedules
(`Run.runRandom`), with random inputs, random chunkings (empty chunks included), random batch
sizes and random read sizes, and checks for every run that

* the run finishes (all three components reach `fin`: no deadlock under that schedule), and
* the consumer's items are `T.run` of the concatenated input (what `Run.runRandom_correct`
  proves for every finished run) and agree with an independent reference implementation.

```
wasm-streams [TRIALS]          default 200 trials per transformer
wasm-streams wast CASE SEED [N] a wasmtime `.wast` test (CASE: map, filter, take7, take0,
                                dropempty), expected output from the Lean transformer;
                                N: the transformer's read size (default: from the seed,
                                1..8; 0 also means from the seed); `bytewise` after N: one
                                byte per stream.write of the transformer (default: all its
                                pending output at once)
```

Exit status 0 when every run passed, 1 otherwise. See `docs/projects/wasm-wasi.md`.
-/

/-!
# WAST generation for the wasmtime tests of `wasm-streams`

`pipelineWast` writes a `.wast` file with one component: a transformer component `$C`
(`transform: async func(in: stream<u8>) -> stream<u8>`, callback-style async lift, one core module
whose byte kernel is the transformer under test) and a driver component `$D` that creates the
input stream, calls `transform`, writes the input in the given chunks, reads the output with the
given read sizes (waiting on a waitable set whenever both copies are pending), and returns `42`
when the output equals the expected bytes. The expected bytes are `T.run` of the Lean
transformer; the components are hand-written WAT, so the test is differential: real Component
Model streams in wasmtime against the verified specification.
-/

namespace WasmStreams.Wast

/-- A byte kernel in WAT: the initial state, the per-byte step (`$k`, may call `$emit` and set
`$done`), and the flush (`$kflush`). -/
structure Kernel where
  init : Nat
  step : String
  flush : String := ""
  /-- `1` when the transformer is done before reading anything (`take 0`). -/
  done0 : Nat := 0

def mapInc : Kernel where
  init := 0
  step := "(call $emit (i32.and (i32.add (local.get $b) (i32.const 1)) (i32.const 0xff)))"

def filterNonDigit : Kernel where
  init := 0
  step := "(if (i32.or (i32.lt_u (local.get $b) (i32.const 48)) (i32.gt_u (local.get $b) (i32.const 57))) (then (call $emit (local.get $b))))"

def take (n : Nat) : Kernel where
  init := n
  done0 := if n == 0 then 1 else 0
  step := "(call $emit (local.get $b)) (global.set $st (i32.sub (global.get $st) (i32.const 1))) (if (i32.eqz (global.get $st)) (then (global.set $done (i32.const 1))))"

def dropEmptyLines : Kernel where
  init := 0
  step := "(if (i32.eq (local.get $b) (i32.const 10)) (then (if (global.get $st) (then (call $emit (i32.const 10)))) (global.set $st (i32.const 0))) (else (call $emit (local.get $b)) (global.set $st (i32.add (global.get $st) (i32.const 1)))))"
  flush := "(if (global.get $st) (then (call $emit (i32.const 10))))"

/-- A WAT data string. -/
def dataStr (bs : List Nat) : String :=
  let hex (n : Nat) : String :=
    let d := "0123456789abcdef".toList
    String.ofList [d.getD (n / 16 % 16) '0', d.getD (n % 16) '0']
  "\"" ++ String.join (bs.map fun b => "\\" ++ hex b) ++ "\""

/-- The `.wast` text of one test. -/
def pipelineWast (k : Kernel) (batch : Nat) (input : List Nat) (chunks : List Nat)
    (reads : List Nat) (expected : List Nat) (wholeWrites : Bool := true) : String :=
  let writeLen := if wholeWrites then "(i32.sub (global.get $outlen) (global.get $outoff))"
    else "(i32.const 1)"
  s!";; Generated by `wasm-streams wast`; see docs/projects/wasm-wasi.md.
(component
  (component $C
    (core module $Memory (memory (export \"mem\") 1))
    (core instance $memory (instantiate $Memory))
    (core module $CM
      (import \"\" \"mem\" (memory 1))
      (import \"\" \"task.return\" (func $task.return (param i32)))
      (import \"\" \"waitable.join\" (func $waitable.join (param i32 i32)))
      (import \"\" \"waitable-set.new\" (func $waitable-set.new (result i32)))
      (import \"\" \"stream.new\" (func $stream.new (result i64)))
      (import \"\" \"stream.read\" (func $stream.read (param i32 i32 i32) (result i32)))
      (import \"\" \"stream.write\" (func $stream.write (param i32 i32 i32) (result i32)))
      (import \"\" \"stream.drop-readable\" (func $stream.drop-readable (param i32)))
      (import \"\" \"stream.drop-writable\" (func $stream.drop-writable (param i32)))
      (global $ws (mut i32) (i32.const 0))
      (global $insr (mut i32) (i32.const 0))
      (global $outsw (mut i32) (i32.const 0))
      (global $outlen (mut i32) (i32.const 0))
      (global $outoff (mut i32) (i32.const 0))
      (global $eof (mut i32) (i32.const 0))
      (global $rdropped (mut i32) (i32.const 0))
      (global $flushed (mut i32) (i32.const 0))
      (global $done (mut i32) (i32.const {k.done0}))
      (global $wpend (mut i32) (i32.const 0))
      (global $rpend (mut i32) (i32.const 0))
      (global $st (mut i32) (i32.const {k.init}))
      (func $emit (param $b i32)
        (i32.store8 (i32.add (i32.const 0x1000) (global.get $outlen)) (local.get $b))
        (global.set $outlen (i32.add (global.get $outlen) (i32.const 1))))
      (func $k (param $b i32) {k.step})
      (func $kflush {k.flush})
      (func $stopReading
        (if (i32.eqz (global.get $rdropped))
          (then (call $stream.drop-readable (global.get $insr)) (global.set $rdropped (i32.const 1))))
        (global.set $eof (i32.const 1)))
      (func $onread (param $p i32) (local $n i32) (local $i i32)
        (local.set $n (i32.shr_u (local.get $p) (i32.const 4)))
        (block $out (loop $l
          (br_if $out (i32.ge_u (local.get $i) (local.get $n)))
          (br_if $out (global.get $done))
          (call $k (i32.load8_u (i32.add (i32.const 0x100) (local.get $i))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        ;; a copy may report DROPPED together with the items it copied
        (if (i32.ne (i32.and (local.get $p) (i32.const 0xf)) (i32.const 0)) (then (call $stopReading)))
        (if (global.get $done) (then (call $stopReading))))
      (func $pump (result i32) (local $r i32)
        (loop $l
          ;; at most one copy per stream end: an event may arrive on an idle end (DROPPED)
          (if (global.get $wpend)
            (then (return (i32.or (i32.const 2) (i32.shl (global.get $ws) (i32.const 4))))))
          (if (i32.lt_u (global.get $outoff) (global.get $outlen))
            (then
              (local.set $r (call $stream.write (global.get $outsw)
                (i32.add (i32.const 0x1000) (global.get $outoff))
                {writeLen}))
              (if (i32.eq (local.get $r) (i32.const -1))
                (then (global.set $wpend (i32.const 1))
                  (return (i32.or (i32.const 2) (i32.shl (global.get $ws) (i32.const 4))))))
              (if (i32.ne (i32.and (local.get $r) (i32.const 0xf)) (i32.const 0)) (then unreachable))
              (global.set $outoff (i32.add (global.get $outoff) (i32.shr_u (local.get $r) (i32.const 4))))
              (br $l)))
          (global.set $outoff (i32.const 0))
          (global.set $outlen (i32.const 0))
          (if (global.get $eof)
            (then
              (if (i32.eqz (global.get $flushed))
                (then (global.set $flushed (i32.const 1)) (call $kflush) (br $l)))
              (call $stream.drop-writable (global.get $outsw))
              (return (i32.const 0))))
          (if (global.get $rpend)
            (then (return (i32.or (i32.const 2) (i32.shl (global.get $ws) (i32.const 4))))))
          (local.set $r (call $stream.read (global.get $insr) (i32.const 0x100) (i32.const {batch})))
          (if (i32.eq (local.get $r) (i32.const -1))
            (then (global.set $rpend (i32.const 1))
              (return (i32.or (i32.const 2) (i32.shl (global.get $ws) (i32.const 4))))))
          (call $onread (local.get $r))
          (br $l))
        unreachable)
      (func (export \"transform\") (param i32) (result i32) (local $p i64)
        (global.set $insr (local.get 0))
        (local.set $p (call $stream.new))
        (global.set $outsw (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))))
        (global.set $ws (call $waitable-set.new))
        (call $task.return (i32.wrap_i64 (local.get $p)))
        (call $waitable.join (global.get $insr) (global.get $ws))
        (call $waitable.join (global.get $outsw) (global.get $ws))
        (if (global.get $done) (then (call $stopReading)))
        (call $pump))
      (func (export \"transform_cb\") (param $code i32) (param $idx i32) (param $p i32) (result i32)
        (if (i32.eq (local.get $code) (i32.const 2))
          (then (global.set $rpend (i32.const 0)) (call $onread (local.get $p))))
        (if (i32.eq (local.get $code) (i32.const 3))
          (then
            (global.set $wpend (i32.const 0))
            (if (i32.ne (i32.and (local.get $p) (i32.const 0xf)) (i32.const 0)) (then unreachable))
            (global.set $outoff (i32.add (global.get $outoff) (i32.shr_u (local.get $p) (i32.const 4))))))
        (call $pump)))
    (type $ST (stream u8))
    (canon task.return (result $ST) (memory (core memory $memory \"mem\")) (core func $task.return))
    (canon waitable.join (core func $waitable.join))
    (canon waitable-set.new (core func $waitable-set.new))
    (canon stream.new $ST (core func $stream.new))
    (canon stream.read $ST async (memory (core memory $memory \"mem\")) (core func $stream.read))
    (canon stream.write $ST async (memory (core memory $memory \"mem\")) (core func $stream.write))
    (canon stream.drop-readable $ST (core func $stream.drop-readable))
    (canon stream.drop-writable $ST (core func $stream.drop-writable))
    (core instance $cm (instantiate $CM (with \"\" (instance
      (export \"mem\" (memory $memory \"mem\"))
      (export \"task.return\" (func $task.return))
      (export \"waitable.join\" (func $waitable.join))
      (export \"waitable-set.new\" (func $waitable-set.new))
      (export \"stream.new\" (func $stream.new))
      (export \"stream.read\" (func $stream.read))
      (export \"stream.write\" (func $stream.write))
      (export \"stream.drop-readable\" (func $stream.drop-readable))
      (export \"stream.drop-writable\" (func $stream.drop-writable))))))
    (func (export \"transform\") async (param \"in\" (stream u8)) (result (stream u8)) (canon lift
      (core func $cm \"transform\")
      async (memory (core memory $memory \"mem\")) (callback (core func $cm \"transform_cb\")))))

  (component $D
    (import \"transform\" (func $transform async (param \"in\" (stream u8)) (result (stream u8))))
    (core module $Memory (memory (export \"mem\") 1))
    (core instance $memory (instantiate $Memory))
    (core module $DM
      (import \"\" \"mem\" (memory 1))
      (import \"\" \"waitable.join\" (func $waitable.join (param i32 i32)))
      (import \"\" \"waitable-set.new\" (func $waitable-set.new (result i32)))
      (import \"\" \"waitable-set.wait\" (func $waitable-set.wait (param i32 i32) (result i32)))
      (import \"\" \"stream.new\" (func $stream.new (result i64)))
      (import \"\" \"stream.read\" (func $stream.read (param i32 i32 i32) (result i32)))
      (import \"\" \"stream.write\" (func $stream.write (param i32 i32 i32) (result i32)))
      (import \"\" \"stream.drop-readable\" (func $stream.drop-readable (param i32)))
      (import \"\" \"stream.drop-writable\" (func $stream.drop-writable (param i32)))
      (import \"\" \"transform\" (func $transform (param i32 i32) (result i32)))
      (data (i32.const 0x200) {dataStr chunks})
      (data (i32.const 0x300) {dataStr reads})
      (data (i32.const 0x2000) {dataStr input})
      (data (i32.const 0x4000) {dataStr expected})
      (global $insw (mut i32) (i32.const 0))
      (global $outsr (mut i32) (i32.const 0))
      (global $wpend (mut i32) (i32.const 0))
      (global $rpend (mut i32) (i32.const 0))
      (global $wdone (mut i32) (i32.const 0))
      (global $rdone (mut i32) (i32.const 0))
      (global $inoff (mut i32) (i32.const 0))
      (global $ci (mut i32) (i32.const 0))
      (global $ri (mut i32) (i32.const 0))
      (global $outlen (mut i32) (i32.const 0))
      (func $handleW (param $r i32) (local $rem i32)
        (if (i32.ne (i32.and (local.get $r) (i32.const 0xf)) (i32.const 0))
          (then (call $stream.drop-writable (global.get $insw)) (global.set $wdone (i32.const 1)) (return)))
        (if (i32.ge_u (global.get $ci) (i32.const 256)) (then unreachable))
        (global.set $inoff (i32.add (global.get $inoff) (i32.shr_u (local.get $r) (i32.const 4))))
        (local.set $rem (i32.sub (i32.load8_u (i32.add (i32.const 0x200) (global.get $ci)))
                                 (i32.shr_u (local.get $r) (i32.const 4))))
        (i32.store8 (i32.add (i32.const 0x200) (global.get $ci)) (local.get $rem))
        (if (i32.eqz (local.get $rem)) (then (global.set $ci (i32.add (global.get $ci) (i32.const 1))))))
      (func $handleR (param $r i32)
        (global.set $outlen (i32.add (global.get $outlen) (i32.shr_u (local.get $r) (i32.const 4))))
        (if (i32.ne (i32.and (local.get $r) (i32.const 0xf)) (i32.const 0))
          (then (call $stream.drop-readable (global.get $outsr)) (global.set $rdone (i32.const 1)))))
      (func $run (export \"run\") (result i32)
        (local $p i64) (local $insr i32) (local $ws i32) (local $r i32) (local $code i32) (local $i i32)
        (local.set $p (call $stream.new))
        (local.set $insr (i32.wrap_i64 (local.get $p)))
        (global.set $insw (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))))
        (local.set $r (call $transform (local.get $insr) (i32.const 8)))
        (if (i32.ne (local.get $r) (i32.const 2)) (then unreachable))
        (global.set $outsr (i32.load (i32.const 8)))
        (local.set $ws (call $waitable-set.new))
        (call $waitable.join (global.get $insw) (local.get $ws))
        (call $waitable.join (global.get $outsr) (local.get $ws))
        (block $exit (loop $l
          (if (i32.and (i32.eqz (global.get $wpend)) (i32.eqz (global.get $wdone)))
            (then
              (if (i32.ge_u (global.get $ci) (i32.const {chunks.length}))
                (then (call $stream.drop-writable (global.get $insw)) (global.set $wdone (i32.const 1)) (br $l)))
              (local.set $r (call $stream.write (global.get $insw)
                (i32.add (i32.const 0x2000) (global.get $inoff))
                (i32.load8_u (i32.add (i32.const 0x200) (global.get $ci)))))
              (if (i32.eq (local.get $r) (i32.const -1)) (then (global.set $wpend (i32.const 1)) (br $l)))
              (call $handleW (local.get $r))
              (br $l)))
          (if (i32.and (i32.eqz (global.get $rpend)) (i32.eqz (global.get $rdone)))
            (then
              (local.set $r (call $stream.read (global.get $outsr)
                (i32.add (i32.const 0x8000) (global.get $outlen))
                (i32.load8_u (i32.add (i32.const 0x300) (i32.rem_u (global.get $ri) (i32.const {reads.length}))))))
              (global.set $ri (i32.add (global.get $ri) (i32.const 1)))
              (if (i32.eq (local.get $r) (i32.const -1)) (then (global.set $rpend (i32.const 1)) (br $l)))
              (call $handleR (local.get $r))
              (br $l)))
          (br_if $exit (i32.and (global.get $wdone) (global.get $rdone)))
          (local.set $code (call $waitable-set.wait (local.get $ws) (i32.const 0)))
          (if (i32.eq (local.get $code) (i32.const 3))
            (then (global.set $wpend (i32.const 0)) (call $handleW (i32.load (i32.const 4)))))
          (if (i32.eq (local.get $code) (i32.const 2))
            (then (global.set $rpend (i32.const 0)) (call $handleR (i32.load (i32.const 4)))))
          (br $l)))
        (if (i32.ne (global.get $outlen) (i32.const {expected.length}))
          (then (return (i32.add (i32.const 1000) (global.get $outlen)))))
        (block $done (loop $c
          (br_if $done (i32.ge_u (local.get $i) (global.get $outlen)))
          (if (i32.ne (i32.load8_u (i32.add (i32.const 0x8000) (local.get $i)))
                      (i32.load8_u (i32.add (i32.const 0x4000) (local.get $i))))
            (then (return (i32.add (i32.const 100000) (local.get $i)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $c)))
        (i32.const 42)))
    (type $ST (stream u8))
    (canon waitable.join (core func $waitable.join))
    (canon waitable-set.new (core func $waitable-set.new))
    (canon waitable-set.wait (memory (core memory $memory \"mem\")) (core func $waitable-set.wait))
    (canon stream.new $ST (core func $stream.new))
    (canon stream.read $ST async (memory (core memory $memory \"mem\")) (core func $stream.read))
    (canon stream.write $ST async (memory (core memory $memory \"mem\")) (core func $stream.write))
    (canon stream.drop-readable $ST (core func $stream.drop-readable))
    (canon stream.drop-writable $ST (core func $stream.drop-writable))
    (canon lower (func $transform) async (memory (core memory $memory \"mem\")) (core func $transform'))
    (core instance $dm (instantiate $DM (with \"\" (instance
      (export \"mem\" (memory $memory \"mem\"))
      (export \"waitable.join\" (func $waitable.join))
      (export \"waitable-set.new\" (func $waitable-set.new))
      (export \"waitable-set.wait\" (func $waitable-set.wait))
      (export \"stream.new\" (func $stream.new))
      (export \"stream.read\" (func $stream.read))
      (export \"stream.write\" (func $stream.write))
      (export \"stream.drop-readable\" (func $stream.drop-readable))
      (export \"stream.drop-writable\" (func $stream.drop-writable))
      (export \"transform\" (func $transform'))))))
    (func (export \"run\") async (result u32) (canon lift (core func $dm \"run\"))))

  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with \"transform\" (func $c \"transform\"))))
  (func (export \"run\") (alias export $d \"run\")))
(assert_return (invoke \"run\") (u32.const 42))
"

end WasmStreams.Wast


open Silmaril.Wasm.Component (Val)
open Silmaril.Wasm.Component.Streams
open Silmaril.Wasm.Component.Streams.Proc
open Silmaril.Wasm.Component.Streams.Run
open scoped Silmaril.Wasm.Component.Streams.Tr

/-- A byte as a component value. -/
def u8 (n : Nat) : Val := .u8 (BitVec.ofNat 8 n)

/-- The byte of a `u8` value. -/
def byteOf : Val → Nat
  | .u8 x => x.toNat
  | _ => 256

/-- Newline. -/
def isNl (v : Val) : Bool := byteOf v == 10

/-- `count` pseudo-random numbers below `bound`, and the next seed. -/
def randoms (seed count bound : Nat) : List Nat × Nat := Id.run do
  let mut s := seed
  let mut out := #[]
  for _ in [0:count] do
    s := lcg s
    out := out.push ((s / 65536) % bound)
  return (out.toList, s)

/-- Random bytes over a small alphabet (`a`, `b`, `c`, newline, space, `0..9`). -/
def randomBytes (seed len : Nat) : List Val × Nat :=
  let alphabet : List Nat := [97, 98, 99, 10, 32, 48, 49, 50, 10, 97]
  let (rs, s) := randoms seed len alphabet.length
  (rs.map fun r => u8 (alphabet.getD r 97), s)

/-- Cut a list into random chunks of `0..maxChunk` items (empty chunks included). -/
def randomChunks (seed maxChunk : Nat) : List Val → Nat → List (List Val) × Nat
  | [], _ => ([], seed)
  | xs, 0 => ([xs], seed)
  | xs, fuel + 1 =>
    let s := lcg seed
    let k := (s / 65536) % (maxChunk + 1)
    let (rest, s') := randomChunks s maxChunk (xs.drop k) fuel
    (xs.take k :: rest, s')

/-- An independent reference line splitter. -/
def refLines (xs : List Val) : List (List Val) :=
  let (done, cur) := xs.foldl (fun (acc : Array (List Val) × Array Val) x =>
    if isNl x then (acc.1.push acc.2.toList, #[]) else (acc.1, acc.2.push x)) (#[], #[])
  if cur.isEmpty then done.toList else (done.push cur.toList).toList

/-- An independent reference rechunker. -/
def refChunks (n : Nat) (xs : List Val) : List (List Val) := Id.run do
  let mut out := #[]
  let mut cur := #[]
  for x in xs do
    cur := cur.push x
    if cur.size == n then
      out := out.push cur.toList
      cur := #[]
  if !cur.isEmpty then out := out.push cur.toList
  return out.toList

/-- The result of one transformer's trials. -/
structure Outcome where
  passed : Nat := 0
  failed : Nat := 0
  maxSteps : Nat := 0
  firstFailure : Option String := none

/-- Run `trials` random pipelines of `T` and compare with `T.run` and the reference. -/
def runTest {σ : Type} (name : String) (T : Tr σ Val Val) (ref : List Val → List Val)
    (trials : Nat) (baseSeed : Nat) : IO Bool := do
  let mut o : Outcome := {}
  for i in [0:trials] do
    let seed := lcg (baseSeed + 7919 * i)
    let (len, s1) := match randoms seed 1 120 with | (l :: _, s) => (l, s) | ([], s) => (0, s)
    let (bytes, s2) := randomBytes s1 len
    let (maxChunk, s3) := match randoms s2 1 9 with | (m :: _, s) => (m, s) | ([], s) => (0, s)
    let (cs, s4) := randomChunks s3 maxChunk bytes (bytes.length + 1)
    let (nb, s5) := match randoms s4 2 8 with | (a :: b :: _, s) => ((a + 1, b + 1), s) | (_, s) => ((1, 1), s)
    let (N, maxRead) := nb
    match start T cs with
    | none => o := { o with failed := o.failed + 1, firstFailure := o.firstFailure <|> some "setup failed" }
    | some s₀ =>
      let (sEnd, steps) := runRandom T N maxRead 1000000 s5 s₀
      o := { o with maxSteps := max o.maxSteps steps }
      match finished sEnd with
      | none =>
        o := { o with failed := o.failed + 1,
                      firstFailure := o.firstFailure <|> some s!"trial {i}: did not finish after {steps} steps" }
      | some acc =>
        let spec := T.run cs.flatten
        if acc == spec && acc == ref bytes then o := { o with passed := o.passed + 1 }
        else
          o := { o with failed := o.failed + 1,
                        firstFailure := o.firstFailure <|> some s!"trial {i}: wrong output" }
  if o.failed == 0 then
    IO.println s!"PASS {name}: {o.passed}/{trials} runs finished with T.run and the reference (max {o.maxSteps} steps)"
    return true
  else
    IO.println s!"FAIL {name}: {o.failed}/{trials} failed; first: {o.firstFailure.getD "?"}"
    return false

/-- The Lean transformer of a byte-stream line filter: drop the empty lines (each kept line is
followed by a newline). -/
def dropEmptyT :=
  (linesV isNl ⟫ Tr.filter (fun v => match v with | .record [] => false | _ => true)) ⟫
    Tr.flatMap (fun v => match v with | .record bs => bs ++ [u8 10] | _ => [])

/-- `wasm-streams wast CASE SEED`. -/
def wastMain (case : String) (seed : Nat) (batchOverride : Option Nat) (whole : Bool) :
    IO UInt32 := do
  let inc (v : Val) : Val := u8 ((byteOf v + 1) % 256)
  let isDigit (v : Val) : Bool := 48 ≤ byteOf v && byteOf v ≤ 57
  let s0 := lcg (seed + 1)
  let (len, s1) := match randoms s0 1 120 with | (l :: _, s) => (l + 1, s) | ([], s) => (1, s)
  let (bytes, s2) := randomBytes s1 len
  let (sizes, s3) := randoms s2 (len + 1) 8
  let chunks := Id.run do
    let mut out := #[]
    let mut left := len
    for z in sizes do
      if left == 0 then break
      let c := min (z + 1) left
      out := out.push c
      left := left - c
    return out.toList
  let (reads, s4) := randoms s3 16 8
  let (batch0, _) := match randoms s4 1 8 with | (b :: _, s) => (b + 1, s) | ([], s) => (1, s)
  let batch := match batchOverride with | some (n + 1) => n + 1 | _ => batch0
  let some (kernel, expected) := (match case with
    | "map" => some (WasmStreams.Wast.mapInc, (Tr.map inc).run bytes)
    | "filter" => some (WasmStreams.Wast.filterNonDigit, (Tr.filter (!isDigit ·)).run bytes)
    | "take7" => some (WasmStreams.Wast.take 7, (Tr.take 7 : Tr Nat Val Val).run bytes)
    | "take0" => some (WasmStreams.Wast.take 0, (Tr.take 0 : Tr Nat Val Val).run bytes)
    | "dropempty" => some (WasmStreams.Wast.dropEmptyLines, dropEmptyT.run bytes)
    | _ => none) | do IO.eprintln s!"wasm-streams: unknown case {case}"; return 2
  IO.print (WasmStreams.Wast.pipelineWast kernel batch (bytes.map byteOf) chunks
    (reads.map (· + 1)) (expected.map byteOf) whole)
  return 0

def main (args : List String) : IO UInt32 := do
  if let "wast" :: case :: seed :: rest := args then
    return ← wastMain case (seed.toNat?.getD 0) (rest.head? >>= String.toNat?)
      (rest.drop 1 != ["bytewise"])
  let trials := (args.head? >>= String.toNat?).getD 200
  let inc (v : Val) : Val := u8 ((byteOf v + 1) % 256)
  let isDigit (v : Val) : Bool := 48 ≤ byteOf v && byteOf v ≤ 57
  let nonempty (v : Val) : Bool := match v with | .record [] => false | _ => true
  let results ← [
    runTest "id" (Tr.id : Tr Unit Val Val) id trials 1,
    runTest "map (+1)" (Tr.map inc) (·.map inc) trials 2,
    runTest "filter (not digit)" (Tr.filter (!isDigit ·)) (·.filter (!isDigit ·)) trials 3,
    runTest "take 7" (Tr.take 7 : Tr Nat Val Val) (·.take 7) trials 4,
    runTest "take 0" (Tr.take 0 : Tr Nat Val Val) (·.take 0) trials 5,
    runTest "map then filter (fused)" (Tr.map inc ⟫ Tr.filter (!isDigit ·))
      (fun xs => (xs.map inc).filter (!isDigit ·)) trials 6,
    runTest "lines" (linesV isNl) (fun xs => (refLines xs).map Val.record) trials 7,
    runTest "rechunk 4" (rechunkV 4) (fun xs => (refChunks 4 xs).map Val.record) trials 8,
    runTest "rechunk 1" (rechunkV 1) (fun xs => (refChunks 1 xs).map Val.record) trials 9,
    runTest "lines then drop empty lines then take 3 (fused)"
      ((linesV isNl ⟫ Tr.filter nonempty) ⟫ (Tr.take 3 : Tr Nat Val Val))
      (fun xs => (((refLines xs).map Val.record).filter nonempty).take 3) trials 10
  ].mapM id
  if results.all id then
    IO.println "wasm-streams: all tests passed"
    return 0
  else
    IO.println "wasm-streams: FAILURES"
    return 1
