;;; Read translated terms and signatures in raw SBCL, after the certified include.
(in-package "ACL2")

(defun c3-dependency-root (name world)
  (let* ((requested (or (find-symbol name "X86ISA")
                        (error "Missing X86ISA symbol ~a" name)))
         (resolved (if (function-symbolp requested world)
                       requested
                     (deref-macro-name requested (macro-aliases world)))))
    (unless (and (function-symbolp resolved world) (logicp resolved world))
      (error "Root ~s does not resolve to a logical function" requested))
    (list requested resolved (if (eq requested resolved) "direct" "macro-alias"))))

(defun c3-dependency-world-row (fn world)
  (list fn (arity fn world)
        (cond ((not (function-symbolp fn world)) "absent")
              ((not (logicp fn world)) "program")
              ((assoc-eq fn *primitive-formals-and-guards*) "primitive")
              ((getpropc fn 'constrainedp nil world) "constrained")
              ((getpropc fn 'unnormalized-body nil world) "definition")
              (t "no-body"))))

(defun c3-dependency-body (fn world)
  (let ((body (getpropc fn 'unnormalized-body nil world)))
    (unless (and body (not (getpropc fn 'constrainedp nil world)))
      (error "Missing defining body for ~s" fn))
    (let ((projected (remove-guard-holders body world)))
      (list fn (formals fn world) projected (all-fnnames projected)))))

(defun c3-export-dependencies (source output)
  (let* ((state *the-live-state*)
         (world (w state))
         (marker (find-symbol "X86ISA_SYSCALL_EXEC_SUPPORT" "X86ISA")))
    (when (and marker (function-symbolp marker world))
      (error "Unexpected native syscall support in the ACL2 world"))
    (multiple-value-bind (expansions pre post live)
        (c1-certificate-evidence source state)
      (declare (ignore expansions))
      (dolist (entry (append pre post live))
        (let* ((book (if (eq (car entry) 'local) (cadr entry) entry))
               (annotations (fourth book)))
          (dolist (key '(:skipped-proofsp :axiomsp :ttags))
            (when (cdr (assoc key annotations))
              (error "Unexpected ~s annotation in ~s" key (car book)))))))
    (let* ((roots (mapcar (lambda (name) (c3-dependency-root name world))
                          '("X86-RUN" "X86-FETCH-DECODE-EXECUTE")))
           (bodies (mapcar (lambda (root) (c3-dependency-body (second root) world)) roots))
           (names (remove-duplicates (append (mapcar #'second roots)
                                             (mapcan (lambda (row) (copy-list (fourth row))) bodies))
                                     :test #'eq))
           (rows (mapcar (lambda (fn) (c3-dependency-world-row fn world)) names)))
      (with-open-file (out output :direction :output :if-exists :error :external-format :utf-8)
        (c3-json-term (list roots bodies rows) out)
        (terpri out)))))
