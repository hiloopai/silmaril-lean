;;; Loaded in raw SBCL after including the certified machine book.
(in-package "ACL2")

(defun c3-json-string (value out)
  (write-char #\" out)
  (loop for character across value
        do (case character
             ((#\" #\\) (write-char #\\ out) (write-char character out))
             (otherwise
              (if (< (char-code character) 32)
                  (format out "\\u~4,'0X" (char-code character))
                (write-char character out)))))
  (write-char #\" out))

(defun c3-json-term (value out)
  ;; JSON strings are distinct from symbols, whose first element is a tag.
  ;; Proper lists and dotted pairs preserve the structure of ACL2 records.
  (cond ((symbolp value)
         (write-string "[\"symbol\"," out)
         (c3-json-string (symbol-package-name value) out)
         (write-char #\, out)
         (c3-json-string (symbol-name value) out)
         (write-char #\] out))
        ((consp value)
         (if (true-listp value)
             (progn
               (write-char #\[ out)
               (loop for (element . rest) on value
                     do (c3-json-term element out)
                     when rest do (write-char #\, out))
               (write-char #\] out))
           (progn
             (write-string "[\"pair\"," out)
             (c3-json-term (car value) out)
             (write-char #\, out)
             (c3-json-term (cdr value) out)
             (write-char #\] out))))
        ((integerp value) (format out "~d" value))
        ((stringp value) (c3-json-string value out))
        (t (error "Unsupported ACL2 value: ~s" value))))

(defun c3-field (name value out)
  (write-string "  " out)
  (c3-json-string name out)
  (write-string ": " out)
  (c3-json-term value out))

(defun c3-property (symbol property world)
  (let ((value (getpropc symbol property :missing world)))
    (when (eq value :missing)
      (error "Missing ~s property for ~s" property symbol))
    value))

(defun c3-logical-certificate (source state)
  (let* ((world (w state))
         (exec-marker (find-symbol "X86ISA_SYSCALL_EXEC_SUPPORT" "X86ISA")))
    (multiple-value-bind (expansions pre post live)
        (c1-certificate-evidence source state)
      (when (and exec-marker (function-symbolp exec-marker world))
        (error "Unexpected native syscall support in the ACL2 world"))
      (dolist (entry (append pre post live))
        (let* ((book (if (eq (car entry) 'local) (cadr entry) entry))
               (annotations (fourth book)))
          (dolist (key '(:skipped-proofsp :axiomsp :ttags))
            (when (cdr (assoc key annotations))
              (error "Unexpected ~s annotation in ~s" key (car book))))))
      expansions)))

(defun c3-export-x86-run (source output source-sha commit tree)
  (let* ((state *the-live-state*)
         (world (w state))
         (run (find-symbol "X86-RUN" "X86ISA"))
         (halted (find-symbol "X86-RUN-HALTED" "X86ISA")))
    (c3-logical-certificate source state)
    (unless (and run halted (function-symbolp run world) (logicp run world))
      (error "Missing X86-RUN logical declaration or X86-RUN-HALTED theorem"))
    (let* ((body (c3-property run 'unnormalized-body world))
           (logic-body (remove-guard-holders body world))
           (formula (c3-property halted 'theorem world))
           (termination (termination-theorem run world))
           (justification (c3-property run 'justification world))
           (references (sort (all-fnnames-lst (list logic-body formula)) #'string<
                             :key (lambda (symbol)
                                    (concatenate 'string (symbol-package-name symbol)
                                                 ":" (symbol-name symbol))))))
      (when (and (consp termination) (eq (car termination) :failed))
        (error "ACL2 could not reconstruct its X86-RUN termination theorem"))
      (unless (and body formula termination justification)
        (error "Missing X86-RUN body, admission metadata, or halted theorem"))
      (with-open-file (out output :direction :output :if-exists :error :external-format :utf-8)
        (format out "{~%")
        (loop for (key value) in
              `(("schema" 1)
                ("acl2_commit" ,commit)
                ("acl2_tree" ,tree)
                ("x86isa_exec" "nil")
                ("book" "projects/x86isa/machine/x86.lisp")
                ("source_sha256" ,source-sha)
                ("name" ,run)
                ("arity" ,(arity run world))
                ("formals" ,(c3-property run 'formals world))
                ("unnormalized_body" ,body)
                ("body" ,logic-body)
                ("guard" ,(c3-property run 'guard world))
                ("stobjs_in" ,(c3-property run 'stobjs-in world))
                ("stobjs_out" ,(c3-property run 'stobjs-out world))
                ("symbol_class" ,(c3-property run 'symbol-class world))
                ("recursivep" ,(c3-property run 'recursivep world))
                ("justification" ,justification)
                ("measure" ,(access justification justification :measure))
                ("measure_domain" ,(access justification justification :mp))
                ("well_founded_relation" ,(access justification justification :rel))
                ("induction_machine" ,(c3-property run 'induction-machine world))
                ("termination_theorem" ,termination)
                ("references" ,(loop for fn in references
                                     for arity = (arity fn world)
                                     collect (progn
                                               (unless (and arity (logicp fn world))
                                                 (error "Missing logical function reference ~s" fn))
                                               (list fn arity))))
                ("halted_name" ,halted))
              do (c3-field key value out) (format out ",~%"))
        (c3-field "halted" formula out)
        (format out "~%}~%")))))
