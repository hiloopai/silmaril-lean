;;; Read the stock logical definitions in the same certified world as X86-RUN.
(in-package "ACL2")

(defun c3-export-pure-helpers (root output root-sha commit tree axioms-sha)
  (let* ((state *the-live-state*)
         (world (w state))
         (mv (f-get-global 'c3-mv-nth-samples state))
         (eql (f-get-global 'c3-eql-samples state))
         (not (f-get-global 'c3-not-samples state)))
    (c3-logical-certificate root state)
    (unless (and mv eql not) (error "Missing pure helper observations"))
    (with-open-file (out output :direction :output :if-exists :error :external-format :utf-8)
      (format out "{~%")
      (loop for (key value) in
            `(("schema" 1)
              ("acl2_commit" ,commit)
              ("acl2_tree" ,tree)
              ("x86isa_exec" "nil")
              ("source_sha256" (("axioms.lisp" ,axioms-sha)
                                ("books/projects/x86isa/machine/x86.lisp" ,root-sha)))
              ("functions" ,(mapcar (lambda (name) (c3-status-function name world))
                                    '(mv-nth eql not atom)))
              ("arities" ,(mapcar (lambda (name) (list name (arity name world)))
                                  '(if mv-nth eql not atom equal consp car cdr zp binary-+)))
              ("mv_nth_justification" ,(c3-property 'mv-nth 'justification world))
              ("mv_nth_termination" ,(termination-theorem 'mv-nth world))
              ("mv_nth_observations" ,mv)
              ("eql_observations" ,eql))
            do (c3-field key value out) (format out ",~%"))
      (c3-field "not_observations" not out)
      (format out "~%}~%"))))
