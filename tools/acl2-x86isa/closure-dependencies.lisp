;;; Traverse translated logical bodies in the certified world without emitting them.
(in-package "ACL2")

(sb-alien:load-shared-object "libcrypto.so.3")
(sb-alien:define-alien-routine ("SHA256" c3-closure-sha256) sb-alien:system-area-pointer
  (input sb-alien:system-area-pointer)
  (size sb-alien:unsigned-long)
  (output sb-alien:system-area-pointer))

(defun c3-body-digest (parameters body)
  (let ((input (sb-ext:string-to-octets
                (with-output-to-string (out) (c3-json-term (list parameters body) out))
                :external-format :utf-8))
        (output (make-array 32 :element-type '(unsigned-byte 8))))
    (sb-sys:with-pinned-objects (input output)
      (c3-closure-sha256 (sb-sys:vector-sap input) (length input) (sb-sys:vector-sap output)))
    (string-downcase (format nil "~{~2,'0X~}" (coerce output 'list)))))

(defun c3-closure-scan (owner parameters body)
  (let ((pending (list (cons body parameters)))
        (arities (make-hash-table :test #'eq))
        (string-quotes 0)
        (other-quotes 0))
    (loop while pending
          for (term . scope) = (pop pending)
          do (cond
              ((symbolp term)
               (unless (member term scope :test #'eq)
                 (error "Unbound translated variable in ~s" owner)))
              ((consp term)
               (let ((head (car term)) (args (cdr term)))
                 (cond
                  ((eq head 'quote)
                   (unless (= (length args) 1) (error "Bad quotation arity in ~s" owner))
                   (cond ((stringp (car args)) (incf string-quotes))
                         ((or (symbolp (car args)) (integerp (car args))))
                         (t (incf other-quotes))))
                  (t
                   (if (symbolp head)
                       (let ((argc (length args)))
                         (unless (= (gethash head arities argc) argc)
                           (error "Inconsistent call arity for ~s in ~s" head owner))
                         (setf (gethash head arities) argc))
                     (destructuring-bind (lambda-name formals lambda-body) head
                       (unless (and (eq lambda-name 'lambda) (= (length args) (length formals)))
                         (error "Bad translated lambda in ~s" owner))
                       (push (cons lambda-body formals) pending)))
                   (dolist (arg args) (push (cons arg scope) pending))))))
              (t (error "Non-term atom in ~s" owner))))
    (values arities string-quotes other-quotes)))

(defun c3-closure-x86-roles (world)
  (let ((roles (make-hash-table :test #'eq))
        (tuples (car (absstobj-tuples-lst (find-symbol "X86" "X86ISA") world))))
    (unless tuples (error "Missing live abstract X86 stobj tuples"))
    (dolist (tuple tuples)
      (loop for fn in (subseq tuple 0 3)
            for role in '("abstract-export" "logical-implementation" "foundation-implementation")
            do (pushnew role (gethash fn roles) :test #'equal)))
    roles))

(defun c3-export-closure-dependencies (source output roots)
  (let* ((state *the-live-state*)
         (world (w state))
         (x86-roles (c3-closure-x86-roles world))
         (seen (make-hash-table :test #'eq))
         (pending (loop for (package spelling argc) in roots
                        for fn = (find-symbol spelling package)
                        collect (progn
                                  (unless (and fn (equal (symbol-package-name fn) package)
                                               (logicp fn world) (eql (arity fn world) argc))
                                    (error "Missing exact logical root ~a::~a/~a" package spelling argc))
                                  fn))))
    (c3-logical-certificate source state)
    (with-open-file (out output :direction :output :if-exists :error :external-format :utf-8)
      (write-char #\[ out)
      (loop with first = t
            while pending
            for fn = (pop pending)
            unless (gethash fn seen)
            do (setf (gethash fn seen) t)
               (unless first (write-char #\, out))
               (setf first nil)
               (destructuring-bind (id argc kind) (c3-dependency-world-row fn world)
                 (let* ((defined (equal kind "definition"))
                        (base (list id argc kind (symbol-class fn world)
                                   (and defined (stobjs-in fn world))
                                   (and defined (stobjs-out fn world))
                                   (getpropc fn 'stobj-function nil world)
                                   (gethash fn x86-roles) (getpropc fn 'recursivep nil world))))
                   (if defined
                       (destructuring-bind (owner parameters body native-calls) (c3-dependency-body fn world)
                         (multiple-value-bind (arities strings others) (c3-closure-scan owner parameters body)
                           (unless (and (eql argc (length parameters))
                                        (= (hash-table-count arities) (length native-calls))
                                        (every (lambda (callee) (nth-value 1 (gethash callee arities)))
                                               native-calls))
                             (error "Call-head or formal scan disagrees with ACL2 for ~s" owner))
                           (let ((calls (loop for callee being the hash-keys of arities using (hash-value n)
                                              do (push callee pending)
                                              collect (list callee n))))
                             (c3-json-term (append base (list (c3-body-digest parameters body) calls strings others))
                                          out))))
                     (c3-json-term base out)))))
      (write-char #\] out)
      (terpri out))))
