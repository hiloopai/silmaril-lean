; Values only. No stobj or execution operations.
(set-guard-checking :none)
(defmacro c3-order-pair (x y)
  `(list ,x ,y (<< ,x ,y) (<< ,y ,x) (lexorder ,x ,y) (lexorder ,y ,x)))
(assign c3-order-samples
  (list (c3-order-pair -3/2 -1/2)
        (c3-order-pair 99 #C(-1 -2))
        (c3-order-pair #C(1 -2) #C(1 2))
        (c3-order-pair #C(1 3) #C(2 -3))
        (c3-order-pair #C(9 -1) #\a)
        (c3-order-pair #\a (code-char 255))
        (c3-order-pair #\z "")
        (c3-order-pair "" "")
        (c3-order-pair "A" "AA")
        (c3-order-pair "AA" "AZ")
        (c3-order-pair (coerce (list (code-char 200)) 'string) "z")
        (c3-order-pair "Z" :a)
        (c3-order-pair 'acl2::c3-same :c3-same)
        (c3-order-pair :a 'acl2::c3-same)
        (c3-order-pair :|a| :A)
        (c3-order-pair nil '(0))
        (c3-order-pair '(2 . -1) '(2 . 1))
        (c3-order-pair '((1 . 9) . 20) '((2 . 0) . -20))
        (c3-order-pair '(1 . :a) '(1 . :a))))
(defmacro c3-entry-case (entry)
  `(list ,entry (x86isa::x86rec-p1 ,entry)))
(assign c3-entry-samples
  (list (c3-entry-case nil) (c3-entry-case :bad) (c3-entry-case '(:one))
        (c3-entry-case '(((:fault) . 42)))
        (c3-entry-case '(((:fault) . 42) ((:ms) . 40)))
        (c3-entry-case '(((:ms) . 40) ((:fault) . 42)))
        (c3-entry-case '(((:fault) . nil)))
        (c3-entry-case '(((:ms) . 40) ((:ms) . 42)))
        (c3-entry-case '(((:ms) . 40) . :bad))
        (c3-entry-case '(((:app-view) . t))) (c3-entry-case '(((:app-view) . 1)))
        (c3-entry-case '(((:app-view) . nil))) (c3-entry-case '(((:os-info) . :linux)))
        (c3-entry-case '(((:tty-in) . (0 255))))
        (c3-entry-case '(((:tty-in) . (256))))
        (c3-entry-case '(((:tty-in) . (0 . 255))))
        (c3-entry-case '(((:tty-out) . (1/2))))
        (c3-entry-case '(((:tty-out) . nil)))))
