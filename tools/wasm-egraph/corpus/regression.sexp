; Pinned regression corpus of tools/wasm-egraph (see docs/wasm-auto-verify.md).
; (case NAME (locals T..) [(flat)] [(mode ref)] (lhs ..) (rhs ..) [(expect unknown)])
; (case NAME (locals T..) [(flat)] (optimize ..))
; Flat sides are instruction lists; others are WAT folded expressions.

; --- wasm-opt peepholes: the inputs of tools/wasm-opt/test-peepholes.mjs and
; --- the bodies the neutral-ops / eqz-pair stages produce for them.
(case peep_mul_add0 (locals i32 i32) (flat)
  (lhs "local.get 1; local.get 0; i32.const 0; i32.add; i32.mul")
  (rhs "local.get 1; local.get 0; i32.mul"))
(case peep_eqz_sub0 (locals i32) (flat)
  (lhs "local.get 0; i32.const 0; i32.sub; i32.eqz")
  (rhs "local.get 0; i32.eqz"))
(case peep_eq64_and_m1 (locals i64 i64) (flat)
  (lhs "local.get 0; local.get 1; i64.const -1; i64.and; i64.eq")
  (rhs "local.get 0; local.get 1; i64.eq"))
(case peep_clz_shl0 (locals i32) (flat)
  (lhs "local.get 0; i32.const 0; i32.shl; i32.clz")
  (rhs "local.get 0; i32.clz"))
(case peep_rotl64_xor0 (locals i64) (flat)
  (lhs "local.get 0; local.get 0; i64.const 0; i64.xor; i64.rotl")
  (rhs "local.get 0; local.get 0; i64.rotl"))
(case peep_sub_rotr0 (locals i32 i32) (flat)
  (lhs "local.get 0; local.get 1; i32.const 0; i32.rotr; i32.sub")
  (rhs "local.get 0; local.get 1; i32.sub"))
(case peep_chain_add0 (locals i32) (flat)
  (lhs "local.get 0; i32.const 0; i32.add; i32.const 0; i32.add; i32.eqz")
  (rhs "local.get 0; i32.eqz"))
(case peep_lt_shr0 (locals i32 i32) (flat)
  (lhs "local.get 0; local.get 1; i32.const 0; i32.shr_s; i32.lt_u")
  (rhs "local.get 0; local.get 1; i32.lt_u"))
(case peep_mul64_one (locals i64 i64) (flat)
  (lhs "local.get 0; local.get 1; i64.const 1; i64.mul; i64.sub")
  (rhs "local.get 0; local.get 1; i64.sub"))
(case peep_eqz3 (locals i32) (flat)
  (lhs "local.get 0; i32.eqz; i32.eqz; i32.eqz")
  (rhs "local.get 0; i32.eqz"))
; the pass keeps this one (its consumer is the function end); the typed rule still applies
(case peep_or0_return (locals i32) (flat)
  (lhs "local.get 0; i32.const 0; i32.or")
  (rhs "local.get 0"))
; k = 32: the pass leaves it; the shift count is taken mod 32 (rule shl-width)
(case peep_shl32 (locals i32) (flat)
  (lhs "local.get 0; i32.const 32; i32.shl; i32.eqz")
  (rhs "local.get 0; i32.eqz"))

; --- optimizer-style rewrites (Binaryen OptimizeInstructions / Precompute shapes)
(case opt_add_consts (locals i32)
  (lhs (i32.add (i32.add (local.get 0) (i32.const 1)) (i32.const 2)))
  (rhs (i32.add (local.get 0) (i32.const 3))))
(case opt_sub_neg_const (locals i32)
  (lhs (i32.sub (local.get 0) (i32.const -5)))
  (rhs (i32.add (local.get 0) (i32.const 5))))
(case opt_mul2_shl (locals i64)
  (lhs (i64.mul (local.get 0) (i64.const 2)))
  (rhs (i64.shl (local.get 0) (i64.const 1))))
(case opt_add_self_shl (locals i32)
  (lhs (i32.add (local.get 0) (local.get 0)))
  (rhs (i32.shl (local.get 0) (i32.const 1))))
(case opt_eq0_eqz (locals i64)
  (lhs (i64.eq (local.get 0) (i64.const 0)))
  (rhs (i64.eqz (local.get 0))))
(case opt_eqz2_ne (locals i64)
  (lhs (i32.eqz (i64.eqz (local.get 0))))
  (rhs (i64.ne (local.get 0) (i64.const 0))))
(case opt_comm_canon (locals i32 i32 i32)
  (lhs (i32.mul (i32.add (local.get 1) (local.get 0)) (local.get 2)))
  (rhs (i32.mul (local.get 2) (i32.add (local.get 0) (local.get 1)))))
(case opt_factor (locals i32 i32 i32)
  (lhs (i32.add (i32.mul (local.get 0) (local.get 1)) (i32.mul (local.get 0) (local.get 2))))
  (rhs (i32.mul (local.get 0) (i32.add (local.get 1) (local.get 2)))))
(case opt_gt_swap (locals i32 i32)
  (lhs (i32.gt_s (local.get 1) (local.get 0)))
  (rhs (i32.lt_s (local.get 0) (local.get 1))))
(case opt_precompute (locals)
  (lhs (i32.add (i32.mul (i32.const 3) (i32.const 4)) (i32.sub (i32.const 10) (i32.const 2))))
  (rhs (i32.const 20)))
(case opt_two_results (locals i32 i64) (flat)
  (lhs "local.get 0; i32.const 0; i32.xor; local.get 1; i64.const 1; i64.mul")
  (rhs "local.get 0; local.get 1"))
(case opt_neg_neg (locals i64)
  (lhs (i64.sub (i64.const 0) (i64.sub (i64.const 0) (local.get 0))))
  (rhs (local.get 0)))
(case opt_mul_neg1 (locals i32)
  (lhs (i32.mul (local.get 0) (i32.const -1)))
  (rhs (i32.sub (i32.const 0) (local.get 0))))

; --- total variables: rules that hold for terms that cannot trap
(case tot_xor_self_chain (locals i32)
  (lhs (i32.shr_s (local.get 0) (i32.eqz (i32.xor (local.get 0) (i32.xor (local.get 0) (i32.const 255))))))
  (rhs (local.get 0)))
(case tot_cmp_self (locals i64 i64)
  (lhs (i32.add (i64.lt_u (i64.add (local.get 0) (local.get 1)) (i64.add (local.get 1) (local.get 0))) (i64.eq (local.get 1) (local.get 1))))
  (rhs (i32.const 1)))
(case tot_mul_zero (locals i32 i32)
  (lhs (i32.add (local.get 1) (i32.mul (i32.shl (local.get 0) (local.get 1)) (i32.const 0))))
  (rhs (local.get 1)))

; --- computed rewrites (powers of two, shift counts modulo the width)
(case comp_div_pow2 (locals i64)
  (lhs (i64.div_u (local.get 0) (i64.const 32)))
  (rhs (i64.shr_u (local.get 0) (i64.const 5))))
(case comp_rem_pow2 (locals i32)
  (lhs (i32.rem_u (local.get 0) (i32.const 8)))
  (rhs (i32.and (local.get 0) (i32.const 7))))
(case comp_rotl_count (locals i32)
  (lhs (i32.rotl (local.get 0) (i32.const -2)))
  (rhs (i32.rotl (local.get 0) (i32.const 30))))

; --- refinements: the left side traps only if the right side does, and may be undefined
(case ref_sub_self (locals i32) (mode ref)
  (lhs (i32.sub (local.get 0) (local.get 0)))
  (rhs (i32.const 0)))
(case ref_add_sub_cancel (locals i64 i64) (mode ref)
  (lhs (i64.sub (i64.add (local.get 0) (local.get 1)) (local.get 1)))
  (rhs (local.get 0)))
(case ref_div_mul0 (locals i32 i32) (mode ref)
  (lhs (i32.mul (i32.div_s (local.get 0) (local.get 1)) (i32.const 0)))
  (rhs (i32.const 0)))

; --- non-equivalent pairs: the search must not prove them
(case neg_add1 (locals i32)
  (lhs (i32.add (local.get 0) (i32.const 1)))
  (rhs (local.get 0))
  (expect unknown))
(case neg_sub_comm (locals i32 i32)
  (lhs (i32.sub (local.get 0) (local.get 1)))
  (rhs (i32.sub (local.get 1) (local.get 0)))
  (expect unknown))
(case neg_divs_shr (locals i32)
  (lhs (i32.div_s (local.get 0) (i32.const 2)))
  (rhs (i32.shr_s (local.get 0) (i32.const 1)))
  (expect unknown))
; x / y may trap, so (x / y) - (x / y) is only refined by 0
(case neg_ref_as_eq (locals i32 i32)
  (lhs (i32.sub (i32.div_u (local.get 0) (local.get 1)) (i32.div_u (local.get 0) (local.get 1))))
  (rhs (i32.const 0))
  (expect unknown))
(case ref_div_sub_self (locals i32 i32) (mode ref)
  (lhs (i32.sub (i32.div_u (local.get 0) (local.get 1)) (i32.div_u (local.get 0) (local.get 1))))
  (rhs (i32.const 0)))

; --- extraction: the smallest equivalent term, with its certificate
(case min_neutral_chain (locals i32) (optimize (i32.xor (i32.sub (i32.mul (i32.add (local.get 0) (i32.const 0)) (i32.const 1)) (i32.const 0)) (i32.const 0))))
(case min_consts (locals i64) (optimize (i64.add (i64.add (local.get 0) (i64.const 7)) (i64.const -7))))
(case min_eqz3 (locals i32) (flat) (optimize "local.get 0; i32.eqz; i32.eqz; i32.eqz"))
