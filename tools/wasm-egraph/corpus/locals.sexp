; Segments with locals and drops, checked through effect summaries (Lean's
; Silmaril.Wasm.Auto.ESeg). `(mode seg)`: same stack, locals and traps (`SegEquiv`); otherwise
; function bodies, same results and traps, locals may differ (`BodyEquiv`).
(case tee-form (locals i32 i32) (mode seg)
  (lhs "local.get 0; i32.const 1; i32.add; local.set 1; local.get 1")
  (rhs "local.get 0; i32.const 1; i32.add; local.tee 1"))
(case set-get-dead (locals i32 i32)
  (lhs "local.get 0; i32.const 3; i32.mul; local.set 1; local.get 1; local.get 1; i32.add")
  (rhs "local.get 0; i32.const 6; i32.mul"))
(case swap-locals (locals i32 i32 i32) (mode seg)
  (lhs "local.get 0; local.set 2; local.get 1; local.set 0; local.get 2; local.set 1; local.get 1; local.set 2; local.get 1; local.set 1")
  (rhs "local.get 1; local.get 0; local.set 1; local.set 0; local.get 1; local.set 2"))
(case dead-store-total (locals i64 i64)
  (lhs "local.get 0; local.get 0; i64.mul; local.set 1; local.get 0")
  (rhs "local.get 0"))
(case dropped-total (locals i32)
  (lhs "local.get 0; i32.const 7; i32.xor; drop; local.get 0; i32.eqz")
  (rhs "local.get 0; i32.eqz"))
(case dropped-div-kept (locals i32 i32)
  (lhs "local.get 0; local.get 1; i32.div_u; drop; local.get 0")
  (rhs "local.get 0; local.get 1; i32.div_u; local.set 1; local.get 0"))
(case dropped-div-removed (locals i32 i32) (expect unknown)
  (lhs "local.get 0; local.get 1; i32.div_u; drop; local.get 0")
  (rhs "local.get 0"))
(case div-by-const-dropped (locals i32)
  (lhs "local.get 0; i32.const 7; i32.div_u; drop; local.get 0")
  (rhs "local.get 0"))
(case div-recomputed (locals i32 i32 i32)
  (lhs "local.get 0; local.get 1; i32.div_u; local.set 2; local.get 0; local.get 1; i32.div_u")
  (rhs "local.get 0; local.get 1; i32.div_u"))
(case trap-order (locals i32 i32)
  (lhs "local.get 0; local.get 1; i32.div_u; local.get 1; local.get 0; i32.rem_u; i32.add")
  (rhs "local.get 1; local.get 0; i32.rem_u; local.get 0; local.get 1; i32.div_u; i32.add"))
(case sdiv-pow2 (locals i32)
  (lhs "local.get 0; i32.const 8; i32.div_s")
  (rhs "local.get 0; local.get 0; i32.const 31; i32.shr_s; i32.const 29; i32.shr_u; i32.add; i32.const 3; i32.shr_s"))
(case sdiv-pow2-i64 (locals i64 i64)
  (lhs "local.get 0; i64.const 1024; i64.div_s; local.set 1; local.get 1")
  (rhs "local.get 0; local.get 0; i64.const 63; i64.shr_s; i64.const 54; i64.shr_u; i64.add; i64.const 10; i64.shr_s"))
(case sdiv-not-shift (locals i32) (expect unknown)
  (lhs "local.get 0; i32.const 2; i32.div_s")
  (rhs "local.get 0; i32.const 1; i32.shr_s"))
(case srem-eqz (locals i32)
  (lhs "local.get 0; i32.const 16; i32.rem_s; i32.eqz")
  (rhs "local.get 0; i32.const 15; i32.and; i32.eqz"))
(case shift-shift (locals i64)
  (lhs "local.get 0; i64.const 3; i64.shl; i64.const 5; i64.shl")
  (rhs "local.get 0; i64.const 8; i64.shl"))
(case shift-shift-too-far (locals i32) (expect unknown)
  (lhs "local.get 0; i32.const 20; i32.shl; i32.const 20; i32.shl")
  (rhs "local.get 0; i32.const 40; i32.shl"))
(case ltu-one (locals i32 i32)
  (lhs "local.get 0; local.get 1; i32.add; i32.const 1; i32.lt_u")
  (rhs "local.get 1; local.get 0; i32.add; i32.eqz"))
(case gtu-zero (locals i64)
  (lhs "local.get 0; i64.const 0; i64.gt_u")
  (rhs "local.get 0; i64.const 0; i64.ne"))
(case sign-test (locals i32)
  (lhs "local.get 0; i32.const 0; i32.lt_s")
  (rhs "local.get 0; i32.const 31; i32.shr_u"))
(case cse-tee (locals i32 i32 i32)
  (lhs "local.get 0; local.get 1; i32.mul; local.get 0; local.get 1; i32.mul; i32.add")
  (rhs "local.get 0; local.get 1; i32.mul; local.tee 2; local.get 2; i32.add"))
(case wrong-local (locals i32 i32) (expect unknown)
  (lhs "local.get 0; local.set 1; local.get 1")
  (rhs "local.get 1"))
