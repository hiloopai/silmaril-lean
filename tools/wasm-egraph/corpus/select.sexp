; `select` and bodies whose declared locals differ, checked through Lean's
; Silmaril.Wasm.Auto.ESeg. A body with `select` is proved with `checkBodySel` (`BodyEquivSel`) or,
; with `(mode seg)`, `checkSegSel` (`SegEquivSel`). `(mode func)`: `(locals ..)` are the
; parameters, `(alocals ..)` and `(blocals ..)` the declared locals of each side, compared from
; function entry (`checkFunc`, `FuncEquiv`; declared locals start at zero).
(case sel-true (locals i32 i32)
  (lhs "local.get 0; local.get 1; i32.const 1; select")
  (rhs "local.get 0"))
(case sel-false (locals i32 i32)
  (lhs "local.get 0; local.get 1; i32.const 0; select")
  (rhs "local.get 1"))
(case sel-same (locals i32 i32)
  (lhs "local.get 0; local.get 0; local.get 1; select")
  (rhs "local.get 0"))
(case sel-both (locals i32 i32 i32)
  (lhs "local.get 0; local.get 1; local.get 2; select; local.get 0; local.get 1; local.get 2; select; i32.add")
  (rhs "local.get 0; local.get 1; local.get 2; select; i32.const 1; i32.shl"))
(case sel-trap (locals i32 i32)
  (lhs "local.get 0; local.get 1; i32.const 7; select; local.get 1; i32.div_u")
  (rhs "local.get 0; local.get 1; i32.div_u"))
(case sel-seg (locals i32 i32 i32) (mode seg)
  (lhs "local.get 0; local.get 1; i32.const 5; select; local.set 2")
  (rhs "local.get 0; local.set 2"))
(case sel-wrong (locals i32 i32) (expect unknown)
  (lhs "local.get 0; local.get 1; i32.const 1; select")
  (rhs "local.get 1"))
(case sel-trap-lost (locals i32 i32 i32) (expect unknown)
  (lhs "local.get 0; local.get 1; i32.div_u; local.get 2; local.get 0; select")
  (rhs "local.get 2"))
(case func-renumber (locals i32 i32) (mode func) (alocals i32 i64) (blocals i64 i32)
  (lhs "local.get 0; local.get 1; i32.add; local.set 2; local.get 2; local.get 2; i32.mul")
  (rhs "local.get 0; local.get 1; i32.add; local.set 3; local.get 3; local.get 3; i32.mul"))
(case func-merge (locals i32) (mode func) (alocals i32 i32) (blocals i32)
  (lhs "local.get 0; i32.const 1; i32.add; local.set 1; local.get 1; i32.const 2; i32.mul; local.set 2; local.get 2")
  (rhs "local.get 0; i32.const 1; i32.add; local.set 1; local.get 1; i32.const 2; i32.mul; local.set 1; local.get 1"))
(case func-zero-init (locals i32) (mode func) (alocals i32) (blocals)
  (lhs "local.get 1; local.get 0; i32.add")
  (rhs "local.get 0"))
(case func-trap (locals i32 i32) (mode func) (alocals i32) (blocals)
  (lhs "local.get 0; local.get 1; i32.div_s; local.set 2; local.get 0")
  (rhs "local.get 0; local.get 1; i32.div_s; drop; local.get 0"))
(case func-select (locals i32 i32) (mode func) (alocals i32) (blocals i64)
  (lhs "local.get 0; local.get 1; local.get 0; select; local.set 2; local.get 2")
  (rhs "local.get 0; local.get 1; local.get 0; select"))
(case func-wrong (locals i32) (mode func) (alocals i32) (blocals) (expect unknown)
  (lhs "local.get 1")
  (rhs "local.get 0"))
