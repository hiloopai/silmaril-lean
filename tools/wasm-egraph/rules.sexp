; The rewrite library of Silmaril.Wasm.Auto.Rules.schemas, in order. `T` is the rule's type
; (each schema is instantiated at i32, then i64); `?n` are pattern variables of type T;
; `ones` is 2^width - 1. Kinds: eq (both directions), ref (left to right only).
(add-comm eq (T.add ?0 ?1) (T.add ?1 ?0))
(add-assoc eq (T.add (T.add ?0 ?1) ?2) (T.add ?0 (T.add ?1 ?2)))
(mul-comm eq (T.mul ?0 ?1) (T.mul ?1 ?0))
(mul-assoc eq (T.mul (T.mul ?0 ?1) ?2) (T.mul ?0 (T.mul ?1 ?2)))
(and-comm eq (T.and ?0 ?1) (T.and ?1 ?0))
(and-assoc eq (T.and (T.and ?0 ?1) ?2) (T.and ?0 (T.and ?1 ?2)))
(or-comm eq (T.or ?0 ?1) (T.or ?1 ?0))
(or-assoc eq (T.or (T.or ?0 ?1) ?2) (T.or ?0 (T.or ?1 ?2)))
(xor-comm eq (T.xor ?0 ?1) (T.xor ?1 ?0))
(xor-assoc eq (T.xor (T.xor ?0 ?1) ?2) (T.xor ?0 (T.xor ?1 ?2)))
(add-zero eq (T.add ?0 (T.const 0)) ?0)
(sub-zero eq (T.sub ?0 (T.const 0)) ?0)
(mul-one eq (T.mul ?0 (T.const 1)) ?0)
(or-zero eq (T.or ?0 (T.const 0)) ?0)
(xor-zero eq (T.xor ?0 (T.const 0)) ?0)
(and-ones eq (T.and ?0 (T.const ones)) ?0)
(shl-zero eq (T.shl ?0 (T.const 0)) ?0)
(shru-zero eq (T.shr_u ?0 (T.const 0)) ?0)
(shrs-zero eq (T.shr_s ?0 (T.const 0)) ?0)
(rotl-zero eq (T.rotl ?0 (T.const 0)) ?0)
(rotr-zero eq (T.rotr ?0 (T.const 0)) ?0)
(mul-add-distrib eq (T.mul ?0 (T.add ?1 ?2)) (T.add (T.mul ?0 ?1) (T.mul ?0 ?2)))
(sub-add-neg eq (T.sub ?0 ?1) (T.add ?0 (T.sub (T.const 0) ?1)))
(neg-neg eq (T.sub (T.const 0) (T.sub (T.const 0) ?0)) ?0)
(add-self eq (T.add ?0 ?0) (T.mul ?0 (T.const 2)))
(mul-two-shl eq (T.mul ?0 (T.const 2)) (T.shl ?0 (T.const 1)))
(and-self eq (T.and ?0 ?0) ?0)
(or-self eq (T.or ?0 ?0) ?0)
(mul-neg-one eq (T.mul ?0 (T.const ones)) (T.sub (T.const 0) ?0))
(add-sub-assoc eq (T.sub (T.add ?0 ?1) ?2) (T.add ?0 (T.sub ?1 ?2)))
(eqz-eq eq (T.eqz ?0) (T.eq ?0 (T.const 0)))
(eqz-eqz eq (i32.eqz (T.eqz ?0)) (T.ne ?0 (T.const 0)))
(eqz-ne-zero eq (i32.ne (T.eqz ?0) (i32.const 0)) (T.eqz ?0))
(eq-comm eq (T.eq ?0 ?1) (T.eq ?1 ?0))
(ne-comm eq (T.ne ?0 ?1) (T.ne ?1 ?0))
(lts-gts eq (T.lt_s ?0 ?1) (T.gt_s ?1 ?0))
(ltu-gtu eq (T.lt_u ?0 ?1) (T.gt_u ?1 ?0))
(les-ges eq (T.le_s ?0 ?1) (T.ge_s ?1 ?0))
(leu-geu eq (T.le_u ?0 ?1) (T.ge_u ?1 ?0))
(sub-self ref (T.sub ?0 ?0) (T.const 0))
(xor-self ref (T.xor ?0 ?0) (T.const 0))
(mul-zero ref (T.mul ?0 (T.const 0)) (T.const 0))
(and-zero ref (T.and ?0 (T.const 0)) (T.const 0))
(add-sub-cancel ref (T.sub (T.add ?0 ?1) ?1) ?0)
(div-u-one eq (T.div_u ?0 (T.const 1)) ?0)
(div-s-one eq (T.div_s ?0 (T.const 1)) ?0)
(shl-width eq (T.shl ?0 (T.const width)) ?0)
(shru-width eq (T.shr_u ?0 (T.const width)) ?0)
(shrs-width eq (T.shr_s ?0 (T.const width)) ?0)
(neg-mul eq (T.mul (T.sub (T.const 0) ?0) ?1) (T.sub (T.const 0) (T.mul ?0 ?1)))
; total variables `?n!` match only terms without division or remainder
(sub-self-t eq (T.sub ?0! ?0!) (T.const 0))
(xor-self-t eq (T.xor ?0! ?0!) (T.const 0))
(mul-zero-t eq (T.mul ?0! (T.const 0)) (T.const 0))
(and-zero-t eq (T.and ?0! (T.const 0)) (T.const 0))
(or-ones-t eq (T.or ?0! (T.const ones)) (T.const ones))
(zero-shl-t eq (T.shl (T.const 0) ?0!) (T.const 0))
(zero-shru-t eq (T.shr_u (T.const 0) ?0!) (T.const 0))
(zero-shrs-t eq (T.shr_s (T.const 0) ?0!) (T.const 0))
(rem-u-one-t eq (T.rem_u ?0! (T.const 1)) (T.const 0))
(eq-self-t eq (T.eq ?0! ?0!) (i32.const 1))
(ne-self-t eq (T.ne ?0! ?0!) (i32.const 0))
(lts-self-t eq (T.lt_s ?0! ?0!) (i32.const 0))
(ltu-self-t eq (T.lt_u ?0! ?0!) (i32.const 0))
(gts-self-t eq (T.gt_s ?0! ?0!) (i32.const 0))
(gtu-self-t eq (T.gt_u ?0! ?0!) (i32.const 0))
(les-self-t eq (T.le_s ?0! ?0!) (i32.const 1))
(leu-self-t eq (T.le_u ?0! ?0!) (i32.const 1))
(ges-self-t eq (T.ge_s ?0! ?0!) (i32.const 1))
(geu-self-t eq (T.ge_u ?0! ?0!) (i32.const 1))
(zero-gtu-t eq (T.gt_u (T.const 0) ?0!) (i32.const 0))
(ltu-zero-t eq (T.lt_u ?0! (T.const 0)) (i32.const 0))
(geu-zero-t eq (T.ge_u ?0! (T.const 0)) (i32.const 1))
(zero-leu-t eq (T.le_u (T.const 0) ?0!) (i32.const 1))
(add-sub-cancel-t eq (T.sub (T.add ?1 ?0!) ?0!) ?1)
