X86_64 MP+stosb
"Hand-written loose corner (string store): MP whose data store is rep stosb. Not covered by x86-TSO; XL verdict only."
{ int x=0; int y=0; 0:rax=1; 0:rcx=4; 0:rdi=x; }
 P0            | P1            ;
 rep stosb     | movl (y),%eax ;
 movl $1,(y)   | movb (x),%bl  ;
exists (1:rax=1 /\ 1:rbx=0)
