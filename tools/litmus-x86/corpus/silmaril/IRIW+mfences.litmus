X86 IRIW+mfences
"Hand-written: amd6 (IRIW) with an MFENCE between each reader's loads"
{ }
 P0         | P1         | P2          | P3          ;
 MOV [x],$1 | MOV [y],$1 | MOV EAX,[x] | MOV ECX,[y] ;
            |            | MFENCE      | MFENCE      ;
            |            | MOV EBX,[y] | MOV EDX,[x] ;
exists (2:EAX=1 /\ 2:EBX=0 /\ 3:ECX=1 /\ 3:EDX=0)
