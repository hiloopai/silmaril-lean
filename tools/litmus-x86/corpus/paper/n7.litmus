X86 n7
"Transcribed from Owens, Sarkar, Sewell, A better x86 memory model: x86-TSO (extended version), Appendix A"
{  }
 P0          | P1         | P2          ;
 MOV [x],$1  | MOV [y],$1 | MOV ECX,[y] ;
 MOV EAX,[x] |            | MOV EDX,[x] ;
 MOV EBX,[y] |            |             ;
exists (0:EAX=1 /\ 0:EBX=0 /\ 2:ECX=1 /\ 2:EDX=0)
