X86 iwp2.6
"Transcribed from Owens, Sarkar, Sewell, A better x86 memory model: x86-TSO (extended version), Appendix A"
{  }
 P0         | P1         | P2          | P3          ;
 MOV [x],$1 | MOV [x],$2 | MOV EAX,[x] | MOV ECX,[x] ;
            |            | MOV EBX,[x] | MOV EDX,[x] ;
exists (2:EAX=1 /\ 2:EBX=2 /\ 3:ECX=2 /\ 3:EDX=1)
