X86 n2
"Transcribed from Owens, Sarkar, Sewell, A better x86 memory model: x86-TSO (extended version), Appendix A"
{  }
 P0         | P1         | P2          | P3          ;
 MOV [y],$1 | MOV [x],$2 | MOV EAX,[x] | MOV ECX,[z] ;
 MOV [x],$1 | MOV [z],$1 | MOV EBX,[x] | MOV EDX,[y] ;
exists (2:EAX=1 /\ 2:EBX=2 /\ 3:ECX=1 /\ 3:EDX=0)
