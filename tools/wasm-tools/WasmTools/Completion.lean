import WasmTools.Types
import WasmTools.Args
import WasmTools.CompletionData

/-!
# `wasm-tools completion <SHELL>` (cli track)

The argument grammar is upstream's (`[OPTIONS] <SHELL>`, `-v`, `--color`, `-h`, `--help`;
`SHELL` one of `bash`, `elvish`, `fish`, `powershell`, `zsh`), with clap's errors for a
missing or invalid `SHELL` (status 2). The scripts themselves are clap_complete's rendering of
upstream's full command grammar, reproduced as data captured from the pinned binary
(`WasmTools.CompletionData`, regenerated by `tools/wasm-tools/tests/gen-completion.sh`); they
are not generated from this build's own grammar (tools/wasm-tools/README.md).
-/

namespace WasmTools.Completion

open Args

def spec : CmdSpec where
  path := "wasm-tools completion"
  opts := generalOpts
  positionals := ["SHELL"]
  usage := "wasm-tools completion [OPTIONS] <SHELL>"
  shortHelp := CompletionData.help_short
  longHelp := CompletionData.help_long

def shells : List (String × String) :=
  [("bash", CompletionData.bash), ("elvish", CompletionData.elvish),
   ("fish", CompletionData.fish), ("powershell", CompletionData.powershell),
   ("zsh", CompletionData.zsh)]

def missing : String :=
  "error: the following required arguments were not provided:\n  <SHELL>\n\n" ++
  "Usage: wasm-tools completion <SHELL>\n\nFor more information, try '--help'.\n"

def invalid (v : String) : String :=
  s!"error: invalid value '{v}' for '<SHELL>'\n" ++
  "  [possible values: bash, elvish, fish, powershell, zsh]\n\n" ++
  "For more information, try '--help'.\n"

def run (args : List String) : IO UInt32 := do
  match parseArgs spec args with
  | .help t => (← IO.getStdout).putStr t; return 0
  | .usageError t => (← IO.getStderr).putStr t; return 2
  | .ok p =>
    match p.positionals.head? with
    | none => (← IO.getStderr).putStr missing; return 2
    | some sh =>
      match shells.lookup sh with
      | none => (← IO.getStderr).putStr (invalid sh); return 2
      | some script =>
        let out ← IO.getStdout
        out.putStr script; out.flush
        return 0

def table : List Subcommand := [⟨"completion", run⟩]

end WasmTools.Completion
