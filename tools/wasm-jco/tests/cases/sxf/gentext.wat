;; A producer of text: byte i is a newline when i % 7 = 6 or i % 11 = 10 (so some lines are
;; empty), else 'a' + i % 26; written with one stream.write, completed until all is taken.
(module
  (import "[export]$root" "[task-return]gentext" (func $task_return (param i32)))
  (import "[export]$root" "[stream-new-0]gentext" (func $stream_new (result i64)))
  (import "[export]$root" "[async-lower][stream-write-0]gentext" (func $write (param i32 i32 i32) (result i32)))
  (import "[export]$root" "[stream-drop-writable-0]gentext" (func $drop_w (param i32)))
  (import "$root" "[waitable-set-new]" (func $ws_new (result i32)))
  (import "$root" "[waitable-join]" (func $join (param i32 i32)))
  (import "$root" "[waitable-set-wait]" (func $wait (param i32 i32) (result i32)))
  (memory (export "memory") 1)
  (func (export "cabi_realloc") (param i32 i32 i32 i32) (result i32) i32.const 60000)
  (func $settle (param $res i32) (param $ws i32) (result i32)
    (if (result i32) (i32.eq (local.get $res) (i32.const -1))
      (then (drop (call $wait (local.get $ws) (i32.const 200))) (i32.load (i32.const 204)))
      (else (local.get $res))))
  (func (export "[async-lift-stackful]gentext") (param $n i32)
    (local $p i64) (local $w i32) (local $i i32) (local $ws i32) (local $res i32) (local $off i32)
    (local.set $p (call $stream_new))
    (call $task_return (i32.wrap_i64 (local.get $p)))
    (local.set $w (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (i32.store8 (i32.add (i32.const 1000) (local.get $i))
        (if (result i32) (i32.or (i32.eq (i32.rem_u (local.get $i) (i32.const 7)) (i32.const 6))
                                 (i32.eq (i32.rem_u (local.get $i) (i32.const 11)) (i32.const 10)))
          (then (i32.const 10))
          (else (i32.add (i32.const 97) (i32.rem_u (local.get $i) (i32.const 26))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (local.set $ws (call $ws_new))
    (call $join (local.get $w) (local.get $ws))
    (block $wd (loop $wl
      (br_if $wd (i32.ge_u (local.get $off) (local.get $n)))
      (local.set $res (call $settle (call $write (local.get $w) (i32.add (i32.const 1000) (local.get $off))
                                               (i32.sub (local.get $n) (local.get $off))) (local.get $ws)))
      (local.set $off (i32.add (local.get $off) (i32.shr_u (local.get $res) (i32.const 4))))
      (br_if $wd (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))
      (br $wl)))
    (call $join (local.get $w) (i32.const 0))
    (call $drop_w (local.get $w)))
)
