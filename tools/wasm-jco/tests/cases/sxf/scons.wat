;; The driver of the stream transformers: `raw(n)` is gentext(n); `runlines(n)` the lines of
;; gentext(n), each followed by '|'; `runchunks(n, k)` the chunks of rechunk(gentext(n), k),
;; each followed by '|'; `runtee(n)` the two outputs of tee(gentext(n)), read alternately,
;; joined by '/'.
(module
  (import "$root" "gentext" (func $gentext (param i32) (result i32)))
  (import "$root" "lines" (func $lines (param i32) (result i32)))
  (import "$root" "rechunk" (func $rechunk (param i32 i32) (result i32)))
  (import "$root" "tee" (func $tee (param i32 i32)))
  (import "$root" "[async-lower][stream-read-0]gentext" (func $readb (param i32 i32 i32) (result i32)))
  (import "$root" "[stream-drop-readable-0]gentext" (func $dropb (param i32)))
  (import "$root" "[async-lower][stream-read-1]lines" (func $readl (param i32 i32 i32) (result i32)))
  (import "$root" "[stream-drop-readable-1]lines" (func $dropl (param i32)))
  (import "$root" "[waitable-set-new]" (func $ws_new (result i32)))
  (import "$root" "[waitable-join]" (func $join (param i32 i32)))
  (import "$root" "[waitable-set-wait]" (func $wait (param i32 i32) (result i32)))
  (import "[export]$root" "[task-return]raw" (func $ret_raw (param i32 i32)))
  (import "[export]$root" "[task-return]runlines" (func $ret_lines (param i32 i32)))
  (import "[export]$root" "[task-return]runchunks" (func $ret_chunks (param i32 i32)))
  (import "[export]$root" "[task-return]runtee" (func $ret_tee (param i32 i32)))
  (memory (export "memory") 1)
  (global $heap (mut i32) (i32.const 30000))
  ;; a bump allocator for the list elements a read delivers
  (func (export "cabi_realloc") (param i32 i32 i32 i32) (result i32)
    (local $p i32)
    (local.set $p (global.get $heap))
    (global.set $heap (i32.add (global.get $heap) (local.get 3)))
    (local.get $p))
  (func $settle (param $res i32) (param $ws i32) (result i32)
    (if (result i32) (i32.eq (local.get $res) (i32.const -1))
      (then (drop (call $wait (local.get $ws) (i32.const 200))) (i32.load (i32.const 204)))
      (else (local.get $res))))
  ;; one read of up to 64 bytes from $r to $dst: the result word
  (func $readOnce (param $r i32) (param $ws i32) (param $dst i32) (result i32)
    (call $settle (call $readb (local.get $r) (local.get $dst) (i32.const 64)) (local.get $ws)))
  ;; read all of byte stream $r to $dst; its length
  (func $drainBytes (param $r i32) (param $dst i32) (result i32)
    (local $len i32) (local $res i32) (local $ws i32)
    (local.set $ws (call $ws_new))
    (call $join (local.get $r) (local.get $ws))
    (block $end (loop $l
      (local.set $res (call $readOnce (local.get $r) (local.get $ws) (i32.add (local.get $dst) (local.get $len))))
      (local.set $len (i32.add (local.get $len) (i32.shr_u (local.get $res) (i32.const 4))))
      (br_if $end (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))
      (br $l)))
    (call $join (local.get $r) (i32.const 0))
    (call $dropb (local.get $r))
    (local.get $len))
  ;; read all of list stream $r to 1000, each element followed by '|'; the length
  (func $drainLists (param $r i32) (result i32)
    (local $len i32) (local $res i32) (local $ws i32) (local $i i32) (local $p i32) (local $n i32)
    (local.set $ws (call $ws_new))
    (call $join (local.get $r) (local.get $ws))
    (block $end (loop $l
      (local.set $res (call $settle (call $readl (local.get $r) (i32.const 300) (i32.const 1)) (local.get $ws)))
      (if (i32.ge_u (i32.shr_u (local.get $res) (i32.const 4)) (i32.const 1)) (then
        (local.set $p (i32.load (i32.const 300)))
        (local.set $n (i32.load (i32.const 304)))
        (local.set $i (i32.const 0))
        (block $d (loop $c
          (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
          (i32.store8 (i32.add (i32.const 1000) (local.get $len))
            (i32.load8_u (i32.add (local.get $p) (local.get $i))))
          (local.set $len (i32.add (local.get $len) (i32.const 1)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $c)))
        (i32.store8 (i32.add (i32.const 1000) (local.get $len)) (i32.const 124))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))))
      (br_if $end (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))
      (br $l)))
    (call $join (local.get $r) (i32.const 0))
    (call $dropl (local.get $r))
    (local.get $len))
  (func (export "[async-lift-stackful]raw") (param $n i32)
    (call $ret_raw (i32.const 1000) (call $drainBytes (call $gentext (local.get $n)) (i32.const 1000))))
  (func (export "[async-lift-stackful]runlines") (param $n i32)
    (call $ret_lines (i32.const 1000) (call $drainLists (call $lines (call $gentext (local.get $n))))))
  (func (export "[async-lift-stackful]runchunks") (param $n i32) (param $k i32)
    (call $ret_chunks (i32.const 1000)
      (call $drainLists (call $rechunk (call $gentext (local.get $n)) (local.get $k)))))
  ;; the two outputs of tee, read alternately (tee writes each chunk to the first output, then
  ;; to the second), to 1000 and 10000; then the second appended after '/'
  (func (export "[async-lift-stackful]runtee") (param $n i32)
    (local $r1 i32) (local $r2 i32) (local $ws1 i32) (local $ws2 i32) (local $d1 i32) (local $d2 i32)
    (local $l1 i32) (local $l2 i32) (local $res i32) (local $i i32)
    (call $tee (call $gentext (local.get $n)) (i32.const 400))
    (local.set $r1 (i32.load (i32.const 400)))
    (local.set $r2 (i32.load (i32.const 404)))
    (local.set $ws1 (call $ws_new))
    (local.set $ws2 (call $ws_new))
    (call $join (local.get $r1) (local.get $ws1))
    (call $join (local.get $r2) (local.get $ws2))
    (block $end (loop $l
      (br_if $end (i32.and (local.get $d1) (local.get $d2)))
      (if (i32.eqz (local.get $d1)) (then
        (local.set $res (call $readOnce (local.get $r1) (local.get $ws1) (i32.add (i32.const 1000) (local.get $l1))))
        (local.set $l1 (i32.add (local.get $l1) (i32.shr_u (local.get $res) (i32.const 4))))
        (local.set $d1 (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))))
      (if (i32.eqz (local.get $d2)) (then
        (local.set $res (call $readOnce (local.get $r2) (local.get $ws2) (i32.add (i32.const 10000) (local.get $l2))))
        (local.set $l2 (i32.add (local.get $l2) (i32.shr_u (local.get $res) (i32.const 4))))
        (local.set $d2 (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))))
      (br $l)))
    (call $join (local.get $r1) (i32.const 0))
    (call $join (local.get $r2) (i32.const 0))
    (call $dropb (local.get $r1))
    (call $dropb (local.get $r2))
    (i32.store8 (i32.add (i32.const 1000) (local.get $l1)) (i32.const 47))
    (block $d (loop $c
      (br_if $d (i32.ge_u (local.get $i) (local.get $l2)))
      (i32.store8 (i32.add (i32.add (i32.const 1001) (local.get $l1)) (local.get $i))
        (i32.load8_u (i32.add (i32.const 10000) (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $c)))
    (call $ret_tee (i32.const 1000) (i32.add (i32.add (local.get $l1) (i32.const 1)) (local.get $l2))))
)
