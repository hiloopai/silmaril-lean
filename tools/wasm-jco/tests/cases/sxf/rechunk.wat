;; Streams.rechunk n: read bytes in chunks of up to 64, write every n bytes as one list<u8>
;; element, and at the end of the input the remainder when it is not empty (n = 0: one chunk).
(module
  (import "[export]$root" "[task-return]rechunk" (func $task_return (param i32)))
  (import "[export]$root" "[async-lower][stream-read-0]rechunk" (func $read (param i32 i32 i32) (result i32)))
  (import "[export]$root" "[stream-drop-readable-0]rechunk" (func $drop_r (param i32)))
  (import "[export]$root" "[stream-new-1]rechunk" (func $stream_new (result i64)))
  (import "[export]$root" "[async-lower][stream-write-1]rechunk" (func $write (param i32 i32 i32) (result i32)))
  (import "[export]$root" "[stream-drop-writable-1]rechunk" (func $drop_w (param i32)))
  (import "$root" "[waitable-set-new]" (func $ws_new (result i32)))
  (import "$root" "[waitable-join]" (func $join (param i32 i32)))
  (import "$root" "[waitable-set-wait]" (func $wait (param i32 i32) (result i32)))
  (memory (export "memory") 1)
  (func (export "cabi_realloc") (param i32 i32 i32 i32) (result i32) i32.const 60000)
  (func $settle (param $res i32) (param $ws i32) (result i32)
    (if (result i32) (i32.eq (local.get $res) (i32.const -1))
      (then (drop (call $wait (local.get $ws) (i32.const 200))) (i32.load (i32.const 204)))
      (else (local.get $res))))
  (func $emit (param $w i32) (param $ws i32) (param $len i32)
    (local $res i32)
    (i32.store (i32.const 300) (i32.const 4096))
    (i32.store (i32.const 304) (local.get $len))
    (block $d (loop $l
      (local.set $res (call $settle (call $write (local.get $w) (i32.const 300) (i32.const 1)) (local.get $ws)))
      (br_if $d (i32.ge_u (i32.shr_u (local.get $res) (i32.const 4)) (i32.const 1)))
      (br_if $d (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))
      (br $l))))
  (func (export "[async-lift-stackful]rechunk") (param $s i32) (param $k i32)
    (local $p i64) (local $w i32) (local $ws i32) (local $wsw i32) (local $res i32) (local $n i32)
    (local $i i32) (local $len i32)
    (local.set $p (call $stream_new))
    (call $task_return (i32.wrap_i64 (local.get $p)))
    (local.set $w (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))))
    (local.set $ws (call $ws_new))
    (local.set $wsw (call $ws_new))
    (call $join (local.get $s) (local.get $ws))
    (call $join (local.get $w) (local.get $wsw))
    (block $end (loop $l
      (local.set $res (call $settle (call $read (local.get $s) (i32.const 1000) (i32.const 64)) (local.get $ws)))
      (local.set $n (i32.shr_u (local.get $res) (i32.const 4)))
      (local.set $i (i32.const 0))
      (block $d (loop $u
        (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
        (i32.store8 (i32.add (i32.const 4096) (local.get $len))
          (i32.load8_u (i32.add (i32.const 1000) (local.get $i))))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))
        (if (i32.eq (local.get $len) (local.get $k))
          (then (call $emit (local.get $w) (local.get $wsw) (local.get $len)) (local.set $len (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $u)))
      (br_if $end (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))
      (br $l)))
    (if (local.get $len) (then (call $emit (local.get $w) (local.get $wsw) (local.get $len))))
    (call $join (local.get $s) (i32.const 0))
    (call $join (local.get $w) (i32.const 0))
    (call $drop_r (local.get $s))
    (call $drop_w (local.get $w)))
)
