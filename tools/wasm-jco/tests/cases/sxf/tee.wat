;; Streams.tee: read bytes in chunks of up to 64 and write each chunk to both outputs (first
;; one, then the other, each until it is taken); drop both at the end of the input.
(module
  (import "[export]$root" "[task-return]tee" (func $task_return (param i32 i32)))
  (import "[export]$root" "[async-lower][stream-read-0]tee" (func $read (param i32 i32 i32) (result i32)))
  (import "[export]$root" "[stream-drop-readable-0]tee" (func $drop_r (param i32)))
  (import "[export]$root" "[stream-new-0]tee" (func $stream_new (result i64)))
  (import "[export]$root" "[async-lower][stream-write-0]tee" (func $write (param i32 i32 i32) (result i32)))
  (import "[export]$root" "[stream-drop-writable-0]tee" (func $drop_w (param i32)))
  (import "$root" "[waitable-set-new]" (func $ws_new (result i32)))
  (import "$root" "[waitable-join]" (func $join (param i32 i32)))
  (import "$root" "[waitable-set-wait]" (func $wait (param i32 i32) (result i32)))
  (memory (export "memory") 1)
  (func (export "cabi_realloc") (param i32 i32 i32 i32) (result i32) i32.const 60000)
  (func $settle (param $res i32) (param $ws i32) (result i32)
    (if (result i32) (i32.eq (local.get $res) (i32.const -1))
      (then (drop (call $wait (local.get $ws) (i32.const 200))) (i32.load (i32.const 204)))
      (else (local.get $res))))
  ;; write bytes [1000, 1000 + n) to $w until all are taken (or the reader is gone)
  (func $put (param $w i32) (param $ws i32) (param $n i32)
    (local $off i32) (local $res i32)
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $off) (local.get $n)))
      (local.set $res (call $settle (call $write (local.get $w) (i32.add (i32.const 1000) (local.get $off))
                                               (i32.sub (local.get $n) (local.get $off))) (local.get $ws)))
      (local.set $off (i32.add (local.get $off) (i32.shr_u (local.get $res) (i32.const 4))))
      (br_if $d (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))
      (br $l))))
  (func (export "[async-lift-stackful]tee") (param $s i32)
    (local $p i64) (local $q i64) (local $w1 i32) (local $w2 i32) (local $ws i32) (local $ws1 i32)
    (local $ws2 i32) (local $res i32) (local $n i32)
    (local.set $p (call $stream_new))
    (local.set $q (call $stream_new))
    (call $task_return (i32.wrap_i64 (local.get $p)) (i32.wrap_i64 (local.get $q)))
    (local.set $w1 (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))))
    (local.set $w2 (i32.wrap_i64 (i64.shr_u (local.get $q) (i64.const 32))))
    (local.set $ws (call $ws_new))
    (local.set $ws1 (call $ws_new))
    (local.set $ws2 (call $ws_new))
    (call $join (local.get $s) (local.get $ws))
    (call $join (local.get $w1) (local.get $ws1))
    (call $join (local.get $w2) (local.get $ws2))
    (block $end (loop $l
      (local.set $res (call $settle (call $read (local.get $s) (i32.const 1000) (i32.const 64)) (local.get $ws)))
      (local.set $n (i32.shr_u (local.get $res) (i32.const 4)))
      (call $put (local.get $w1) (local.get $ws1) (local.get $n))
      (call $put (local.get $w2) (local.get $ws2) (local.get $n))
      (br_if $end (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))
      (br $l)))
    (call $join (local.get $s) (i32.const 0))
    (call $join (local.get $w1) (i32.const 0))
    (call $join (local.get $w2) (i32.const 0))
    (call $drop_r (local.get $s))
    (call $drop_w (local.get $w1))
    (call $drop_w (local.get $w2)))
)
