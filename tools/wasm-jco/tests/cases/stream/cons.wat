;; Read a whole stream into a string: `run(n)` reads upper(gen(n)), `raw(n)` reads gen(n).
(module
  (import "$root" "gen" (func $gen (param i32) (result i32)))
  (import "$root" "upper" (func $upper (param i32) (result i32)))
  (import "$root" "[async-lower][stream-read-0]gen" (func $read (param i32 i32 i32) (result i32)))
  (import "$root" "[stream-drop-readable-0]gen" (func $drop_r (param i32)))
  (import "$root" "[waitable-set-new]" (func $ws_new (result i32)))
  (import "$root" "[waitable-join]" (func $join (param i32 i32)))
  (import "$root" "[waitable-set-wait]" (func $wait (param i32 i32) (result i32)))
  (import "[export]$root" "[task-return]run" (func $ret_run (param i32 i32)))
  (import "[export]$root" "[task-return]raw" (func $ret_raw (param i32 i32)))
  (memory (export "memory") 1)
  (func (export "cabi_realloc") (param i32 i32 i32 i32) (result i32) i32.const 30000)
  ;; read all of stream `r` to address 1000; its length
  (func $drain (param $r i32) (result i32)
    (local $len i32) (local $res i32) (local $ws i32)
    (local.set $ws (call $ws_new))
    (call $join (local.get $r) (local.get $ws))
    (block $end (loop $l
      (local.set $res (call $read (local.get $r) (i32.add (i32.const 1000) (local.get $len)) (i32.const 64)))
      (if (i32.eq (local.get $res) (i32.const -1)) (then
        (drop (call $wait (local.get $ws) (i32.const 200)))
        (local.set $res (i32.load (i32.const 204)))))
      (local.set $len (i32.add (local.get $len) (i32.shr_u (local.get $res) (i32.const 4))))
      (br_if $end (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))
      (br $l)))
    (call $join (local.get $r) (i32.const 0))
    (call $drop_r (local.get $r))
    (local.get $len))
  (func (export "[async-lift-stackful]run") (param $n i32)
    (call $ret_run (i32.const 1000) (call $drain (call $upper (call $gen (local.get $n))))))
  (func (export "[async-lift-stackful]raw") (param $n i32)
    (call $ret_raw (i32.const 1000) (call $drain (call $gen (local.get $n)))))
)
