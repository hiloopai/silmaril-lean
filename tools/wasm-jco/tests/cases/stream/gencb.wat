;; `gen` in the callback ABI: the core export and the callback write what is left and return
;; WAIT (2 | set << 4) while a write blocks, then drop the writable end and return EXIT (0).
(module
  (import "[export]$root" "[task-return]gen" (func $task_return (param i32)))
  (import "[export]$root" "[stream-new-0]gen" (func $stream_new (result i64)))
  (import "[export]$root" "[async-lower][stream-write-0]gen" (func $stream_write (param i32 i32 i32) (result i32)))
  (import "[export]$root" "[stream-drop-writable-0]gen" (func $drop_w (param i32)))
  (import "$root" "[waitable-set-new]" (func $ws_new (result i32)))
  (import "$root" "[waitable-join]" (func $join (param i32 i32)))
  (memory (export "memory") 1)
  (global $w (mut i32) (i32.const 0))
  (global $off (mut i32) (i32.const 0))
  (global $n (mut i32) (i32.const 0))
  (global $ws (mut i32) (i32.const 0))
  ;; write the rest from $off; the callback code: WAIT on the set if the write blocked, else EXIT
  (func $pump (result i32)
    (local $res i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (global.get $off) (global.get $n)))
      (local.set $res (call $stream_write (global.get $w) (i32.add (i32.const 100) (global.get $off))
                                          (i32.sub (global.get $n) (global.get $off))))
      (if (i32.eq (local.get $res) (i32.const -1))
        (then (return (i32.or (i32.const 2) (i32.shl (global.get $ws) (i32.const 4))))))
      (global.set $off (i32.add (global.get $off) (i32.shr_u (local.get $res) (i32.const 4))))
      (br_if $done (i32.eq (i32.and (local.get $res) (i32.const 15)) (i32.const 1)))
      (br $l)))
    (call $join (global.get $w) (i32.const 0))
    (call $drop_w (global.get $w))
    (i32.const 0))
  (func (export "cabi_realloc") (param i32 i32 i32 i32) (result i32) i32.const 4096)
  (func (export "[async-lift]gen") (param $n i32) (result i32)
    (local $p i64) (local $i i32) (local $ws i32)
    (local.set $p (call $stream_new))
    (call $task_return (i32.wrap_i64 (local.get $p)))
    (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (i32.store8 (i32.add (i32.const 100) (local.get $i))
        (i32.add (i32.const 65) (i32.rem_u (local.get $i) (i32.const 26))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (global.set $n (local.get $n))
    (global.set $ws (call $ws_new))
    (call $join (global.get $w) (global.get $ws))
    (call $pump))
  ;; the event of the pending write: (event code, handle, payload)
  (func (export "[callback][async-lift]gen") (param i32 i32 i32) (result i32)
    (global.set $off (i32.add (global.get $off) (i32.shr_u (local.get 2) (i32.const 4))))
    (if (i32.eq (i32.and (local.get 2) (i32.const 15)) (i32.const 1))
      (then (global.set $off (global.get $n))))
    (call $pump))
)
