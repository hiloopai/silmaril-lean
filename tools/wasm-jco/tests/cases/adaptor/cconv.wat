;; The C convention of Silmaril.Wasm.Jco.Meta: an allocator alloc(size, align) -> ptr, and string
;; and list results written as (ptr, len) to an out-pointer passed as the last argument.
(module
  (memory (export "memory") 1)
  (global $bump (mut i32) (i32.const 1024))
  (func $alloc (export "alloc") (param $size i32) (param $align i32) (result i32)
    (local $p i32)
    (local.set $p (i32.and (i32.add (global.get $bump) (i32.const 7)) (i32.const -8)))
    (global.set $bump (i32.add (local.get $p) (local.get $size)))
    (local.get $p))
  (func (export "add") (param i32 i32) (result i32) local.get 0 local.get 1 i32.add)
  (data (i32.const 64) "hello, ")
  (func (export "greet") (param $p i32) (param $n i32) (param $out i32)
    (local $o i32)
    (local.set $o (call $alloc (i32.add (local.get $n) (i32.const 7)) (i32.const 1)))
    (memory.copy (local.get $o) (i32.const 64) (i32.const 7))
    (memory.copy (i32.add (local.get $o) (i32.const 7)) (local.get $p) (local.get $n))
    (i32.store (local.get $out) (local.get $o))
    (i32.store offset=4 (local.get $out) (i32.add (local.get $n) (i32.const 7))))
  (func (export "rev") (param $p i32) (param $n i32) (param $out i32)
    (local $o i32) (local $i i32)
    (local.set $o (call $alloc (local.get $n) (i32.const 1)))
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
      (i32.store8 (i32.add (local.get $o) (local.get $i))
        (i32.load8_u (i32.sub (i32.add (local.get $p) (local.get $n)) (i32.add (local.get $i) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (i32.store (local.get $out) (local.get $o))
    (i32.store offset=4 (local.get $out) (local.get $n)))
  (func (export "count") (param i32 i32) (result i32) local.get 1)
)
