(module
  (memory (export "memory") 1)
  (global $bump (mut i32) (i32.const 1024))
  (global $posts (mut i32) (i32.const 0))
  (func $alloc (export "cabi_realloc") (param i32 i32 i32 i32) (result i32)
    (local $p i32)
    ;; align up to 8, then bump
    (local.set $p (i32.and (i32.add (global.get $bump) (i32.const 7)) (i32.const -8)))
    (global.set $bump (i32.add (local.get $p) (local.get 3)))
    (local.get $p))
  ;; greet(s) = "hi " ++ s, returned through a pointer to (ptr, len)
  (data (i32.const 64) "hi ")
  (func (export "greet") (param $p i32) (param $n i32) (result i32)
    (local $o i32)
    (local.set $o (call $alloc (i32.const 0) (i32.const 0) (i32.const 1) (i32.add (local.get $n) (i32.const 3))))
    (memory.copy (local.get $o) (i32.const 64) (i32.const 3))
    (memory.copy (i32.add (local.get $o) (i32.const 3)) (local.get $p) (local.get $n))
    (i32.store (i32.const 16) (local.get $o))
    (i32.store (i32.const 20) (i32.add (local.get $n) (i32.const 3)))
    (i32.const 16))
  (func (export "len") (param i32 i32) (result i32) local.get 1)
  (func (export "rev") (param $p i32) (param $n i32) (result i32)
    (local $o i32) (local $i i32)
    (local.set $o (call $alloc (i32.const 0) (i32.const 0) (i32.const 1) (local.get $n)))
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
      (i32.store8 (i32.add (local.get $o) (local.get $i))
        (i32.load8_u (i32.sub (i32.add (local.get $p) (local.get $n)) (i32.add (local.get $i) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (i32.store (i32.const 32) (local.get $o))
    (i32.store (i32.const 36) (local.get $n))
    (i32.const 32))
  ;; post-return: count calls (observable only through the module)
  (func (export "cabi_post_rev") (param i32) (global.set $posts (i32.add (global.get $posts) (i32.const 1))))
  ;; pair(a) = (a + 1, "ok")
  (data (i32.const 80) "ok")
  (func (export "pair") (param $a i32) (result i32)
    (i32.store (i32.const 48) (i32.add (local.get $a) (i32.const 1)))
    (i32.store (i32.const 52) (i32.const 80))
    (i32.store (i32.const 56) (i32.const 2))
    (i32.const 48))
)
