;; Calls the inline interface calc and the resource interface test:iface/counter.
(module
  (import "calc" "twice" (func $twice (param i32 i32 i32)))
  (import "calc" "area" (func $area (param i32 i32 i32) (result i32)))
  (import "calc" "can" (func $can (param i32) (result i32)))
  (import "test:iface/counter" "[constructor]cnt" (func $mk (param i32) (result i32)))
  (import "test:iface/counter" "[method]cnt.get" (func $get (param i32) (result i32)))
  (import "test:iface/counter" "[method]cnt.bump" (func $bump (param i32 i32)))
  (import "test:iface/counter" "[resource-drop]cnt" (func $drop (param i32)))
  (import "$root" "drops" (func $drops (result i32)))
  (memory (export "memory") 1)
  (func (export "cabi_realloc") (param i32 i32 i32 i32) (result i32) i32.const 8192)
  ;; twice({x, y}) = {x', y'}: 1000 x' + y'
  (func (export "t1") (param $x i32) (param $y i32) (result i32)
    (call $twice (local.get $x) (local.get $y) (i32.const 32))
    (i32.add (i32.mul (i32.load (i32.const 32)) (i32.const 1000)) (i32.load (i32.const 36))))
  (func (export "t2") (param i32 i32 i32) (result i32)
    (call $area (local.get 0) (local.get 1) (local.get 2)))
  (func (export "t3") (param i32) (result i32) (call $can (local.get 0)))
  ;; a cnt of n, bumped by 5 and by 2, read, dropped
  (func $round (param $n i32) (result i32)
    (local $c i32) (local $v i32)
    (local.set $c (call $mk (local.get $n)))
    (call $bump (local.get $c) (i32.const 5))
    (call $bump (local.get $c) (i32.const 2))
    (local.set $v (call $get (local.get $c)))
    (call $drop (local.get $c))
    (local.get $v))
  (func (export "t4") (param i32) (result i32) (call $round (local.get 0)))
  ;; two rounds, then the number of destructor calls
  (func (export "t5") (param i32) (result i32)
    (drop (call $round (local.get 0)))
    (drop (call $round (local.get 0)))
    (call $drops))
)
