;; Imports test:iface/math, exports the resource interface test:iface/counter (cnt, with a
;; destructor) and the inline interface calc over the named types of test:iface/types.
(module
  (import "test:iface/math" "add" (func $add (param i32 i32) (result i32)))
  (import "test:iface/math" "norm" (func $norm (param i32 i32) (result i32)))
  (import "test:iface/math" "hue" (func $hue (param i32) (result i32)))
  (import "[export]test:iface/counter" "[resource-new]cnt" (func $new (param i32) (result i32)))
  (import "[export]test:iface/counter" "[resource-rep]cnt" (func $rep (param i32) (result i32)))
  (import "[export]test:iface/counter" "[resource-drop]cnt" (func $rdrop (param i32)))
  (memory (export "memory") 1)
  (global $next (mut i32) (i32.const 1024))
  (global $drops (mut i32) (i32.const 0))
  (func (export "cabi_realloc") (param i32 i32 i32 i32) (result i32) i32.const 8192)
  ;; a cnt is a cell of memory holding its value; the handle's rep is its address
  (func (export "test:iface/counter#[constructor]cnt") (param $start i32) (result i32)
    (local $p i32)
    (local.set $p (global.get $next))
    (global.set $next (i32.add (global.get $next) (i32.const 4)))
    (i32.store (local.get $p) (local.get $start))
    (call $new (local.get $p)))
  (func (export "test:iface/counter#[method]cnt.get") (param $self i32) (result i32)
    (i32.load (local.get $self)))
  (func (export "test:iface/counter#[method]cnt.bump") (param $self i32) (param $by i32)
    (i32.store (local.get $self) (i32.add (i32.load (local.get $self)) (local.get $by))))
  (func (export "test:iface/counter#[dtor]cnt") (param i32)
    (global.set $drops (i32.add (global.get $drops) (i32.const 1))))
  ;; calc: twice(p) = {x: add(p.x, p.x), y: norm(p)}, through a return pointer
  (func (export "calc#twice") (param $x i32) (param $y i32) (result i32)
    (i32.store (i32.const 64) (call $add (local.get $x) (local.get $x)))
    (i32.store (i32.const 68) (call $norm (local.get $x) (local.get $y)))
    (i32.const 64))
  ;; area: circle(r) = 3 r r, square(p) = p.x p.y, none = 0 (discriminant, then the joined payload)
  (func (export "calc#area") (param $d i32) (param $a i32) (param $b i32) (result i32)
    (if (result i32) (i32.eqz (local.get $d))
      (then (i32.mul (i32.const 3) (i32.mul (local.get $a) (local.get $a))))
      (else (if (result i32) (i32.eq (local.get $d) (i32.const 1))
        (then (i32.mul (local.get $a) (local.get $b)))
        (else (i32.const 0))))))
  ;; can: the read flag
  (func (export "calc#can") (param $p i32) (result i32) (i32.and (local.get $p) (i32.const 1)))
  (func (export "run") (param i32 i32) (result i32) (call $add (local.get 0) (local.get 1)))
  (func (export "drops") (result i32) (global.get $drops))
)
