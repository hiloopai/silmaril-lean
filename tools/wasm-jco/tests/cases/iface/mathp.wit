package test:iface;

interface types {
  record point { x: u32, y: u32 }
  enum color { red, green, blue }
}

interface math {
  use types.{point, color};
  add: func(a: u32, b: u32) -> u32;
  norm: func(p: point) -> u32;
  hue: func(c: color) -> color;
}

interface counter {
  resource cnt {
    constructor(start: u32);
    get: func() -> u32;
    bump: func(by: u32);
  }
}

world mathp {
  export math;
}
