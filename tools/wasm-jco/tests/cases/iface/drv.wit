package test:iface;

interface types {
  record point { x: u32, y: u32 }
  variant shape { circle(u32), square(point), none }
  flags perms { read, write, exec }
}

interface counter {
  resource cnt {
    constructor(start: u32);
    get: func() -> u32;
    bump: func(by: u32);
  }
}

world drv {
  import calc: interface {
    use types.{point, shape, perms};
    twice: func(p: point) -> point;
    area: func(s: shape) -> u32;
    can: func(p: perms) -> bool;
  }
  import counter;
  import drops: func() -> u32;
  export t1: func(x: u32, y: u32) -> u32;
  export t2: func(k: u32, a: u32, b: u32) -> u32;
  export t3: func(f: u32) -> bool;
  export t4: func(n: u32) -> u32;
  export t5: func(n: u32) -> u32;
}
